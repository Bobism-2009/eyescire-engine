let last_sprite_field_h: int = 0;

/* MATERIALS map fields (asset drag-drop) */
let mat_field_albedo_x: int = 0; let mat_field_albedo_y: int = 0; let mat_field_albedo_w: int = 0; let mat_field_albedo_h: int = 0;
let mat_field_normal_x: int = 0; let mat_field_normal_y: int = 0; let mat_field_normal_w: int = 0; let mat_field_normal_h: int = 0;
let mat_field_rough_x: int = 0; let mat_field_rough_y: int = 0; let mat_field_rough_w: int = 0; let mat_field_rough_h: int = 0;
let mat_field_metal_x: int = 0; let mat_field_metal_y: int = 0; let mat_field_metal_w: int = 0; let mat_field_metal_h: int = 0;
let mat_field_height_x: int = 0; let mat_field_height_y: int = 0; let mat_field_height_w: int = 0; let mat_field_height_h: int = 0;
let mat_field_ao_x: int = 0; let mat_field_ao_y: int = 0; let mat_field_ao_w: int = 0; let mat_field_ao_h: int = 0;

fn parse_int_or(s: string, def: int): int {
    if (s.len() == 0) return def;
    let n: int = 0;
    let neg: int = 0;
    let i: int = 0;
    if (s.substring(0, 1) == "-") { neg = 1; i = 1; }
    while (i < s.len()) {
        let ch: string = s.substring(i, 1);
        if (ch >= "0" && ch <= "9") {
            let d: int = 0;
            if (ch == "0") d = 0;
            if (ch == "1") d = 1;
            if (ch == "2") d = 2;
            if (ch == "3") d = 3;
            if (ch == "4") d = 4;
            if (ch == "5") d = 5;
            if (ch == "6") d = 6;
            if (ch == "7") d = 7;
            if (ch == "8") d = 8;
            if (ch == "9") d = 9;
            n = n * 10 + d;
        } else {
            return def;
        }
        i = i + 1;
    }
    if (neg == 1) return -n;
    return n;
}

/* Values the script marked with pub_float, pub_bool, or pub_string. */
fn inspector_draw_public(s: int, x: int, yy: int, w: int): int {
    let n: int = eng_pub_scan(s);
    if (n <= 0) return yy;
    if (n > 16) n = 16;
    yy = chrome_section(x, yy, w, "PUBLIC");
    let i: int = 0;
    while (i < n) {
        let nm: string = eng_pub_decl_name(i);
        let ty: int = eng_pub_decl_type(i);
        chrome_field_label(x, yy, nm);
        if (ty == 1) {
            let on: int = eng_pub_bool(s, i);
            let k0: string = "secondary";
            let k1: string = "secondary";
            if (on == 1) k1 = "primary";
            else k0 = "primary";
            if (ui_button_kind(rect(x, yy + 16, 70, 28), "Off", k0) == 1 && on == 1) {
                undo_save_modify(s);
                eng_pub_set_bool(s, i, 0);
            }
            if (ui_button_kind(rect(x + 78, yy + 16, 70, 28), "On", k1) == 1 && on == 0) {
                undo_save_modify(s);
                eng_pub_set_bool(s, i, 1);
            }
            if (eng_pub_isset(s, i) == 1) {
                if (ui_button(rect(x + w - 76, yy + 16, 76, 28), "Default") == 1) {
                    undo_save_modify(s);
                    eng_pub_unset(s, i);
                }
            }
            yy = yy + 52;
        } else {
            let shown: string = eng_pub_text(s, i);
            let fid: string = "insp_pub_" + i;
            let field_w: int = w;
            if (eng_pub_isset(s, i) == 1) field_w = w - 84;
            let edited: string = ui_field(fid, rect(x, yy + 16, field_w, 24), shown);
            if (edited != shown && eng_pub_text_ok(s, i, edited) == 2) {
                undo_save_modify(s);
                eng_pub_set_text(s, i, edited);
            }
            if (eng_pub_isset(s, i) == 1) {
                if (ui_button(rect(x + w - 76, yy + 16, 76, 24), "Default") == 1) {
                    undo_save_modify(s);
                    eng_pub_unset(s, i);
                    if (edit_target == fid) edit_target = "";
                }
            }
            yy = yy + 48;
        }
        i = i + 1;
    }
    return yy;
}

fn digit_of(ch: string): int {
    if (ch == "0") return 0;
    if (ch == "1") return 1;
    if (ch == "2") return 2;
    if (ch == "3") return 3;
    if (ch == "4") return 4;
    if (ch == "5") return 5;
    if (ch == "6") return 6;
    if (ch == "7") return 7;
    if (ch == "8") return 8;
    if (ch == "9") return 9;
    return -1;
}

fn parse_float_or(s: string, def: float): float {
    if (s.len() == 0) return def;
    let neg: int = 0;
    let i: int = 0;
    if (s.substring(0, 1) == "-") { neg = 1; i = 1; }
    let whole: int = 0;
    let frac: int = 0;
    let frac_div: float = 1.0;
    let seen_dot: int = 0;
    let any_digit: int = 0;
    while (i < s.len()) {
        let ch: string = s.substring(i, 1);
        if (ch == ".") {
            if (seen_dot == 1) return def;
            seen_dot = 1;
            i = i + 1;
            continue;
        }
        let d: int = digit_of(ch);
        if (d < 0) return def;
        any_digit = 1;
        if (seen_dot == 0) {
            whole = whole * 10 + d;
        } else {
            frac = frac * 10 + d;
            frac_div = frac_div * 10.0;
        }
        i = i + 1;
    }
    if (any_digit == 0) return def;
    let wf: float = whole;
    let ff: float = frac;
    let val: float = wf + ff / frac_div;
    if (neg == 1) val = -val;
    return val;
}

/* Format a float with two decimal places (no printf dependency). */
fn fmt2(v: float): string {
    let neg: int = 0;
    let x: float = v;
    if (x < 0.0) { neg = 1; x = -x; }
    let scaled: int = x * 100.0 + 0.5;
    let whole: int = scaled / 100;
    let frac: int = scaled - whole * 100;
    let fs: string = "" + frac;
    if (frac < 10) fs = "0" + fs;
    let out: string = "" + whole + "." + fs;
    if (neg == 1) out = "-" + out;
    return out;
}

fn body_type_label(t: int): string {
    if (t == 0) return "Static";
    if (t == 2) return "Kinematic";
    return "Dynamic";
}

fn refresh_inspector_buffers(s: int) {
    if (s != last_inspector_slot) {
        /* Only discard an in-progress edit when switching between two real
         * entities.  last_inspector_slot is sometimes set to -1 just to force
         * a buffer reload (e.g. after a drag-drop) — that must NOT kill rename. */
        if (last_inspector_slot >= 0 && s >= 0) {
            edit_target = "";
            edit_buf    = "";
        }
        last_inspector_slot = s;
        insp_btn_pick = 0;
        btn_fn_for = "";
        insp_buf_name   = ent_name(s);
        insp_buf_text   = ent_text(s);
        insp_buf_uival  = "" + ent_ui_value(s);
        insp_buf_script = ent_script(s);
        insp_buf_sprite = ent_sprite(s);
        insp_buf_x      = "" + ent_x(s);
        insp_buf_y      = "" + ent_y(s);
        insp_buf_w      = "" + ent_w(s);
        insp_buf_h      = "" + ent_h(s);
        insp_buf_font   = "" + ent_font_px(s);
        insp_buf_rot    = "" + ent_rot(s);
        insp_buf_rotx   = "" + ent_rot_x(s);
        insp_buf_roty   = "" + ent_rot_y(s);
        insp_buf_z      = "" + ent_z(s);
        insp_buf_depth  = "" + ent_depth(s);
        insp_buf_l_int   = "" + ent_light_intensity(s);
        insp_buf_l_range = "" + ent_light_range(s);
        insp_buf_l_angle = "" + ent_light_angle(s);
        insp_buf_l_tilt  = "" + ent_light_tilt(s);
        insp_buf_model  = ent_model(s);
        insp_buf_tex_albedo = ent_tex_albedo(s);
        insp_buf_tex_normal = ent_tex_normal(s);
        insp_buf_tex_rough  = ent_tex_rough(s);
        insp_buf_tex_metal  = ent_tex_metal(s);
        insp_buf_tex_height = ent_tex_height(s);
        insp_buf_tex_ao     = ent_tex_ao(s);
        insp_buf_mat_rough  = "" + ent_mat_rough(s);
        insp_buf_mat_metal  = "" + ent_mat_metal(s);
        insp_buf_mat_bump   = "" + ent_mat_bump(s);
        insp_buf_mat_tile   = "" + ent_mat_tile(s);
        insp_buf_sound  = ent_sound(s);
        insp_buf_sound_range = "" + ent_sound_range(s);
        insp_buf_emrate = "" + ent_emit_rate(s);
        insp_buf_emlife = "" + ent_emit_life(s);
        insp_buf_emspeed = "" + ent_emit_speed(s);
        insp_buf_emspread = "" + ent_emit_spread(s);
        insp_buf_emsize = "" + ent_emit_size(s);
        insp_buf_density     = fmt2(ent_density(s));
        insp_buf_friction    = fmt2(ent_friction(s));
        insp_buf_restitution = fmt2(ent_restitution(s));
        insp_buf_gravscale   = fmt2(ent_gravity_scale(s));
    }
}

fn inspector_end_rename() {
    if (rename_ent_slot >= 0 && edit_target == "insp_name") {
        if (edit_buf != ent_name(rename_ent_slot)) {
            undo_save_modify(rename_ent_slot);
            ent_set_name(rename_ent_slot, edit_buf);
            if (last_inspector_slot == rename_ent_slot) insp_buf_name = edit_buf;
        }
    }
    if (edit_target == "insp_name") edit_target = "";
    rename_ent_slot = -1;
}

fn inspector_begin_rename(s: int) {
    refresh_inspector_buffers(s);
    rename_ent_slot = s;
    edit_buf    = insp_buf_name;
    edit_target = "insp_name";
    /* caret at the end, nothing selected — Rename / F2 should not select-all */
    edit_caret  = edit_buf.len();
    edit_anchor = edit_caret;
}

fn insp_tint_row(s: int, x: int, yy: int, w: int, label: string, which: int): int {
    chrome_field_label(x, yy, label);
    let mode: string = "Auto";
    if (ent_button_custom(s, which) == 1) mode = "Custom";
    if (ui_button(rect(x + w - 78, yy - 2, 78, 22), mode) == 1 && ent_button_custom(s, which) == 1) {
        undo_save_modify(s);
        ent_set_button_custom(s, which, 0);
    }
    yy = yy + 18;
    let cr: int = ent_button_resolved(s, which, 0);
    let cg: int = ent_button_resolved(s, which, 1);
    let cb: int = ent_button_resolved(s, which, 2);
    th_fill(rect(x, yy, 22, 22), 5, rgb(cr, cg, cb));
    let fw: int = (w - 36) / 3;
    let rs: string = ui_field("bc" + which + "r", rect(x + 30, yy, fw - 4, 22), "" + cr);
    let gs: string = ui_field("bc" + which + "g", rect(x + 30 + fw, yy, fw - 4, 22), "" + cg);
    let bs: string = ui_field("bc" + which + "b", rect(x + 30 + fw * 2, yy, w - 30 - fw * 2, 22), "" + cb);
    let nr: int = parse_int_or(rs, cr);
    let ng: int = parse_int_or(gs, cg);
    let nb: int = parse_int_or(bs, cb);
    if (nr < 0) nr = 0;
    if (ng < 0) ng = 0;
    if (nb < 0) nb = 0;
    if (nr > 255) nr = 255;
    if (ng > 255) ng = 255;
    if (nb > 255) nb = 255;
    if (nr != cr || ng != cg || nb != cb) {
        undo_save_modify(s);
        ent_set_button_color(s, which, nr, ng, nb);
    }
    yy = yy + 28;
    let pal_r = [220, 220,  80,  80, 180, 220,  60,  40];
    let pal_g = [180,  80, 200, 140,  80, 220,  60,  44];
    let pal_b = [ 80,  80, 120, 220, 200, 220,  60,  52];
    let pi: int = 0;
    while (pi < 8) {
        let sw: Rect = rect(x + pi * 30, yy, 22, 22);
        let pc: Color = rgb(pal_r[pi], pal_g[pi], pal_b[pi]);
        let mx: int = eng_mouse_x();
        let my: int = eng_mouse_y();
        if (cr == pal_r[pi] && cg == pal_g[pi] && cb == pal_b[pi]) {
            th_edge(rect(sw.x - 3, sw.y - 3, sw.w + 6, sw.h + 6), 8, col_text_main());
        } else if (point_in_rect(mx, my, sw)) {
            th_edge(rect(sw.x - 3, sw.y - 3, sw.w + 6, sw.h + 6), 8, col_ui_border());
        }
        th_fill(sw, 5, pc);
        if (point_in_rect(mx, my, sw) && mouse_pressed(MOUSE_LEFT)) {
            undo_save_modify(s);
            ent_set_button_color(s, which, pal_r[pi], pal_g[pi], pal_b[pi]);
        }
        pi = pi + 1;
    }
    return yy + 32;
}

fn btn_trim(s: string): string {
    let i: int = 0;
    while (i < s.len()) {
        let c: string = s.substring(i, 1);
        if (c != " " && c != "\t" && c != "\r") return s.substring(i, s.len() - i);
        i = i + 1;
    }
    return "";
}

fn btn_find(s: string, ch: string, from: int): int {
    let i: int = from;
    while (i < s.len()) {
        if (s.substring(i, 1) == ch) return i;
        i = i + 1;
    }
    return -1;
}

fn btn_blank(s: string): int {
    let i: int = 0;
    while (i < s.len()) {
        let c: string = s.substring(i, 1);
        if (c != " " && c != "\t" && c != "\r") return 0;
        i = i + 1;
    }
    return 1;
}

fn btn_ident(s: string): int {
    if (s.len() == 0) return 0;
    let i: int = 0;
    while (i < s.len()) {
        let c: string = s.substring(i, 1);
        let ok: int = 0;
        if (c >= "a" && c <= "z") ok = 1;
        if (c >= "A" && c <= "Z") ok = 1;
        if (c >= "0" && c <= "9") ok = 1;
        if (c == "_") ok = 1;
        if (ok == 0) return 0;
        i = i + 1;
    }
    return 1;
}

fn btn_cut_line(line: string): string {
    let i: int = 0;
    while (i + 1 < line.len()) {
        if (line.substring(i, 2) == "//") return line.substring(0, i);
        i = i + 1;
    }
    return line;
}

fn btn_skip_name(name: string): int {
    if (name == "script_init" || name == "script_update" || name == "script_draw") return 1;
    /* Blueprint helpers are always emitted as bp_*; only bpfn_* is a user On click target. */
    if (name.len() >= 5 && name.substring(0, 5) == "bpfn_") return 0;
    if (name.len() >= 3 && name.substring(0, 3) == "bp_") return 1;
    return 0;
}

fn btn_fn_label(sym: string): string {
    let hash: int = btn_find(sym, "#", 0);
    if (hash >= 0) sym = sym.substring(0, hash);
    if (sym.len() < 6 || sym.substring(0, 5) != "bpfn_") return sym;
    let i: int = 5;
    while (i < sym.len()) {
        let c: string = sym.substring(i, 1);
        if (c == "_") {
            let rest: string = sym.substring(i + 1, sym.len() - i - 1);
            if (rest.len() == 0) return sym;
            let o: string = "";
            let k: int = 0;
            while (k < rest.len()) {
                let ch: string = rest.substring(k, 1);
                if (ch == "_") o = o + " ";
                else o = o + ch;
                k = k + 1;
            }
            return o;
        }
        if (c < "0" || c > "9") return sym;
        i = i + 1;
    }
    return sym;
}

fn btn_fn_count(): int {
    if (btn_fn_blob.len() == 0) return 0;
    return len(btn_fn_blob.split("\n"));
}

fn btn_fn_at(index: int): string {
    if (btn_fn_blob.len() == 0) return "";
    let lines = btn_fn_blob.split("\n");
    if (index < 0 || index >= len(lines)) return "";
    return lines[index];
}

fn btn_arg_sig(args: string): string {
    if (btn_blank(args) == 1) return "";
    let sig: string = "";
    let part: string = "";
    let i: int = 0;
    while (i <= args.len()) {
        let at_end: int = 0;
        let comma: int = 0;
        if (i == args.len()) at_end = 1;
        else if (args.substring(i, 1) == ",") comma = 1;
        if (at_end == 1 || comma == 1) {
            let ty: string = btn_trim(part);
            let colon: int = btn_find(ty, ":", 0);
            if (colon >= 0) ty = btn_trim(ty.substring(colon + 1, ty.len() - colon - 1));
            if (ty == "float") sig = sig + "f";
            else if (ty == "int" || ty == "bool") sig = sig + "i";
            else if (ty == "string") sig = sig + "s";
            else return "?";
            part = "";
        } else {
            part = part + args.substring(i, 1);
        }
        i = i + 1;
    }
    if (sig.len() > 4) return "?";
    return sig;
}

fn btn_rescan(sc: string) {
    if (sc == btn_fn_for) return;
    btn_fn_for = sc;
    btn_fn_blob = "";
    if (sc.len() == 0) return;
    let path: string = proj_path_join(proj_path_join(proj_root(), "scripts"), sc);
    if (eng_fs_exists(path) == 0) return;
    let raw: string = file.read(path);
    let lines = raw.split("\n");
    let n: int = len(lines);
    let i: int = 0;
    let note: int = 0;
    while (i < n) {
        let line: string = lines[i];
        i = i + 1;
        if (note == 1) {
            if (btn_find(line, "*", 0) >= 0 && btn_find(line, "/", 0) >= 0) note = 0;
            continue;
        }
        let cut: string = btn_cut_line(line);
        if (btn_find(cut, "/", 0) >= 0 && btn_find(cut, "*", 0) >= 0) {
            let open_at: int = btn_find(cut, "/", 0);
            if (open_at + 1 < cut.len() && cut.substring(open_at, 2) == "/*") {
                if (btn_find(cut, "*", open_at + 2) < 0) note = 1;
                cut = cut.substring(0, open_at);
            }
        }
        let body: string = btn_trim(cut);
        if (body.len() < 5) continue;
        if (body.substring(0, 3) != "fn ") continue;
        let paren: int = btn_find(body, "(", 3);
        if (paren < 0) continue;
        let close: int = btn_find(body, ")", paren + 1);
        if (close < 0) continue;
        let name: string = btn_trim(body.substring(3, paren - 3));
        let args: string = body.substring(paren + 1, close - paren - 1);
        if (btn_ident(name) == 0) continue;
        if (btn_skip_name(name) == 1) continue;
        let sig: string = btn_arg_sig(args);
        if (sig == "?") continue;
        let token: string = name + "#" + sig;
        if (btn_fn_blob.len() == 0) btn_fn_blob = token;
        else btn_fn_blob = btn_fn_blob + "\n" + token;
    }
}

fn insp_button_action(s: int, x: int, yy: int, w: int): int {
    let was: int = insp_btn_pick;
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let ate: int = 0;
    chrome_field_label(x, yy, "On click");
    yy = yy + 16;
    let sc: string = ent_button_script(s);
    let slabel: string = "Script: none";
    if (sc.len() > 0) slabel = sc;
    let son: int = 0;
    if (was == 1) son = 1;
    let y_script: int = yy;
    if (ui_pill(rect(x, yy, w, 24), slabel, son) == 1) {
        ate = 1;
        if (was == 1) insp_btn_pick = 0;
        else insp_btn_pick = 1;
    }
    yy = yy + 28;
    if (was == 1) {
        let none_on: int = 0;
        if (sc.len() == 0) none_on = 1;
        if (ui_pill(rect(x, yy, w, 24), "None", none_on) == 1) {
            ate = 1;
            undo_save_modify(s);
            ent_set_button_script(s, "");
            ent_set_button_fn(s, "");
            insp_btn_pick = 0;
            btn_fn_for = "";
        }
        yy = yy + 26;
        let si: int = 0;
        let sn: int = proj_script_count();
        while (si < sn) {
            let sname: string = proj_script_name(si);
            let on: int = 0;
            if (sname == sc) on = 1;
            if (ui_pill(rect(x, yy, w, 24), sname, on) == 1) {
                ate = 1;
                undo_save_modify(s);
                ent_set_button_script(s, sname);
                ent_set_button_fn(s, "");
                insp_btn_pick = 0;
                btn_fn_for = "";
            }
            yy = yy + 26;
            si = si + 1;
        }
    }
    if (sc.len() > 0) btn_rescan(sc);
    else {
        btn_fn_for = "";
        btn_fn_blob = "";
    }
    let fnm: string = ent_button_fn(s);
    /* Drop a stale pick that is no longer a listed On click target. */
    if (fnm.len() > 0) {
        let known: int = 0;
        let ki: int = 0;
        let kn: int = btn_fn_count();
        while (ki < kn) {
            if (btn_fn_at(ki) == fnm) known = 1;
            ki = ki + 1;
        }
        if (known == 0) {
            ent_set_button_fn(s, "");
            fnm = "";
        }
    }
    let flabel: string = "Function: none";
    if (fnm.len() > 0) flabel = btn_fn_label(fnm);
    let fon: int = 0;
    if (was == 2) fon = 1;
    if (ui_pill(rect(x, yy, w, 24), flabel, fon) == 1 && sc.len() > 0) {
        ate = 1;
        if (was == 2) insp_btn_pick = 0;
        else {
            insp_btn_pick = 2;
            btn_fn_for = "";
        }
    }
    yy = yy + 28;
    if (was == 2 && sc.len() > 0) {
        let fnone: int = 0;
        if (fnm.len() == 0) fnone = 1;
        if (ui_pill(rect(x, yy, w, 24), "None", fnone) == 1) {
            ate = 1;
            undo_save_modify(s);
            ent_set_button_fn(s, "");
            insp_btn_pick = 0;
        }
        yy = yy + 26;
        let fi: int = 0;
        let fnc: int = btn_fn_count();
        while (fi < fnc) {
            let sym: string = btn_fn_at(fi);
            let onf: int = 0;
            if (sym == fnm) onf = 1;
            if (ui_pill(rect(x, yy, w, 24), btn_fn_label(sym), onf) == 1) {
                ate = 1;
                undo_save_modify(s);
                ent_set_button_fn(s, sym);
                insp_btn_pick = 0;
            }
            yy = yy + 26;
            fi = fi + 1;
        }
        if (fnc == 0) {
            th_font(11);
            draw_text(x, yy, "This script has no On click functions.", col_text_dim());
            th_font(14);
            yy = yy + 16;
        }
    }
    th_font(11);
    draw_text(x, yy, "Play and click. Runs on an object that uses this script.", col_text_dim());
    th_font(14);
    yy = yy + 16;
    if (ate == 0 && mouse_pressed(MOUSE_LEFT) && was != 0) {
        if (my < y_script || my >= yy || mx < x || mx >= x + w) insp_btn_pick = 0;
    }
    return yy + 8;
}

fn insp_button_colors(s: int, x: int, yy: int, w: int): int {
    yy = insp_button_action(s, x, yy, w);
    let tog_label: string = "Toggle: off";
    if (ent_button_toggle(s) == 1) tog_label = "Toggle: on";
    if (ui_button(rect(x, yy, w, 24), tog_label) == 1) {
        undo_save_modify(s);
        if (ent_button_toggle(s) == 1) ent_set_button_toggle(s, 0);
        else                            ent_set_button_toggle(s, 1);
    }
    yy = yy + 30;
    yy = insp_tint_row(s, x, yy, w, "Hover", 0);
    yy = insp_tint_row(s, x, yy, w, "Pressed", 1);
    if (ent_button_toggle(s) == 1) {
        yy = insp_tint_row(s, x, yy, w, "On", 2);
        yy = insp_tint_row(s, x, yy, w, "On hover", 3);
    }
    th_font(11);
    draw_text(x, yy, "Auto darkens. A swatch or number sets that color.", col_text_dim());
    th_font(14);
    return yy + 18;
}

fn insp_style_num(s: int, x: int, yy: int, w: int, label: string, field_id: string, cur: int, which: int): int {
    chrome_field_label(x, yy, label);
    let shown: string = "Auto";
    if (cur >= 0) shown = "" + cur;
    let box_w: int = w - 72;
    let next: string = ui_field(field_id, rect(x, yy + 16, box_w, 24), shown);
    if (next != shown) {
        undo_save_modify(s);
        let nv: int = -1;
        if (next != "" && next != "Auto" && next != "auto") nv = parse_int_or(next, cur);
        if (which == 0) ent_set_ui_radius(s, nv);
        else ent_set_ui_border(s, nv);
    }
    if (ui_button(rect(x + w - 64, yy + 16, 64, 24), "Auto") == 1 && cur >= 0) {
        undo_save_modify(s);
        if (which == 0) ent_set_ui_radius(s, -1);
        else ent_set_ui_border(s, -1);
    }
    return yy + 48;
}

fn insp_ui_style(s: int, x: int, yy: int, w: int): int {
    let align: int = ent_ui_align(s);
    let ha: int = align % 3;
    let va: int = align / 3;
    let bw: int = (w - 16) / 3;
    let k0: string = "secondary";
    let k1: string = "secondary";
    let k2: string = "secondary";
    if (ui_ent_owns_caption(s) == 0) {
    if (ha == 0) k0 = "primary";
    if (ha == 1) k1 = "primary";
    if (ha == 2) k2 = "primary";
    chrome_field_label(x, yy, "Align");
    yy = yy + 16;
    if (ui_button_kind(rect(x, yy, bw, 24), "Left", k0) == 1 && ha != 0) {
        undo_save_modify(s);
        ent_set_ui_align(s, va * 3);
    }
    if (ui_button_kind(rect(x + bw + 8, yy, bw, 24), "Center", k1) == 1 && ha != 1) {
        undo_save_modify(s);
        ent_set_ui_align(s, 1 + va * 3);
    }
    if (ui_button_kind(rect(x + (bw + 8) * 2, yy, bw, 24), "Right", k2) == 1 && ha != 2) {
        undo_save_modify(s);
        ent_set_ui_align(s, 2 + va * 3);
    }
    yy = yy + 30;
    k0 = "secondary";
    k1 = "secondary";
    k2 = "secondary";
    if (va == 0) k0 = "primary";
    if (va == 1) k1 = "primary";
    if (va == 2) k2 = "primary";
    if (ui_button_kind(rect(x, yy, bw, 24), "Top", k0) == 1 && va != 0) {
        undo_save_modify(s);
        ent_set_ui_align(s, ha);
    }
    if (ui_button_kind(rect(x + bw + 8, yy, bw, 24), "Middle", k1) == 1 && va != 1) {
        undo_save_modify(s);
        ent_set_ui_align(s, ha + 3);
    }
    if (ui_button_kind(rect(x + (bw + 8) * 2, yy, bw, 24), "Bottom", k2) == 1 && va != 2) {
        undo_save_modify(s);
        ent_set_ui_align(s, ha + 6);
    }
    yy = yy + 32;
    }

    let kind: string = ent_kind(s);
    let boxy: int = 1;
    if (kind == "label" || kind == "ui_label") boxy = 0;
    if (kind == "checkbox" || kind == "ui_checkbox") boxy = 0;
    if (kind == "toggle" || kind == "ui_toggle") boxy = 0;
    if (kind == "slider" || kind == "ui_slider") boxy = 0;
    if (boxy == 1) {
        yy = insp_style_num(s, x, yy, w, "Radius", "insp_rad", ent_ui_radius(s), 0);
        yy = insp_style_num(s, x, yy, w, "Border", "insp_bdr", ent_ui_border(s), 1);
        let sh: int = ent_ui_shadow(s);
        k0 = "secondary";
        k1 = "secondary";
        k2 = "secondary";
        if (sh == 0) k0 = "primary";
        if (sh == 1) k1 = "primary";
        if (sh == 2) k2 = "primary";
        chrome_field_label(x, yy, "Shadow");
        yy = yy + 16;
        if (ui_button_kind(rect(x, yy, bw, 24), "Auto", k0) == 1 && sh != 0) {
            undo_save_modify(s);
            ent_set_ui_shadow(s, 0);
        }
        if (ui_button_kind(rect(x + bw + 8, yy, bw, 24), "Off", k1) == 1 && sh != 1) {
            undo_save_modify(s);
            ent_set_ui_shadow(s, 1);
        }
        if (ui_button_kind(rect(x + (bw + 8) * 2, yy, bw, 24), "On", k2) == 1 && sh != 2) {
            undo_save_modify(s);
            ent_set_ui_shadow(s, 2);
        }
        yy = yy + 32;
    }

    if (kind != "label" && kind != "ui_label") {
        chrome_field_label(x, yy, "Text color");
        let custom: int = ent_ui_text(s);
        let cr: int = 240;
        let cg: int = 240;
        let cb: int = 240;
        if (custom >= 0) {
            cr = ui_text_chan(s, 0);
            cg = ui_text_chan(s, 1);
            cb = ui_text_chan(s, 2);
        }
        if (ui_button(rect(x + w - 64, yy - 2, 64, 22), "Auto") == 1 && custom >= 0) {
            undo_save_modify(s);
            ent_set_ui_text(s, -1);
        }
        yy = yy + 18;
        th_fill(rect(x, yy, 22, 22), 5, rgb(cr, cg, cb));
        let fw: int = (w - 36) / 3;
        let rs: string = ui_field("insp_tr", rect(x + 30, yy, fw - 4, 22), "" + cr);
        let gs: string = ui_field("insp_tg", rect(x + 30 + fw, yy, fw - 4, 22), "" + cg);
        let bs: string = ui_field("insp_tb", rect(x + 30 + fw * 2, yy, w - 30 - fw * 2, 22), "" + cb);
        let nr: int = parse_int_or(rs, cr);
        let ng: int = parse_int_or(gs, cg);
        let nb: int = parse_int_or(bs, cb);
        if (nr < 0) nr = 0;
        if (ng < 0) ng = 0;
        if (nb < 0) nb = 0;
        if (nr > 255) nr = 255;
        if (ng > 255) ng = 255;
        if (nb > 255) nb = 255;
        if (nr != cr || ng != cg || nb != cb) {
            undo_save_modify(s);
            ent_set_ui_text(s, ui_pack_text(nr, ng, nb));
        }
        yy = yy + 30;
    }
    return yy;
}

fn insp_ui_widget(s: int, x: int, yy: int, w: int): int {
    let check: int = ui_ent_is_check(s);
    let tog: int = ui_ent_is_toggle(s);
    let slider: int = ui_ent_is_slider(s);
    let bar: int = ui_ent_is_bar(s);
    let field: int = ui_ent_is_field(s);
    if (check == 0 && tog == 0 && slider == 0 && bar == 0 && field == 0) return yy;
    if (check == 1 || tog == 1) {
        let lab: string = "Checked: off";
        if (ent_button_toggled(s) == 1) lab = "Checked: on";
        if (ui_button(rect(x, yy, w, 24), lab) == 1) {
            undo_save_modify(s);
            if (ent_button_toggled(s) == 1) ent_set_button_toggled(s, 0);
            else ent_set_button_toggled(s, 1);
        }
        yy = yy + 30;
    }
    if (slider == 1 || bar == 1) {
        chrome_field_label(x, yy, "Value (0-100)");
        let vb: string = ui_field("insp_uival", rect(x, yy + 16, w, 24), insp_buf_uival);
        if (vb != insp_buf_uival) {
            undo_save_modify(s);
            ent_set_ui_value(s, parse_int_or(vb, ent_ui_value(s)));
            insp_buf_uival = "" + ent_ui_value(s);
        }
        yy = yy + 48;
    }
    if (bar == 0) yy = insp_button_action(s, x, yy, w);
    th_font(11);
    if (field == 1) draw_text(x, yy, "Play, click it, and type. Enter runs On click.", col_text_dim());
    else if (slider == 1) draw_text(x, yy, "Play and drag. Releasing runs On click.", col_text_dim());
    else if (bar == 1) draw_text(x, yy, "A script sets the value. Clicks do nothing.", col_text_dim());
    else draw_text(x, yy, "Play and click. On click runs after it flips.", col_text_dim());
    th_font(14);
    return yy + 18;
}

fn pick_checker(x: int, y: int, w: int, h: int) {
    eng_fill_rect(x, y, w, h, 168, 168, 168);
    let row: int = 0;
    let yy: int = 0;
    while (yy < h) {
        let xx: int = 0;
        if (row % 2 == 1) xx = 4;
        while (xx < w) {
            let cw: int = 4;
            if (xx + cw > w) cw = w - xx;
            let ch: int = 4;
            if (yy + ch > h) ch = h - yy;
            eng_fill_rect(x + xx, y + yy, cw, ch, 110, 110, 110);
            xx = xx + 8;
        }
        yy = yy + 4;
        row = row + 1;
    }
}

fn pick_write_rgb(slot: int, r: int, gv: int, b: int) {
    if (r == ent_r(slot) && gv == ent_g(slot) && b == ent_b(slot)) return;
    if (pick_undo == 0) {
        undo_save_modify(slot);
        pick_undo = 1;
    }
    ent_set_color(slot, r, gv, b);
}

fn pick_write_a(slot: int, a: int) {
    if (a < 0) a = 0;
    if (a > 255) a = 255;
    if (a == ent_a(slot)) return;
    if (pick_undo == 0) {
        undo_save_modify(slot);
        pick_undo = 1;
    }
    ent_set_alpha(slot, a);
}

fn pick_commit_chan(slot: int, id: string, box: Rect, cur: int): int {
    let shown: string = "" + cur;
    let got: string = ui_field(id, box, shown);
    if (got == shown) return cur;
    let nv: int = parse_int_or(got, cur);
    if (nv < 0) nv = 0;
    if (nv > 255) nv = 255;
    if (nv == cur) return cur;
    undo_save_modify(slot);
    return nv;
}

fn mat_field_store(kind: string, r: Rect) {
    if (kind == "albedo") { mat_field_albedo_x = r.x; mat_field_albedo_y = r.y; mat_field_albedo_w = r.w; mat_field_albedo_h = r.h; }
    else if (kind == "normal") { mat_field_normal_x = r.x; mat_field_normal_y = r.y; mat_field_normal_w = r.w; mat_field_normal_h = r.h; }
    else if (kind == "rough") { mat_field_rough_x = r.x; mat_field_rough_y = r.y; mat_field_rough_w = r.w; mat_field_rough_h = r.h; }
    else if (kind == "metal") { mat_field_metal_x = r.x; mat_field_metal_y = r.y; mat_field_metal_w = r.w; mat_field_metal_h = r.h; }
    else if (kind == "height") { mat_field_height_x = r.x; mat_field_height_y = r.y; mat_field_height_w = r.w; mat_field_height_h = r.h; }
    else if (kind == "ao") { mat_field_ao_x = r.x; mat_field_ao_y = r.y; mat_field_ao_w = r.w; mat_field_ao_h = r.h; }
}

fn mat_field_clear_all() {
    mat_field_albedo_w = 0; mat_field_normal_w = 0; mat_field_rough_w = 0;
    mat_field_metal_w = 0; mat_field_height_w = 0; mat_field_ao_w = 0;
}

fn mat_drop_highlight(r: Rect) {
    if (drag_asset_path.len() == 0) return;
    if (path_is_image(drag_asset_path) == 0 && path_is_image(drag_asset_rel) == 0) return;
    let hr: Rect = rect(r.x - 3, r.y - 3, r.w + 6, r.h + 6);
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    if (point_in_rect(mx, my, r)) th_fill(hr, TH_RADIUS + 3, col_accent_dim());
    th_ring(hr, TH_RADIUS + 3, 2, col_accent());
}

fn insp_mat_row(s: int, x: int, yy: int, w: int, label: string, edit_id: string, kind: string, buf: string): int {
    chrome_field_label(x, yy, label);
    let fr: Rect = rect(x, yy + 16, w - 90, 24);
    mat_field_store(kind, fr);
    mat_drop_highlight(fr);
    let next: string = ui_field(edit_id, fr, buf);
    if (next != buf) {
        undo_save_modify(s);
        if (kind == "albedo") { ent_set_tex_albedo(s, next); insp_buf_tex_albedo = ent_tex_albedo(s); }
        else if (kind == "normal") { ent_set_tex_normal(s, next); insp_buf_tex_normal = ent_tex_normal(s); }
        else if (kind == "rough") { ent_set_tex_rough(s, next); insp_buf_tex_rough = ent_tex_rough(s); }
        else if (kind == "metal") { ent_set_tex_metal(s, next); insp_buf_tex_metal = ent_tex_metal(s); }
        else if (kind == "height") { ent_set_tex_height(s, next); insp_buf_tex_height = ent_tex_height(s); }
        else if (kind == "ao") { ent_set_tex_ao(s, next); insp_buf_tex_ao = ent_tex_ao(s); }
    }
    if (ui_button(rect(x + w - 84, yy + 16, 84, 24), "Browse...") == 1) {
        let initial: string = "";
        if (proj_loaded() == 1) initial = proj_path_join(proj_root(), "assets");
        let chosen: string = eng_open_file_dialog("Choose " + label, "Images|*.png;*.jpg;*.jpeg;*.bmp;*.tga|All files|*.*", initial);
        if (chosen.len() > 0) {
            undo_save_modify(s);
            if (kind == "albedo") { ent_set_tex_albedo(s, chosen); insp_buf_tex_albedo = ent_tex_albedo(s); }
            else if (kind == "normal") { ent_set_tex_normal(s, chosen); insp_buf_tex_normal = ent_tex_normal(s); }
            else if (kind == "rough") { ent_set_tex_rough(s, chosen); insp_buf_tex_rough = ent_tex_rough(s); }
            else if (kind == "metal") { ent_set_tex_metal(s, chosen); insp_buf_tex_metal = ent_tex_metal(s); }
            else if (kind == "height") { ent_set_tex_height(s, chosen); insp_buf_tex_height = ent_tex_height(s); }
            else if (kind == "ao") { ent_set_tex_ao(s, chosen); insp_buf_tex_ao = ent_tex_ao(s); }
        }
    }
    yy = yy + 44;
    let cur: string = buf;
    if (kind == "albedo") cur = insp_buf_tex_albedo;
    else if (kind == "normal") cur = insp_buf_tex_normal;
    else if (kind == "rough") cur = insp_buf_tex_rough;
    else if (kind == "metal") cur = insp_buf_tex_metal;
    else if (kind == "height") cur = insp_buf_tex_height;
    else if (kind == "ao") cur = insp_buf_tex_ao;
    if (cur.len() > 0) {
        if (ui_button(rect(x, yy, 90, 22), "Clear") == 1) {
            undo_save_modify(s);
            if (kind == "albedo") { ent_set_tex_albedo(s, ""); insp_buf_tex_albedo = ""; }
            else if (kind == "normal") { ent_set_tex_normal(s, ""); insp_buf_tex_normal = ""; }
            else if (kind == "rough") { ent_set_tex_rough(s, ""); insp_buf_tex_rough = ""; }
            else if (kind == "metal") { ent_set_tex_metal(s, ""); insp_buf_tex_metal = ""; }
            else if (kind == "height") { ent_set_tex_height(s, ""); insp_buf_tex_height = ""; }
            else if (kind == "ao") { ent_set_tex_ao(s, ""); insp_buf_tex_ao = ""; }
        }
        yy = yy + 28;
    }
    return yy;
}

fn insp_materials(s: int, x: int, yy: int, w: int): int {
    th_font(11);
    draw_text(x, yy, "PBR maps for Filament / high-quality 3D. Empty uses the model file.", col_text_dim());
    th_font(14);
    yy = yy + 18;
    if (edit_target != "insp_tex_albedo" && insp_buf_tex_albedo != ent_tex_albedo(s)) insp_buf_tex_albedo = ent_tex_albedo(s);
    if (edit_target != "insp_tex_normal" && insp_buf_tex_normal != ent_tex_normal(s)) insp_buf_tex_normal = ent_tex_normal(s);
    if (edit_target != "insp_tex_rough" && insp_buf_tex_rough != ent_tex_rough(s)) insp_buf_tex_rough = ent_tex_rough(s);
    if (edit_target != "insp_tex_metal" && insp_buf_tex_metal != ent_tex_metal(s)) insp_buf_tex_metal = ent_tex_metal(s);
    if (edit_target != "insp_tex_height" && insp_buf_tex_height != ent_tex_height(s)) insp_buf_tex_height = ent_tex_height(s);
    if (edit_target != "insp_tex_ao" && insp_buf_tex_ao != ent_tex_ao(s)) insp_buf_tex_ao = ent_tex_ao(s);
    if (edit_target != "insp_mat_rough" && insp_buf_mat_rough != ("" + ent_mat_rough(s))) insp_buf_mat_rough = "" + ent_mat_rough(s);
    if (edit_target != "insp_mat_metal" && insp_buf_mat_metal != ("" + ent_mat_metal(s))) insp_buf_mat_metal = "" + ent_mat_metal(s);
    if (edit_target != "insp_mat_bump" && insp_buf_mat_bump != ("" + ent_mat_bump(s))) insp_buf_mat_bump = "" + ent_mat_bump(s);
    if (edit_target != "insp_mat_tile" && insp_buf_mat_tile != ("" + ent_mat_tile(s))) insp_buf_mat_tile = "" + ent_mat_tile(s);

    let half: int = (w - 8) / 2;
    chrome_field_label(x, yy, "Roughness (0-100)");
    chrome_field_label(x + half + 8, yy, "Metallic (0-100)");
    th_font(11);
    draw_text(x, yy + 14, "Used when that map slot is empty.", col_text_dim());
    th_font(14);
    let rb: string = ui_field("insp_mat_rough", rect(x, yy + 30, half, 22), insp_buf_mat_rough);
    let mb: string = ui_field("insp_mat_metal", rect(x + half + 8, yy + 30, half, 22), insp_buf_mat_metal);
    if (rb != insp_buf_mat_rough) {
        undo_save_modify(s);
        ent_set_mat_rough(s, parse_int_or(rb, ent_mat_rough(s)));
        insp_buf_mat_rough = "" + ent_mat_rough(s);
    }
    if (mb != insp_buf_mat_metal) {
        undo_save_modify(s);
        ent_set_mat_metal(s, parse_int_or(mb, ent_mat_metal(s)));
        insp_buf_mat_metal = "" + ent_mat_metal(s);
    }
    yy = yy + 60;
    chrome_field_label(x, yy, "Bump strength (0-200)");
    chrome_field_label(x + half + 8, yy, "Tiling (1-32)");
    let bb: string = ui_field("insp_mat_bump", rect(x, yy + 16, half, 22), insp_buf_mat_bump);
    let tb: string = ui_field("insp_mat_tile", rect(x + half + 8, yy + 16, half, 22), insp_buf_mat_tile);
    if (bb != insp_buf_mat_bump) {
        undo_save_modify(s);
        ent_set_mat_bump(s, parse_int_or(bb, ent_mat_bump(s)));
        insp_buf_mat_bump = "" + ent_mat_bump(s);
    }
    if (tb != insp_buf_mat_tile) {
        undo_save_modify(s);
        ent_set_mat_tile(s, parse_int_or(tb, ent_mat_tile(s)));
        insp_buf_mat_tile = "" + ent_mat_tile(s);
    }
    yy = yy + 46;

    yy = insp_mat_row(s, x, yy, w, "Albedo / Base Color", "insp_tex_albedo", "albedo", insp_buf_tex_albedo);
    yy = insp_mat_row(s, x, yy, w, "Normal Map", "insp_tex_normal", "normal", insp_buf_tex_normal);
    yy = insp_mat_row(s, x, yy, w, "Roughness Map", "insp_tex_rough", "rough", insp_buf_tex_rough);
    yy = insp_mat_row(s, x, yy, w, "Metallic Map", "insp_tex_metal", "metal", insp_buf_tex_metal);
    yy = insp_mat_row(s, x, yy, w, "Height / Displacement", "insp_tex_height", "height", insp_buf_tex_height);
    yy = insp_mat_row(s, x, yy, w, "Ambient Occlusion", "insp_tex_ao", "ao", insp_buf_tex_ao);
    return yy;
}

fn insp_albedo(s: int, x: int, yy: int, w: int): int {
    chrome_field_label(x, yy, "Color");
    yy = yy + 16;
    if (w < 8) return yy;

    let hue_w: int = 16;
    let gap: int = 8;
    let sv_w: int = w - hue_w - gap;
    if (sv_w < 8) sv_w = 8;
    let sv_h: int = 132;
    let svx: int = x;
    let svy: int = yy;
    let hx: int = x + sv_w + gap;
    let hy: int = yy;
    let show_a: int = 1;
    if (ent_is_light(s) == 1) show_a = 0;
    let ay: int = svy + sv_h + gap + 16;
    let ah: int = 16;

    let rr: int = ent_r(s);
    let gg: int = ent_g(s);
    let bb: int = ent_b(s);
    let aa: int = ent_a(s);
    if (pick_slot != s) {
        pick_drag = 0;
        pick_undo = 0;
        pick_slot = s;
    }
    if (pick_drag == 0) {
        let sat: int = eng_rgb_sat(rr, gg, bb);
        if (sat > 0) pick_h = eng_rgb_hue(rr, gg, bb);
        pick_s = sat;
        pick_v = eng_rgb_val(rr, gg, bb);
    }

    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    if (pick_drag == 0 && mouse_pressed(MOUSE_LEFT)) {
        if (point_in_rect(mx, my, rect(svx, svy, sv_w, sv_h))) pick_drag = 1;
        else if (point_in_rect(mx, my, rect(hx, hy, hue_w, sv_h))) pick_drag = 2;
        else if (show_a == 1 && point_in_rect(mx, my, rect(x, ay, w, ah))) pick_drag = 3;
    }
    if (pick_drag == 1 && mouse_down(MOUSE_LEFT)) {
        let px: int = mx - svx;
        let py: int = my - svy;
        if (px < 0) px = 0;
        if (py < 0) py = 0;
        if (px > sv_w - 1) px = sv_w - 1;
        if (py > sv_h - 1) py = sv_h - 1;
        pick_s = px * 255 / (sv_w - 1);
        pick_v = 255 - py * 255 / (sv_h - 1);
        pick_write_rgb(s, eng_hsv_r(pick_h, pick_s, pick_v), eng_hsv_g(pick_h, pick_s, pick_v), eng_hsv_b(pick_h, pick_s, pick_v));
    } else if (pick_drag == 2 && mouse_down(MOUSE_LEFT)) {
        let py: int = my - hy;
        if (py < 0) py = 0;
        if (py > sv_h - 1) py = sv_h - 1;
        pick_h = py * 359 / (sv_h - 1);
        pick_write_rgb(s, eng_hsv_r(pick_h, pick_s, pick_v), eng_hsv_g(pick_h, pick_s, pick_v), eng_hsv_b(pick_h, pick_s, pick_v));
    } else if (pick_drag == 3 && show_a == 1 && mouse_down(MOUSE_LEFT)) {
        let px: int = mx - x;
        if (px < 0) px = 0;
        if (px > w - 1) px = w - 1;
        pick_write_a(s, px * 255 / (w - 1));
    }

    rr = ent_r(s);
    gg = ent_g(s);
    bb = ent_b(s);
    aa = ent_a(s);

    eng_picker_sv(svx, svy, sv_w, sv_h, pick_h);
    eng_picker_hue(hx, hy, hue_w, sv_h);
    eng_outline_rect(svx - 1, svy - 1, sv_w + 2, sv_h + 2, 1, 70, 74, 82);
    eng_outline_rect(hx - 1, hy - 1, hue_w + 2, sv_h + 2, 1, 70, 74, 82);

    let cx: int = svx + pick_s * (sv_w - 1) / 255;
    let cy: int = svy + (255 - pick_v) * (sv_h - 1) / 255;
    eng_outline_rect(cx - 6, cy - 6, 13, 13, 2, 0, 0, 0);
    eng_outline_rect(cx - 4, cy - 4, 9, 9, 1, 255, 255, 255);
    let mark: int = hy + pick_h * (sv_h - 1) / 359;
    eng_fill_rect(hx - 2, mark - 1, hue_w + 4, 3, 255, 255, 255);
    eng_outline_rect(hx - 3, mark - 2, hue_w + 6, 5, 1, 0, 0, 0);

    yy = svy + sv_h + gap;
    if (show_a == 1) {
        chrome_field_label(x, yy, "Opacity");
        yy = yy + 16;
        eng_picker_alpha(x, yy, w, ah, rr, gg, bb);
        eng_outline_rect(x - 1, yy - 1, w + 2, ah + 2, 1, 70, 74, 82);
        let ax: int = x + aa * (w - 1) / 255;
        eng_fill_rect(ax - 1, yy - 2, 3, ah + 4, 255, 255, 255);
        eng_outline_rect(ax - 2, yy - 3, 5, ah + 6, 1, 0, 0, 0);
        yy = yy + ah + gap;
    }

    pick_checker(x, yy, 24, 24);
    eng_fill_rect_a(x, yy, 24, 24, rr, gg, bb, aa);
    eng_outline_rect(x - 1, yy - 1, 26, 26, 1, 70, 74, 82);
    let hex: string = col_to_hex(rgb(rr, gg, bb));
    let got: string = ui_field("insp_hex", rect(x + 32, yy, w - 32, 24), hex);
    let body: int = got.len();
    if (body > 0 && got.substring(0, 1) == "#") body = body - 1;
    if (body >= 6) {
        let c: Color = col_from_hex(got);
        if (c.r != rr || c.g != gg || c.b != bb) {
            undo_save_modify(s);
            ent_set_color(s, c.r, c.g, c.b);
            rr = c.r;
            gg = c.g;
            bb = c.b;
        }
    }
    yy = yy + 32;

    let col_w: int = (w - 12) / 4;
    if (show_a == 0) col_w = (w - 8) / 3;
    chrome_field_label(x, yy, "R");
    chrome_field_label(x + col_w + 4, yy, "G");
    chrome_field_label(x + (col_w + 4) * 2, yy, "B");
    if (show_a == 1) chrome_field_label(x + (col_w + 4) * 3, yy, "A");
    let nr: int = pick_commit_chan(s, "insp_cr", rect(x, yy + 16, col_w, 24), rr);
    let ng: int = pick_commit_chan(s, "insp_cg", rect(x + col_w + 4, yy + 16, col_w, 24), gg);
    let nb: int = pick_commit_chan(s, "insp_cb", rect(x + (col_w + 4) * 2, yy + 16, col_w, 24), bb);
    let na: int = aa;
    if (show_a == 1) na = pick_commit_chan(s, "insp_ca", rect(x + (col_w + 4) * 3, yy + 16, col_w, 24), aa);
    if (nr != rr || ng != gg || nb != bb) ent_set_color(s, nr, ng, nb);
    if (na != aa) ent_set_alpha(s, na);
    return yy + 48;
}

fn inspector_draw_one(s: int) {
    refresh_inspector_buffers(s);
    gravity_buf_ready = 0;   /* so the no-selection scene panel reloads next time */
    env_buf_ready = 0;

    let r: Rect = right_rect();
    let x: int = r.x + 12;
    let w: int = r.w - 24;
    let half: int = (w - 8) / 2;
    chrome_header_bar(rect(r.x, r.y, r.w, 24), "Inspector");
    eng_set_clip(r.x, r.y + 24, r.w, r.h - 24);
    let top: int = r.y + 32 - insp_scroll;
    let yy: int = top;
    last_sprite_field_w = 0;
    last_script_field_w = 0;
    mat_field_clear_all();

    yy = insp_module(x, yy, w, "ent", "Entity");
    if (insp_mod_open == 1) {
    eng_set_font_size(11);
    draw_text(x, yy, "id " + ent_id(s) + "   slot " + s + "   " + ent_kind(s), col_text_dim());
    eng_set_font_size(14);
    yy = yy + 18;

    chrome_field_label(x, yy, "Name");
    let name_r: Rect = rect(x, yy + 16, w, 24);
    let nb: string = insp_buf_name;
    if (insp_name_field_done == 1 && edit_target == "insp_name") {
        /* hierarchy already owns the live field this frame — mirror it here */
        ui_field_draw(name_r, edit_buf, 1);
        nb = edit_buf;
    } else {
        nb = ui_field("insp_name", name_r, insp_buf_name);
    }
    if (nb != insp_buf_name) {
        undo_save_modify(s);
        ent_set_name(s, nb);
        insp_buf_name = nb;
    }
    if (edit_target == "insp_name") rename_ent_slot = s;
    else                            rename_ent_slot = -1;
    yy = yy + 48;

    let vis_label: string = "Visible";
    if (ent_visible(s) == 0) vis_label = "Hidden";
    if (ui_button(rect(x, yy, w, 24), vis_label) == 1) {
        undo_save_modify(s);
        if (ent_visible(s) == 1) ent_set_visible(s, 0);
        else                      ent_set_visible(s, 1);
    }
    yy = yy + 28;
    if (ent_visible(s) == 1 && ent_shown(s) == 0) {
        th_font(11);
        draw_text(x, yy, "Hidden because a parent is hidden.", col_text_dim());
        th_font(14);
        yy = yy + 16;
    }

    if (scene_render3d() == 1 && ent_is_mesh3d(s) == 1) {
        yy = yy + 8;
        chrome_field_label(x, yy, "Smooth edges");
        yy = yy + 18;
        let mode: int = ent_aa(s);
        let bw: int = (w - 16) / 3;
        let k_proj: string = "secondary";
        let k_off: string = "secondary";
        let k_on: string = "secondary";
        if (mode < 0) k_proj = "primary";
        else if (mode == 0) k_off = "primary";
        else k_on = "primary";
        if (ui_button_kind(rect(x, yy, bw, 24), "Project", k_proj) == 1 && mode >= 0) {
            undo_save_modify(s);
            ent_set_aa(s, -1);
        }
        if (ui_button_kind(rect(x + bw + 8, yy, bw, 24), "Off", k_off) == 1 && mode != 0) {
            undo_save_modify(s);
            ent_set_aa(s, 0);
        }
        if (ui_button_kind(rect(x + (bw + 8) * 2, yy, bw, 24), "On", k_on) == 1 && mode != 1) {
            undo_save_modify(s);
            ent_set_aa(s, 1);
        }
        yy = yy + 36;
    }

    yy = yy + 8;
    }

    yy = insp_module(x, yy, w, "xf", "Transform");
    if (insp_mod_open == 1) {
    chrome_field_label(x, yy, "X");
    chrome_field_label(x + half + 8, yy, "Y");
    let xb: string = ui_field("insp_x", rect(x, yy + 16, half, 24), insp_buf_x);
    let yb: string = ui_field("insp_y", rect(x + half + 8, yy + 16, half, 24), insp_buf_y);
    if (xb != insp_buf_x) {
        if (ent_child_count(s) > 0) undo_save_modify_tree(s);
        else undo_save_modify(s);
        ent_set_x(s, parse_int_or(xb, ent_x(s)));
        insp_buf_x = xb;
    }
    if (yb != insp_buf_y) {
        if (ent_child_count(s) > 0) undo_save_modify_tree(s);
        else undo_save_modify(s);
        ent_set_y(s, parse_int_or(yb, ent_y(s)));
        insp_buf_y = yb;
    }
    yy = yy + 48;

    chrome_field_label(x, yy, "W");
    chrome_field_label(x + half + 8, yy, "H");
    let wb: string = ui_field("insp_w", rect(x, yy + 16, half, 24), insp_buf_w);
    let hb: string = ui_field("insp_h", rect(x + half + 8, yy + 16, half, 24), insp_buf_h);
    if (wb != insp_buf_w) { undo_save_modify(s); ent_set_w(s, parse_int_or(wb, ent_w(s))); insp_buf_w = wb; }
    if (hb != insp_buf_h) { undo_save_modify(s); ent_set_h(s, parse_int_or(hb, ent_h(s))); insp_buf_h = hb; }
    yy = yy + 48;

    if (scene_render3d() == 0 && ent_is_3d_kind(s) == 0) {
        chrome_field_label(x, yy, "Depth");
        if (edit_target != "insp_z" && insp_buf_z != "" + ent_z(s)) insp_buf_z = "" + ent_z(s);
        let zb: string = ui_field("insp_z", rect(x, yy + 16, half, 24), insp_buf_z);
        if (zb != insp_buf_z) {
            if (ent_child_count(s) > 0) undo_save_modify_tree(s);
            else undo_save_modify(s);
            ent_set_z(s, parse_int_or(zb, ent_z(s)));
            insp_buf_z = zb;
        }
        yy = yy + 48;
        th_font(11);
        draw_text(x, yy - 8, "Higher draws in front.", col_text_dim());
        th_font(14);
        yy = yy + 10;
    }

    if (scene_render3d() == 1 || ent_is_3d_kind(s) == 1) {
        let third: int = (w - 16) / 3;
        chrome_field_label(x, yy, "Rotation");
        chrome_field_label(x + third + 8, yy, "Pitch");
        chrome_field_label(x + (third + 8) * 2, yy, "Yaw");
        let rb: string = ui_field("insp_rot", rect(x, yy + 16, third, 24), insp_buf_rot);
        let pxb: string = ui_field("insp_rotx", rect(x + third + 8, yy + 16, third, 24), insp_buf_rotx);
        let pyb: string = ui_field("insp_roty", rect(x + (third + 8) * 2, yy + 16, third, 24), insp_buf_roty);
        if (rb != insp_buf_rot) { undo_save_modify(s); ent_set_rot(s, parse_int_or(rb, ent_rot(s))); insp_buf_rot = rb; }
        if (pxb != insp_buf_rotx) { undo_save_modify(s); ent_set_rot_x(s, parse_int_or(pxb, ent_rot_x(s))); insp_buf_rotx = pxb; }
        if (pyb != insp_buf_roty) { undo_save_modify(s); ent_set_rot_y(s, parse_int_or(pyb, ent_rot_y(s))); insp_buf_roty = pyb; }
    } else {
        chrome_field_label(x, yy, "Rotation (deg)");
        let rb2: string = ui_field("insp_rot", rect(x, yy + 16, half, 24), insp_buf_rot);
        if (rb2 != insp_buf_rot) { undo_save_modify(s); ent_set_rot(s, parse_int_or(rb2, ent_rot(s))); insp_buf_rot = rb2; }
    }
    yy = yy + 48;

    yy = yy + 8;
    }

    /* 3D: shown for 3D scenes and 3D shapes (see engine/shape3d.nxa) */
    if (scene_render3d() == 1 || ent_is_3d_kind(s) == 1) {
        yy = insp_module(x, yy, w, "d3", "3D");
        if (insp_mod_open == 1) {
        chrome_field_label(x, yy, "Z (into screen)");
        chrome_field_label(x + half + 8, yy, "Depth (0 = auto)");
        let zb: string = ui_field("insp_z", rect(x, yy + 16, half, 24), insp_buf_z);
        let db3: string = ui_field("insp_depth", rect(x + half + 8, yy + 16, half, 24), insp_buf_depth);
        if (zb != insp_buf_z) {
            if (ent_child_count(s) > 0) undo_save_modify_tree(s);
            else undo_save_modify(s);
            ent_set_z(s, parse_int_or(zb, ent_z(s)));
            insp_buf_z = zb;
        }
        if (db3 != insp_buf_depth) { undo_save_modify(s); ent_set_depth(s, parse_int_or(db3, ent_depth(s))); insp_buf_depth = db3; }
        yy = yy + 48;
        if (ent_is_camera_ent(s) == 1) {
            th_font(11);
            draw_text(x, yy - 4, "Red ring tilts. Green ring turns. Z is the focus depth.", col_text_dim());
            th_font(14);
            yy = yy + 18;
        }
        if (ent_kind(s) == "model") {
            if (edit_target != "insp_model" && insp_buf_model != ent_model(s)) insp_buf_model = ent_model(s);
            chrome_field_label(x, yy, "Model (.obj)");
            let mb: string = ui_field("insp_model", rect(x, yy + 16, w - 90, 24), insp_buf_model);
            if (mb != insp_buf_model) { undo_save_modify(s); ent_set_model(s, mb); insp_buf_model = mb; }
            if (ui_button(rect(x + w - 84, yy + 16, 84, 24), "Browse...") == 1) {
                let initial: string = "";
                if (proj_loaded() == 1) initial = proj_path_join(proj_root(), "assets");
                let chosen: string = eng_open_file_dialog("Choose a model", "Wavefront OBJ (*.obj)|*.obj|All files|*.*", initial);
                if (chosen.len() > 0) {
                    undo_save_modify(s);
                    ent_set_model(s, chosen);
                    insp_buf_model = ent_model(s);
                }
            }
            yy = yy + 50;
        }
        yy = yy + 8;
        }
    }

    if (ent_is_light(s) == 1) {
        let lk: string = ent_kind(s);
        yy = insp_module(x, yy, w, "light", "Light");
        if (insp_mod_open == 1) {
        chrome_field_label(x, yy, "Intensity (%)");
        let lib: string = ui_field("insp_l_int", rect(x, yy + 16, half, 24), insp_buf_l_int);
        if (lib != insp_buf_l_int) { undo_save_modify(s); ent_set_light_intensity(s, parse_int_or(lib, ent_light_intensity(s))); insp_buf_l_int = lib; }
        if (lk == "light_point" || lk == "light_spot") {
            chrome_field_label(x + half + 8, yy, "Range (px)");
            let lrb: string = ui_field("insp_l_range", rect(x + half + 8, yy + 16, half, 24), insp_buf_l_range);
            if (lrb != insp_buf_l_range) { undo_save_modify(s); ent_set_light_range(s, parse_int_or(lrb, ent_light_range(s))); insp_buf_l_range = lrb; }
        }
        yy = yy + 48;
        if (lk == "light_directional" || lk == "light_spot") {
            chrome_field_label(x, yy, "Tilt into screen (deg)");
            let ltb: string = ui_field("insp_l_tilt", rect(x, yy + 16, half, 24), insp_buf_l_tilt);
            if (ltb != insp_buf_l_tilt) { undo_save_modify(s); ent_set_light_tilt(s, parse_int_or(ltb, ent_light_tilt(s))); insp_buf_l_tilt = ltb; }
            if (lk == "light_spot") {
                chrome_field_label(x + half + 8, yy, "Cone angle (deg)");
                let lab: string = ui_field("insp_l_angle", rect(x + half + 8, yy + 16, half, 24), insp_buf_l_angle);
                if (lab != insp_buf_l_angle) { undo_save_modify(s); ent_set_light_angle(s, parse_int_or(lab, ent_light_angle(s))); insp_buf_l_angle = lab; }
            }
            yy = yy + 48;
            th_font(11);
            draw_text(x, yy - 4, "Shines down. Rotation turns it, Tilt aims inward.", col_text_dim());
            th_font(14);
            yy = yy + 18;
        }
        th_font(11);
        draw_text(x, yy - 4, "Color (below) is the light's color.", col_text_dim());
        th_font(14);
        yy = yy + 18;
        yy = yy + 8;
        }
    }

    yy = insp_module(x, yy, w, "cam", "Camera");
    if (insp_mod_open == 1) {
    if (ent_camera(s) == 1) {
        th_chip(rect(x, yy + 2, 110, 20), "MAIN CAMERA", col_accent());
        th_font(11);
        draw_text(x + 118, th_text_y(yy, 24), "play / export view", col_text_dim());
        th_font(14);
        if (ui_button(rect(x + w - 64, yy, 64, 24), "Clear") == 1) {
            undo_save_modify(s);
            ent_set_camera(s, 0);
        }
    } else {
        if (ui_button(rect(x, yy, w, 24), "Set as Main Camera") == 1) {
            undo_save_modify(s);
            ent_set_camera(s, 1);
        }
    }
    yy = yy + 36;
    yy = yy + 8;
    }

    yy = insp_module(x, yy, w, "look", "Appearance");
    if (insp_mod_open == 1) {
    if (ent_kind(s) == "label" || (ent_is_ui(s) == 1 && ent_kind(s) != "sprite2d")) {
        chrome_field_label(x, yy, "Text size");
        if (edit_target != "insp_font") insp_buf_font = "" + ent_font_px(s);
        let tsz: string = ui_field("insp_font", rect(x, yy + 16, (w - 8) / 2, 24), insp_buf_font);
        if (tsz != insp_buf_font) {
            undo_save_modify(s);
            let sz: int = parse_int_or(tsz, ent_font_px(s));
            if (sz < 6) sz = 6;
            if (sz > 512) sz = 512;
            ent_set_font_px(s, sz);
            insp_buf_font = "" + ent_font_px(s);
        }
        yy = yy + 48;
    }
    yy = insp_albedo(s, x, yy, w);
    if (ent_is_ui(s) == 1 && ent_kind(s) != "sprite2d") yy = insp_ui_style(s, x, yy, w);

    chrome_field_label(x, yy, "Label / text");
    let tb: string = ui_field("insp_text", rect(x, yy + 16, w, 24), insp_buf_text);
    if (tb != insp_buf_text) {
        undo_save_modify(s);
        ent_set_text(s, tb);
        insp_buf_text = tb;
    }
    yy = yy + 48;

    chrome_field_label(x, yy, "Sprite");
    let sprite_field: Rect = rect(x, yy + 16, w - 90, 24);
    last_sprite_field_x = sprite_field.x;
    last_sprite_field_y = sprite_field.y;
    last_sprite_field_w = sprite_field.w;
    last_sprite_field_h = sprite_field.h;
    if (drag_asset_path.len() > 0) {
        let hr: Rect = rect(sprite_field.x - 3, sprite_field.y - 3,
                            sprite_field.w + 6, sprite_field.h + 6);
        let mx: int = eng_mouse_x();
        let my: int = eng_mouse_y();
        let hovering: bool = point_in_rect(mx, my, sprite_field);
        if (hovering) th_fill(hr, TH_RADIUS + 3, col_accent_dim());
        th_ring(hr, TH_RADIUS + 3, 2, col_accent());
    }
    let spb: string = ui_field("insp_sprite", sprite_field, insp_buf_sprite);
    if (spb != insp_buf_sprite) {
        undo_save_modify(s);
        ent_set_sprite(s, spb);
        insp_buf_sprite = spb;
    }
    if (ui_button(rect(x + w - 84, yy + 16, 84, 24), "Browse...") == 1) {
        let filter: string = "Images|*.png;*.jpg;*.jpeg;*.bmp;*.gif|All files|*.*";
        let initial: string = "";
        if (proj_loaded() == 1) initial = proj_path_join(proj_root(), "assets");
        let chosen: string = eng_open_file_dialog("Choose sprite", filter, initial);
        if (chosen.len() > 0) {
            undo_save_modify(s);
            ent_set_sprite(s, chosen);
            insp_buf_sprite = chosen;
        }
    }
    yy = yy + 50;

    draw_text(x, yy + 6, "Scale", col_text_main());
    let pix: int = ent_pixel(s);
    let pk0: string = "secondary";
    let pk1: string = "secondary";
    if (pix == 1) pk1 = "primary";
    else pk0 = "primary";
    if (ui_button_kind(rect(x + 160, yy, 70, 28), "Smooth", pk0) == 1 && pix == 1) {
        undo_save_modify(s);
        ent_set_pixel(s, 0);
    }
    if (ui_button_kind(rect(x + 238, yy, 70, 28), "Pixel", pk1) == 1 && pix == 0) {
        undo_save_modify(s);
        ent_set_pixel(s, 1);
    }
    yy = yy + 32;
    th_font(11);
    draw_text(x, yy, "Pixel keeps hard edges when this picture is scaled up.", col_text_dim());
    th_font(14);
    yy = yy + 20;

    /* preview thumbnail of the assigned sprite */
    if (insp_buf_sprite.len() > 0) {
        let prev: Rect = rect(x, yy, 96, 96);
        th_fill(prev, TH_RADIUS, col_field());
        th_edge(prev, TH_RADIUS, col_ui_border());
        let pid: int = eng_image_load_cached(insp_buf_sprite);
        if (pid != 0) {
            let iw: int = eng_image_w(pid);
            let ih: int = eng_image_h(pid);
            if (iw > 0 && ih > 0) {
                let scale_x: float = (prev.w - 8.0) / iw;
                let scale_y: float = (prev.h - 8.0) / ih;
                let sc: float = scale_x;
                if (scale_y < sc) sc = scale_y;
                if (sc > 1.0) sc = 1.0;
                let dw: int = iw * sc;
                let dh: int = ih * sc;
                if (dw < 1) dw = 1;
                if (dh < 1) dh = 1;
                let dxp: int = prev.x + (prev.w - dw) / 2;
                let dyp: int = prev.y + (prev.h - dh) / 2;
                eng_image_blit_scaled(pid, dxp, dyp, dw, dh);
            }
        }
        if (ui_button(rect(x + 110, yy + 18, 110, 24), "Clear sprite") == 1) {
            undo_save_modify(s);
            ent_set_sprite(s, "");
            insp_buf_sprite = "";
        }
        yy = yy + 110;
    }
    yy = yy + 8;
    }

    if (ui_ent_is_button(s) == 1) {
        yy = insp_module(x, yy, w, "btn", "Button");
        if (insp_mod_open == 1) {
            yy = insp_button_colors(s, x, yy, w);
            yy = yy + 8;
        }
    } else {
        let show_ctrl: int = 0;
        if (ui_ent_is_check(s) == 1) show_ctrl = 1;
        if (ui_ent_is_toggle(s) == 1) show_ctrl = 1;
        if (ui_ent_is_slider(s) == 1) show_ctrl = 1;
        if (ui_ent_is_bar(s) == 1) show_ctrl = 1;
        if (ui_ent_is_field(s) == 1) show_ctrl = 1;
        if (show_ctrl == 1) {
            yy = insp_module(x, yy, w, "ctrl", "Control");
            if (insp_mod_open == 1) {
                yy = insp_ui_widget(s, x, yy, w);
                yy = yy + 8;
            }
        }
    }
    if (ent_is_3d_kind(s) == 1) {
        yy = insp_module(x, yy, w, "mat", "Materials");
        if (insp_mod_open == 1) {
            yy = insp_materials(s, x, yy, w);
            yy = yy + 8;
        }
    }

    yy = insp_module(x, yy, w, "snd", "Sound");
    if (insp_mod_open == 1) {
    if (edit_target != "insp_sound" && insp_buf_sound != ent_sound(s)) insp_buf_sound = ent_sound(s);
    chrome_field_label(x, yy, "Sound");
    let sndb: string = ui_field("insp_sound", rect(x, yy + 16, w - 90, 24), insp_buf_sound);
    if (sndb != insp_buf_sound) {
        undo_save_modify(s);
        ent_set_sound(s, sndb);
        insp_buf_sound = ent_sound(s);
    }
    if (ui_button(rect(x + w - 84, yy + 16, 84, 24), "Browse...") == 1) {
        let initial: string = "";
        if (proj_loaded() == 1) initial = proj_path_join(proj_root(), "assets");
        let chosen: string = eng_open_file_dialog("Choose a sound", "Sound|*.wav;*.mp3|All files|*.*", initial);
        if (chosen.len() > 0) {
            undo_save_modify(s);
            ent_set_sound(s, chosen);
            insp_buf_sound = ent_sound(s);
        }
    }
    yy = yy + 48;
    draw_text(x, yy + 6, "Loop", col_text_main());
    let loop_on: int = ent_sound_loop(s);
    let lk0: string = "secondary";
    let lk1: string = "secondary";
    if (loop_on == 1) lk1 = "primary";
    else lk0 = "primary";
    if (ui_button_kind(rect(x + 160, yy, 70, 28), "Off", lk0) == 1 && loop_on == 1) {
        undo_save_modify(s);
        ent_set_sound_loop(s, 0);
    }
    if (ui_button_kind(rect(x + 238, yy, 70, 28), "On", lk1) == 1 && loop_on == 0) {
        undo_save_modify(s);
        ent_set_sound_loop(s, 1);
    }
    yy = yy + 40;
    chrome_field_label(x, yy, "Range (px)");
    if (edit_target != "insp_srange" && insp_buf_sound_range != "" + ent_sound_range(s)) insp_buf_sound_range = "" + ent_sound_range(s);
    let srb: string = ui_field("insp_srange", rect(x, yy + 16, 120, 24), insp_buf_sound_range);
    if (srb != insp_buf_sound_range) {
        undo_save_modify(s);
        ent_set_sound_range(s, parse_int_or(srb, ent_sound_range(s)));
        insp_buf_sound_range = srb;
    }
    yy = yy + 48;
    th_font(11);
    draw_text(x, yy - 4, "Follows this object. Quieter with distance, and it shifts left or right.", col_text_dim());
    th_font(14);
    yy = yy + 18;
    yy = yy + 8;
    }

    if (ent_kind(s) == "emitter") {
        yy = insp_module(x, yy, w, "part", "Particles");
        if (insp_mod_open == 1) {
        th_font(11);
        draw_text(x, yy, "The picture is the Sprite, tinted by the color above.", col_text_dim());
        th_font(14);
        yy = yy + 18;
        chrome_field_label(x, yy, "Rate");
        if (edit_target != "insp_emrate" && insp_buf_emrate != "" + ent_emit_rate(s)) insp_buf_emrate = "" + ent_emit_rate(s);
        let erb: string = ui_field("insp_emrate", rect(x, yy + 16, 120, 24), insp_buf_emrate);
        if (erb != insp_buf_emrate) {
            undo_save_modify(s);
            ent_set_emit_rate(s, parse_int_or(erb, ent_emit_rate(s)));
            insp_buf_emrate = erb;
        }
        yy = yy + 48;
        chrome_field_label(x, yy, "Life (ms)");
        if (edit_target != "insp_emlife" && insp_buf_emlife != "" + ent_emit_life(s)) insp_buf_emlife = "" + ent_emit_life(s);
        let elb: string = ui_field("insp_emlife", rect(x, yy + 16, 120, 24), insp_buf_emlife);
        if (elb != insp_buf_emlife) {
            undo_save_modify(s);
            ent_set_emit_life(s, parse_int_or(elb, ent_emit_life(s)));
            insp_buf_emlife = elb;
        }
        yy = yy + 48;
        chrome_field_label(x, yy, "Speed");
        if (edit_target != "insp_emspeed" && insp_buf_emspeed != "" + ent_emit_speed(s)) insp_buf_emspeed = "" + ent_emit_speed(s);
        let esb: string = ui_field("insp_emspeed", rect(x, yy + 16, 120, 24), insp_buf_emspeed);
        if (esb != insp_buf_emspeed) {
            undo_save_modify(s);
            ent_set_emit_speed(s, parse_int_or(esb, ent_emit_speed(s)));
            insp_buf_emspeed = esb;
        }
        yy = yy + 48;
        chrome_field_label(x, yy, "Spread");
        if (edit_target != "insp_emspread" && insp_buf_emspread != "" + ent_emit_spread(s)) insp_buf_emspread = "" + ent_emit_spread(s);
        let epb: string = ui_field("insp_emspread", rect(x, yy + 16, 120, 24), insp_buf_emspread);
        if (epb != insp_buf_emspread) {
            undo_save_modify(s);
            ent_set_emit_spread(s, parse_int_or(epb, ent_emit_spread(s)));
            insp_buf_emspread = epb;
        }
        yy = yy + 48;
        chrome_field_label(x, yy, "Size");
        if (edit_target != "insp_emsize" && insp_buf_emsize != "" + ent_emit_size(s)) insp_buf_emsize = "" + ent_emit_size(s);
        let ezb: string = ui_field("insp_emsize", rect(x, yy + 16, 120, 24), insp_buf_emsize);
        if (ezb != insp_buf_emsize) {
            undo_save_modify(s);
            ent_set_emit_size(s, parse_int_or(ezb, ent_emit_size(s)));
            insp_buf_emsize = ezb;
        }
        yy = yy + 48;
        if (scene_render3d() == 1) {
            draw_text(x, yy + 6, "High definition", col_text_main());
            let hd_on: int = ent_emit_hd(s);
            let hk0: string = "secondary";
            let hk1: string = "secondary";
            if (hd_on == 1) hk1 = "primary";
            else hk0 = "primary";
            if (ui_button_kind(rect(x + 160, yy, 70, 28), "Off", hk0) == 1 && hd_on == 1) {
                undo_save_modify(s);
                ent_set_emit_hd(s, 0);
            }
            if (ui_button_kind(rect(x + 238, yy, 70, 28), "On", hk1) == 1 && hd_on == 0) {
                undo_save_modify(s);
                ent_set_emit_hd(s, 1);
            }
            yy = yy + 36;
            th_font(11);
            draw_text(x, yy, "Many more particles, drawn softer. Costs more.", col_text_dim());
            th_font(14);
            yy = yy + 18;
        }
        th_font(11);
        draw_text(x, yy, "A script can also call emit_burst.", col_text_dim());
        th_font(14);
        yy = yy + 18;
        yy = yy + 8;
        }
    }

    yy = insp_module(x, yy, w, "scr", "Script");
    if (insp_mod_open == 1) {
    if (edit_target != "insp_script" && insp_buf_script != ent_script(s)) insp_buf_script = ent_script(s);
    chrome_field_label(x, yy, "Script (.nxa)");
    let field_w: int = w;
    if (ent_script(s).len() > 0) field_w = w - 84;
    let script_field: Rect = rect(x, yy + 16, field_w, 24);
    last_script_field_x = script_field.x;
    last_script_field_y = script_field.y;
    last_script_field_w = script_field.w;
    last_script_field_h = script_field.h;
    /* highlight when a script is being dragged so the drop target is obvious */
    if (drag_is_active()) {
        let hr: Rect = rect(script_field.x - 3, script_field.y - 3,
                            script_field.w + 6, script_field.h + 6);
        let mx: int = eng_mouse_x();
        let my: int = eng_mouse_y();
        let hovering: bool = point_in_rect(mx, my, script_field);
        if (hovering) th_fill(hr, TH_RADIUS + 3, col_accent_dim());
        th_ring(hr, TH_RADIUS + 3, 2, col_accent());
    }
    let sb: string = ui_field("insp_script", script_field, insp_buf_script);
    if (sb != insp_buf_script) {
        undo_save_modify(s);
        ent_set_script(s, sb);
        insp_buf_script = sb;
    }
    if (ent_script(s).len() > 0) {
        if (ui_button(rect(x + w - 76, yy + 16, 76, 24), "Remove") == 1) {
            undo_save_modify(s);
            ent_set_script(s, "");
            insp_buf_script = "";
            if (edit_target == "insp_script") edit_target = "";
        }
    }
    yy = yy + 50;
    yy = inspector_draw_public(s, x, yy, w);
    yy = yy + 8;
    }

    yy = insp_module(x, yy, w, "body", "Physics");
    if (insp_mod_open == 1) {
    if (ent_kind(s) == "model") {
        let hb: int = ent_hitbox(s);
        if (hb == 0) {
            if (ui_button(rect(x, yy, w, 26), "Mesh hitbox") == 1) {
                undo_save_modify(s);
                ent_set_body(s, 1);
                ent_set_hitbox(s, 3);
                refresh_physics_buffers(s);
            }
            yy = yy + 28;
            draw_text(x, yy, "The collider is the rectangle.", col_text_dim());
            yy = yy + 22;
        } else {
            if (ui_button(rect(x, yy, 88, 26), "Box") == 1) {
                undo_save_modify(s);
                ent_set_hitbox(s, 0);
            }
            draw_text(x + 96, yy + 4, "Mesh cover", col_text_main());
            yy = yy + 32;
            chrome_field_label(x, yy, "Accuracy");
            yy = yy + 16;
            let bw: int = (w - 16) / 5;
            let lv: int = 1;
            while (lv <= 5) {
                let kind: string = "secondary";
                if (lv == hb) kind = "primary";
                if (ui_button_kind(rect(x + (lv - 1) * (bw + 4), yy, bw, 26), "" + lv, kind) == 1 && lv != hb) {
                    undo_save_modify(s);
                    ent_set_hitbox(s, lv);
                }
                lv = lv + 1;
            }
            yy = yy + 30;
            draw_text(x, yy, "Floors and walls are solid. The open space inside stays empty.", col_text_dim());
            yy = yy + 18;
            if (ent_hitbox_count(s) == 0) {
                draw_text(x, yy, "No mesh loaded, so it stays a box.", col_text_dim());
            } else {
                draw_text(x, yy, "" + ent_hitbox_count(s) + " pieces", col_text_dim());
            }
            yy = yy + 22;
        }
    }
    if (ent_has_body(s) == 0) {
        if (ui_button(rect(x, yy, w, 26), "Add Rigidbody") == 1) {
            undo_save_modify(s);
            ent_set_body(s, 1);
            refresh_physics_buffers(s);
        }
        yy = yy + 36;
    } else {
        if (ui_button(rect(x + w - 110, yy, 110, 22), "Remove") == 1) {
            undo_save_modify(s);
            ent_set_body(s, 0);
        }
        yy = yy + 28;

        chrome_field_label(x, yy, "Type");
        let bt: int = ent_body_type(s);
        if (ui_button(rect(x + 50, yy - 2, w - 50, 22), body_type_label(bt)) == 1) {
            undo_save_modify(s);
            let nt: int = bt + 1;
            if (nt > 2) nt = 0;
            ent_set_body_type(s, nt);
        }
        yy = yy + 30;

        chrome_field_label(x, yy, "Density");
        chrome_field_label(x + half + 8, yy, "Friction");
        let db: string = ui_field("insp_density", rect(x, yy + 16, half, 22), insp_buf_density);
        let frb: string = ui_field("insp_friction", rect(x + half + 8, yy + 16, half, 22), insp_buf_friction);
        if (db != insp_buf_density) {
            undo_save_modify(s);
            ent_set_density(s, parse_float_or(db, ent_density(s)));
            insp_buf_density = db;
        }
        if (frb != insp_buf_friction) {
            undo_save_modify(s);
            ent_set_friction(s, parse_float_or(frb, ent_friction(s)));
            insp_buf_friction = frb;
        }
        yy = yy + 46;

        chrome_field_label(x, yy, "Bounce");
        chrome_field_label(x + half + 8, yy, "Grav scale");
        let reb: string = ui_field("insp_restitution", rect(x, yy + 16, half, 22), insp_buf_restitution);
        let gsb: string = ui_field("insp_gravscale", rect(x + half + 8, yy + 16, half, 22), insp_buf_gravscale);
        if (reb != insp_buf_restitution) {
            undo_save_modify(s);
            ent_set_restitution(s, parse_float_or(reb, ent_restitution(s)));
            insp_buf_restitution = reb;
        }
        if (gsb != insp_buf_gravscale) {
            undo_save_modify(s);
            ent_set_gravity_scale(s, parse_float_or(gsb, ent_gravity_scale(s)));
            insp_buf_gravscale = gsb;
        }
        yy = yy + 46;

        let fr_label: string = "Fixed Rotation: Off";
        if (ent_fixed_rotation(s) == 1) fr_label = "Fixed Rotation: On";
        if (ui_button(rect(x, yy, w, 22), fr_label) == 1) {
            undo_save_modify(s);
            let cur: int = ent_fixed_rotation(s);
            if (cur == 1) ent_set_fixed_rotation(s, 0);
            else          ent_set_fixed_rotation(s, 1);
        }
        yy = yy + 32;
    }
    yy = yy + 8;
    }

    yy = insp_module(x, yy, w, "act", "Actions");
    if (insp_mod_open == 1) {
    if (ui_button(rect(x, yy, w, 26), "Save as Prefab") == 1) {
        let pname: string = ent_name(s);
        if (pname.len() == 0) pname = "prefab";
        let ok: int = proj_save_prefab(pname, s);
        if (ok == 1) eng_log("[prefab] saved " + pname + ".prefab");
        else         eng_log("[prefab] save failed");
    }
    yy = yy + 36;

    if (ui_button_danger(rect(x, yy, w, 30), "Delete") == 1) {
        undo_save_delete(s);
        ent_destroy(s);
    }
    yy = yy + 40;
    yy = yy + 8;
    }

    eng_clear_clip();

    /* scroll bookkeeping: total content height, clamp, wheel input */
    insp_content_h = yy - top;
    let max_scroll: int = insp_content_h - (r.h - 28);
    if (max_scroll < 0) max_scroll = 0;
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    if (point_in_rect(mx, my, r)) {
        let wheel: int = eng_mouse_wheel();
        if (wheel != 0) insp_scroll = insp_scroll - wheel * 28;
    }
    if (insp_scroll > max_scroll) insp_scroll = max_scroll;
    if (insp_scroll < 0) insp_scroll = 0;
}

fn refresh_physics_buffers(s: int) {
    insp_buf_density     = fmt2(ent_density(s));
    insp_buf_friction    = fmt2(ent_friction(s));
    insp_buf_restitution = fmt2(ent_restitution(s));
    insp_buf_gravscale   = fmt2(ent_gravity_scale(s));
}

fn inspector_draw() {
    let held: int = 0;
    if (mouse_down(MOUSE_LEFT)) held = 1;
    if (held == 0) {
        pick_drag = 0;
        pick_undo = 0;
    }
    let r: Rect = right_rect();
    chrome_panel(r);
    chrome_vsep(r.x, r.y, r.h);
    let s: int = sel_first();
    let n: int = sel_count();
    if (s < 0) {
        last_inspector_slot = -1;
        /* Only drop an inspector edit. Blueprint and other fields stay focused. */
        if (edit_target.len() >= 5 && edit_target.substring(0, 5) == "insp_") {
            edit_target = "";
            edit_buf = "";
        }
        inspector_draw_no_selection();
        return;
    }
    if (n > 1) {
        chrome_header_bar(rect(r.x, r.y, r.w, 24), "Inspector");
        eng_set_font_size(13);
        draw_text(r.x + 12, r.y + 44, n + " entities selected", col_text_main());
        eng_set_font_size(14);
        if (ui_button_danger(rect(r.x + 12, r.y + 76, r.w - 24, 28), "Delete all") == 1) {
            let s2: int = sel_first();
            while (s2 >= 0) {
                undo_save_delete(s2);
                ent_destroy(s2);
                s2 = sel_iter_next(0);
            }
        }
        return;
    }
    inspector_draw_one(s);
}

// =============================================================================
// Script editor (occupies the viewport rect when viewport_mode == "script")
// =============================================================================

let SCRIPT_LINE_H: int = 18;
let SCRIPT_GUTTER: int = 56;
let cursor_blink_ms: float = 0.0;

fn token_color(tok: string): Color {
    if (tok == "fn"     || tok == "let"    || tok == "if"   || tok == "else"
        || tok == "while" || tok == "for"  || tok == "return" || tok == "break"
        || tok == "continue" || tok == "struct" || tok == "enum" || tok == "match"
        || tok == "switch" || tok == "case" || tok == "default" || tok == "true"
        || tok == "false" || tok == "include") {
        return rgb(200, 130, 220);
    }
    if (tok == "int" || tok == "float" || tok == "string" || tok == "bool" || tok == "void"
        || tok == "Color" || tok == "Rect") {
        return rgb(108, 178, 255);
    }
    return rgb(220, 225, 235);
}

fn is_word_char(c: string): int {
    if (c >= "a" && c <= "z") return 1;
    if (c >= "A" && c <= "Z") return 1;
    if (c >= "0" && c <= "9") return 1;
    if (c == "_") return 1;
    return 0;
}

fn draw_script_line(x_start: int, y: int, line: string, max_w: int) {
    let n: int = line.len();
    if (n == 0) return;
    /* line comment? */
    let i: int = 0;
    /* trim leading whitespace for comment detection */
    let scan: int = 0;
    while (scan < n) {
        let ch: string = line.substring(scan, 1);
        if (ch != " " && ch != "\t") break;
        scan = scan + 1;
    }
    if (scan + 1 < n && line.substring(scan, 2) == "//") {
        eng_text(x_start, y, line, 110, 160, 110);
        return;
    }
    /* token-by-token */
    let xx: int = x_start;
    while (i < n) {
        let ch: string = line.substring(i, 1);
        if (is_word_char(ch) == 1) {
            let j: int = i;
            while (j < n && is_word_char(line.substring(j, 1)) == 1) j = j + 1;
            let tok: string = line.substring(i, j - i);
            let tc: Color = token_color(tok);
            eng_text(xx, y, tok, tc.r, tc.g, tc.b);
            xx = xx + eng_text_width(tok);
            i = j;
        } else if (ch == "\"") {
            let j: int = i + 1;
            while (j < n && line.substring(j, 1) != "\"") j = j + 1;
            if (j < n) j = j + 1;
            let tok: string = line.substring(i, j - i);
            eng_text(xx, y, tok, 230, 180, 110);
            xx = xx + eng_text_width(tok);
            i = j;
        } else {
            eng_text(xx, y, ch, 200, 210, 230);
            xx = xx + eng_text_width(ch);
            i = i + 1;
        }
        if (xx > x_start + max_w) return;
    }
}

fn script_editor_input() {
    if (bp_is_open() == 1) { bp_editor_input(); return; }
    let r: Rect = viewport_rect();
    let body_y: int = r.y + 36;
    let body_h: int = r.h - 36;
    let visible: int = body_h / SCRIPT_LINE_H;

    let cursor_before_line: int = te_cursor_line();
    let cursor_before_col: int  = te_cursor_col();

    if (edit_target.len() == 0) {
        let c: int = typed_pop();
        while (c != 0) {
            if (c == 8) te_backspace();
            else if (c == 13) te_newline();
            else if (c == 9) te_insert_text("    ");
            else if (c >= 32 && c < 127) te_insert_char(c);
            c = typed_pop();
        }
        if (key_pressed(VK_LEFT))  te_move_cursor(0, -1);
        if (key_pressed(VK_RIGHT)) te_move_cursor(0, 1);
        if (key_pressed(VK_UP))    te_move_cursor(-1, 0);
        if (key_pressed(VK_DOWN))  te_move_cursor(1, 0);
        if (key_pressed(VK_HOME))  te_home();
        if (key_pressed(VK_END))   te_end();
        if (key_pressed(VK_PAGEUP))   te_page(-visible + 1);
        if (key_pressed(VK_PAGEDOWN)) te_page(visible - 1);
        if (key_pressed(VK_DELETE) && ctrl_held() == false) te_delete();
    }

    if (ctrl_held() && key_pressed(VK_S)) {
        let ok: int = te_save();
        if (ok == 1) eng_log("[script] saved " + te_path());
        else         eng_log("[script] save failed");
    }

    /* mouse click positions cursor (measured in the font the editor draws with) */
    if (point_in_rect(eng_mouse_x(), eng_mouse_y(), r) && mouse_pressed(MOUSE_LEFT)) {
        edit_target = "";
        let mx: int = eng_mouse_x();
        let my: int = eng_mouse_y();
        th_font_mono(13);
        if (my > r.y + 30 && my < r.y + r.h - 22) {
            let line_idx: int = (my - body_y) / SCRIPT_LINE_H + te_scroll_y();
            if (line_idx < 0) line_idx = 0;
            if (line_idx >= te_line_count()) line_idx = te_line_count() - 1;
            let line_text: string = te_line(line_idx);
            let cur_x: int = r.x + SCRIPT_GUTTER;
            let n: int = line_text.len();
            let i: int = 0;
            while (i < n) {
                let ch: string = line_text.substring(i, 1);
                let cw: int = eng_text_width(ch);
                if (mx < cur_x + cw / 2) break;
                cur_x = cur_x + cw;
                i = i + 1;
            }
            te_set_cursor(line_idx, i);
        }
        th_font(14);
    }

    /* auto-scroll only when the cursor moved this frame */
    let cursor_moved: int = 0;
    if (te_cursor_line() != cursor_before_line) cursor_moved = 1;
    if (te_cursor_col()  != cursor_before_col)  cursor_moved = 1;
    if (cursor_moved == 1) {
        let cl: int = te_cursor_line();
        let sy: int = te_scroll_y();
        if (cl < sy) te_set_scroll_y(cl);
        if (cl >= sy + visible) te_set_scroll_y(cl - visible + 1);
    }

    /* mouse wheel scrolls (run AFTER cursor-follow so it is not clobbered) */
    if (point_in_rect(eng_mouse_x(), eng_mouse_y(), r)) {
        let w: int = eng_mouse_wheel();
        if (w != 0) {
            let total: int = te_line_count();
            let max_sy: int = total - visible;
            if (max_sy < 0) max_sy = 0;
            let new_sy: int = te_scroll_y() - w * 3;
            if (new_sy < 0) new_sy = 0;
            if (new_sy > max_sy) new_sy = max_sy;
            te_set_scroll_y(new_sy);
        }
    }
}

fn script_editor_draw() {
    if (bp_is_open() == 1) { bp_editor_draw(); return; }
    let r: Rect = viewport_rect();
    draw_fill_rect(r, col_ui_input());

    /* small action strip across the top of the editor body */
    let strip: Rect = rect(r.x, r.y, r.w, 26);
    draw_fill_rect(strip, col_panel_dark());
    draw_fill_rect(rect(strip.x, strip.y + strip.h - 1, strip.w, 1), col_border_soft());

    let title: string = path_basename(te_path());
    if (title.len() == 0) title = "(no script open)";
    th_font_semi(12);
    draw_text(r.x + 12, th_text_y(strip.y, strip.h), title, col_text_main());
    if (te_dirty() == 1) {
        let dx: int = r.x + 12 + eng_text_width(title) + 10;
        th_chip(rect(dx, strip.y + 5, 64, strip.h - 10), "UNSAVED", col_warn());
    }
    th_font(14);

    let bx: int = r.x + r.w - 190;
    if (ui_pill(rect(bx, r.y + 3, 80, strip.h - 6), "Save",  0) == 1) {
        let ok: int = te_save();
        if (ok == 1) eng_log("[script] saved " + te_path());
    }
    if (ui_pill(rect(bx + 86, r.y + 3, 96, strip.h - 6), "Build", 1) == 1) compile_begin("idle");

    if (te_line_count() == 0) return;

    let body_y: int = r.y + 30;
    let body_h: int = r.h - 30;
    eng_set_clip(r.x, body_y, r.w, body_h);

    th_font_mono(13);
    let visible: int = body_h / SCRIPT_LINE_H;
    let total: int = te_line_count();
    let sy: int = te_scroll_y();
    if (sy + visible > total) sy = total - visible;
    if (sy < 0) sy = 0;
    if (sy != te_scroll_y()) te_set_scroll_y(sy);

    /* gutter background */
    eng_fill_rect(r.x, body_y, SCRIPT_GUTTER - 4, body_h, 24, 25, 29);
    draw_fill_rect(rect(r.x + SCRIPT_GUTTER - 4, body_y, 1, body_h), col_border_soft());

    /* highlight current line */
    let cl_hl: int = te_cursor_line();
    if (cl_hl >= sy && cl_hl < sy + visible) {
        let hy: int = body_y + 2 + (cl_hl - sy) * SCRIPT_LINE_H;
        eng_fill_rect(r.x + SCRIPT_GUTTER - 4, hy - 2, r.w - SCRIPT_GUTTER + 4, SCRIPT_LINE_H, 37, 39, 46);
    }

    let i: int = sy;
    let yy: int = body_y + 2;
    while (i < total && i - sy < visible) {
        let lnum: string = "" + (i + 1);
        let lw: int = eng_text_width(lnum);
        let lnum_color_r: int = 90;
        let lnum_color_g: int = 100;
        let lnum_color_b: int = 120;
        if (i == te_cursor_line()) { lnum_color_r = 200; lnum_color_g = 210; lnum_color_b = 230; }
        eng_text(r.x + SCRIPT_GUTTER - 12 - lw, yy, lnum, lnum_color_r, lnum_color_g, lnum_color_b);
        let line_text: string = te_line(i);
        draw_script_line(r.x + SCRIPT_GUTTER, yy, line_text, r.w - SCRIPT_GUTTER - 8);
        i = i + 1;
        yy = yy + SCRIPT_LINE_H;
    }

    /* cursor */
    let cl: int = te_cursor_line();
    let cc: int = te_cursor_col();
    if (cl >= sy && cl < sy + visible) {
        let line_text: string = te_line(cl);
        let prefix: string = "";
        if (cc <= line_text.len()) prefix = line_text.substring(0, cc);
        let cx: int = r.x + SCRIPT_GUTTER + eng_text_width(prefix);
        let cy: int = body_y + 2 + (cl - sy) * SCRIPT_LINE_H;
        cursor_blink_ms = cursor_blink_ms + frame_dt_ms();
        let phase: int = cursor_blink_ms;
        phase = phase % 1000;
        if (phase < 600) {
            eng_fill_rect(cx, cy - 1, 2, SCRIPT_LINE_H, 220, 230, 250);
        }
    }

    eng_clear_clip();
    th_font(14);
}

// =============================================================================
// Viewport
// =============================================================================

fn snap_coord(v: int): int {
    if (pref_int("snap", 0) == 0) return v;
    let g: int = pref_int("grid", 32);
    if (g < 1) g = 1;
    let half: int = g / 2;
    if (v >= 0) return ((v + half) / g) * g;
    return 0 - (((0 - v) + half) / g) * g;
}

/* Where the drag root should sit. delta is the total move since the grab, in
   the same units as from. A zero delta leaves that axis where the drag began,
   so a sideways drag does not yank the other axis onto a line. */
fn drag_snap_target(from: int, delta: int): int {
    if (delta == 0) return from;
    return snap_coord(from + delta);
}

/* 1 when a selected ancestor will carry this slot (parent move propagates). */
fn sel_is_carried(slot: int): int {
    let p: int = ent_parent(slot);
    while (p >= 0) {
        if (ent_selected(p) == 1) return 1;
        p = ent_parent(p);
    }
    return 0;
}

/* First selected UI root. The world root below skips these on purpose. */
fn sel_ui_move_root(): int {
    let s: int = sel_first();
    while (s >= 0) {
        if (ent_is_ui(s) == 1 && sel_is_carried(s) == 0) return s;
        s = sel_iter_next(s + 1);
    }
    return -1;
}

/* First selected world root (not carried by another selected parent; skips UI). */
fn sel_move_root(): int {
    let s: int = sel_first();
    while (s >= 0) {
        if (ent_is_ui(s) == 0 && sel_is_carried(s) == 0) return s;
        s = sel_iter_next(s + 1);
    }
    return -1;
}

/* Snap a proposed delta against the lead selection root so the whole group
   stays in relative formation (instead of each entity snapping alone). */
fn sel_snap_delta(dx: int, dy: int, dz: int) {
    move_out_x = dx;
    move_out_y = dy;
    move_out_z = dz;
    let root: int = sel_move_root();
    if (root < 0) return;
    if (dx != 0) move_out_x = snap_coord(ent_x(root) + dx) - ent_x(root);
    if (dy != 0) move_out_y = snap_coord(ent_y(root) + dy) - ent_y(root);
    if (dz != 0) move_out_z = snap_coord(ent_z(root) + dz) - ent_z(root);
}

/* Move every selected root by the same delta. Children of selected parents are
   carried by engine parent propagation. UI canvas slots are skipped (screen-space).
   Returns 1 when anything moved. */
fn sel_move_by(dx: int, dy: int, dz: int): int {
    if (dx == 0 && dy == 0 && dz == 0) return 0;
    if (sel_move_root() < 0) return 0;
    let moved: int = 0;
    let s: int = sel_first();
    while (s >= 0) {
        if (ent_is_ui(s) == 0 && sel_is_carried(s) == 0) {
            if (dx != 0) ent_set_x(s, ent_x(s) + dx);
            if (dy != 0) ent_set_y(s, ent_y(s) + dy);
            if (dz != 0) ent_set_z(s, ent_z(s) + dz);
            moved = 1;
        }
        s = sel_iter_next(s + 1);
    }
    return moved;
}

/* Selected object whose padded pick rect contains the screen point, or -1. */
fn sel_pick_at(mx: int, my: int): int {
    let s: int = sel_first();
    while (s >= 0) {
        if (point_in_rect(mx, my, sel_pick_rect(s))) return s;
        s = sel_iter_next(s + 1);
    }
    return -1;
}

fn viewport_draw_grid() {
    let v: Rect = viewport_rect();
    eng_set_clip(v.x, v.y, v.w, v.h);
    draw_fill_rect(v, col_viewport());
    if (viewport_mode == "play") {
        game_view_draw_letterbox();
        let gv: Rect = game_view_rect();
        eng_set_clip(gv.x, gv.y, gv.w, gv.h);
        eng_fill_rect(gv.x, gv.y, gv.w, gv.h, scene_clear_r(), scene_clear_g(), scene_clear_b());
        eng_clear_clip();
        return;
    }

    let clip: Rect = v;
    eng_set_clip(clip.x, clip.y, clip.w, clip.h);
    if (pref_int("show_grid", 1) == 0) {
        eng_clear_clip();
        return;
    }
    let step_world: int = pref_int("grid", 32);
    let step_screen: int = step_world * cam_zoom;
    if (step_screen < 4) step_screen = 4;
    /* origin in screen pixels */
    let ox: int = world_to_screen_x(0.0);
    let oy: int = world_to_screen_y(0.0);
    let world_left: float  = screen_to_world_x(clip.x);
    let world_right: float = screen_to_world_x(clip.x + clip.w);
    let world_top: float   = screen_to_world_y(clip.y);
    let world_bot: float   = screen_to_world_y(clip.y + clip.h);

    let wx_start: int = world_left;
    wx_start = (wx_start / step_world) * step_world - step_world;
    let wy_start: int = world_top;
    wy_start = (wy_start / step_world) * step_world - step_world;

    let line_c: Color = rgb(39, 42, 49);
    let x: int = wx_start;
    while (x < world_right + step_world) {
        let sx: int = world_to_screen_x(x);
        eng_line(sx, clip.y, sx, clip.y + clip.h, line_c.r, line_c.g, line_c.b);
        x = x + step_world;
    }
    let y: int = wy_start;
    while (y < world_bot + step_world) {
        let sy: int = world_to_screen_y(y);
        eng_line(clip.x, sy, clip.x + clip.w, sy, line_c.r, line_c.g, line_c.b);
        y = y + step_world;
    }
    /* origin axes a touch brighter */
    let axis_c: Color = rgb(62, 78, 112);
    if (ox >= clip.x && ox < clip.x + clip.w) eng_line(ox, clip.y, ox, clip.y + clip.h, axis_c.r, axis_c.g, axis_c.b);
    if (oy >= clip.y && oy < clip.y + clip.h) eng_line(clip.x, oy, clip.x + clip.w, oy, axis_c.r, axis_c.g, axis_c.b);

    eng_clear_clip();
}

fn ent_is_empty(slot: int): int {
    if (slot < 0) return 0;
    if (ent_kind(slot) == "empty") return 1;
    return 0;
}

fn undo_save_modify_tree(slot: int) {
    if (slot < 0) return;
    undo_save_modify(slot);
    let ci: int = 0;
    while (ci < ent_child_count(slot)) {
        undo_save_modify_tree(ent_child(slot, ci));
        ci = ci + 1;
    }
}

fn ent_is_camera_ent(slot: int): int {
    if (slot < 0) return 0;
    if (ent_camera(slot) == 1) return 1;
    if (ent_kind(slot) == "camera") return 1;
    return 0;
}

fn play_snap_to_camera() {
    let cam_slot: int = ent_find_main_camera();
    /* No camera: the desktop player shows the origin. Play must match that,
       not whatever pan was left on the scene tab. */
    if (cam_slot < 0) {
        cam_x = 0.0;
        cam_y = 0.0;
        cam_zoom = 1.0;
        return;
    }
    let v: Rect = game_view_rect();
    let ex: int = ent_x(cam_slot);
    let ey: int = ent_y(cam_slot);
    let ew: int = ent_w(cam_slot);
    let eh: int = ent_h(cam_slot);
    if (ew < 4) ew = 4;
    if (eh < 4) eh = 4;
    /* Pin the camera's outer rect to the viewport: one axis fills edge-to-edge,
     * the other is centered (cropped if aspects differ). */
    let zoom_x: float = v.w / ew;
    let zoom_y: float = v.h / eh;
    if (v.w * eh <= v.h * ew) {
        cam_zoom = zoom_x;
        cam_x = ex;
        cam_y = ey + eh / 2.0 - v.h / (2.0 * cam_zoom);
    } else {
        cam_zoom = zoom_y;
        cam_x = ex + ew / 2.0 - v.w / (2.0 * cam_zoom);
        cam_y = ey;
    }
    if (cam_zoom < 0.05) cam_zoom = 0.05;
}

fn camera_gizmo_color(slot: int): Color {
    if (ent_camera(slot) == 1) return rgb(80, 220, 140);
    return rgb(100, 160, 230);
}

/* True visible world region for a camera, using the exact same "contain" fit
 * as play_snap_to_camera against the fixed 16:9 game view. This is what the
 * game actually shows, so the editor can frame it precisely (WYSIWYG). */
fn camera_fov_world_rect(slot: int): Rect {
    let ex: int = ent_x(slot);
    let ey: int = ent_y(slot);
    let ew: int = ent_w(slot);
    let eh: int = ent_h(slot);
    if (ew < 4) ew = 4;
    if (eh < 4) eh = 4;
    let aw: int = UI_CANVAS_W;
    let ah: int = UI_CANVAS_H;
    let vw: float = ew;
    let vh: float = eh;
    if (aw * eh <= ah * ew) {
        let t: float = ew;
        vw = ew;
        vh = t * ah / aw;
    } else {
        let t: float = eh;
        vh = eh;
        vw = t * aw / ah;
    }
    let cxw: float = ex + ew / 2.0;
    let cyw: float = ey + eh / 2.0;
    let vxf: float = cxw - vw / 2.0;
    let vyf: float = cyw - vh / 2.0;
    let rx: int = vxf;
    let ry: int = vyf;
    let rw: int = vw;
    let rh: int = vh;
    return rect(rx, ry, rw, rh);
}

fn viewport_draw_camera_gizmo(slot: int, sx: int, sy: int, sw: int, sh: int) {
    let col: Color = camera_gizmo_color(slot);

    /* the bright frame is the actual visible FOV (matches play/export) */
    let fov: Rect = camera_fov_world_rect(slot);
    let fx: int = world_to_screen_x(fov.x);
    let fy: int = world_to_screen_y(fov.y);
    let fw: int = world_len(fov.w);
    let fh: int = world_len(fov.h);
    draw_outline_rect(rect(fx, fy, fw, fh), 2, col);

    /* the camera's own box is drawn dim as a secondary reference */
    let dim: Color = rgb(col.r / 2, col.g / 2, col.b / 2);
    draw_outline_rect(rect(sx, sy, sw, sh), 1, dim);

    let cx: int = fx + fw / 2;
    let cy: int = fy + fh / 2;
    eng_line(cx - 6, cy, cx + 6, cy, col.r, col.g, col.b);
    eng_line(cx, cy - 6, cx, cy + 6, col.r, col.g, col.b);
    let lbl: string = "Camera";
    if (ent_camera(slot) == 1) lbl = "Main Camera";
    if (fw > 60 && fh > 20) draw_text(fx + 4, fy + 4, lbl, col);
}

fn empty_gizmo_screen(slot: int): Rect {
    let gizmo: int = 16;
    let cx: int = world_to_screen_x(ent_x(slot));
    let cy: int = world_to_screen_y(ent_y(slot));
    return rect(cx - gizmo / 2, cy - gizmo / 2, gizmo, gizmo);
}

fn viewport_hit_at(mx: int, my: int): int {
    let best: int = -1;
    let best_z: int = 0;
    let s: int = ent_iter_next(0);
    while (s >= 0) {
        if (ent_active(s) == 1 && ent_shown(s) == 1 && ent_is_ui(s) == 0) {
            let hit: int = 0;
            if (ent_is_empty(s) == 1) {
                let gr: Rect = empty_gizmo_screen(s);
                if (point_in_rect(mx, my, gr)) hit = 1;
            } else {
                let wxf: float = screen_to_world_x(mx);
                let wyf: float = screen_to_world_y(my);
                let wxi: int = wxf;
                let wyi: int = wyf;
                if (wxi >= ent_x(s) && wyi >= ent_y(s) &&
                    wxi < ent_x(s) + ent_w(s) && wyi < ent_y(s) + ent_h(s)) hit = 1;
            }
            if (hit == 1) {
                let z: int = ent_z(s);
                if (best < 0 || z > best_z || (z == best_z && s > best)) {
                    best = s;
                    best_z = z;
                }
            }
        }
        s = ent_iter_next(s + 1);
    }
    return best;
}

fn dist_sq(ax: int, ay: int, bx: int, by: int): int {
    let dx: int = bx - ax;
    let dy: int = by - ay;
    return dx * dx + dy * dy;
}

fn gizmo_rot(slot: int): float {
    if (xform_local == 0) return 0.0;
    return ent_rot(slot);
}

/* Screen direction of an axis. 1 is the object's right, 2 is its up. */
fn gizmo_col_x(): Color { return rgb(240, 52, 79); }
fn gizmo_col_y(): Color { return rgb(82, 196, 140); }

fn axis_place(px: int, py: int, len: float, deg: float, which: int) {
    let c: float = m3_cos(deg);
    let s: float = m3_sin(deg);
    scr_dx = c;
    scr_dy = s;
    if (which == 2) {
        scr_dx = s;
        scr_dy = 0.0 - c;
    }
    axis_tx = px + scr_dx * len;
    axis_ty = py + scr_dy * len;
}

/* Thick shaft: three parallel strokes for a solid ~3px bar. */
fn axis_thick_line(x0: int, y0: int, x1: int, y1: int, col: Color) {
    eng_line(x0, y0, x1, y1, col.r, col.g, col.b);
    let ox: int = 0 - scr_dy;
    let oy: int = scr_dx;
    if (ox == 0 && oy == 0) { ox = 1; oy = 0; }
    eng_line(x0 + ox, y0 + oy, x1 + ox, y1 + oy, col.r, col.g, col.b);
    eng_line(x0 - ox, y0 - oy, x1 - ox, y1 - oy, col.r, col.g, col.b);
}

/* Filled triangular arrow tip (matches the 3D cone read). */
fn axis_arrow_head(col: Color) {
    let tipx: int = axis_tx;
    let tipy: int = axis_ty;
    let basex: int = tipx - scr_dx * 12.0;
    let basey: int = tipy - scr_dy * 12.0;
    let i: int = 0;
    while (i <= 12) {
        let u: float = i;
        u = u / 12.0;
        let cx: float = tipx + (basex - tipx) * u;
        let cy: float = tipy + (basey - tipy) * u;
        let hw: float = 6.0 * u;
        let lx: int = cx - scr_dy * hw;
        let ly: int = cy + scr_dx * hw;
        let rx: int = cx + scr_dy * hw;
        let ry: int = cy - scr_dx * hw;
        eng_line(lx, ly, rx, ry, col.r, col.g, col.b);
        i = i + 1;
    }
}

fn axis_draw(px: int, py: int, col: Color) {
    let basex: int = axis_tx - scr_dx * 11.0;
    let basey: int = axis_ty - scr_dy * 11.0;
    axis_thick_line(px, py, basex, basey, col);
    axis_arrow_head(col);
}

fn axis_hit(mx: int, my: int, px: int, py: int): int {
    if (dist_sq(mx, my, axis_tx, axis_ty) <= 256) return 1;
    if (gz_dist_sq(mx, my, px, py, axis_tx, axis_ty) <= 121.0) return 1;
    return 0;
}

fn gizmo_pivot_draw(px: int, py: int) {
    eng_fill_round_a(px - 5, py - 5, 10, 10, 5, 20, 22, 26, 220);
    eng_fill_round_a(px - 4, py - 4, 8, 8, 4, 235, 236, 240, 255);
}

fn draw_move_gizmo_at(px: int, py: int, deg: float) {
    let len: float = 42.0;
    axis_place(px, py, len, deg, 1);
    axis_draw(px, py, gizmo_col_x());
    axis_place(px, py, len, deg, 2);
    axis_draw(px, py, gizmo_col_y());
    gizmo_pivot_draw(px, py);
}

fn draw_move_gizmo(slot: int) {
    draw_move_gizmo_at(ent_pivot_screen_x(slot), ent_pivot_screen_y(slot), gizmo_rot(slot));
}

fn draw_scale_axes_at(px: int, py: int, lenx: float, leny: float, deg: float) {
    let cx: Color = gizmo_col_x();
    let cy: Color = gizmo_col_y();
    axis_place(px, py, lenx, deg, 1);
    axis_thick_line(px, py, axis_tx, axis_ty, cx);
    eng_fill_round_a(axis_tx - 5, axis_ty - 5, 10, 10, 3, cx.r, cx.g, cx.b, 255);
    eng_outline_round_a(axis_tx - 5, axis_ty - 5, 10, 10, 3, 1, 235, 236, 240, 180);
    axis_place(px, py, leny, deg, 2);
    axis_thick_line(px, py, axis_tx, axis_ty, cy);
    eng_fill_round_a(axis_tx - 5, axis_ty - 5, 10, 10, 3, cy.r, cy.g, cy.b, 255);
    eng_outline_round_a(axis_tx - 5, axis_ty - 5, 10, 10, 3, 1, 235, 236, 240, 180);
    gizmo_pivot_draw(px, py);
}

/* 0 none, 1 x, 2 y, 3 center */
fn axis_pick_at(mx: int, my: int, px: int, py: int, len: float, deg: float): int {
    if (dist_sq(px, py, mx, my) <= 100) return 3;
    axis_place(px, py, len, deg, 1);
    if (axis_hit(mx, my, px, py) == 1) return 1;
    axis_place(px, py, len, deg, 2);
    if (axis_hit(mx, my, px, py) == 1) return 2;
    return 0;
}

fn move_gizmo_pick(mx: int, my: int, slot: int): int {
    return axis_pick_at(mx, my, ent_pivot_screen_x(slot), ent_pivot_screen_y(slot), 42.0, gizmo_rot(slot));
}

/* Keep the drag on one arrow. Writes move_out_x / move_out_y. */
fn move_along(dx: int, dy: int, axis: int, slot: int) {
    move_out_x = dx;
    move_out_y = dy;
    if (axis != 1 && axis != 2) return;
    if (slot < 0) slot = sel_first();
    if (slot < 0) return;
    axis_place(0, 0, 1.0, gizmo_rot(slot), axis);
    let along: float = dx * scr_dx + dy * scr_dy;
    move_out_x = along * scr_dx;
    move_out_y = along * scr_dy;
}

fn move_gizmo_pick_selection(mx: int, my: int): int {
    if (sel_count() == 0) return 0;
    let s: int = sel_first();
    while (s >= 0) {
        let p: int = move_gizmo_pick(mx, my, s);
        if (p != 0) return p;
        s = sel_iter_next(s + 1);
    }
    return 0;
}

fn rotate_gizmo_hit(mx: int, my: int, slot: int): int {
    let px: int = ent_pivot_screen_x(slot);
    let py: int = ent_pivot_screen_y(slot);
    let ring_r: int = 28;
    let ds: int = dist_sq(px, py, mx, my);
    /* ring around the pivot (between inner/outer radius) */
    if (ds >= 121 && ds <= 2209) return 1;
    /* knob at the end of the radius line */
    let rot: int = ent_rot(slot);
    let hx: int = px + ring_r;
    let hy: int = py;
    inline_cpp! {
        double ha = (double)rot * 0.01745329252;
        hx = px + (int)(cos(ha) * (double)(ring_r + 8));
        hy = py + (int)(sin(ha) * (double)(ring_r + 8));
    }
    if (dist_sq(hx, hy, mx, my) <= 196) return 1;
    return 0;
}

fn sel_pick_rect(slot: int): Rect {
    let inset: Rect = sel_inset_screen(slot);
    return rect(inset.x - 24, inset.y - 24, inset.w + 48, inset.h + 48);
}

/* Pick target for the rotate tool: gizmo, entity body, or selected bounds. */
fn rotate_tool_pick(mx: int, my: int): int {
    let i: int = sel_first();
    while (i >= 0) {
        if (rotate_gizmo_hit(mx, my, i) == 1) return i;
        i = sel_iter_next(i + 1);
    }
    let hit: int = viewport_hit_at(mx, my);
    if (hit >= 0) return hit;
    if (sel_count() == 1) {
        let s: int = sel_first();
        if (s >= 0) {
            let pr: Rect = sel_pick_rect(s);
            if (point_in_rect(mx, my, pr)) return s;
        }
    }
    return -1;
}

fn ent_pivot_screen_x(slot: int): int {
    if (ent_is_empty(slot) == 1) return world_to_screen_x(ent_x(slot));
    return world_to_screen_x(ent_x(slot) + ent_w(slot) / 2);
}

fn ent_pivot_screen_y(slot: int): int {
    if (ent_is_empty(slot) == 1) return world_to_screen_y(ent_y(slot));
    return world_to_screen_y(ent_y(slot) + ent_h(slot) / 2);
}

fn angle_deg_at(px: int, py: int, mx: int, my: int): float {
    let r: float = 0.0;
    inline_cpp! {
        double dx = (double)mx - (double)px;
        double dy = (double)my - (double)py; /* matches GDI+ clockwise rotation */
        r = (float)(atan2(dy, dx) * 57.29577951308232);
    }
    return r;
}

fn wrap_deg_f(d: float): int {
    while (d < 0.0) d = d + 360.0;
    while (d >= 360.0) d = d - 360.0;
    let r: int = d;
    return r;
}

fn wrap_deg(d: int): int {
    while (d < 0) d = d + 360;
    while (d >= 360) d = d - 360;
    return d;
}

fn rotate_begin_drag(slot: int, mx: int, my: int) {
    rotate_active = 1;
    rotate_slot = slot;
    rotate_recorded = 0;
    let px: int = ent_pivot_screen_x(slot);
    let py: int = ent_pivot_screen_y(slot);
    let cursor_deg: float = angle_deg_at(px, py, mx, my);
    let base_deg: float = ent_rot(slot);
    rotate_grab_offset = base_deg - cursor_deg;
}

fn rotate_apply_drag(mx: int, my: int) {
    if (rotate_active == 0 || rotate_slot < 0) return;
    let px: int = ent_pivot_screen_x(rotate_slot);
    let py: int = ent_pivot_screen_y(rotate_slot);
    let cursor_deg: float = angle_deg_at(px, py, mx, my);
    let new_rot_f: float = cursor_deg + rotate_grab_offset;
    if (rotate_recorded == 0) {
        undo_save_modify(rotate_slot);
        rotate_recorded = 1;
    }
    ent_set_rot(rotate_slot, wrap_deg_f(new_rot_f));
}

fn dist_world(x0: float, ya: float, x1: float, yb: float): float {
    let r: float = 0.0;
    inline_cpp! {
        double dx = (double)x1 - (double)x0;
        double dy = (double)yb - (double)ya;
        r = (float)sqrt(dx * dx + dy * dy);
    }
    return r;
}

fn scale_axis_hit(mx: int, my: int, px: int, py: int, lenx: float, leny: float, deg: float): int {
    if (dist_sq(px, py, mx, my) <= 81) return 3;
    axis_place(px, py, lenx, deg, 1);
    if (axis_hit(mx, my, px, py) == 1) return 1;
    axis_place(px, py, leny, deg, 2);
    if (axis_hit(mx, my, px, py) == 1) return 2;
    return 0;
}

fn scale_local_press(mx: int, my: int): int {
    let s: int = sel_first();
    while (s >= 0) {
        let px: int = ent_pivot_screen_x(s);
        let py: int = ent_pivot_screen_y(s);
        let lx: float = world_len(ent_w(s)) / 2.0 + 18.0;
        let ly: float = world_len(ent_h(s)) / 2.0 + 18.0;
        let ax: int = scale_axis_hit(mx, my, px, py, lx, ly, gizmo_rot(s));
        if (ax == 1 || ax == 2) {
            scale_begin_axis(s, mx, my, ax);
            return 1;
        }
        if (ax == 3) {
            scale_begin_uniform(s, mx, my);
            return 1;
        }
        s = sel_iter_next(s + 1);
    }
    return 0;
}

fn scale_local_press_ui(mx: int, my: int): int {
    let s: int = sel_first();
    while (s >= 0) {
        if (ent_is_ui(s) == 1) {
            let px: int = ui_ent_pivot_screen_x(s);
            let py: int = ui_ent_pivot_screen_y(s);
            let inset_w: float = ui_len_w(ent_w(s));
            let inset_h: float = ui_len_h(ent_h(s));
            let lx: float = inset_w / 2.0 + 18.0;
            let ly: float = inset_h / 2.0 + 18.0;
            let ax: int = scale_axis_hit(mx, my, px, py, lx, ly, gizmo_rot(s));
            if (ax == 1 || ax == 2) {
                scale_begin_axis(s, mx, my, ax);
                return 1;
            }
            if (ax == 3) {
                scale_begin_uniform_ui(s, mx, my);
                return 1;
            }
        }
        s = sel_iter_next(s + 1);
    }
    return 0;
}

fn scale_begin_axis(slot: int, mx: int, my: int, axis: int) {
    if (viewport_mode == "ui" && ent_is_ui(slot) == 1) scale_begin_uniform_ui(slot, mx, my);
    else scale_begin_uniform(slot, mx, my);
    scale_axis = axis;
    scale_grab_sx = mx;
    scale_grab_sy = my;
    axis_place(0, 0, 1.0, gizmo_rot(slot), axis);
    scale_dir_x = scr_dx;
    scale_dir_y = scr_dy;
}

fn scale_factor_axis(mx: int, my: int): float {
    let along: float = (mx - scale_grab_sx) * scale_dir_x + (my - scale_grab_sy) * scale_dir_y;
    let factor: float = 1.0 + along / 80.0;
    if (factor < 0.05) factor = 0.05;
    if (factor > 6.0) factor = 6.0;
    return factor;
}

fn scale_begin_uniform(slot: int, mx: int, my: int) {
    scale_axis = 0;
    scale_uniform_active = 1;
    scale_uniform_slot = slot;
    scale_recorded = 0;
    scale_start_w = ent_w(slot);
    scale_start_h = ent_h(slot);
    scale_start_x = ent_x(slot);
    scale_start_y = ent_y(slot);
    scale_pivot_wx = ent_x(slot) + scale_start_w / 2.0;
    scale_pivot_wy = ent_y(slot) + scale_start_h / 2.0;
    let mxw: float = screen_to_world_x(mx);
    let myw: float = screen_to_world_y(my);
    scale_start_dist = dist_world(scale_pivot_wx, scale_pivot_wy, mxw, myw);
    if (scale_start_dist < 4.0) scale_start_dist = 4.0;
}

fn scale_apply_uniform(mx: int, my: int) {
    if (scale_uniform_active == 0 || scale_uniform_slot < 0) return;
    let mxw: float = screen_to_world_x(mx);
    let myw: float = screen_to_world_y(my);
    let dist: float = dist_world(scale_pivot_wx, scale_pivot_wy, mxw, myw);
    if (dist < 4.0) dist = 4.0;
    let factor: float = dist / scale_start_dist;
    if (scale_axis == 1 || scale_axis == 2) factor = scale_factor_axis(mx, my);
    let nw_f: float = scale_start_w * factor;
    let nh_f: float = scale_start_h * factor;
    if (ctrl_held() == false && scale_axis == 1) nh_f = scale_start_h;
    if (ctrl_held() == false && scale_axis == 2) nw_f = scale_start_w;
    let nw: int = nw_f;
    let nh: int = nh_f;
    if (nw < 4) nw = 4;
    if (nh < 4) nh = 4;
    if (scale_recorded == 0) {
        undo_save_modify(scale_uniform_slot);
        scale_recorded = 1;
    }
    let nx_f: float = scale_pivot_wx - nw / 2.0;
    let ny_f: float = scale_pivot_wy - nh / 2.0;
    let nx: int = nx_f;
    let ny: int = ny_f;
    ent_set_x(scale_uniform_slot, nx);
    ent_set_y(scale_uniform_slot, ny);
    ent_set_w(scale_uniform_slot, nw);
    ent_set_h(scale_uniform_slot, nh);
}

fn tool_display_name(): string {
    if (edit_tool == "hand") return "Pan";
    if (edit_tool == "move") return "Move";
    if (edit_tool == "rotate") return "Rotate";
    if (edit_tool == "scale") return "Scale";
    return "Move";
}

fn tool_shortcut_key(): string {
    if (edit_tool == "hand") return "Q";
    if (edit_tool == "move") return "W";
    if (edit_tool == "rotate") return "E";
    if (edit_tool == "scale") return "R";
    return "W";
}

fn tool_help_text(): string {
    if (edit_tool == "hand") return "Drag to pan the view. Hold Space and drag, or use the middle mouse button, from any tool.";
    if (edit_tool == "move") return "Drag the arrows, or the object. L swaps local and world axes.";
    if (edit_tool == "rotate") return "Drag a ring to turn around that axis. L swaps local and world.";
    if (edit_tool == "scale") return "Drag a handle to scale that axis. Hold Ctrl to scale both axes together.";
    return "";
}

fn toolbar_tool_rect(index: int): Rect {
    let bx: int = TOOL_BTN_X0 + index * (TOOL_BTN_W + TOOL_BTN_GAP);
    return rect(bx, toolbar_btn_y(), TOOL_BTN_W, toolbar_btn_h());
}

fn toolbar_btn_h(): int { return 32; }
fn toolbar_btn_y(): int { return toolbar_y() + (TOOLBAR_H - toolbar_btn_h()) / 2; }

fn toolbar_icon_w(): int { return 32; }
fn toolbar_save_rect(): Rect {
    let bx: int = TOOL_BTN_X0 + 5 * (TOOL_BTN_W + TOOL_BTN_GAP) + 12;
    return rect(bx, toolbar_btn_y(), toolbar_icon_w(), toolbar_btn_h());
}
fn toolbar_build_rect(): Rect {
    let s: Rect = toolbar_save_rect();
    return rect(s.x + s.w + 6, s.y, toolbar_icon_w(), s.h);
}
fn toolbar_transport_w(): int { return toolbar_icon_w() * 3 + 12; }
fn toolbar_play_x(): int { return (WIN_W - toolbar_transport_w()) / 2; }
fn toolbar_play_rect(): Rect  { return rect(toolbar_play_x(), toolbar_btn_y(), toolbar_icon_w(), toolbar_btn_h()); }
fn toolbar_pause_rect(): Rect { return rect(toolbar_play_x() + toolbar_icon_w() + 6, toolbar_btn_y(), toolbar_icon_w(), toolbar_btn_h()); }
fn toolbar_stop_rect(): Rect  { return rect(toolbar_play_x() + (toolbar_icon_w() + 6) * 2, toolbar_btn_y(), toolbar_icon_w(), toolbar_btn_h()); }
fn toolbar_close_rect(): Rect { return rect(WIN_W - 12 - toolbar_icon_w(), toolbar_btn_y(), toolbar_icon_w(), toolbar_btn_h()); }
fn toolbar_settings_rect(): Rect {
    let a: Rect = toolbar_add_rect();
    return rect(a.x - 102, toolbar_btn_y(), 92, toolbar_btn_h());
}
fn toolbar_redo_rect(): Rect  {
    let c: Rect = toolbar_close_rect();
    return rect(c.x - 38, toolbar_btn_y(), 32, toolbar_btn_h());
}
fn toolbar_undo_rect(): Rect  {
    let c: Rect = toolbar_redo_rect();
    return rect(c.x - 36, toolbar_btn_y(), 32, toolbar_btn_h());
}
fn toolbar_add_label_rect(): Rect {
    let c: Rect = toolbar_undo_rect();
    return rect(c.x - 40, toolbar_btn_y(), 34, toolbar_btn_h());
}
fn toolbar_add_rect(): Rect {
    let c: Rect = toolbar_add_label_rect();
    return rect(c.x - 38, toolbar_btn_y(), 34, toolbar_btn_h());
}

/* A light's editor icon: a disc in its color, plus what tells the kinds apart
   (directional: an arrow the way it shines in the x/y plane; spot: a short
   cone; point: rays; ambient: a ring). */
fn light_icon_draw(slot: int, cx: int, cy: int, rad: int) {
    let k: string = ent_kind(slot);
    let r: int = ent_r(slot);
    let g: int = ent_g(slot);
    let b: int = ent_b(slot);
    if (rad < 5) rad = 5;
    let dxs: int = 0;
    let dys: int = rad * 2;
    let rot: int = ent_rot(slot);
    inline_cpp! {
        /* down the screen, turned clockwise by the rotation */
        double a = (double)rot * 0.01745329252;
        dxs = (int)(-sin(a) * (double)(rad * 2 + 4));
        dys = (int)(cos(a) * (double)(rad * 2 + 4));
    }
    if (k == "light_point") {
        let i: int = 0;
        while (i < 8) {
            let ex: int = 0;
            let ey: int = 0;
            inline_cpp! {
                double a = (double)i * 0.78539816;
                ex = (int)(cos(a) * (double)(rad + 6));
                ey = (int)(sin(a) * (double)(rad + 6));
            }
            eng_line(cx + ex / 2, cy + ey / 2, cx + ex, cy + ey, r, g, b);
            i = i + 1;
        }
    } else if (k == "light_ambient") {
        eng_outline_round_a(cx - rad - 4, cy - rad - 4, rad * 2 + 8, rad * 2 + 8, rad + 4, 1, r, g, b, 200);
    } else {
        eng_line(cx, cy, cx + dxs, cy + dys, r, g, b);
        eng_line(cx + 1, cy, cx + dxs + 1, cy + dys, r, g, b);
        if (k == "light_spot") {
            /* cone mouth across the end of the beam */
            eng_line(cx + dxs - dys / 3, cy + dys + dxs / 3, cx + dxs + dys / 3, cy + dys - dxs / 3, r, g, b);
            eng_line(cx, cy, cx + dxs - dys / 3, cy + dys + dxs / 3, r, g, b);
            eng_line(cx, cy, cx + dxs + dys / 3, cy + dys - dxs / 3, r, g, b);
        } else {
            /* arrow head */
            eng_line(cx + dxs, cy + dys, cx + dxs * 2 / 3 - dys / 5, cy + dys * 2 / 3 + dxs / 5, r, g, b);
            eng_line(cx + dxs, cy + dys, cx + dxs * 2 / 3 + dys / 5, cy + dys * 2 / 3 - dxs / 5, r, g, b);
        }
    }
    eng_fill_round_a(cx - rad - 1, cy - rad - 1, rad * 2 + 2, rad * 2 + 2, rad + 1, 20, 21, 24, 255);
    eng_fill_round_a(cx - rad + 1, cy - rad + 1, rad * 2 - 2, rad * 2 - 2, rad - 1, r, g, b, 255);
    if (ent_selected(slot) == 1) {
        let ac: Color = col_accent();
        eng_outline_round_a(cx - rad - 3, cy - rad - 3, rad * 2 + 6, rad * 2 + 6, rad + 3, 2, ac.r, ac.g, ac.b, 255);
    }
}

/* Screen-space camera, same idea as a light icon: a body and a lens, so a
   camera stays readable at any zoom. The play camera is green; others blue. */
fn camera_icon_draw(slot: int, cx: int, cy: int) {
    let col: Color = camera_gizmo_color(slot);
    eng_fill_round_a(cx - 11, cy - 8, 18, 16, 3, 20, 21, 24, 255);
    eng_fill_round_a(cx - 9, cy - 6, 14, 12, 2, col.r, col.g, col.b, 255);
    eng_line(cx + 5, cy - 4, cx + 14, cy - 9, col.r, col.g, col.b);
    eng_line(cx + 5, cy + 4, cx + 14, cy + 9, col.r, col.g, col.b);
    eng_line(cx + 14, cy - 9, cx + 14, cy + 9, col.r, col.g, col.b);
    eng_line(cx + 6, cy - 4, cx + 14, cy - 8, col.r, col.g, col.b);
    eng_line(cx + 6, cy + 4, cx + 14, cy + 8, col.r, col.g, col.b);
    if (ent_selected(slot) == 1) {
        let ac: Color = col_accent();
        eng_outline_round_a(cx - 14, cy - 11, 32, 22, 4, 2, ac.r, ac.g, ac.b, 255);
    }
}

fn draw_entity_body(slot: int, sx: int, sy: int, sw: int, sh: int) {
    let kind: string = ent_kind(slot);
    let rot: int = ent_rot(slot);
    if (ent_is_light(slot) == 1) {
        if (viewport_mode != "play") {
            let lr: int = sw / 4;
            if (sh / 4 < lr) lr = sh / 4;
            light_icon_draw(slot, sx + sw / 2, sy + sh / 2, lr);
        }
        return;
    }
    if (kind == "emitter") {
        if (viewport_mode == "play") return;
        if (ent_sprite_id(slot) != 0) eng_image_blit_scaled_rot_px(ent_sprite_id(slot), sx, sy, sw, sh, rot, ent_a(slot), ent_pixel(slot));
        else eng_fill_rect_a(sx, sy, sw, sh, ent_r(slot), ent_g(slot), ent_b(slot), ent_a(slot));
        return;
    }
    /* 3D exports draw interface text with the player's 5x7 font. 2D exports
       use Consolas, same as the native and web players. */
    if (kind == "label") {
        let txt: string = ent_text(slot);
        if (txt.len() == 0) txt = ent_name(slot);
        ui_draw_label(sx, sy, sw, sh, txt, ent_r(slot), ent_g(slot), ent_b(slot), ent_sprite(slot), ent_font_px(slot), ent_font_ox(slot), ent_font_oy(slot), ui_ha(slot), ui_va(slot));
        th_font(14);
    } else if (ent_is_3d_kind(slot) == 1) {
        shape3d_draw_flat(slot, sx, sy, sw, sh);
    } else if (ent_is_ui(slot) == 1 && kind != "sprite2d") {
        /* A picture on a panel or button stays inside the widget. It does not
           replace the widget with a world sprite. */
        if (rot != 0) eng_fill_rect_rot_a(sx, sy, sw, sh, ent_r(slot), ent_g(slot), ent_b(slot), ent_a(slot), rot);
        else          ui_draw_box(slot, sx, sy, sw, sh);
        let txt: string = ent_text(slot);
        if (txt.len() > 0 && sw > 10 && sh > 8 && rot == 0 && ui_ent_owns_caption(slot) == 0) {
            ui_draw_caption(sx, sy, sw, sh, txt, ent_font_px(slot), ent_font_ox(slot), ent_font_oy(slot), ui_text_chan(slot, 0), ui_text_chan(slot, 1), ui_text_chan(slot, 2), ui_ha(slot), ui_va(slot));
            th_font(14);
        }
    } else if (ent_sprite_id(slot) != 0) {
        eng_image_blit_scaled_rot_px(ent_sprite_id(slot), sx, sy, sw, sh, rot, ent_a(slot), ent_pixel(slot));
    } else {
        if (rot != 0)                 eng_fill_rect_rot_a(sx, sy, sw, sh, ent_r(slot), ent_g(slot), ent_b(slot), ent_a(slot), rot);
        else if (ent_is_ui(slot) == 1) ui_draw_box(slot, sx, sy, sw, sh);
        else                          eng_fill_rect_a(sx, sy, sw, sh, ent_r(slot), ent_g(slot), ent_b(slot), ent_a(slot));
        let txt: string = ent_text(slot);
        if (txt.len() > 0 && sw > 10 && sh > 8 && rot == 0 && ui_ent_owns_caption(slot) == 0) {
            ui_draw_caption(sx, sy, sw, sh, txt, ent_font_px(slot), ent_font_ox(slot), ent_font_oy(slot), ui_text_chan(slot, 0), ui_text_chan(slot, 1), ui_text_chan(slot, 2), ui_ha(slot), ui_va(slot));
            th_font(14);
        } else if (viewport_mode != "play" && ent_is_ui(slot) == 0 && scene_render3d() == 0) {
            let nm: string = ent_name(slot);
            if (nm.len() > 0 && sw > 40 && rot == 0) {
                th_font(11);
                draw_text(sx + 5, sy + 4, nm, rgb(20, 20, 20));
                th_font(14);
            }
        }
    }
}

fn viewport_draw_entities() {
    let v: Rect = viewport_rect();
    let clip: Rect = v;
    if (viewport_mode == "play") clip = game_view_rect();
    eng_set_clip(clip.x, clip.y, clip.w, clip.h);
    let i: int = ent_next_by_depth(-1);
    while (i >= 0) {
        if (ent_is_empty(i) == 1) {
            i = ent_next_by_depth(i);
            continue;
        }
        if (ent_is_ui(i) == 1) {
            i = ent_next_by_depth(i);
            continue;
        }
        if (ent_shown(i) == 0) {
            i = ent_next_by_depth(i);
            continue;
        }
        if (viewport_mode == "play" && ent_is_camera_ent(i) == 1) {
            i = ent_next_by_depth(i);
            continue;
        }
        let sx: int = world_to_screen_x(ent_x(i));
        let sy: int = world_to_screen_y(ent_y(i));
        let sw: int = world_len(ent_w(i));
        let sh: int = world_len(ent_h(i));
        let er: Rect = rect(sx, sy, sw, sh);
        if (ent_is_camera_ent(i) == 1) {
            if (ent_selected(i) == 0) {
                viewport_draw_camera_gizmo(i, sx, sy, sw, sh);
            }
        } else {
            draw_entity_body(i, sx, sy, sw, sh);
        }
        let sc: string = ent_script(i);
        if (sc.len() > 0 && sw > 12) {
            let dot: Rect = rect(er.x + er.w - 8, er.y + 2, 6, 6);
            draw_fill_rect(dot, col_play());
        }
        i = ent_next_by_depth(i);
    }
    particles_draw();
    eng_clear_clip();
}

fn sel_inset_screen(slot: int): Rect {
    if (ent_is_empty(slot) == 1) return empty_gizmo_screen(slot);
    let sx: int = world_to_screen_x(ent_x(slot));
    let sy: int = world_to_screen_y(ent_y(slot));
    let sw: int = world_len(ent_w(slot));
    let sh: int = world_len(ent_h(slot));
    return rect(sx - 2, sy - 2, sw + 4, sh + 4);
}

fn resize_handle_hit_rect(inset: Rect, handle: int): Rect {
    /* Corners first, then the rest of each edge. */
    let hit: int = 14;
    if (handle == 0) return rect(inset.x - hit / 2,               inset.y - hit / 2,               hit, hit);
    if (handle == 1) return rect(inset.x + inset.w - hit / 2,     inset.y - hit / 2,               hit, hit);
    if (handle == 2) return rect(inset.x - hit / 2,               inset.y + inset.h - hit / 2,   hit, hit);
    if (handle == 3) return rect(inset.x + inset.w - hit / 2, inset.y + inset.h - hit / 2, hit, hit);
    let thick: int = 8;
    if (handle == 4) {
        let w: int = inset.w - hit;
        if (w < 4) return rect(0, 0, 0, 0);
        return rect(inset.x + hit / 2, inset.y - thick / 2, w, thick);
    }
    if (handle == 5) {
        let h: int = inset.h - hit;
        if (h < 4) return rect(0, 0, 0, 0);
        return rect(inset.x + inset.w - thick / 2, inset.y + hit / 2, thick, h);
    }
    if (handle == 6) {
        let w: int = inset.w - hit;
        if (w < 4) return rect(0, 0, 0, 0);
        return rect(inset.x + hit / 2, inset.y + inset.h - thick / 2, w, thick);
    }
    let h: int = inset.h - hit;
    if (h < 4) return rect(0, 0, 0, 0);
    return rect(inset.x - thick / 2, inset.y + hit / 2, thick, h);
}

fn draw_resize_handles(inset: Rect, col: Color) {
    let h: int = 8;
    draw_fill_rect(rect(inset.x - h / 2,                inset.y - h / 2,                h, h), col);
    draw_fill_rect(rect(inset.x + inset.w - h / 2 - 1,  inset.y - h / 2,                h, h), col);
    draw_fill_rect(rect(inset.x - h / 2,                inset.y + inset.h - h / 2 - 1,  h, h), col);
    draw_fill_rect(rect(inset.x + inset.w - h / 2 - 1,  inset.y + inset.h - h / 2 - 1,  h, h), col);
    draw_fill_rect(rect(inset.x + inset.w / 2 - h / 2,  inset.y - h / 2,                h, h), col);
    draw_fill_rect(rect(inset.x + inset.w - h / 2 - 1,  inset.y + inset.h / 2 - h / 2,  h, h), col);
    draw_fill_rect(rect(inset.x + inset.w / 2 - h / 2,  inset.y + inset.h - h / 2 - 1,  h, h), col);
    draw_fill_rect(rect(inset.x - h / 2,                inset.y + inset.h / 2 - h / 2,  h, h), col);
}

fn resize_handle_at(mx: int, my: int): int {
    ui_canvas_layout_game_view(game_view_rect());
    let i: int = sel_first();
    while (i >= 0) {
        if (ent_is_empty(i) == 1) {
            i = sel_iter_next(i + 1);
            continue;
        }
        if (ent_is_ui(i) == 1) {
            i = sel_iter_next(i + 1);
            continue;
        }
        let inset: Rect = sel_inset_screen(i);
        let h: int = 0;
        while (h < 8) {
            let hr: Rect = resize_handle_hit_rect(inset, h);
            if (point_in_rect(mx, my, hr)) {
                resize_slot = i;
                return h;
            }
            h = h + 1;
        }
        i = sel_iter_next(i + 1);
    }
    return -1;
}

fn resize_begin(slot: int, handle: int) {
    resize_active = 1;
    resize_handle = handle;
    resize_slot   = slot;
    resize_recorded = 0;
    let ax: int = ent_x(slot);
    let ay: int = ent_y(slot);
    let aw: int = ent_w(slot);
    let ah: int = ent_h(slot);
    resize_orig_x = ax;
    resize_orig_y = ay;
    resize_orig_w = aw;
    resize_orig_h = ah;
    if (handle == 0 || handle == 7) resize_anchor_wx = ax + aw;
    else resize_anchor_wx = ax;
    if (handle == 0 || handle == 1 || handle == 4) resize_anchor_wy = ay + ah;
    else resize_anchor_wy = ay;
    if (ent_is_ui(slot) == 1) {
        ui_canvas_layout_game_view(game_view_rect());
        resize_fix_l = ui_to_screen_x(ax);
        resize_fix_t = ui_to_screen_y(ay);
        resize_fix_r = resize_fix_l + ui_len_w(aw);
        resize_fix_b = resize_fix_t + ui_len_h(ah);
    }
}

/* One scale for both axes. The grabbed side stays under the cursor. */
fn resize_linear_factor(dx: float, dy: float, ow: float, oh: float, edge: int): float {
    let s: float = 1.0;
    if (ow < 1.0) ow = 1.0;
    if (oh < 1.0) oh = 1.0;
    if (edge == 1) s = dx / ow;
    else if (edge == 2) s = dy / oh;
    else {
        s = dx * ow + dy * oh;
        s = s / (ow * ow + oh * oh);
    }
    let smin: float = 4.0 / ow;
    let smin_h: float = 4.0 / oh;
    if (smin_h > smin) smin = smin_h;
    if (s < smin) s = smin;
    return s;
}

fn resize_linear_world(mxw: int, myw: int) {
    let ox: int = resize_orig_x;
    let oy: int = resize_orig_y;
    let ow: int = resize_orig_w;
    let oh: int = resize_orig_h;
    if (ow < 1) ow = 1;
    if (oh < 1) oh = 1;
    let ow_f: float = ow;
    let oh_f: float = oh;
    let dx: float = 0.0;
    let dy: float = 0.0;
    let edge: int = 0;
    let h: int = resize_handle;
    if (h == 5 || h == 7) edge = 1;
    if (h == 4 || h == 6) edge = 2;
    if (h == 0 || h == 7) dx = (ox + ow) - mxw;
    else dx = mxw - ox;
    if (h == 0 || h == 1 || h == 4) dy = (oy + oh) - myw;
    else dy = myw - oy;
    let s: float = resize_linear_factor(dx, dy, ow_f, oh_f, edge);
    let nw_f: float = ow_f * s;
    let nh_f: float = oh_f * s;
    let nw: int = ui_round(nw_f);
    let nh: int = ui_round(nh_f);
    if (nw < 4) nw = 4;
    if (nh < 4) nh = 4;
    let cx: float = ox + ow_f / 2.0;
    let cy: float = oy + oh_f / 2.0;
    let nx: int = ox;
    let ny: int = oy;
    if (h == 0) {
        nx = ox + ow - nw;
        ny = oy + oh - nh;
    } else if (h == 1) {
        nx = ox;
        ny = oy + oh - nh;
    } else if (h == 2) {
        nx = ox + ow - nw;
        ny = oy;
    } else if (h == 3) {
        nx = ox;
        ny = oy;
    } else if (h == 4) {
        nx = ui_round(cx - nw / 2.0);
        ny = oy + oh - nh;
    } else if (h == 5) {
        nx = ox;
        ny = ui_round(cy - nh / 2.0);
    } else if (h == 6) {
        nx = ui_round(cx - nw / 2.0);
        ny = oy;
    } else {
        nx = ox + ow - nw;
        ny = ui_round(cy - nh / 2.0);
    }
    resize_lin_x = nx;
    resize_lin_y = ny;
    resize_lin_w = nw;
    resize_lin_h = nh;
}

fn resize_apply(mx: int, my: int) {
    if (resize_active == 0 || resize_slot < 0) return;
    if (ent_is_ui(resize_slot) == 1) {
        ui_canvas_layout_game_view(game_view_rect());
        ui_resize_apply(mx, my);
        return;
    }
    let min_sz: int = 4;
    let wxf: float = screen_to_world_x(mx);
    let wyf: float = screen_to_world_y(my);
    let mxw: int = ui_round(wxf);
    let myw: int = ui_round(wyf);
    let ax: int = resize_anchor_wx;
    let ay: int = resize_anchor_wy;
    let nx: int = 0;
    let ny: int = 0;
    let nw: int = 0;
    let nh: int = 0;

    if (resize_handle == 0) {
        nx = mxw;
        ny = myw;
        nw = ax - mxw;
        nh = ay - myw;
        if (nw < min_sz) { nx = ax - min_sz; nw = min_sz; }
        if (nh < min_sz) { ny = ay - min_sz; nh = min_sz; }
    } else if (resize_handle == 1) {
        nx = ax;
        ny = myw;
        nw = mxw - ax;
        nh = ay - myw;
        if (nw < min_sz) nw = min_sz;
        if (nh < min_sz) { ny = ay - min_sz; nh = min_sz; }
    } else if (resize_handle == 2) {
        nx = mxw;
        ny = ay;
        nw = ax - mxw;
        nh = myw - ay;
        if (nw < min_sz) { nx = ax - min_sz; nw = min_sz; }
        if (nh < min_sz) nh = min_sz;
    } else if (resize_handle == 3) {
        nx = ax;
        ny = ay;
        nw = mxw - ax;
        nh = myw - ay;
        if (nw < min_sz) nw = min_sz;
        if (nh < min_sz) nh = min_sz;
    } else if (resize_handle == 4) {
        nx = ax;
        ny = myw;
        nw = ent_w(resize_slot);
        nh = ay - myw;
        if (nh < min_sz) { ny = ay - min_sz; nh = min_sz; }
    } else if (resize_handle == 5) {
        nx = ax;
        ny = ay;
        nw = mxw - ax;
        nh = ent_h(resize_slot);
        if (nw < min_sz) nw = min_sz;
    } else if (resize_handle == 6) {
        nx = ax;
        ny = ay;
        nw = ent_w(resize_slot);
        nh = myw - ay;
        if (nh < min_sz) nh = min_sz;
    } else {
        nx = mxw;
        ny = ay;
        nw = ax - mxw;
        nh = ent_h(resize_slot);
        if (nw < min_sz) { nx = ax - min_sz; nw = min_sz; }
    }

    if (ctrl_held()) {
        resize_linear_world(mxw, myw);
        nx = resize_lin_x;
        ny = resize_lin_y;
        nw = resize_lin_w;
        nh = resize_lin_h;
    }

    if (resize_recorded == 0) {
        undo_save_modify(resize_slot);
        resize_recorded = 1;
    }
    ent_set_x(resize_slot, nx);
    ent_set_y(resize_slot, ny);
    ent_set_w(resize_slot, nw);
    ent_set_h(resize_slot, nh);
}

fn draw_rotate_gizmo(slot: int) {
    let px: int = ent_pivot_screen_x(slot);
    let py: int = ent_pivot_screen_y(slot);
    let ac: Color = col_accent();
    let rad: int = 28;
    draw_outline_rect(rect(px - rad, py - rad, rad * 2, rad * 2), 1, ac);
    let rot: int = ent_rot(slot);
    let hx: int = px + rad;
    let hy: int = py;
    inline_cpp! {
        double ha = (double)rot * 0.01745329252;
        hx = px + (int)(cos(ha) * (double)(rad + 8));
        hy = py + (int)(sin(ha) * (double)(rad + 8));
    }
    eng_line(px, py, hx, hy, ac.r, ac.g, ac.b);
    draw_fill_rect(rect(hx - 5, hy - 5, 10, 10), ac);
}

fn hitbox_rot_x(lx: float, ly: float, deg: float): float {
    return lx * m3_cos(deg) - ly * m3_sin(deg);
}
fn hitbox_rot_y(lx: float, ly: float, deg: float): float {
    return lx * m3_sin(deg) + ly * m3_cos(deg);
}

fn hitbox_draw_2d(slot: int) {
    if (ent_hitbox(slot) <= 0 || ent_kind(slot) != "model") return;
    let n: int = ent_hitbox_count(slot);
    let ox: float = ent_x(slot) + ent_w(slot) / 2.0;
    let oy: float = ent_y(slot) + ent_h(slot) / 2.0;
    let deg: float = ent_rot(slot);
    let col: Color = th_white();
    let i: int = 0;
    while (i < n) {
        let cx: float = ent_hitbox_cx(slot, i);
        let cy: float = ent_hitbox_cy(slot, i);
        let hw: float = ent_hitbox_hw(slot, i);
        let hh: float = ent_hitbox_hh(slot, i);
        let ax: float = ox + hitbox_rot_x(cx - hw, cy - hh, deg);
        let ay: float = oy + hitbox_rot_y(cx - hw, cy - hh, deg);
        let bx: float = ox + hitbox_rot_x(cx + hw, cy - hh, deg);
        let by: float = oy + hitbox_rot_y(cx + hw, cy - hh, deg);
        let cx2: float = ox + hitbox_rot_x(cx + hw, cy + hh, deg);
        let cy2: float = oy + hitbox_rot_y(cx + hw, cy + hh, deg);
        let dx: float = ox + hitbox_rot_x(cx - hw, cy + hh, deg);
        let dy: float = oy + hitbox_rot_y(cx - hw, cy + hh, deg);
        let sax: int = world_to_screen_x(ax);
        let say: int = world_to_screen_y(ay);
        let sbx: int = world_to_screen_x(bx);
        let sby: int = world_to_screen_y(by);
        let scx: int = world_to_screen_x(cx2);
        let scy: int = world_to_screen_y(cy2);
        let sdx: int = world_to_screen_x(dx);
        let sdy: int = world_to_screen_y(dy);
        eng_line(sax, say, sbx, sby, col.r, col.g, col.b);
        eng_line(sbx, sby, scx, scy, col.r, col.g, col.b);
        eng_line(scx, scy, sdx, sdy, col.r, col.g, col.b);
        eng_line(sdx, sdy, sax, say, col.r, col.g, col.b);
        i = i + 1;
    }
}

fn viewport_draw_selection() {
    let v: Rect = viewport_rect();
    eng_set_clip(v.x, v.y, v.w, v.h);
    let i: int = sel_first();
    while (i >= 0) {
        if (ent_is_ui(i) == 1) {
            i = sel_iter_next(i + 1);
            continue;
        }
        hitbox_draw_2d(i);
        if (ent_is_camera_ent(i) == 1) {
            let col: Color = camera_gizmo_color(i);
            let sx: int = world_to_screen_x(ent_x(i));
            let sy: int = world_to_screen_y(ent_y(i));
            let sw: int = world_len(ent_w(i));
            let sh: int = world_len(ent_h(i));
            /* true visible FOV frame (matches play/export) */
            let fov: Rect = camera_fov_world_rect(i);
            draw_outline_rect(rect(world_to_screen_x(fov.x), world_to_screen_y(fov.y),
                                   world_len(fov.w), world_len(fov.h)), 2, col);
            let dim: Color = rgb(col.r / 2, col.g / 2, col.b / 2);
            draw_outline_rect(rect(sx, sy, sw, sh), 1, dim);
            let cx: int = sx + sw / 2;
            let cy: int = sy + sh / 2;
            eng_line(cx - 6, cy, cx + 6, cy, col.r, col.g, col.b);
            eng_line(cx, cy - 6, cx, cy + 6, col.r, col.g, col.b);
            if (edit_tool == "rotate") {
                draw_rotate_gizmo(i);
            } else if (edit_tool == "scale") {
                draw_resize_handles(sel_inset_screen(i), col);
            } else if (edit_tool == "move") {
                draw_move_gizmo(i);
            }
            i = sel_iter_next(i + 1);
            continue;
        }
        let inset: Rect = sel_inset_screen(i);
        if (ent_is_empty(i) == 1) {
            let cx: int = inset.x + inset.w / 2;
            let cy: int = inset.y + inset.h / 2;
            let ac: Color = col_accent();
            draw_outline_rect(inset, 1, ac);
            if (edit_tool == "move") draw_move_gizmo(i);
            else {
                eng_line(cx - 7, cy, cx + 7, cy, ac.r, ac.g, ac.b);
                eng_line(cx, cy - 7, cx, cy + 7, ac.r, ac.g, ac.b);
            }
        } else if (edit_tool == "rotate") {
            draw_outline_rect(inset, 1, col_accent());
            draw_rotate_gizmo(i);
        } else if (edit_tool == "scale") {
            draw_outline_rect(inset, 2, col_accent());
            if (xform_local == 1) {
                let px: int = ent_pivot_screen_x(i);
                let py: int = ent_pivot_screen_y(i);
                let lx: float = world_len(ent_w(i)) / 2.0 + 18.0;
                let ly: float = world_len(ent_h(i)) / 2.0 + 18.0;
                draw_scale_axes_at(px, py, lx, ly, gizmo_rot(i));
            } else {
                draw_resize_handles(inset, col_accent());
            }
        } else if (edit_tool == "move") {
            draw_outline_rect(inset, 2, col_accent());
            draw_move_gizmo(i);
        } else {
            draw_outline_rect(inset, 2, col_accent());
        }
        i = sel_iter_next(i + 1);
    }
    eng_clear_clip();
}

fn viewport_draw_box_select() {
    if (box_select_active == 0) return;
    let v: Rect = viewport_rect();
    eng_set_clip(v.x, v.y, v.w, v.h);
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let x0: int = box_select_x0;
    let y0: int = box_select_y0;
    let x1: int = mx;
    let y1: int = my;
    if (x1 < x0) { let t: int = x0; x0 = x1; x1 = t; }
    if (y1 < y0) { let t: int = y0; y0 = y1; y1 = t; }
    let br: Rect = rect(x0, y0, x1 - x0, y1 - y0);
    /* soft white — same language as hierarchy selection chrome */
    let c: Color = th_white();
    /* 3D draws the tint into the picture so it stays see-through. */
    if (view3d_active() == 0) eng_fill_rect_a(br.x, br.y, br.w, br.h, c.r, c.g, c.b, 40);
    draw_outline_rect(br, 1, c);
    eng_clear_clip();
}

/* Translucent HUD card so hints stay readable over scene content. */
fn viewport_hud_card(x: int, y: int, w: int, h: int) {
    let bg: Color = col_ui_bg();
    th_fill_a(rect(x, y, w, h), TH_RADIUS, bg, 215);
}

fn viewport_draw_overlay_info() {
    let v: Rect = viewport_rect();
    let tool_line: string = tool_display_name() + " tool  (" + tool_shortcut_key() + ")";
    let help: string = tool_help_text();
    th_font(11);
    let hw: int = eng_text_width(help);
    th_font_semi(12);
    let tw: int = eng_text_width(tool_line);
    if (hw > tw) tw = hw;
    let hud_h: int = 42;
    if (rotate_active == 1 && rotate_slot >= 0) hud_h = 58;
    viewport_hud_card(v.x + 8, v.y + 8, tw + 20, hud_h);
    draw_text(v.x + 18, v.y + 13, tool_line, col_text_main());
    th_font(11);
    draw_text(v.x + 18, v.y + 30, help, col_text_dim());
    if (rotate_active == 1 && rotate_slot >= 0) {
        let ang: string = "Angle: " + ent_rot(rotate_slot) + " deg";
        draw_text(v.x + 18, v.y + 46, ang, col_accent());
    }
    let z: int = cam_zoom * 100;
    let zoom_line: string = "Zoom " + z + "%    Middle mouse or Space+drag to pan";
    let zw: int = eng_text_width(zoom_line);
    viewport_hud_card(v.x + 8, v.y + v.h - 28, zw + 20, 22);
    draw_text(v.x + 18, th_text_y(v.y + v.h - 28, 22), zoom_line, col_text_dim());
    th_font(14);
    view3d_toggle_draw();
}

fn ui_sel_inset_screen(slot: int): Rect {
    let sx: int = ui_to_screen_x(ent_x(slot));
    let sy: int = ui_to_screen_y(ent_y(slot));
    let sw: int = ui_len_w(ent_w(slot));
    let sh: int = ui_len_h(ent_h(slot));
    return rect(sx - 2, sy - 2, sw + 4, sh + 4);
}

fn ui_ent_pivot_screen_x(slot: int): int {
    if (ent_is_empty(slot) == 1) return ui_to_screen_x(ent_x(slot));
    let px: float = ent_x(slot) + ent_w(slot) / 2;
    return ui_to_screen_x(px);
}

fn ui_ent_pivot_screen_y(slot: int): int {
    if (ent_is_empty(slot) == 1) return ui_to_screen_y(ent_y(slot));
    let py: float = ent_y(slot) + ent_h(slot) / 2;
    return ui_to_screen_y(py);
}

fn ui_move_gizmo_pick(mx: int, my: int, slot: int): int {
    return axis_pick_at(mx, my, ui_ent_pivot_screen_x(slot), ui_ent_pivot_screen_y(slot), 42.0, gizmo_rot(slot));
}

fn ui_move_gizmo_pick_selection(mx: int, my: int): int {
    if (sel_count() == 0) return 0;
    let s: int = sel_first();
    while (s >= 0) {
        if (ent_is_ui(s) == 0) {
            s = sel_iter_next(s + 1);
            continue;
        }
        let p: int = ui_move_gizmo_pick(mx, my, s);
        if (p != 0) return p;
        s = sel_iter_next(s + 1);
    }
    return 0;
}

fn ui_viewport_hit_at(mx: int, my: int): int {
    let best: int = -1;
    let best_z: int = 0;
    let s: int = ent_iter_next(0);
    while (s >= 0) {
        if (ent_active(s) == 1 && ent_is_ui(s) == 1 && ent_shown(s) == 1) {
            let uxf: float = screen_to_ui_x(mx);
            let uyf: float = screen_to_ui_y(my);
            let uxi: int = uxf;
            let uyi: int = uyf;
            if (uxi >= ent_x(s) && uyi >= ent_y(s) &&
                uxi < ent_x(s) + ent_w(s) && uyi < ent_y(s) + ent_h(s)) {
                let z: int = ent_z(s);
                if (best < 0 || z > best_z || (z == best_z && s > best)) {
                    best = s;
                    best_z = z;
                }
            }
        }
        s = ent_iter_next(s + 1);
    }
    return best;
}

fn ui_resize_handle_at(mx: int, my: int): int {
    let i: int = sel_first();
    while (i >= 0) {
        if (ent_is_ui(i) == 0) {
            i = sel_iter_next(i + 1);
            continue;
        }
        let inset: Rect = ui_sel_inset_screen(i);
        let h: int = 0;
        while (h < 8) {
            let hr: Rect = resize_handle_hit_rect(inset, h);
            if (point_in_rect(mx, my, hr)) {
                resize_slot = i;
                return h;
            }
            h = h + 1;
        }
        i = sel_iter_next(i + 1);
    }
    return -1;
}

fn ui_round(v: float): int {
    if (v >= 0.0) return v + 0.5;
    return v - 0.5;
}

/* Canvas length whose on-screen size is the closest to px. */
fn ui_len_for_screen(px: int, vertical: int): int {
    let scale: float = ui_scale_x;
    if (vertical == 1) scale = ui_scale_y;
    if (scale < 0.0001) scale = 0.0001;
    if (px < 1) px = 1;
    let guess_f: float = px;
    let guess: int = ui_round(guess_f / scale);
    if (guess < 1) guess = 1;
    let best: int = guess;
    let best_d: int = 100000;
    let k: int = guess - 4;
    if (k < 1) k = 1;
    let end: int = guess + 4;
    while (k <= end) {
        let got: int = ui_len_w(k);
        if (vertical == 1) got = ui_len_h(k);
        let d: int = got - px;
        if (d < 0) d = -d;
        if (d < best_d) { best_d = d; best = k; }
        k = k + 1;
    }
    return best;
}

fn ui_origin_for_x(target: int): int {
    let scale: float = ui_scale_x;
    if (scale < 0.0001) scale = 0.0001;
    let rel: float = target - ui_cx;
    let guess: int = ui_round(rel / scale);
    let best: int = guess;
    let best_d: int = 100000;
    let k: int = guess - 4;
    let end: int = guess + 4;
    while (k <= end) {
        let s: int = ui_to_screen_x(k);
        let d: int = s - target;
        if (d < 0) d = -d;
        if (d < best_d) { best_d = d; best = k; }
        k = k + 1;
    }
    return best;
}

fn ui_origin_for_y(target: int): int {
    let scale: float = ui_scale_y;
    if (scale < 0.0001) scale = 0.0001;
    let rel: float = target - ui_cy;
    let guess: int = ui_round(rel / scale);
    let best: int = guess;
    let best_d: int = 100000;
    let k: int = guess - 4;
    let end: int = guess + 4;
    while (k <= end) {
        let s: int = ui_to_screen_y(k);
        let d: int = s - target;
        if (d < 0) d = -d;
        if (d < best_d) { best_d = d; best = k; }
        k = k + 1;
    }
    return best;
}

fn ui_resize_apply(mx: int, my: int) {
    if (resize_active == 0 || resize_slot < 0) return;
    let l: int = resize_fix_l;
    let t: int = resize_fix_t;
    let r: int = resize_fix_r;
    let b: int = resize_fix_b;
    let move_l: int = 0;
    let move_t: int = 0;
    let move_r: int = 0;
    let move_b: int = 0;
    if (resize_handle == 0 || resize_handle == 2 || resize_handle == 7) move_l = 1;
    if (resize_handle == 0 || resize_handle == 1 || resize_handle == 4) move_t = 1;
    if (resize_handle == 1 || resize_handle == 3 || resize_handle == 5) move_r = 1;
    if (resize_handle == 2 || resize_handle == 3 || resize_handle == 6) move_b = 1;
    if (move_l == 1) l = mx;
    if (move_t == 1) t = my;
    if (move_r == 1) r = mx;
    if (move_b == 1) b = my;
    if (ctrl_held()) {
        let ox: int = resize_fix_l;
        let oy: int = resize_fix_t;
        let ow: int = resize_fix_r - resize_fix_l;
        let oh: int = resize_fix_b - resize_fix_t;
        if (ow < 1) ow = 1;
        if (oh < 1) oh = 1;
        let ow_f: float = ow;
        let oh_f: float = oh;
        let dx: float = 0.0;
        let dy: float = 0.0;
        let edge: int = 0;
        let h: int = resize_handle;
        if (h == 5 || h == 7) edge = 1;
        if (h == 4 || h == 6) edge = 2;
        if (h == 0 || h == 7) dx = (ox + ow) - mx;
        else dx = mx - ox;
        if (h == 0 || h == 1 || h == 4) dy = (oy + oh) - my;
        else dy = my - oy;
        let s: float = resize_linear_factor(dx, dy, ow_f, oh_f, edge);
        let nw: int = ui_round(ow_f * s);
        let nh: int = ui_round(oh_f * s);
        if (nw < 4) nw = 4;
        if (nh < 4) nh = 4;
        let cx: float = ox + ow_f / 2.0;
        let cy: float = oy + oh_f / 2.0;
        let nx: int = ox;
        let ny: int = oy;
        if (h == 0) {
            nx = ox + ow - nw;
            ny = oy + oh - nh;
        } else if (h == 1) {
            nx = ox;
            ny = oy + oh - nh;
        } else if (h == 2) {
            nx = ox + ow - nw;
            ny = oy;
        } else if (h == 3) {
            nx = ox;
            ny = oy;
        } else if (h == 4) {
            nx = ui_round(cx - nw / 2.0);
            ny = oy + oh - nh;
        } else if (h == 5) {
            nx = ox;
            ny = ui_round(cy - nh / 2.0);
        } else if (h == 6) {
            nx = ui_round(cx - nw / 2.0);
            ny = oy;
        } else {
            nx = ox + ow - nw;
            ny = ui_round(cy - nh / 2.0);
        }
        l = nx;
        t = ny;
        r = nx + nw;
        b = ny + nh;
        move_l = 1;
        move_t = 1;
    }
    let min_px: int = ui_len_w(8);
    if (min_px < 4) min_px = 4;
    if (r - l < min_px) {
        if (move_l == 1) l = r - min_px;
        else r = l + min_px;
    }
    let min_py: int = ui_len_h(8);
    if (min_py < 4) min_py = 4;
    if (b - t < min_py) {
        if (move_t == 1) t = b - min_py;
        else b = t + min_py;
    }
    let nw: int = ui_len_for_screen(r - l, 0);
    let nh: int = ui_len_for_screen(b - t, 1);
    let nx: int = ui_origin_for_x(l);
    let ny: int = ui_origin_for_y(t);
    if (resize_recorded == 0) {
        undo_save_modify(resize_slot);
        resize_recorded = 1;
    }
    let old_x: int = ent_x(resize_slot);
    let old_y: int = ent_y(resize_slot);
    if (move_l == 1) ent_set_x(resize_slot, nx);
    if (move_t == 1) ent_set_y(resize_slot, ny);
    ent_set_w(resize_slot, nw);
    ent_set_h(resize_slot, nh);
    /* Dragging the top or left moves the box origin. Shift the glyph
       anchor the other way so the words stay on the same pixels. */
    if (ent_kind(resize_slot) != "sprite2d") {
        let dx: int = ent_x(resize_slot) - old_x;
        let dy: int = ent_y(resize_slot) - old_y;
        if (dx != 0) ent_set_font_ox(resize_slot, ent_font_ox(resize_slot) - dx);
        if (dy != 0) ent_set_font_oy(resize_slot, ent_font_oy(resize_slot) - dy);
    }
}

fn game_view_draw_letterbox() {
    let v: Rect = viewport_rect();
    let gv: Rect = game_view_rect();
    if (gv.x == v.x && gv.y == v.y && gv.w == v.w && gv.h == v.h) return;
    let dim: Color = rgb(18, 19, 22);
    if (gv.y > v.y) draw_fill_rect(rect(v.x, v.y, v.w, gv.y - v.y), dim);
    if (gv.y + gv.h < v.y + v.h) draw_fill_rect(rect(v.x, gv.y + gv.h, v.w, v.y + v.h - (gv.y + gv.h)), dim);
    if (gv.x > v.x) draw_fill_rect(rect(v.x, gv.y, gv.x - v.x, gv.h), dim);
    if (gv.x + gv.w < v.x + v.w) draw_fill_rect(rect(gv.x + gv.w, gv.y, v.x + v.w - (gv.x + gv.w), gv.h), dim);
}

fn ui_viewport_draw_background() {
    let v: Rect = viewport_rect();
    eng_set_clip(v.x, v.y, v.w, v.h);
    draw_fill_rect(v, col_viewport());
    game_view_draw_letterbox();
    let c: Rect = ui_canvas_area();
    draw_fill_rect(c, rgb(40, 43, 50));
    if (pref_int("show_grid", 1) == 1) {
        eng_set_clip(c.x, c.y, c.w, c.h);
        let step: int = pref_int("grid", 32);
        if (step < 1) step = 1;
        let line_c: Color = rgb(52, 56, 64);
        let gx: int = 0;
        while (gx <= UI_CANVAS_W) {
            let sx: int = ui_to_screen_x(gx);
            eng_line(sx, c.y, sx, c.y + c.h, line_c.r, line_c.g, line_c.b);
            gx = gx + step;
        }
        let gy: int = 0;
        while (gy <= UI_CANVAS_H) {
            let sy: int = ui_to_screen_y(gy);
            eng_line(c.x, sy, c.x + c.w, sy, line_c.r, line_c.g, line_c.b);
            gy = gy + step;
        }
        eng_clear_clip();
    }
    draw_outline_rect(c, 1, col_ui_border());
    eng_clear_clip();
}

fn ui_viewport_draw_entities() {
    let v: Rect = viewport_rect();
    eng_set_clip(v.x, v.y, v.w, v.h);
    let i: int = ent_next_by_depth(-1);
    while (i >= 0) {
        if (ent_is_ui(i) == 0 || ent_shown(i) == 0) {
            i = ent_next_by_depth(i);
            continue;
        }
        let sx: int = ui_to_screen_x(ent_x(i));
        let sy: int = ui_to_screen_y(ent_y(i));
        let sw: int = ui_len_w(ent_w(i));
        let sh: int = ui_len_h(ent_h(i));
        draw_entity_body(i, sx, sy, sw, sh);
        let sc: string = ent_script(i);
        if (sc.len() > 0 && sw > 12) {
            let dot: Rect = rect(sx + sw - 8, sy + 2, 6, 6);
            draw_fill_rect(dot, col_play());
        }
        i = ent_next_by_depth(i);
    }
    eng_clear_clip();
}

fn ui_viewport_draw_selection() {
    let v: Rect = viewport_rect();
    eng_set_clip(v.x, v.y, v.w, v.h);
    let i: int = sel_first();
    while (i >= 0) {
        if (ent_is_ui(i) == 0) {
            i = sel_iter_next(i + 1);
            continue;
        }
        let inset: Rect = ui_sel_inset_screen(i);
        if (edit_tool == "rotate") {
            draw_outline_rect(inset, 1, col_accent());
            let px: int = ui_ent_pivot_screen_x(i);
            let py: int = ui_ent_pivot_screen_y(i);
            let ac: Color = col_accent();
            let rad: int = 28;
            draw_outline_rect(rect(px - rad, py - rad, rad * 2, rad * 2), 1, ac);
        } else if (edit_tool == "scale") {
            draw_outline_rect(inset, 2, col_accent());
            draw_resize_handles(inset, col_accent());
        } else if (edit_tool == "move") {
            draw_outline_rect(inset, 2, col_accent());
            draw_move_gizmo_at(ui_ent_pivot_screen_x(i), ui_ent_pivot_screen_y(i), gizmo_rot(i));
        } else {
            let sx: int = ui_to_screen_x(ent_x(i));
            let sy: int = ui_to_screen_y(ent_y(i));
            ui_selected_outline(i, sx, sy, ui_len_w(ent_w(i)), ui_len_h(ent_h(i)));
        }
        i = sel_iter_next(i + 1);
    }
    eng_clear_clip();
}

fn ui_viewport_draw_overlay_info() {
    let v: Rect = viewport_rect();
    let c: Rect = ui_canvas_area();
    th_font(11);
    /* resolution tag in the margin above the canvas — never on the canvas itself */
    let cap: string = "UI Canvas  " + UI_CANVAS_W + " x " + UI_CANVAS_H;
    let cap_w: int = eng_text_width(cap);
    let cap_x: int = c.x + (c.w - cap_w) / 2;
    let cap_y: int = c.y - 17;
    if (cap_y >= v.y + 2) draw_text(cap_x, cap_y, cap, col_text_dim());
    /* tool hints in the margin below the canvas */
    let by: int = c.y + c.h + 6;
    if (by + 38 > v.y + v.h - 4) by = v.y + v.h - 42;
    let tool_line: string = tool_display_name() + " tool  (" + tool_shortcut_key() + ")";
    let help: string = tool_help_text();
    let hw: int = eng_text_width(help);
    th_font_semi(12);
    let tw: int = eng_text_width(tool_line);
    if (hw > tw) tw = hw;
    viewport_hud_card(v.x + 8, by, tw + 20, 38);
    draw_text(v.x + 18, by + 4, tool_line, col_text_main());
    th_font(11);
    draw_text(v.x + 18, by + 20, help, col_text_dim());
    th_font(14);
}

fn ui_viewport_draw() {
    ui_canvas_layout_update();
    ui_viewport_draw_background();
    ui_viewport_draw_entities();
    ui_viewport_draw_selection();
    viewport_draw_box_select();
    ui_viewport_draw_overlay_info();
}

/* A ring just outside a GUI element, so a hierarchy click shows which one it is. */
fn ui_selected_outline(slot: int, sx: int, sy: int, sw: int, sh: int) {
    if (ent_selected(slot) == 0) return;
    let ac: Color = col_accent();
    let base: float = 10.0;
    if (ui_ent_is_button(slot) == 1) base = 6.0;
    if (ent_kind(slot) == "label" || ent_kind(slot) == "ui_label") base = 3.0;
    let rad: int = base * ui_scale_y;
    if (rad < 2) rad = 2;
    let pad: int = 3;
    eng_outline_round_a(sx - pad, sy - pad, sw + pad * 2, sh + pad * 2, rad + pad, 2, ac.r, ac.g, ac.b, 255);
}

/* World entity for 3D gizmos: nearest selected non-UI to the camera (skips UI). */
fn sel_view3d_slot(): int {
    let best: int = -1;
    let best_d: float = 1000000000.0;
    let s: int = sel_first();
    while (s >= 0) {
        if (ent_is_ui(s) == 0 && ent_shown(s) == 1) {
            let dx: float = orb_eye_x() - v3_center_x(s);
            let dy: float = orb_eye_y() - v3_center_y(s);
            let dz: float = orb_eye_z() - v3_center_z(s);
            let d: float = dx * dx + dy * dy + dz * dz;
            if (d < best_d) {
                best_d = d;
                best = s;
            }
        }
        s = sel_iter_next(s + 1);
    }
    return best;
}

/* Keep a widget's box on the picture. A full-canvas panel's outline sits on the
   clip edge and would otherwise disappear. */
fn ui_box_on_game(sx: int, sy: int, sw: int, sh: int): Rect {
    let gv: Rect = game_view_rect();
    let x: int = sx;
    let y: int = sy;
    let r: int = sx + sw;
    let b: int = sy + sh;
    if (x < gv.x + 2) x = gv.x + 2;
    if (y < gv.y + 2) y = gv.y + 2;
    if (r > gv.x + gv.w - 2) r = gv.x + gv.w - 2;
    if (b > gv.y + gv.h - 2) b = gv.y + gv.h - 2;
    if (r < x + 4) r = x + 4;
    if (b < y + 4) b = y + 4;
    return rect(x, y, r - x, b - y);
}

fn viewport_draw_ui_overlay() {
    let gv: Rect = game_view_rect();
    ui_canvas_layout_game_view(gv);
    eng_set_clip(gv.x, gv.y, gv.w, gv.h);
    let i: int = ent_next_by_depth(-1);
    while (i >= 0) {
        if (ent_is_ui(i) == 0 || ent_shown(i) == 0) {
            i = ent_next_by_depth(i);
            continue;
        }
        let sx: int = ui_to_screen_x(ent_x(i));
        let sy: int = ui_to_screen_y(ent_y(i));
        let sw: int = ui_len_w(ent_w(i));
        let sh: int = ui_len_h(ent_h(i));
        draw_entity_body(i, sx, sy, sw, sh);
        i = ent_next_by_depth(i);
    }
    eng_clear_clip();
    if (app_state == "play") return;
    i = ent_iter_next(0);
    while (i >= 0) {
        if (ent_is_ui(i) == 0 || ent_shown(i) == 0) {
            i = ent_iter_next(i + 1);
            continue;
        }
        let sx: int = ui_to_screen_x(ent_x(i));
        let sy: int = ui_to_screen_y(ent_y(i));
        if (ent_selected(i) == 0) {
            i = ent_iter_next(i + 1);
            continue;
        }
        let box: Rect = ui_box_on_game(sx, sy, ui_len_w(ent_w(i)), ui_len_h(ent_h(i)));
        if (edit_tool == "rotate") {
            draw_outline_rect(box, 2, col_accent());
            let px: int = ui_ent_pivot_screen_x(i);
            let py: int = ui_ent_pivot_screen_y(i);
            let ac: Color = col_accent();
            let rad: int = 28;
            draw_outline_rect(rect(px - rad, py - rad, rad * 2, rad * 2), 1, ac);
        } else if (edit_tool == "scale") {
            draw_outline_rect(box, 2, col_accent());
            draw_resize_handles(box, col_accent());
        } else if (edit_tool == "move") {
            draw_outline_rect(box, 2, col_accent());
            draw_move_gizmo_at(ui_ent_pivot_screen_x(i), ui_ent_pivot_screen_y(i), gizmo_rot(i));
        } else {
            draw_outline_rect(box, 2, col_accent());
        }
        i = ent_iter_next(i + 1);
    }
}

fn ui_viewport_input() {
    ui_canvas_layout_update();
    let v: Rect = viewport_rect();
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let inside: bool = point_in_rect(mx, my, v);

    if (mouse_released(MOUSE_LEFT)) {
        if (resize_active == 1 || rotate_active == 1 || scale_uniform_active == 1) {
            last_inspector_slot = -1;
        }
        drag_active = 0;
        drag_recorded = 0;
        move_axis = 0;
        resize_active = 0;
        resize_slot = -1;
        resize_recorded = 0;
        rotate_active = 0;
        rotate_slot = -1;
        rotate_recorded = 0;
        scale_uniform_active = 0;
        scale_uniform_slot = -1;
        scale_recorded = 0;
    }

    if (inside && mouse_pressed(MOUSE_RIGHT)) {
        let hit: int = ui_viewport_hit_at(mx, my);
        if (hit >= 0) {
            if (ent_selected(hit) == 0) { sel_clear(); ent_set_selected(hit, 1); }
        }
        context_menu_open(mx, my);
        return;
    }
    if (context_menu_active == 1) return;

    if (edit_tool == "scale" && inside && mouse_pressed(MOUSE_LEFT) &&
        drag_active == 0 && box_select_active == 0 && rotate_active == 0 &&
        scale_uniform_active == 0 && resize_active == 0) {
        let rh: int = ui_resize_handle_at(mx, my);
        if (rh >= 0 && resize_slot >= 0) {
            resize_begin(resize_slot, rh);
            return;
        }
    }

    if (edit_tool != "hand" && inside && mouse_pressed(MOUSE_LEFT) &&
        drag_active == 0 && box_select_active == 0 && resize_active == 0 &&
        rotate_active == 0 && scale_uniform_active == 0) {
        if (edit_tool == "move") {
            let gizmo_axis: int = ui_move_gizmo_pick_selection(mx, my);
            if (gizmo_axis != 0) {
                move_axis = gizmo_axis;
                if (move_axis == 3) move_axis = 0;
                drag_active = 1;
                drag_anchor_x = mx;
                drag_anchor_y = my;
                drag_recorded = 0;
                return;
            }
        }
        let hit: int = ui_viewport_hit_at(mx, my);
        if (hit >= 0) {
            if (ctrl_held()) {
                if (ent_selected(hit) == 1) ent_set_selected(hit, 0);
                else                        ent_set_selected(hit, 1);
            } else {
            if (shift_held() == false && ent_selected(hit) == 0) sel_clear();
            ent_set_selected(hit, 1);
            if (edit_tool == "move") {
                move_axis = 0;
                drag_active = 1;
                drag_anchor_x = mx;
                drag_anchor_y = my;
                drag_recorded = 0;
            }
            }
        } else if (edit_tool == "move" && shift_held() == false && ctrl_held() == false && sel_pick_at(mx, my) >= 0) {
            move_axis = 0;
            drag_active = 1;
            drag_anchor_x = mx;
            drag_anchor_y = my;
            drag_recorded = 0;
        } else if (edit_tool != "rotate") {
            if (shift_held() == false && ctrl_held() == false) sel_clear();
            box_select_active = 1;
            box_select_x0 = mx;
            box_select_y0 = my;
        }
    }

    if (resize_active == 1 && mouse_down(MOUSE_LEFT)) {
        ui_resize_apply(mx, my);
        return;
    }
    if (scale_uniform_active == 1 && mouse_down(MOUSE_LEFT)) {
        scale_apply_uniform_ui(mx, my);
        return;
    }

    if (drag_active == 1 && mouse_down(MOUSE_LEFT) && edit_tool == "move") {
        let dx_screen: int = mx - drag_anchor_x;
        let dy_screen: int = my - drag_anchor_y;
        if (dx_screen != 0 || dy_screen != 0) {
            if (drag_recorded == 0) {
                undo_begin_group();
                let s: int = sel_first();
                while (s >= 0) {
                    if (ent_is_ui(s) == 1) undo_save_modify_tree(s);
                    s = sel_iter_next(s + 1);
                }
                undo_end_group();
                let origin: int = sel_ui_move_root();
                if (origin >= 0) {
                    move_from_x = ent_x(origin);
                    move_from_y = ent_y(origin);
                }
                drag_recorded = 1;
            }
            let uroot: int = sel_ui_move_root();
            if (uroot >= 0) {
                let dxf: float = dx_screen;
                let dyf: float = dy_screen;
                let dx: int = ui_round(dxf / ui_scale_x);
                let dy: int = ui_round(dyf / ui_scale_y);
                move_along(dx, dy, move_axis, uroot);
                let tx: int = drag_snap_target(move_from_x, move_out_x);
                let ty: int = drag_snap_target(move_from_y, move_out_y);
                let adx: int = tx - ent_x(uroot);
                let ady: int = ty - ent_y(uroot);
                if (adx != 0 || ady != 0) {
                    let s2: int = sel_first();
                    while (s2 >= 0) {
                        if (ent_is_ui(s2) == 1 && sel_is_carried(s2) == 0) {
                            if (adx != 0) ent_set_x(s2, ent_x(s2) + adx);
                            if (ady != 0) ent_set_y(s2, ent_y(s2) + ady);
                        }
                        s2 = sel_iter_next(s2 + 1);
                    }
                }
            }
        }
    }

    if (box_select_active == 1 && mouse_released(MOUSE_LEFT)) {
        let x0: int = box_select_x0;
        let y0: int = box_select_y0;
        let x1: int = mx;
        let y1: int = my;
        if (x1 < x0) { let t: int = x0; x0 = x1; x1 = t; }
        if (y1 < y0) { let t: int = y0; y0 = y1; y1 = t; }
        let ux0: float = screen_to_ui_x(x0);
        let uy0: float = screen_to_ui_y(y0);
        let ux1: float = screen_to_ui_x(x1);
        let uy1: float = screen_to_ui_y(y1);
        let i: int = ent_iter_next(0);
        while (i >= 0) {
            if (ent_is_ui(i) == 1) {
                let ex0: int = ent_x(i);
                let ey0: int = ent_y(i);
                let ex1: int = ex0 + ent_w(i);
                let ey1: int = ey0 + ent_h(i);
                let overlap: int = 1;
                if (ex1 < ux0) overlap = 0;
                if (ex0 > ux1) overlap = 0;
                if (ey1 < uy0) overlap = 0;
                if (ey0 > uy1) overlap = 0;
                if (overlap == 1) ent_set_selected(i, 1);
            }
            i = ent_iter_next(i + 1);
        }
        box_select_active = 0;
    }
}

fn scale_begin_uniform_ui(slot: int, mx: int, my: int) {
    scale_axis = 0;
    scale_uniform_active = 1;
    scale_uniform_slot = slot;
    scale_recorded = 0;
    scale_start_w = ent_w(slot);
    scale_start_h = ent_h(slot);
    scale_start_x = ent_x(slot);
    scale_start_y = ent_y(slot);
    scale_pivot_wx = ent_x(slot) + scale_start_w / 2.0;
    scale_pivot_wy = ent_y(slot) + scale_start_h / 2.0;
    let mxu: float = screen_to_ui_x(mx);
    let myu: float = screen_to_ui_y(my);
    scale_start_dist = dist_world(scale_pivot_wx, scale_pivot_wy, mxu, myu);
    if (scale_start_dist < 4.0) scale_start_dist = 4.0;
}

fn scale_apply_uniform_ui(mx: int, my: int) {
    if (scale_uniform_active == 0 || scale_uniform_slot < 0) return;
    let mxu: float = screen_to_ui_x(mx);
    let myu: float = screen_to_ui_y(my);
    let dist: float = dist_world(scale_pivot_wx, scale_pivot_wy, mxu, myu);
    if (dist < 4.0) dist = 4.0;
    let factor: float = dist / scale_start_dist;
    if (scale_axis == 1 || scale_axis == 2) factor = scale_factor_axis(mx, my);
    let nw_f: float = scale_start_w * factor;
    let nh_f: float = scale_start_h * factor;
    if (ctrl_held() == false && scale_axis == 1) nh_f = scale_start_h;
    if (ctrl_held() == false && scale_axis == 2) nw_f = scale_start_w;
    let nw: int = ui_round(nw_f);
    let nh: int = ui_round(nh_f);
    if (nw < 4) nw = 4;
    if (nh < 4) nh = 4;
    if (scale_recorded == 0) {
        undo_save_modify(scale_uniform_slot);
        scale_recorded = 1;
    }
    let nx_f: float = scale_pivot_wx - nw / 2.0;
    let ny_f: float = scale_pivot_wy - nh / 2.0;
    ent_set_x(scale_uniform_slot, ui_round(nx_f));
    ent_set_y(scale_uniform_slot, ui_round(ny_f));
    ent_set_w(scale_uniform_slot, nw);
    ent_set_h(scale_uniform_slot, nh);
}

fn apply_engine_view() {
    let clip: Rect = viewport_rect();
    if (viewport_mode == "play") clip = game_view_rect();
    eng_view_set(cam_x, cam_y, cam_zoom, clip.x, clip.y, clip.w, clip.h);
}

fn viewport_draw_tilemap() {
    if (tilemap_active() == 0) return;
    let clip: Rect = viewport_rect();
    if (viewport_mode == "play") clip = game_view_rect();
    eng_set_clip(clip.x, clip.y, clip.w, clip.h);
    let fill_sky: int = 0;
    if (viewport_mode == "play") fill_sky = 1;
    tilemap_draw(fill_sky);
    eng_clear_clip();
}

// =============================================================================
// 3D view: scenes set to Rendering 3D are shown (edit and play) through
// engine.dll's software renderer (host/render3d.inl), which follows
// EyescirePlayer3D's shapes and camera. "2D layout" switches back to the flat
// editor for precise x/y work.
// =============================================================================

let V3_UNIT: float = 0.03125;      /* world units per scene px, as in the 3D player */
let view3d_flat: int = 0;          /* 1 = 2D layout instead of the 3D view */
let orb_yaw: float = 0.0;          /* degrees about +y; 0 looks straight into the screen */
let orb_pitch: float = 0.0;        /* degrees; + looks down */
let orb_dist: float = 30.0;        /* eye to target, world units */
let orb_tx: float = 0.0;
let orb_ty: float = 0.0;
let orb_tz: float = 0.0;
let orb_scene: string = "";        /* scene the view was last framed for */
let orb_mode: int = 0;             /* 0 idle, 1 look, 2 pan, 3 free move, 5 orbit, 6 arrow move, 7 rotate, 8 axis scale, 9 uniform scale */
let orb_moved: int = 0;
let orb_ax: int = 0;
let orb_ay: int = 0;
let orb_s_yaw: float = 0.0;
let orb_s_pitch: float = 0.0;
let orb_s_tx: float = 0.0;
let orb_s_ty: float = 0.0;
let orb_s_tz: float = 0.0;
let orb_s_ex: float = 0.0;         /* eye when a look-around started (flying moves it) */
let orb_s_ey: float = 0.0;
let orb_s_ez: float = 0.0;
let orb_look_px: int = 0;          /* mouse travel this look; a still right-click opens the menu */
let orb_fly_speed: float = 10.0;   /* world units / s; the wheel changes it while looking */
let orb_fly_time: float = 0.0;     /* how long a fly key has been held (speed eases in) */
let mv3_per: float = 1.0;          /* scene px per screen px for the grabbed entity */
let mv3_done_x: int = 0;          /* offset already applied since the grab */
let mv3_done_y: int = 0;
let mv3_done_z: int = 0;
let mv3_cx: float = 0.0;           /* scene-px center when the move drag started */
let mv3_cy: float = 0.0;
let mv3_cz: float = 0.0;
let hit_x: float = 0.0;            /* where the mouse ray meets the drag plane or axis */
let hit_y: float = 0.0;
let hit_z: float = 0.0;
let mv3_gx: float = 0.0;           /* that point when the drag actually started */
let mv3_gy: float = 0.0;
let mv3_gz: float = 0.0;
let mv3_gt: float = 0.0;           /* axis parameter at the grab */
let mv3_grabbed: int = 0;
let mv3_ref_slot: int = -1;        /* entity under the cursor when the move began */
let axis_ok: int = 0;
let ray_ox: float = 0.0;           /* mouse ray in scene px, direction per world unit */
let ray_oy: float = 0.0;
let ray_oz: float = 0.0;
let ray_dx: float = 0.0;
let ray_dy: float = 0.0;
let ray_dz: float = 0.0;
let ring_wx: float = 0.0;          /* last ring point, world units */
let ring_wy: float = 0.0;
let ring_wz: float = 0.0;
let mv3_started: int = 0;          /* the press has turned into a drag (moved 4 px) */
let mv3_axis: int = 0;             /* arrow being dragged: 1 x, 2 y, 3 z */
/* move gizmo (view3d_draw_gizmo) */
let gz_on: int = 0;                 /* drawn this frame */
let gz_ox: int = 0;                 /* pivot on screen */
let gz_oy: int = 0;
let gz_x1 = [0, 0, 0];              /* arrow tips on screen, by axis */
let gz_y1 = [0, 0, 0];
let gz_ok = [0, 0, 0];
let gz_len: float = 1.0;            /* arrow length in world units */
let gz_sx: float = 0.0;             /* the grabbed arrow on screen (px), set at the grab */
let gz_sy: float = 0.0;
let mv3_recorded: int = 0;
let rt3_grab: float = 0.0;          /* cursor angle when a 3D rotate drag started */
let rt3_applied: int = 0;           /* degrees already applied this drag */
let rt3_axis: int = 3;              /* ring being turned: 1 x, 2 y, 3 z */
let rt3_base: int = 0;              /* camera angle when this drag started */
let sc3_axis: int = 0;              /* 0 uniform, 1 x, 2 y, 3 z */
let sc3_dist_grab: float = 16.0;
let sc3_px: int = 0;                /* screen center frozen when the scale drag started */
let sc3_py: int = 0;
/* game camera, filled by gamecam_compute */
let gc_ex: float = 0.0;
let gc_ey: float = 0.0;
let gc_ez: float = 0.0;
let gc_tx: float = 0.0;
let gc_ty: float = 0.0;
let gc_tz: float = 0.0;

fn m3_sin(deg: float): float { let r: float = 0.0; inline_cpp! { r = sin(deg * 0.017453292519943); } return r; }
fn m3_cos(deg: float): float { let r: float = 0.0; inline_cpp! { r = cos(deg * 0.017453292519943); } return r; }
fn m3_tan(deg: float): float { let r: float = 0.0; inline_cpp! { r = tan(deg * 0.017453292519943); } return r; }

fn view3d_active(): int {
    if (scene_render3d() == 0) return 0;
    if (view3d_flat == 1) return 0;
    if (viewport_mode != "scene") return 0;
    return 1;
}

/* entities that become meshes (not UI, empties or cameras) */
fn ent_is_mesh3d(slot: int): int {
    if (ent_is_empty(slot) == 1) return 0;
    if (ent_is_ui(slot) == 1) return 0;
    if (ent_is_camera_ent(slot) == 1) return 0;
    if (ent_is_light(slot) == 1) return 0;
    if (ent_kind(slot) == "emitter") return 0;
    return 1;
}

fn cam_signed(d: int): int {
    if (d > 180) return d - 360;
    return d;
}

/* Where this camera sits and where it looks. Same rules as player3d.nxa's
   setup_camera. Writes gc_t* (look-at) and gc_e* (eye). */
fn camera_place(slot: int, aspect: float) {
    let cw: float = ent_w(slot);
    let ch: float = ent_h(slot);
    if (cw < 4.0) cw = 4.0;
    if (ch < 4.0) ch = 4.0;
    if (ent_text(slot) == "look") {
        let ex: float = ent_x(slot) + cw / 2.0;
        let ey: float = ent_y(slot) + ch / 2.0;
        let ez: float = ent_z(slot) + ent_depth(slot) / 2.0;
        let pitch: float = ent_look_pitch(slot);
        if (pitch > 89.0) pitch = 89.0;
        if (pitch < -89.0) pitch = -89.0;
        let yaw: float = ent_look_yaw(slot);
        let lx: float = m3_cos(pitch) * m3_cos(yaw);
        let ly: float = 0.0 - m3_sin(pitch);
        let lz: float = m3_cos(pitch) * m3_sin(yaw);
        let reach: float = 400.0;
        ex = ex + lx * 42.0;
        ey = ey + ly * 42.0;
        ez = ez + lz * 42.0;
        gc_ex = ex * V3_UNIT;
        gc_ey = 0.0 - ey * V3_UNIT;
        gc_ez = 0.0 - ez * V3_UNIT;
        gc_tx = (ex + lx * reach) * V3_UNIT;
        gc_ty = 0.0 - (ey + ly * reach) * V3_UNIT;
        gc_tz = 0.0 - (ez + lz * reach) * V3_UNIT;
        return;
    }
    let cx: float = ent_x(slot) + cw / 2.0;
    let cy: float = ent_y(slot) + ch / 2.0;
    let cz: float = ent_z(slot);
    let tilt: int = cam_signed(ent_rot(slot));
    if (tilt > 80) tilt = 80;
    if (tilt < -80) tilt = -80;
    let turn: int = ent_rot_y(slot);
    let tf: float = m3_tan(scene_fov() * 0.5);
    let dist: float = (ch * 0.5 * V3_UNIT) / tf;
    let dist_w: float = (cw * 0.5 * V3_UNIT) / (tf * aspect);
    if (dist_w > dist) dist = dist_w;
    gc_tx = cx * V3_UNIT;
    gc_ty = 0.0 - cy * V3_UNIT;
    gc_tz = 0.0 - cz * V3_UNIT;
    let cosp: float = m3_cos(tilt);
    gc_ex = gc_tx + m3_sin(turn) * cosp * dist;
    gc_ey = gc_ty + m3_sin(tilt) * dist;
    gc_ez = gc_tz + m3_cos(turn) * cosp * dist;
}

/* The main camera frames its rect at its z; rotation tilts it (player3d.nxa's setup_camera). */
fn gamecam_compute(aspect: float) {
    let cam: int = ent_find_main_camera();
    if (cam >= 0) {
        camera_place(cam, aspect);
        return;
    }
    let cx: float = 640.0;
    let cy: float = 360.0;
    let cw: float = 1280.0;
    let ch: float = 720.0;
    let cz: float = 0.0;
    let t: float = m3_tan(scene_fov() * 0.5);
    let dist: float = (ch * 0.5 * V3_UNIT) / t;
    let dist_w: float = (cw * 0.5 * V3_UNIT) / (t * aspect);
    if (dist_w > dist) dist = dist_w;
    gc_tx = cx * V3_UNIT;
    gc_ty = 0.0 - cy * V3_UNIT;
    gc_tz = 0.0 - cz * V3_UNIT;
    gc_ex = gc_tx;
    gc_ey = gc_ty;
    gc_ez = gc_tz + dist;
}

fn orb_eye_x(): float { return orb_tx + orb_dist * m3_sin(orb_yaw) * m3_cos(orb_pitch); }
fn orb_eye_y(): float { return orb_ty + orb_dist * m3_sin(orb_pitch); }
fn orb_eye_z(): float { return orb_tz + orb_dist * m3_cos(orb_yaw) * m3_cos(orb_pitch); }

/* Frame the selection (or the whole scene) from a three-quarter view. */
fn view3d_frame(use_sel: int) {
    let any: int = 0;
    let x0: float = 0.0;
    let y0: float = 0.0;
    let z0: float = 0.0;
    let x1: float = 0.0;
    let y1: float = 0.0;
    let z1: float = 0.0;
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        let take: int = ent_is_mesh3d(i);
        if (ent_shown(i) == 0 && ent_selected(i) == 0) take = 0;
        if (use_sel == 1 && ent_selected(i) == 0) take = 0;
        if (take == 1) {
            let ax: float = ent_x(i);
            let ay: float = ent_y(i);
            let az: float = ent_z(i);
            let bx: float = ax + ent_w(i);
            let by: float = ay + ent_h(i);
            let bz: float = az + ent_depth3d(i);
            if (any == 0 || ax < x0) x0 = ax;
            if (any == 0 || ay < y0) y0 = ay;
            if (any == 0 || az < z0) z0 = az;
            if (any == 0 || bx > x1) x1 = bx;
            if (any == 0 || by > y1) y1 = by;
            if (any == 0 || bz > z1) z1 = bz;
            any = 1;
        }
        i = ent_iter_next(i + 1);
    }
    if (any == 0) {
        if (use_sel == 1) { view3d_frame(0); return; }
        x0 = 0.0; y0 = 0.0; z0 = 0.0; x1 = 1280.0; y1 = 720.0; z1 = 64.0;
    }
    orb_tx = (x0 + x1) * 0.5 * V3_UNIT;
    orb_ty = 0.0 - (y0 + y1) * 0.5 * V3_UNIT;
    orb_tz = 0.0 - (z0 + z1) * 0.5 * V3_UNIT;
    let ext: float = x1 - x0;
    if (y1 - y0 > ext) ext = y1 - y0;
    if (z1 - z0 > ext) ext = z1 - z0;
    if (ext < 64.0) ext = 64.0;
    orb_dist = ext * V3_UNIT * 0.62 / m3_tan(scene_fov() * 0.5) + 2.0;
    orb_yaw = 28.0;
    orb_pitch = 18.0;
}

fn view3d_sync_scene() {
    let key: string = proj_root() + "|" + proj_active_scene();
    if (orb_scene != key) {
        orb_scene = key;
        view3d_frame(0);
    }
}

fn view3d_toggle_rect(): Rect {
    let t: Rect = viewport_tabs_rect();
    return rect(t.x + t.w - 118, t.y + 2, 110, t.h - 4);
}

/* Right side of the scene tab bar. Switches between the 3D view and the 2D layout. */
fn view3d_toggle_draw() {
    if (scene_render3d() == 0 || viewport_mode != "scene") return;
    let label: string = "2D layout";
    if (view3d_flat == 1) label = "3D view";
    th_font(12);
    let st: int = mouse_hover_held(view3d_toggle_rect());
    let hover: int = 0;
    let held: int = 0;
    if (st >= 1) hover = 1;
    if (st == 2) held = 1;
    th_button(view3d_toggle_rect(), label, "secondary", hover, held);
    if (hover == 1) tooltip_request("Switch between the 3D view and the flat x/y layout", view3d_toggle_rect());
    th_font(14);
}

/* 1 when this frame's left click was on the toggle (and it was handled) */
fn view3d_toggle_input(): int {
    if (scene_render3d() == 0 || viewport_mode != "scene") return 0;
    if (mouse_pressed(MOUSE_LEFT) == false) return 0;
    if (point_in_rect(eng_mouse_x(), eng_mouse_y(), view3d_toggle_rect()) == false) return 0;
    if (view3d_flat == 1) view3d_flat = 0;
    else                  view3d_flat = 1;
    return 1;
}

fn view3d_draw_meshes(show_cameras: int) {
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        if (ent_is_mesh3d(i) == 1 && ent_shown(i) == 1) r3d_entity(i);
        i = ent_iter_next(i + 1);
    }
    if (show_cameras == 0) return;
    /* every camera, not only the one flagged for play: the framed rect,
       lines back to the eye, and a body at the same point as the move gizmo */
    let c: int = ent_iter_next(0);
    while (c >= 0) {
        if (ent_is_camera_ent(c) == 1 && ent_shown(c) == 1) {
            camera_place(c, 1280.0 / 720.0);
            let col: Color = camera_gizmo_color(c);
            let a: int = 170;
            if (ent_selected(c) == 1) a = 255;
            if (ent_text(c) == "look") {
                r3d_line(gc_ex, gc_ey, gc_ez, gc_tx, gc_ty, gc_tz, col.r, col.g, col.b, a);
            } else {
                let fx0: float = ent_x(c) * V3_UNIT;
                let fy0: float = 0.0 - ent_y(c) * V3_UNIT;
                let fx1: float = (ent_x(c) + ent_w(c)) * V3_UNIT;
                let fy1: float = 0.0 - (ent_y(c) + ent_h(c)) * V3_UNIT;
                let fz: float = 0.0 - ent_z(c) * V3_UNIT;
                r3d_line(fx0, fy0, fz, fx1, fy0, fz, col.r, col.g, col.b, a);
                r3d_line(fx1, fy0, fz, fx1, fy1, fz, col.r, col.g, col.b, a);
                r3d_line(fx1, fy1, fz, fx0, fy1, fz, col.r, col.g, col.b, a);
                r3d_line(fx0, fy1, fz, fx0, fy0, fz, col.r, col.g, col.b, a);
                r3d_line(gc_ex, gc_ey, gc_ez, fx0, fy0, fz, col.r, col.g, col.b, a);
                r3d_line(gc_ex, gc_ey, gc_ez, fx1, fy0, fz, col.r, col.g, col.b, a);
                r3d_line(gc_ex, gc_ey, gc_ez, fx1, fy1, fz, col.r, col.g, col.b, a);
                r3d_line(gc_ex, gc_ey, gc_ez, fx0, fy1, fz, col.r, col.g, col.b, a);
            }
            view3d_draw_camera_body(c, col, a);
        }
        c = ent_iter_next(c + 1);
    }
}

/* Wire camera at the eye: a box a couple of world units across, so it sits
   next to the move gizmo instead of only existing as a full-view frame. */
fn view3d_draw_camera_body(slot: int, col: Color, a: int) {
    let x: float = gc_ex;
    let y: float = gc_ey;
    let z: float = gc_ez;
    let hw: float = 0.7;
    let hh: float = 0.45;
    let hd: float = 0.4;
    let x0: float = x - hw;
    let x1: float = x + hw;
    let y0: float = y - hh;
    let y1: float = y + hh;
    let z0: float = z - hd;
    let z1: float = z + hd;
    r3d_line(x0, y0, z0, x1, y0, z0, col.r, col.g, col.b, a);
    r3d_line(x1, y0, z0, x1, y1, z0, col.r, col.g, col.b, a);
    r3d_line(x1, y1, z0, x0, y1, z0, col.r, col.g, col.b, a);
    r3d_line(x0, y1, z0, x0, y0, z0, col.r, col.g, col.b, a);
    r3d_line(x0, y0, z1, x1, y0, z1, col.r, col.g, col.b, a);
    r3d_line(x1, y0, z1, x1, y1, z1, col.r, col.g, col.b, a);
    r3d_line(x1, y1, z1, x0, y1, z1, col.r, col.g, col.b, a);
    r3d_line(x0, y1, z1, x0, y0, z1, col.r, col.g, col.b, a);
    r3d_line(x0, y0, z0, x0, y0, z1, col.r, col.g, col.b, a);
    r3d_line(x1, y0, z0, x1, y0, z1, col.r, col.g, col.b, a);
    r3d_line(x1, y1, z0, x1, y1, z1, col.r, col.g, col.b, a);
    r3d_line(x0, y1, z0, x0, y1, z1, col.r, col.g, col.b, a);
}

/* floor grid under the lowest mesh, every 64 px */
fn view3d_draw_grid() {
    let floor_y: int = 0;
    let x0: int = 0;
    let x1: int = 1280;
    let z1: int = 256;
    let any: int = 0;
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        if (ent_is_mesh3d(i) == 1 && ent_shown(i) == 1) {
            let b: int = ent_y(i) + ent_h(i);
            if (any == 0 || b > floor_y) floor_y = b;
            if (any == 0 || ent_x(i) < x0) x0 = ent_x(i);
            if (any == 0 || ent_x(i) + ent_w(i) > x1) x1 = ent_x(i) + ent_w(i);
            if (ent_z(i) + ent_depth3d(i) > z1) z1 = ent_z(i) + ent_depth3d(i);
            any = 1;
        }
        i = ent_iter_next(i + 1);
    }
    if (pref_int("show_grid", 1) == 0) return;
    let step: int = pref_int("grid", 32);
    x0 = (x0 / step - 4) * step;
    x1 = (x1 / step + 5) * step;
    let zs: int = 0 - step * 6;
    let ze: int = (z1 / step + 6) * step;
    let wy: float = 0.0 - floor_y * V3_UNIT;
    let gc: Color = col_ui_border();
    let x: int = x0;
    while (x <= x1) {
        r3d_line(x * V3_UNIT, wy, 0.0 - zs * V3_UNIT, x * V3_UNIT, wy, 0.0 - ze * V3_UNIT, gc.r, gc.g, gc.b, 110);
        x = x + step;
    }
    let z: int = zs;
    while (z <= ze) {
        r3d_line(x0 * V3_UNIT, wy, 0.0 - z * V3_UNIT, x1 * V3_UNIT, wy, 0.0 - z * V3_UNIT, gc.r, gc.g, gc.b, 110);
        z = z + step;
    }
}

fn light_wx(slot: int): float { return (ent_x(slot) + ent_w(slot) / 2.0) * V3_UNIT; }
fn light_wy(slot: int): float { return 0.0 - (ent_y(slot) + ent_h(slot) / 2.0) * V3_UNIT; }
fn light_wz(slot: int): float { return 0.0 - ent_z(slot) * V3_UNIT; }

/* the way directional and spot lights shine, as a line in the 3D view */
fn view3d_draw_light_beams() {
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        let k: string = ent_kind(i);
        if ((k == "light_directional" || k == "light_spot") && ent_shown(i) == 1) {
            let len: float = 3.0;
            if (k == "light_spot") len = ent_light_range(i) * V3_UNIT * 0.5;
            let a: int = 150;
            if (ent_selected(i) == 1) a = 255;
            r3d_line(light_wx(i), light_wy(i), light_wz(i),
                     light_wx(i) + light_dir_x(i) * len, light_wy(i) + light_dir_y(i) * len,
                     light_wz(i) + light_dir_z(i) * len, ent_r(i), ent_g(i), ent_b(i), a);
        }
        i = ent_iter_next(i + 1);
    }
}

fn view3d_draw_light_icons() {
    /* The bars beside the 16:9 picture are letterbox, not the scene. A marker
       that lands there floats off the object it belongs to. */
    let v: Rect = game_view_rect();
    eng_set_clip(v.x, v.y, v.w, v.h);
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        if (ent_is_light(i) == 1 && ent_shown(i) == 1) {
            if (r3d_project(light_wx(i), light_wy(i), light_wz(i)) == 1) {
                let px: int = r3d_px();
                let py: int = r3d_py();
                light_icon_draw(i, px, py, 8);
            }
        }
        i = ent_iter_next(i + 1);
    }
    eng_clear_clip();
}

fn view3d_draw_camera_icons() {
    let v: Rect = game_view_rect();
    eng_set_clip(v.x, v.y, v.w, v.h);
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        if (ent_is_camera_ent(i) == 1 && ent_shown(i) == 1) {
            if (r3d_project(v3_center_x(i), v3_center_y(i), v3_center_z(i)) == 1) {
                let px: int = r3d_px();
                let py: int = r3d_py();
                camera_icon_draw(i, px, py);
            }
        }
        i = ent_iter_next(i + 1);
    }
    eng_clear_clip();
}

/* light whose icon is under the mouse in the 3D view, or -1 */
fn view3d_light_at(mx: int, my: int): int {
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        if (ent_is_light(i) == 1 && ent_shown(i) == 1) {
            if (r3d_project(light_wx(i), light_wy(i), light_wz(i)) == 1) {
                let px: int = r3d_px();
                let py: int = r3d_py();
                if (dist_sq(px, py, mx, my) <= 196) return i;
            }
        }
        i = ent_iter_next(i + 1);
    }
    return -1;
}

/* camera whose icon is under the mouse in the 3D view, or -1 */
fn view3d_camera_at(mx: int, my: int): int {
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        if (ent_is_camera_ent(i) == 1 && ent_shown(i) == 1) {
            if (r3d_project(v3_center_x(i), v3_center_y(i), v3_center_z(i)) == 1) {
                let px: int = r3d_px();
                let py: int = r3d_py();
                if (dist_sq(px, py, mx, my) <= 400) return i;
            }
        }
        i = ent_iter_next(i + 1);
    }
    return -1;
}

fn view3d_emitter_at(mx: int, my: int): int {
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        if (ent_kind(i) == "emitter" && ent_shown(i) == 1) {
            if (r3d_project(v3_center_x(i), v3_center_y(i), v3_center_z(i)) == 1) {
                let px: int = r3d_px();
                let py: int = r3d_py();
                if (dist_sq(px, py, mx, my) <= 196) return i;
            }
        }
        i = ent_iter_next(i + 1);
    }
    return -1;
}

/* what a click in the 3D view lands on: a camera or light icon first, then meshes */
fn view3d_sprite_at(mx: int, my: int): int {
    ui_canvas_layout_game_view(game_view_rect());
    let hit: int = -1;
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        if (ent_kind(i) == "sprite2d" && ent_shown(i) == 1) {
            let sx: int = ui_to_screen_x(ent_x(i));
            let sy: int = ui_to_screen_y(ent_y(i));
            let sw: int = ui_len_w(ent_w(i));
            let sh: int = ui_len_h(ent_h(i));
            if (point_in_rect(mx, my, rect(sx, sy, sw, sh))) hit = i;
        }
        i = ent_iter_next(i + 1);
    }
    return hit;
}

fn view3d_pick(mx: int, my: int): int {
    let sp: int = view3d_sprite_at(mx, my);
    if (sp >= 0) return sp;
    let c: int = view3d_camera_at(mx, my);
    if (c >= 0) return c;
    let l: int = view3d_light_at(mx, my);
    if (l >= 0) return l;
    let em: int = view3d_emitter_at(mx, my);
    if (em >= 0) return em;
    return r3d_pick(mx, my);
}

/* Selected entity whose projected center is near the cursor, or -1. */
fn view3d_sel_near(mx: int, my: int): int {
    let best: int = -1;
    let best_d: int = 1600; /* 40 px */
    let s: int = sel_first();
    while (s >= 0) {
        if (r3d_project(v3_center_x(s), v3_center_y(s), v3_center_z(s)) == 1) {
            let px: int = r3d_px();
            let py: int = r3d_py();
            let d: int = dist_sq(mx, my, px, py);
            if (d < best_d) {
                best_d = d;
                best = s;
            }
        }
        s = sel_iter_next(s + 1);
    }
    return best;
}

fn view3d_draw_hitboxes() {
    let i: int = sel_first();
    while (i >= 0) {
        if (ent_shown(i) == 1) r3d_hitbox(i);
        i = sel_iter_next(i + 1);
    }
}

fn viewport3d_submit() {
    view3d_sync_scene();
    /* Same 16:9 frame as the UI canvas and Play, so labels at the canvas
       edge sit on the edge of the picture. */
    let v: Rect = game_view_rect();
    let bg: Color = col_viewport();
    r3d_begin(v.x, v.y, v.w, v.h, orb_eye_x(), orb_eye_y(), orb_eye_z(),
              orb_tx, orb_ty, orb_tz, scene_fov(), scene_clear_r(), scene_clear_g(), scene_clear_b());
    view3d_draw_grid();
    view3d_draw_meshes(1);
    view3d_draw_hitboxes();
    view3d_draw_light_beams();
    view3d_draw_gizmo_heads();
    view3d_draw_rotate_fill();
    view3d_draw_box_fill();
    let ac: Color = col_accent();
    r3d_end(ac.r, ac.g, ac.b);
}

fn viewport3d_overlay() {
    let gv: Rect = game_view_rect();
    game_view_draw_letterbox();
    /* Do NOT fill the game view here. r3d_end already painted the chroma key;
       wiping with another color makes the whole overlay opaque and hides the
       3D picture (and washes out screen-space gizmo shafts). */
    let ac: Color = col_accent();
    view3d_draw_light_icons();
    view3d_draw_camera_icons();
    view3d_draw_gizmo();

    /* empties: a small cross at their center, same point as the move gizmo */
    eng_set_clip(gv.x, gv.y, gv.w, gv.h);
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        if (ent_is_empty(i) == 1 && ent_shown(i) == 1) {
            if (r3d_project(v3_center_x(i), v3_center_y(i), v3_center_z(i)) == 1) {
                let px: int = r3d_px();
                let py: int = r3d_py();
                let c: Color = col_text_dim();
                if (ent_selected(i) == 1) c = ac;
                eng_line(px - 6, py, px + 6, py, c.r, c.g, c.b);
                eng_line(px, py - 6, px, py + 6, c.r, c.g, c.b);
            }
        }
        if (ent_kind(i) == "emitter" && ent_shown(i) == 1 && viewport_mode != "play") {
            if (r3d_project(v3_center_x(i), v3_center_y(i), v3_center_z(i)) == 1) {
                let px: int = r3d_px();
                let py: int = r3d_py();
                let c: Color = col_text_dim();
                if (ent_selected(i) == 1) c = ac;
                eng_line(px - 7, py, px + 7, py, c.r, c.g, c.b);
                eng_line(px, py - 7, px, py + 7, c.r, c.g, c.b);
            }
        }
        i = ent_iter_next(i + 1);
    }
    eng_clear_clip();

    viewport_draw_ui_overlay();
    viewport_draw_box_select();
    view3d_toggle_draw();
    drag_drop_target_hint();
}

fn view3d_undo_record() {
    if (mv3_recorded == 1) return;
    undo_begin_group();
    let s: int = sel_first();
    while (s >= 0) {
        undo_save_modify_tree(s);
        s = sel_iter_next(s + 1);
    }
    undo_end_group();
    mv3_recorded = 1;
}

/* WASD / QE move the camera while the right button is held (Shift: faster).
   Returns 1 when a fly key is down. */
fn view3d_fly(): int {
    let f: float = 0.0;
    let r: float = 0.0;
    let u: float = 0.0;
    if (key_down(VK_W)) f = f + 1.0;
    if (key_down(VK_S)) f = f - 1.0;
    if (key_down(VK_D)) r = r + 1.0;
    if (key_down(VK_A)) r = r - 1.0;
    if (key_down(VK_E)) u = u + 1.0;
    if (key_down(VK_Q)) u = u - 1.0;
    if (f == 0.0 && r == 0.0 && u == 0.0) {
        orb_fly_time = 0.0;
        return 0;
    }
    /* eases in while a key is held, like Unity; Shift is the fast gear */
    orb_fly_time = orb_fly_time + eng_dt_seconds();
    let ease: float = 0.35 + orb_fly_time * 1.6;
    if (ease > 2.5) ease = 2.5;
    let speed: float = orb_fly_speed * ease;
    if (shift_held()) speed = speed * 4.0;
    let step: float = speed * eng_dt_seconds();
    let sy: float = m3_sin(orb_yaw);
    let cy: float = m3_cos(orb_yaw);
    let sp: float = m3_sin(orb_pitch);
    let cp: float = m3_cos(orb_pitch);
    /* forward = -(sy*cp, sp, cy*cp), right = (cy, 0, -sy) */
    orb_s_ex = orb_s_ex + (0.0 - sy * cp * f + cy * r) * step;
    orb_s_ey = orb_s_ey + (0.0 - sp * f + u) * step;
    orb_s_ez = orb_s_ez + (0.0 - cy * cp * f - sy * r) * step;
    return 1;
}

/* An entity's center in the 3D world (lights sit at their z, shapes extend back from it).
   Cameras use the eye from camera_place — same point as the frustum apex — so the
   icon, pick, and move gizmo sit on the pyramid tip instead of the far frame. */
fn v3_center_x(slot: int): float {
    if (ent_is_camera_ent(slot) == 1) {
        camera_place(slot, 1280.0 / 720.0);
        return gc_ex;
    }
    return (ent_x(slot) + ent_w(slot) / 2.0) * V3_UNIT;
}
fn v3_center_y(slot: int): float {
    if (ent_is_camera_ent(slot) == 1) {
        camera_place(slot, 1280.0 / 720.0);
        return gc_ey;
    }
    return 0.0 - (ent_y(slot) + ent_h(slot) / 2.0) * V3_UNIT;
}
fn v3_center_z(slot: int): float {
    if (ent_is_light(slot) == 1 || ent_is_empty(slot) == 1) return 0.0 - ent_z(slot) * V3_UNIT;
    if (ent_is_camera_ent(slot) == 1) {
        camera_place(slot, 1280.0 / 720.0);
        return gc_ez;
    }
    return 0.0 - (ent_z(slot) + ent_depth3d(slot) / 2.0) * V3_UNIT;
}

/* scene px per screen px for an entity, from its distance in front of the camera */
fn view3d_px_scale(slot: int): float {
    let v: Rect = game_view_rect();
    let sy: float = m3_sin(orb_yaw);
    let cyw: float = m3_cos(orb_yaw);
    let sp: float = m3_sin(orb_pitch);
    let cp: float = m3_cos(orb_pitch);
    let d: float = (orb_eye_x() - v3_center_x(slot)) * sy * cp + (orb_eye_y() - v3_center_y(slot)) * sp
                 + (orb_eye_z() - v3_center_z(slot)) * cyw * cp;
    if (d < 0.5) d = 0.5;
    return d * 2.0 * m3_tan(scene_fov() * 0.5) / v.h / V3_UNIT;
}

/* Moves the selection so it has moved (tx, ty, tz) scene px since the grab.
   A child whose parent is selected too is left to its parent, which carries it. */
fn view3d_move_to(tx: int, ty: int, tz: int) {
    let root: int = sel_move_root();
    if (root < 0) return;
    /* tx/ty/tz are the total shift since the grab. Snap that point, not the
       leftover since the last step, or a slow drag never reaches a grid line. */
    let wx: int = ent_x(root) - mv3_done_x + tx;
    let wy: int = ent_y(root) - mv3_done_y + ty;
    let wz: int = ent_z(root) - mv3_done_z + tz;
    if (tx != 0) wx = snap_coord(wx);
    else         wx = ent_x(root);
    if (ty != 0) wy = snap_coord(wy);
    else         wy = ent_y(root);
    if (tz != 0) wz = snap_coord(wz);
    else         wz = ent_z(root);
    let dx: int = wx - ent_x(root);
    let dy: int = wy - ent_y(root);
    let dz: int = wz - ent_z(root);
    if (dx == 0 && dy == 0 && dz == 0) return;
    view3d_undo_record();
    if (sel_move_by(dx, dy, dz) == 0) return;
    mv3_done_x = mv3_done_x + dx;
    mv3_done_y = mv3_done_y + dy;
    mv3_done_z = mv3_done_z + dz;
}

/* Scene-px center of the gizmo object. Lights and empties sit on their z. */
fn view3d_scene_center(slot: int) {
    mv3_cx = ent_x(slot) + ent_w(slot) / 2.0;
    mv3_cy = ent_y(slot) + ent_h(slot) / 2.0;
    mv3_cz = ent_z(slot);
    if (ent_is_camera_ent(slot) == 1 && ent_text(slot) == "look") mv3_cz = ent_z(slot) + ent_depth(slot) / 2.0;
    else if (ent_is_light(slot) == 0 && ent_is_empty(slot) == 0 && ent_is_camera_ent(slot) == 0) mv3_cz = ent_z(slot) + ent_depth3d(slot) / 2.0;
}

/* Mouse ray in scene px. Direction is one world unit long. */
fn view3d_mouse_ray(mx: int, my: int): int {
    if (r3d_ray_point(mx, my, 0.0) == 0) return 0;
    ray_ox = r3d_hx();
    ray_oy = r3d_hy();
    ray_oz = r3d_hz();
    if (r3d_ray_point(mx, my, 1.0) == 0) return 0;
    ray_dx = r3d_hx() - ray_ox;
    ray_dy = r3d_hy() - ray_oy;
    ray_dz = r3d_hz() - ray_oz;
    return 1;
}

/* Where the mouse ray crosses the camera-facing plane through the grab center.
   Writes hit_x/y/z. The ray must already be filled. */
fn view3d_plane_hit(): int {
    let sy: float = m3_sin(orb_yaw);
    let cy: float = m3_cos(orb_yaw);
    let sp: float = m3_sin(orb_pitch);
    let cp: float = m3_cos(orb_pitch);
    let denom: float = 0.0 - ray_dx * sy * cp + ray_dy * sp + ray_dz * cy * cp;
    let ad: float = denom;
    if (ad < 0.0) ad = 0.0 - ad;
    if (ad < 0.0001) return 0;
    let rhs: float = (ray_ox - mv3_cx) * sy * cp - (ray_oy - mv3_cy) * sp - (ray_oz - mv3_cz) * cy * cp;
    let t: float = rhs / denom;
    if (t < 0.05) return 0;
    if (t > 20000.0) return 0;
    hit_x = ray_ox + ray_dx * t;
    hit_y = ray_oy + ray_dy * t;
    hit_z = ray_oz + ray_dz * t;
    return 1;
}

/* Free move: the point under the cursor stays under the cursor, on the plane
   that faced the camera when the drag started. */
fn view3d_apply_move(mx: int, my: int) {
    if (view3d_mouse_ray(mx, my) == 0) return;
    if (view3d_plane_hit() == 0) return;
    if (mv3_grabbed == 0) {
        mv3_gx = hit_x;
        mv3_gy = hit_y;
        mv3_gz = hit_z;
        mv3_grabbed = 1;
        return;
    }
    view3d_move_to(m3_round(hit_x - mv3_gx), m3_round(hit_y - mv3_gy), m3_round(hit_z - mv3_gz));
}

/* Distance along the grabbed axis to the point closest to the mouse ray. */
fn view3d_scene_axis() {
    view3d_render_axis(sel_first(), mv3_axis);
    basis_x = basis_x;
    basis_y = 0.0 - basis_y;
    basis_z = 0.0 - basis_z;
}

fn view3d_axis_t(): float {
    view3d_scene_axis();
    let ux: float = basis_x;
    let uy: float = basis_y;
    let uz: float = basis_z;
    let wx: float = ray_ox - mv3_cx;
    let wy: float = ray_oy - mv3_cy;
    let wz: float = ray_oz - mv3_cz;
    let a: float = ray_dx * ray_dx + ray_dy * ray_dy + ray_dz * ray_dz;
    let b: float = ray_dx * ux + ray_dy * uy + ray_dz * uz;
    let d: float = ray_dx * wx + ray_dy * wy + ray_dz * wz;
    let e: float = ux * wx + uy * wy + uz * wz;
    let denom: float = a - b * b;
    if (denom < 0.0001) {
        axis_ok = 0;
        return 0.0;
    }
    axis_ok = 1;
    let t: float = (a * e - b * d) / denom;
    if (t > 2000000.0) t = 2000000.0;
    if (t < 0.0 - 2000000.0) t = 0.0 - 2000000.0;
    return t;
}

/* Arrow move: slide along the axis by how far the cursor has moved since the grab. */
fn view3d_apply_axis(mx: int, my: int) {
    if (view3d_mouse_ray(mx, my) == 0) return;
    let t: float = view3d_axis_t();
    if (axis_ok == 0) return;
    if (mv3_grabbed == 0) {
        mv3_gt = t;
        mv3_grabbed = 1;
        return;
    }
    view3d_scene_axis();
    let ux: float = basis_x;
    let uy: float = basis_y;
    let uz: float = basis_z;
    let along: float = t - mv3_gt;
    view3d_move_to(m3_round(along * ux), m3_round(along * uy), m3_round(along * uz));
}

fn m3_round(v: float): int {
    let n: int = 0;
    inline_cpp! { n = (int)lround(v); }
    return n;
}

/* ----- move gizmo: X (red), Y (green), Z (blue) arrows on the first selected entity ----- */


fn gz_dist_sq(px: int, py: int, ax: int, ay: int, bx: int, by: int): float {
    let r: float = 0.0;
    inline_cpp! {
        double vx = bx - ax, vy = by - ay, wx = px - ax, wy = py - ay;
        double l2 = vx * vx + vy * vy;
        double t = l2 > 0.0 ? (wx * vx + wy * vy) / l2 : 0.0;
        if (t < 0.0) t = 0.0;
        if (t > 1.0) t = 1.0;
        double ex = wx - vx * t, ey = wy - vy * t;
        r = ex * ex + ey * ey;
    }
    return r;
}

/* 1 = X, 2 = Y, 3 = Z arrow under the mouse, 0 = none */
fn view3d_gizmo_at(mx: int, my: int): int {
    if (edit_tool != "move" || gz_on == 0) return 0;
    let best: int = 0;
    let best_d: float = 289.0;     /* cone head is wider than the shaft */
    let i: int = 0;
    while (i < 3) {
        if (gz_ok[i] == 1) {
            let d: float = gz_dist_sq(mx, my, gz_ox, gz_oy, gz_x1[i], gz_y1[i]);
            let tip: float = dist_sq(mx, my, gz_x1[i], gz_y1[i]);
            let use: float = 100000.0;
            let ok: int = 0;
            if (d < 81.0) { ok = 1; use = d; }
            if (tip < 289.0) {
                ok = 1;
                if (tip < use) use = tip;
            }
            /* not the pivot itself: that is where the entity is grabbed */
            if (ok == 1 && use < best_d && dist_sq(mx, my, gz_ox, gz_oy) > 100) {
                best_d = use;
                best = i + 1;
            }
        }
        i = i + 1;
    }
    return best;
}

/* Shaded wedge of the angle turned so far. Drawn into the 3D picture so it can be translucent. */
fn view3d_draw_rotate_fill() {
    if (edit_tool != "rotate") return;
    if (orb_mode != 7 || mv3_started == 0) return;
    let s: int = sel_view3d_slot();
    if (s < 0) return;
    if (view3d_use_local(s) == 1) return;
    if (view3d_axes_place(s) == 0) return;
    let px: float = v3_center_x(s);
    let py: float = v3_center_y(s);
    let pz: float = v3_center_z(s);
    let now: float = view3d_spin_angle(s, rt3_axis, eng_mouse_x(), eng_mouse_y());
    let sweep: float = view3d_angle_delta(now, rt3_grab);
    let a0: float = rt3_grab;
    if (rt3_axis == 3) {
        sweep = 0.0 - sweep;
        a0 = 0.0 - rt3_grab;
    }
    let r: int = 255;
    let g: int = 70;
    let b: int = 70;
    if (rt3_axis == 2) { r = 70; g = 220; b = 120; }
    if (rt3_axis == 3) { r = 90; g = 160; b = 255; }
    r3d_sector(px, py, pz, rt3_axis, a0, sweep, view3d_ring_rad(), r, g, b, 90);
}

/* Solid cone + shaft on each axis, in the 3D picture, before the frame is shown.
   Shafts are drawn in world space (no depth) so they share the entity center with
   the cones. A 2D overlay shaft can drift off-center under Filament. */
fn view3d_draw_gizmo_heads() {
    if (edit_tool != "move") return;
    let s: int = sel_view3d_slot();
    if (s < 0) return;
    let px: float = v3_center_x(s);
    let py: float = v3_center_y(s);
    let pz: float = v3_center_z(s);
    let len: float = 70.0 * view3d_px_scale(s) * V3_UNIT;
    let head: float = len * 0.22;
    let rad: float = head * 0.46;
    let cr = [240, 52, 79];
    let cg = [82, 196, 140];
    let cb = [79, 120, 255];
    let i: int = 0;
    while (i < 3) {
        view3d_render_axis(s, i + 1);
        let ex: float = px + basis_x * len;
        let ey: float = py + basis_y * len;
        let ez: float = pz + basis_z * len;
        let bx: float = ex - basis_x * head;
        let by: float = ey - basis_y * head;
        let bz: float = ez - basis_z * head;
        let r: int = cr[i];
        let g: int = cg[i];
        let b: int = cb[i];
        if (orb_mode == 6 && mv3_axis == i + 1) { r = 255; g = 255; b = 255; }
        r3d_line_over(px, py, pz, bx, by, bz, r, g, b, 255);
        r3d_cone(bx, by, bz, ex, ey, ez, rad, r, g, b);
        i = i + 1;
    }
}

fn view3d_draw_gizmo() {
    if (edit_tool == "rotate") { view3d_draw_rotate(); return; }
    if (edit_tool == "scale") { view3d_draw_scale(); return; }
    gz_on = 0;
    if (edit_tool != "move") return;
    let s: int = sel_view3d_slot();
    if (s < 0) return;
    let px: float = v3_center_x(s);
    let py: float = v3_center_y(s);
    let pz: float = v3_center_z(s);
    if (r3d_project(px, py, pz) == 0) return;
    gz_ox = r3d_px();
    gz_oy = r3d_py();
    gz_len = 70.0 * view3d_px_scale(s) * V3_UNIT;     /* about 70 px long at any distance */
    let v: Rect = game_view_rect();
    eng_set_clip(v.x, v.y, v.w, v.h);
    /* Filament already drew shafts in view3d_draw_gizmo_heads. OpenGL/Vulkan
       still need the 2D overlay shafts; Filament's overlay can sit off the mesh. */
    let draw2d: int = 1;
    if (r3d_backend() == 4) draw2d = 0;
    let cr = [240, 52, 79];
    let cg = [82, 196, 140];
    let cb = [79, 120, 255];
    let i: int = 0;
    while (i < 3) {
        view3d_render_axis(s, i + 1);
        let ex: float = px + basis_x * gz_len;
        let ey: float = py + basis_y * gz_len;
        let ez: float = pz + basis_z * gz_len;
        gz_ok[i] = r3d_project(ex, ey, ez);
        if (gz_ok[i] == 1) {
            let tx: int = r3d_px();
            let ty: int = r3d_py();
            gz_x1[i] = tx;
            gz_y1[i] = ty;
            if (draw2d == 1) {
                let r: int = cr[i];
                let g: int = cg[i];
                let b: int = cb[i];
                if (orb_mode == 6 && mv3_axis == i + 1) { r = 255; g = 255; b = 255; }
                let head: float = gz_len * 0.22;
                let bx: float = ex - basis_x * head;
                let by: float = ey - basis_y * head;
                let bz: float = ez - basis_z * head;
                let lx: int = tx;
                let ly: int = ty;
                if (r3d_project(bx, by, bz) == 1) {
                    lx = r3d_px();
                    ly = r3d_py();
                }
                eng_line(gz_ox, gz_oy, lx, ly, r, g, b);
                eng_line(gz_ox + 1, gz_oy, lx + 1, ly, r, g, b);
                eng_line(gz_ox, gz_oy + 1, lx, ly + 1, r, g, b);
            }
        }
        i = i + 1;
    }
    gizmo_pivot_draw(gz_ox, gz_oy);
    eng_clear_clip();
    gz_on = 1;
}

fn view3d_use_local(slot: int): int {
    if (xform_local == 0) return 0;
    if (slot < 0) return 0;
    if (ent_is_camera_ent(slot) == 1) return 0;
    return 1;
}

/* Unit axis in render space. 1 X, 2 Y, 3 Z. Local follows the object's facing. */
fn view3d_render_axis(slot: int, axis: int) {
    basis_x = 0.0;
    basis_y = 0.0;
    basis_z = 0.0;
    let lx: float = 0.0;
    let ly: float = 0.0;
    let lz: float = 0.0;
    if (axis == 1) lx = 1.0;
    if (axis == 2) ly = 1.0;
    if (axis == 3) lz = 1.0;
    if (view3d_use_local(slot) == 0) {
        basis_x = lx;
        basis_y = ly;
        basis_z = lz;
        return;
    }
    eng_orient_vec(slot, lx, ly, lz);
    basis_x = eng_orient_x();
    basis_y = eng_orient_y();
    basis_z = eng_orient_z();
}

/* Pivot and the three axis tips, in screen pixels. 1 when the pivot is on screen. */
fn view3d_axes_place(slot: int): int {
    let px: float = v3_center_x(slot);
    let py: float = v3_center_y(slot);
    let pz: float = v3_center_z(slot);
    if (r3d_project(px, py, pz) == 0) return 0;
    gz_ox = r3d_px();
    gz_oy = r3d_py();
    gz_len = 70.0 * view3d_px_scale(slot) * V3_UNIT;
    let i: int = 0;
    while (i < 3) {
        view3d_render_axis(slot, i + 1);
        let ex: float = px + basis_x * gz_len;
        let ey: float = py + basis_y * gz_len;
        let ez: float = pz + basis_z * gz_len;
        gz_ok[i] = r3d_project(ex, ey, ez);
        if (gz_ok[i] == 1) {
            gz_x1[i] = r3d_px();
            gz_y1[i] = r3d_py();
        }
        i = i + 1;
    }
    return 1;
}

/* 1 when a selected parent will carry this one. */
fn view3d_carried(slot: int): int { return sel_is_carried(slot); }

fn view3d_angle_delta(now: float, grab: float): float {
    let d: float = now - grab;
    while (d > 180.0) d = d - 360.0;
    while (d < -180.0) d = d + 360.0;
    return d;
}

/* Angle of the cursor around the object's spin, in the same sense as rot. */
fn view3d_cursor_angle(slot: int, mx: int, my: int): float {
    let cx: float = ent_x(slot) + ent_w(slot) / 2.0;
    let cy: float = ent_y(slot) + ent_h(slot) / 2.0;
    let cz: float = ent_z(slot);
    if (ent_is_camera_ent(slot) == 1 && ent_text(slot) == "look") cz = ent_z(slot) + ent_depth(slot) / 2.0;
    else if (ent_is_light(slot) == 0 && ent_is_empty(slot) == 0 && ent_is_camera_ent(slot) == 0) cz = ent_z(slot) + ent_depth3d(slot) / 2.0;
    if (r3d_plane_hit(mx, my, cz) == 1) {
        return angle_deg_at(m3_round(cx), m3_round(cy), m3_round(r3d_hx()), m3_round(r3d_hy()));
    }
    return angle_deg_at(gz_ox, gz_oy, mx, my);
}

/* Ring radius in world units. Larger than the move arrows so it reads at a glance. */
fn view3d_ring_rad(): float { return gz_len * 1.7; }

/* A point on the ring around one world axis. 1 when it lands on screen. */
fn view3d_ring_project(axis: int, ang: float, rad: float, px: float, py: float, pz: float): int {
    let c: float = rad * m3_cos(ang);
    let s: float = rad * m3_sin(ang);
    let ox: float = 0.0;
    let oy: float = 0.0;
    let oz: float = 0.0;
    if (axis == 1) { oy = c; oz = s; }
    else if (axis == 2) { ox = s; oz = c; }
    else { ox = c; oy = s; }
    let slot: int = sel_first();
    if (view3d_use_local(slot) == 1) {
        eng_orient_vec(slot, ox, oy, oz);
        ox = eng_orient_x();
        oy = eng_orient_y();
        oz = eng_orient_z();
    }
    let x: float = px + ox;
    let y: float = py + oy;
    let z: float = pz + oz;
    ring_wx = x;
    ring_wy = y;
    ring_wz = z;
    return r3d_project(x, y, z);
}

/* How far a world point sits in front of the camera. */
fn view3d_cam_depth(wx: float, wy: float, wz: float): float {
    let sy: float = m3_sin(orb_yaw);
    let cyw: float = m3_cos(orb_yaw);
    let sp: float = m3_sin(orb_pitch);
    let cp: float = m3_cos(orb_pitch);
    return (orb_eye_x() - wx) * sy * cp + (orb_eye_y() - wy) * sp + (orb_eye_z() - wz) * cyw * cp;
}

/* Two-pixel line. The extra pixel follows the segment so the circle stays smooth. */
fn view3d_line2(x0: int, y0: int, x1: int, y1: int, r: int, g: int, b: int) {
    eng_line(x0, y0, x1, y1, r, g, b);
    let dx: int = x1 - x0;
    let dy: int = y1 - y0;
    if (dx < 0) dx = 0 - dx;
    if (dy < 0) dy = 0 - dy;
    if (dx >= dy) eng_line(x0, y0 + 1, x1, y1 + 1, r, g, b);
    else          eng_line(x0 + 1, y0, x1 + 1, y1, r, g, b);
}

fn view3d_ring_tick(slot: int, axis: int): float {
    if (axis == 1) return ent_rot_x(slot);
    if (axis == 2) return ent_rot_y(slot);
    return 0.0 - ent_rot(slot);
}

fn view3d_draw_rotate() {
    gz_on = 0;
    let s: int = sel_view3d_slot();
    if (s < 0) return;
    if (view3d_axes_place(s) == 0) return;
    let px: float = v3_center_x(s);
    let py: float = v3_center_y(s);
    let pz: float = v3_center_z(s);
    let rad: float = view3d_ring_rad();
    let v: Rect = viewport_rect();
    eng_set_clip(v.x, v.y, v.w, v.h);
    let depth0: float = view3d_cam_depth(px, py, pz);
    let axis: int = 1;
    while (axis <= 3) {
        let r: int = 255;
        let g: int = 64;
        let b: int = 64;
        if (axis == 2) { r = 64; g = 230; b = 110; }
        if (axis == 3) { r = 90; g = 160; b = 255; }
        if (orb_mode == 7 && rt3_axis == axis) { r = 255; g = 255; b = 255; }
        let prev_ok: int = 0;
        let prev_x: int = 0;
        let prev_y: int = 0;
        let prev_back: int = 0;
        let i: int = 0;
        while (i <= 72) {
            let ang: float = i * 5.0;
            let ok: int = view3d_ring_project(axis, ang, rad, px, py, pz);
            let back: int = 0;
            if (view3d_cam_depth(ring_wx, ring_wy, ring_wz) > depth0) back = 1;
            if (ok == 1 && prev_ok == 1) {
                let x: int = r3d_px();
                let y: int = r3d_py();
                let rr: int = r;
                let gg: int = g;
                let bb: int = b;
                if (back == 1 && prev_back == 1) {
                    rr = r * 3 / 5;
                    gg = g * 3 / 5;
                    bb = b * 3 / 5;
                }
                view3d_line2(prev_x, prev_y, x, y, rr, gg, bb);
                prev_x = x;
                prev_y = y;
            } else if (ok == 1) {
                prev_x = r3d_px();
                prev_y = r3d_py();
            }
            prev_ok = ok;
            prev_back = back;
            i = i + 1;
        }
        if (orb_mode == 7 && mv3_started == 1 && rt3_axis == axis) {
            let now: float = view3d_spin_angle(s, axis, eng_mouse_x(), eng_mouse_y());
            let sweep: float = view3d_angle_delta(now, rt3_grab);
            let a0: float = rt3_grab;
            if (axis == 3) {
                sweep = 0.0 - sweep;
                a0 = 0.0 - rt3_grab;
            }
            if (view3d_ring_project(axis, a0, rad, px, py, pz) == 1) {
                let x0: int = r3d_px();
                let y0: int = r3d_py();
                view3d_line2(gz_ox, gz_oy, x0, y0, r, g, b);
            }
            if (view3d_ring_project(axis, a0 + sweep, rad, px, py, pz) == 1) {
                let x1: int = r3d_px();
                let y1: int = r3d_py();
                view3d_line2(gz_ox, gz_oy, x1, y1, r, g, b);
            }
        }
        axis = axis + 1;
    }
    eng_fill_round_a(gz_ox - 3, gz_oy - 3, 6, 6, 3, 235, 236, 240, 255);
    eng_clear_clip();
    gz_on = 1;
}

/* 1, 2, or 3 when the mouse is on that ring. 0 otherwise. */
fn view3d_rotate_at(mx: int, my: int): int {
    let s: int = sel_first();
    if (s < 0) return 0;
    if (view3d_axes_place(s) == 0) return 0;
    let px: float = v3_center_x(s);
    let py: float = v3_center_y(s);
    let pz: float = v3_center_z(s);
    let rad: float = view3d_ring_rad();
    let best: int = 0;
    let best_d: float = 400.0;
    let axis: int = 1;
    while (axis <= 3) {
        let prev_ok: int = 0;
        let prev_x: int = 0;
        let prev_y: int = 0;
        let i: int = 0;
        while (i <= 40) {
            let ang: float = i * 9.0;
            let ok: int = view3d_ring_project(axis, ang, rad, px, py, pz);
            if (ok == 1 && prev_ok == 1) {
                let x: int = r3d_px();
                let y: int = r3d_py();
                let d: float = gz_dist_sq(mx, my, prev_x, prev_y, x, y);
                if (d < best_d && dist_sq(mx, my, gz_ox, gz_oy) > 64) {
                    best_d = d;
                    best = axis;
                }
                prev_x = x;
                prev_y = y;
            } else if (ok == 1) {
                prev_x = r3d_px();
                prev_y = r3d_py();
            }
            prev_ok = ok;
            i = i + 1;
        }
        axis = axis + 1;
    }
    return best;
}

fn view3d_draw_scale() {
    gz_on = 0;
    let s: int = sel_view3d_slot();
    if (s < 0) return;
    if (view3d_axes_place(s) == 0) return;
    let v: Rect = viewport_rect();
    eng_set_clip(v.x, v.y, v.w, v.h);
    let cr = [240, 52, 79];
    let cg = [82, 196, 140];
    let cb = [79, 120, 255];
    let i: int = 0;
    while (i < 3) {
        if (gz_ok[i] == 1) {
            let r: int = cr[i];
            let g: int = cg[i];
            let b: int = cb[i];
            if (orb_mode == 8 && mv3_axis == i + 1) { r = 255; g = 255; b = 255; }
            let tx: int = gz_x1[i];
            let ty: int = gz_y1[i];
            eng_line(gz_ox, gz_oy, tx, ty, r, g, b);
            eng_line(gz_ox + 1, gz_oy, tx + 1, ty, r, g, b);
            eng_fill_rect(tx - 5, ty - 5, 10, 10, r, g, b);
        }
        i = i + 1;
    }
    let cr0: int = 235;
    let cg0: int = 236;
    let cb0: int = 240;
    if (orb_mode == 9) { cr0 = 255; cg0 = 255; cb0 = 255; }
    eng_fill_rect(gz_ox - 5, gz_oy - 5, 10, 10, cr0, cg0, cb0);
    eng_clear_clip();
    gz_on = 1;
}

/* 1..3 an axis handle, 4 the center (scale all), 0 none. */
fn view3d_scale_at(mx: int, my: int): int {
    let s: int = sel_first();
    if (s < 0) return 0;
    if (view3d_axes_place(s) == 0) return 0;
    if (dist_sq(mx, my, gz_ox, gz_oy) <= 100) return 4;
    let best: int = 0;
    let best_d: float = 196.0;
    let i: int = 0;
    while (i < 3) {
        if (gz_ok[i] == 1) {
            let d: float = gz_dist_sq(mx, my, gz_ox, gz_oy, gz_x1[i], gz_y1[i]);
            let tip: float = dist_sq(mx, my, gz_x1[i], gz_y1[i]);
            let use: float = 100000.0;
            let ok: int = 0;
            if (d < 81.0) { ok = 1; use = d; }
            if (tip < 196.0) {
                ok = 1;
                if (tip < use) use = tip;
            }
            if (ok == 1 && use < best_d && dist_sq(gz_x1[i], gz_y1[i], gz_ox, gz_oy) > 256 && dist_sq(mx, my, gz_ox, gz_oy) > 100) {
                best_d = use;
                best = i + 1;
            }
        }
        i = i + 1;
    }
    return best;
}

fn m3_hypot(x: float, y: float): float {
    let r: float = 0.0;
    inline_cpp! { r = (float)sqrt((double)x * (double)x + (double)y * (double)y); }
    return r;
}

/* Meshes only. A selected child is left alone; its parent carries it. */
fn view3d_scale_capture() {
    xform_grab_begin();
    let s: int = sel_first();
    while (s >= 0) {
        if (view3d_carried(s) == 0 && ent_is_mesh3d(s) == 1) xform_grab_add(s);
        s = sel_iter_next(s + 1);
    }
}

fn view3d_rotate_capture() {
    xform_grab_begin();
    let s: int = sel_first();
    while (s >= 0) {
        if (view3d_carried(s) == 0) xform_grab_add(s);
        s = sel_iter_next(s + 1);
    }
}

fn view3d_spin_angle(slot: int, axis: int, mx: int, my: int): float {
    if (view3d_use_local(slot) == 1) {
        view3d_render_axis(slot, axis);
        let nx: float = basis_x;
        let ny: float = basis_y;
        let nz: float = basis_z;
        let ux: float = 0.0;
        let uy: float = 0.0;
        let uz: float = 0.0;
        let vx: float = 0.0;
        let vy: float = 0.0;
        let vz: float = 0.0;
        if (axis == 1) { uy = 1.0; vz = 1.0; }
        else if (axis == 2) { uz = 1.0; vx = 1.0; }
        else { ux = 1.0; vy = 1.0; }
        eng_orient_vec(slot, ux, uy, uz);
        ux = eng_orient_x();
        uy = eng_orient_y();
        uz = eng_orient_z();
        eng_orient_vec(slot, vx, vy, vz);
        vx = eng_orient_x();
        vy = eng_orient_y();
        vz = eng_orient_z();
        let a: int = r3d_basis_angle(mx, my, v3_center_x(slot), v3_center_y(slot), v3_center_z(slot),
                                     nx, ny, nz, ux, uy, uz, vx, vy, vz);
        if (a > 90000) return angle_deg_at(gz_ox, gz_oy, mx, my);
        return a;
    }
    if (axis == 3) return view3d_cursor_angle(slot, mx, my);
    let a2: int = r3d_axis_angle(mx, my, axis, v3_center_x(slot), v3_center_y(slot), v3_center_z(slot));
    if (a2 > 90000) return angle_deg_at(gz_ox, gz_oy, mx, my);
    return a2;
}

/* Factor from the frozen grab. 80 screen px along a handle doubles the size. */
fn view3d_scale_factor(mx: int, my: int): float {
    if (sc3_axis == 0) {
        let dist: float = dist_world(sc3_px, sc3_py, mx, my);
        let ref: float = sc3_dist_grab;
        if (ref < 64.0) ref = 64.0;
        return 1.0 + (dist - sc3_dist_grab) / ref;
    }
    let len: float = m3_hypot(gz_sx, gz_sy);
    if (len < 12.0) return 1.0;
    let along: float = ((mx - orb_ax) * gz_sx + (my - orb_ay) * gz_sy) / len;
    return 1.0 + along / 80.0;
}

fn view3d_scale_apply(factor: float) {
    if (factor < 0.05) factor = 0.05;
    if (factor > 6.0) factor = 6.0;
    view3d_undo_record();
    let axis: int = sc3_axis;
    if (ctrl_held()) axis = 0;
    xform_grab_scale(factor, axis);
}

fn view3d_clamp_pitch(v: int, limit: int): int {
    if (v > limit) return limit;
    if (v < 0 - limit) return 0 - limit;
    return v;
}

/* Cameras are not meshes. A mesh spin rewrites pitch, yaw, and roll together,
   and the picture only reads one of them, so the aim jumps. Each ring writes
   the angle that ring is. */
fn view3d_apply_camera_rotate(slot: int, delta: int) {
    let look: int = 0;
    if (ent_text(slot) == "look") look = 1;
    let next: int = rt3_base + delta;
    if (look == 1) {
        if (rt3_axis == 1) ent_set_rot_x(slot, view3d_clamp_pitch(next, 89));
        else if (rt3_axis == 2) ent_set_rot_y(slot, next);
        return;
    }
    if (rt3_axis == 1) ent_set_rot(slot, view3d_clamp_pitch(next, 80));
    else if (rt3_axis == 2) ent_set_rot_y(slot, next);
}

fn view3d_apply_rotate(mx: int, my: int) {
    let s0: int = sel_first();
    if (s0 < 0) return;
    let want: int = m3_round(view3d_angle_delta(view3d_spin_angle(s0, rt3_axis, mx, my), rt3_grab));
    if (want == rt3_applied) return;
    if (ent_is_camera_ent(s0) == 1) {
        if (rt3_axis == 3) return;
        view3d_undo_record();
        view3d_apply_camera_rotate(s0, want);
        rt3_applied = want;
        return;
    }
    view3d_undo_record();
    xform_grab_spin_local(rt3_axis, want, xform_local);
    rt3_applied = want;
}

/* 1 when this click belongs to the rotate or scale tool. */
fn view3d_tool_press(mx: int, my: int): int {
    if (edit_tool == "rotate") {
        let ring: int = view3d_rotate_at(mx, my);
        if (ring != 0) {
            rt3_axis = ring;
            orb_mode = 7;
            return 1;
        }
        let hit: int = view3d_pick(mx, my);
        if (hit < 0) {
            if (shift_held() == false && ctrl_held() == false) sel_clear();
            return 1;
        }
        if (shift_held() || ctrl_held()) {
            if (ent_selected(hit) == 1) ent_set_selected(hit, 0);
            else                        ent_set_selected(hit, 1);
            return 1;
        }
        if (ent_selected(hit) == 0) { sel_clear(); ent_set_selected(hit, 1); }
        rt3_axis = 3;
        if (ent_is_camera_ent(hit) == 1) rt3_axis = 1;
        orb_mode = 7;
        return 1;
    }
    if (edit_tool == "scale") {
        let axis: int = view3d_scale_at(mx, my);
        if (axis != 0) {
            sc3_axis = 0;
            mv3_axis = 0;
            orb_mode = 9;
            if (axis >= 1 && axis <= 3) {
                sc3_axis = axis;
                mv3_axis = axis;
                gz_sx = gz_x1[axis - 1] - gz_ox;
                gz_sy = gz_y1[axis - 1] - gz_oy;
                orb_mode = 8;
            }
            return 1;
        }
        let hit: int = view3d_pick(mx, my);
        if (hit < 0) {
            if (shift_held() == false && ctrl_held() == false) sel_clear();
            box_select_active = 1;
            box_select_x0 = mx;
            box_select_y0 = my;
            return 1;
        }
        if (shift_held() || ctrl_held()) {
            if (ent_selected(hit) == 1) ent_set_selected(hit, 0);
            else                        ent_set_selected(hit, 1);
            return 1;
        }
        if (ent_selected(hit) == 0) { sel_clear(); ent_set_selected(hit, 1); }
        if (view3d_axes_place(hit) == 0) view3d_axes_place(sel_first());
        sc3_axis = 0;
        mv3_axis = 0;
        orb_mode = 9;
        return 1;
    }
    return 0;
}

fn view3d_rects_hit(ax0: int, ay0: int, ax1: int, ay1: int, bx0: int, by0: int, bx1: int, by1: int): int {
    if (ax1 < bx0) return 0;
    if (ax0 > bx1) return 0;
    if (ay1 < by0) return 0;
    if (ay0 > by1) return 0;
    return 1;
}

fn view3d_pad_hits(wx: float, wy: float, wz: float, pad: int, x0: int, y0: int, x1: int, y1: int): int {
    if (r3d_project(wx, wy, wz) == 0) return 0;
    let px: int = r3d_px();
    let py: int = r3d_py();
    return view3d_rects_hit(px - pad, py - pad, px + pad, py + pad, x0, y0, x1, y1);
}

/* The mesh's oriented box, in screen pixels, against the drag rectangle. */
fn view3d_mesh_hits(slot: int, x0: int, y0: int, x1: int, y1: int): int {
    let w: float = ent_w(slot);
    let h: float = ent_h(slot);
    if (w < 1.0) w = 1.0;
    if (h < 1.0) h = 1.0;
    let k: string = ent_kind(slot);
    let sx: float = w * V3_UNIT;
    let sy: float = h * V3_UNIT;
    let sz: float = ent_depth3d(slot);
    sz = sz * V3_UNIT;
    if (k == "sphere") {
        let dm: float = w;
        if (h < dm) dm = h;
        dm = dm * V3_UNIT;
        sx = dm; sy = dm; sz = dm;
    } else if (k == "cylinder") {
        sz = w * V3_UNIT;
    } else if (k == "capsule") {
        sz = w * V3_UNIT;
        if (h < w) {
            let dm: float = h * V3_UNIT;
            sx = dm;
            sz = dm;
        }
    } else if (k == "model") {
        let dm: float = w;
        if (h > dm) dm = h;
        dm = dm * V3_UNIT;
        sx = dm; sy = dm; sz = dm;
    }
    let cx: float = v3_center_x(slot);
    let cy: float = v3_center_y(slot);
    let cz: float = v3_center_z(slot);
    let rot: float = ent_rot(slot);
    let cs: float = m3_cos(0.0 - rot);
    let sn: float = m3_sin(0.0 - rot);
    let rx: float = ent_rot_x(slot);
    let ry: float = ent_rot_y(slot);
    let cxr: float = m3_cos(rx);
    let sxr: float = m3_sin(rx);
    let cyr: float = m3_cos(ry);
    let syr: float = m3_sin(ry);
    let gv: Rect = game_view_rect();
    let any: int = 0;
    let minx: int = 0;
    let miny: int = 0;
    let maxx: int = 0;
    let maxy: int = 0;
    let ix: int = 0;
    while (ix < 2) {
        let iy: int = 0;
        while (iy < 2) {
            let iz: int = 0;
            while (iz < 2) {
                let lx: float = -0.5;
                let ly: float = -0.5;
                let lz: float = -0.5;
                if (ix == 1) lx = 0.5;
                if (iy == 1) ly = 0.5;
                if (iz == 1) lz = 0.5;
                let vx: float = lx * sx;
                let vy: float = ly * sy;
                let vz: float = lz * sz;
                let x1: float = vx * cs - vy * sn;
                let y1: float = vx * sn + vy * cs;
                let z1: float = vz;
                let y2: float = y1 * cxr - z1 * sxr;
                let z2: float = y1 * sxr + z1 * cxr;
                let x3: float = x1 * cyr + z2 * syr;
                let z3: float = 0.0 - x1 * syr + z2 * cyr;
                let wx: float = cx + x3;
                let wy: float = cy + y2;
                let wz: float = cz + z3;
                if (r3d_project(wx, wy, wz) == 1) {
                    let px: int = r3d_px();
                    let py: int = r3d_py();
                    let far: int = 0;
                    if (px < gv.x - 2500 || px > gv.x + gv.w + 2500) far = 1;
                    if (py < gv.y - 2500 || py > gv.y + gv.h + 2500) far = 1;
                    if (far == 0) {
                        if (any == 0 || px < minx) minx = px;
                        if (any == 0 || py < miny) miny = py;
                        if (any == 0 || px > maxx) maxx = px;
                        if (any == 0 || py > maxy) maxy = py;
                        any = 1;
                    }
                }
                iz = iz + 1;
            }
            iy = iy + 1;
        }
        ix = ix + 1;
    }
    if (any == 1 && view3d_rects_hit(minx, miny, maxx, maxy, x0, y0, x1, y1) == 1) return 1;
    return view3d_pad_hits(cx, cy, cz, 2, x0, y0, x1, y1);
}

fn view3d_draw_box_fill() {
    if (box_select_active == 0) return;
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let x0: int = box_select_x0;
    let y0: int = box_select_y0;
    let x1: int = mx;
    let y1: int = my;
    if (x1 < x0) { let t: int = x0; x0 = x1; x1 = t; }
    if (y1 < y0) { let t: int = y0; y0 = y1; y1 = t; }
    if (x1 <= x0 || y1 <= y0) return;
    let c: Color = th_white();
    r3d_screen_rect(x0, y0, x1 - x0, y1 - y0, c.r, c.g, c.b, 40);
}

fn view3d_box_select_finish(mx: int, my: int) {
    let x0: int = box_select_x0;
    let y0: int = box_select_y0;
    let x1: int = mx;
    let y1: int = my;
    if (x1 < x0) { let t: int = x0; x0 = x1; x1 = t; }
    if (y1 < y0) { let t: int = y0; y0 = y1; y1 = t; }
    ui_canvas_layout_game_view(game_view_rect());
    let i: int = ent_iter_next(0);
    while (i >= 0) {
        if (ent_shown(i) == 1) {
            let hit: int = 0;
            if (ent_is_ui(i) == 1) {
                let ex0: int = ui_to_screen_x(ent_x(i));
                let ey0: int = ui_to_screen_y(ent_y(i));
                let ex1: int = ex0 + ui_len_w(ent_w(i));
                let ey1: int = ey0 + ui_len_h(ent_h(i));
                hit = view3d_rects_hit(ex0, ey0, ex1, ey1, x0, y0, x1, y1);
            } else if (ent_is_light(i) == 1) {
                hit = view3d_pad_hits(light_wx(i), light_wy(i), light_wz(i), 14, x0, y0, x1, y1);
            } else if (ent_is_camera_ent(i) == 1) {
                hit = view3d_pad_hits(v3_center_x(i), v3_center_y(i), v3_center_z(i), 20, x0, y0, x1, y1);
            } else if (ent_is_empty(i) == 1) {
                hit = view3d_pad_hits(v3_center_x(i), v3_center_y(i), v3_center_z(i), 8, x0, y0, x1, y1);
            } else if (ent_is_mesh3d(i) == 1) {
                hit = view3d_mesh_hits(i, x0, y0, x1, y1);
            }
            if (hit == 1) ent_set_selected(i, 1);
        }
        i = ent_iter_next(i + 1);
    }
    box_select_active = 0;
}

fn viewport3d_input() {
    let v: Rect = viewport_rect();
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let inside: bool = point_in_rect(mx, my, v);

    if (view3d_toggle_input() == 1) return;

    if (box_select_active == 1) {
        if (mouse_released(MOUSE_LEFT) || mouse_down(MOUSE_LEFT) == 0) view3d_box_select_finish(mx, my);
        return;
    }

    if (orb_mode == 3 || orb_mode == 6 || orb_mode == 7 || orb_mode == 8 || orb_mode == 9) {
        if (mouse_down(MOUSE_LEFT)) {
            if (mv3_started == 0) {
                /* a click is not a drag: nothing changes until the mouse has
                   gone 4 px, and the gesture is measured from there */
                let ddx: int = mx - orb_ax;
                let ddy: int = my - orb_ay;
                if (ddx * ddx + ddy * ddy > 16) {
                    mv3_started = 1;
                    if (orb_mode == 7) {
                        let s0: int = sel_first();
                        if (s0 >= 0) rt3_grab = view3d_spin_angle(s0, rt3_axis, mx, my);
                        rt3_applied = 0;
                        rt3_base = 0;
                        if (s0 >= 0 && ent_is_camera_ent(s0) == 1) {
                            if (ent_text(s0) == "look") {
                                if (rt3_axis == 1) rt3_base = cam_signed(ent_rot_x(s0));
                                else rt3_base = cam_signed(ent_rot_y(s0));
                            } else if (rt3_axis == 2) {
                                rt3_base = cam_signed(ent_rot_y(s0));
                            } else {
                                rt3_base = cam_signed(ent_rot(s0));
                            }
                        }
                        view3d_rotate_capture();
                    } else if (orb_mode == 8 || orb_mode == 9) {
                        orb_ax = mx;
                        orb_ay = my;
                        let s0: int = sel_first();
                        if (s0 >= 0) view3d_axes_place(s0);
                        sc3_px = gz_ox;
                        sc3_py = gz_oy;
                        if (orb_mode == 8 && mv3_axis >= 1 && mv3_axis <= 3 && gz_ok[mv3_axis - 1] == 1) {
                            gz_sx = gz_x1[mv3_axis - 1] - gz_ox;
                            gz_sy = gz_y1[mv3_axis - 1] - gz_oy;
                        }
                        if (orb_mode == 9) sc3_dist_grab = dist_world(sc3_px, sc3_py, mx, my);
                        view3d_scale_capture();
                    } else {
                        orb_ax = mx;
                        orb_ay = my;
                        let s0: int = mv3_ref_slot;
                        if (s0 < 0) s0 = sel_first();
                        if (s0 >= 0) view3d_scene_center(s0);
                        /* Remember the point under the cursor. Later motion is
                           measured from here, so the object does not jump. */
                        if (view3d_mouse_ray(mx, my) == 1) {
                            if (orb_mode == 6) {
                                mv3_gt = view3d_axis_t();
                                if (axis_ok == 1) mv3_grabbed = 1;
                            } else if (view3d_plane_hit() == 1) {
                                mv3_gx = hit_x;
                                mv3_gy = hit_y;
                                mv3_gz = hit_z;
                                mv3_grabbed = 1;
                            }
                        }
                    }
                }
            } else if (orb_mode == 3) {
                view3d_apply_move(mx, my);
            } else if (orb_mode == 6) {
                view3d_apply_axis(mx, my);
            } else if (orb_mode == 7) {
                view3d_apply_rotate(mx, my);
            } else {
                view3d_scale_apply(view3d_scale_factor(mx, my));
            }
        } else {
            if (mv3_recorded == 1) last_inspector_slot = -1;
            orb_mode = 0;
            mv3_ref_slot = -1;
        }
        return;
    }
    if (orb_mode == 1) {
        /* right button: look around from where the camera is; WASD/QE fly */
        if (mouse_down(MOUSE_RIGHT)) {
            /* Unity's flythrough: the cursor is hidden and held, its motion
               turns the camera in place (0.17 deg per px, no dead zone), the
               wheel changes the fly speed */
            eng_mouse_lock_poll();
            let dx: int = eng_mouse_lock_dx();
            let dy: int = eng_mouse_lock_dy();
            let moved: int = dx;
            if (moved < 0) moved = 0 - moved;
            if (dy < 0) moved = moved - dy;
            else        moved = moved + dy;
            orb_look_px = orb_look_px + moved;
            if (orb_look_px > 3) orb_moved = 1;
            orb_yaw = orb_yaw - dx * 0.17;
            orb_pitch = orb_pitch + dy * 0.17;
            if (orb_pitch > 89.0) orb_pitch = 89.0;
            if (orb_pitch < -89.0) orb_pitch = -89.0;
            let wheel: int = eng_mouse_wheel();
            if (wheel > 0) orb_fly_speed = orb_fly_speed * 1.25;
            if (wheel < 0) orb_fly_speed = orb_fly_speed / 1.25;
            if (orb_fly_speed < 0.5) orb_fly_speed = 0.5;
            if (orb_fly_speed > 400.0) orb_fly_speed = 400.0;
            if (view3d_fly() == 1) orb_moved = 1;
            /* the eye stays where it is (or where flying put it): the target swings */
            orb_tx = orb_s_ex - orb_dist * m3_sin(orb_yaw) * m3_cos(orb_pitch);
            orb_ty = orb_s_ey - orb_dist * m3_sin(orb_pitch);
            orb_tz = orb_s_ez - orb_dist * m3_cos(orb_yaw) * m3_cos(orb_pitch);
        } else {
            orb_mode = 0;
            eng_mouse_lock(0);
            if (orb_moved == 0) {
                let hit: int = view3d_pick(mx, my);
                if (hit >= 0 && ent_selected(hit) == 0) { sel_clear(); ent_set_selected(hit, 1); }
                /* not context_menu_open: that hit-tests the 2D layout */
                if (hit >= 0) context_menu_open_for_entity("viewport", mx, my, hit);
                else          context_menu_open_for("viewport", mx, my);
            }
        }
        return;
    }
    if (orb_mode == 5) {
        /* Alt + left: orbit around the target */
        if (mouse_down(MOUSE_LEFT)) {
            orb_yaw = orb_s_yaw - (mx - orb_ax) * 0.3;
            orb_pitch = orb_s_pitch + (my - orb_ay) * 0.3;
            if (orb_pitch > 88.0) orb_pitch = 88.0;
            if (orb_pitch < -88.0) orb_pitch = -88.0;
        } else {
            orb_mode = 0;
        }
        return;
    }
    if (orb_mode == 2) {
        if (mouse_down(MOUSE_MIDDLE) || mouse_down(MOUSE_LEFT)) {
            let per: float = orb_dist * 2.0 * m3_tan(scene_fov() * 0.5) / v.h;
            let dx: float = mx - orb_ax;
            let dy: float = my - orb_ay;
            let sy: float = m3_sin(orb_yaw);
            let cy: float = m3_cos(orb_yaw);
            let sp: float = m3_sin(orb_pitch);
            let cp: float = m3_cos(orb_pitch);
            /* camera right = (cy, 0, -sy), up = (-sy*sp, cp, -cy*sp); the scene follows the mouse */
            orb_tx = orb_s_tx - cy * dx * per - sy * sp * dy * per;
            orb_ty = orb_s_ty + cp * dy * per;
            orb_tz = orb_s_tz + sy * dx * per - cy * sp * dy * per;
        } else {
            orb_mode = 0;
        }
        return;
    }
    if (inside == false) return;

    if (key_pressed(VK_F) && edit_target.len() == 0) {
        if (sel_count() > 0) view3d_frame(1);
        else                 view3d_frame(0);
    }

    let w: int = eng_mouse_wheel();
    if (w != 0) {
        orb_dist = orb_dist * (1.0 - w * 0.12);
        if (orb_dist < 1.0) orb_dist = 1.0;
        if (orb_dist > 2000.0) orb_dist = 2000.0;
    }

    let pan_start: int = 0;
    if (mouse_pressed(MOUSE_MIDDLE)) pan_start = 1;
    if (mouse_pressed(MOUSE_LEFT) && (edit_tool == "hand" || key_down(VK_SPACE))) pan_start = 1;
    if (pan_start == 1) {
        orb_mode = 2;
        orb_ax = mx;
        orb_ay = my;
        orb_s_tx = orb_tx;
        orb_s_ty = orb_ty;
        orb_s_tz = orb_tz;
        return;
    }
    if (mouse_pressed(MOUSE_RIGHT) || (mouse_pressed(MOUSE_LEFT) && alt_held())) {
        orb_mode = 5;
        if (mouse_pressed(MOUSE_RIGHT)) {
            orb_mode = 1;
            orb_look_px = 0;
            orb_fly_time = 0.0;
            eng_mouse_lock(1);
        }
        orb_moved = 0;
        orb_ax = mx;
        orb_ay = my;
        orb_s_yaw = orb_yaw;
        orb_s_pitch = orb_pitch;
        orb_s_ex = orb_eye_x();
        orb_s_ey = orb_eye_y();
        orb_s_ez = orb_eye_z();
        return;
    }
    if (mouse_pressed(MOUSE_LEFT)) {
        mv3_recorded = 0;
        mv3_started = 0;
        mv3_done_x = 0;
        mv3_done_y = 0;
        mv3_done_z = 0;
        mv3_grabbed = 0;
        orb_ax = mx;
        orb_ay = my;
        if (view3d_tool_press(mx, my) == 1) return;
        /* an arrow of the move gizmo first: it sits on top of everything */
        let axis: int = view3d_gizmo_at(mx, my);
        if (axis != 0) {
            mv3_axis = axis;
            gz_sx = gz_x1[axis - 1] - gz_ox;
            gz_sy = gz_y1[axis - 1] - gz_oy;
            orb_mode = 6;
            return;
        }
        let hit: int = view3d_pick(mx, my);
        if (hit < 0) {
            /* near a selected object's screen center — drag the whole group */
            if (edit_tool == "move" && shift_held() == false && ctrl_held() == false) {
                let near: int = view3d_sel_near(mx, my);
                if (near >= 0) {
                    mv3_ref_slot = near;
                    mv3_per = view3d_px_scale(near);
                    orb_mode = 3;
                    return;
                }
            }
            if (edit_tool != "rotate") {
                if (shift_held() == false && ctrl_held() == false) sel_clear();
                box_select_active = 1;
                box_select_x0 = mx;
                box_select_y0 = my;
            } else if (shift_held() == false && ctrl_held() == false) {
                sel_clear();
            }
            return;
        }
        if (shift_held() || ctrl_held()) {
            if (ent_selected(hit) == 1) ent_set_selected(hit, 0);
            else                        ent_set_selected(hit, 1);
            return;
        }
        if (ent_selected(hit) == 0) { sel_clear(); ent_set_selected(hit, 1); }
        mv3_ref_slot = hit;
        mv3_per = view3d_px_scale(hit);
        orb_mode = 3;
    }
}

/* Play: the game camera's view in the 16:9 game rect, like EyescirePlayer3D. */
fn play_draw3d() {
    let gv: Rect = game_view_rect();
    let aspect: float = gv.w;
    aspect = aspect / gv.h;
    gamecam_compute(aspect);
    r3d_begin(gv.x, gv.y, gv.w, gv.h, gc_ex, gc_ey, gc_ez, gc_tx, gc_ty, gc_tz, scene_fov(), scene_clear_r(), scene_clear_g(), scene_clear_b());
    view3d_draw_meshes(0);
    r3d_end(-1, 0, 0);
}

fn viewport_draw() {
    apply_engine_view();
    viewport_draw_grid();
    viewport_draw_tilemap();
    viewport_draw_entities();
    viewport_draw_selection();
    viewport_draw_box_select();
    drag_drop_target_hint();
    viewport_draw_overlay_info();
}

// =============================================================================
// Hierarchy helpers (used by drag-drop and the hierarchy panel)
// =============================================================================

fn hier_row_at(mx: int, my: int, r: Rect): int {
    if (point_in_rect(mx, my, r) == false) return -1;
    if (my < r.y + 26) return -1;
    let row_h: int = 20;
    let rel_y: int = my - (r.y + 26);
    let row: int = rel_y / row_h + hier_scroll;
    let total: int = ent_hier_count();
    if (row < 0 || row >= total) return -1;
    return row;
}

/* Visible-list row under the cursor, clamped to the list while inside the body. */
fn hier_row_at_clamped(mx: int, my: int, r: Rect): int {
    let total: int = ent_hier_count();
    if (total <= 0) return -1;
    let body: Rect = rect(r.x, r.y + 26, r.w, r.h - 26);
    if (point_in_rect(mx, my, body) == false) return -1;
    let row_h: int = 20;
    let rel_y: int = my - (r.y + 26);
    let row: int = rel_y / row_h + hier_scroll;
    if (row < 0) row = 0;
    if (row >= total) row = total - 1;
    return row;
}

fn hier_row_of_slot(slot: int): int {
    if (slot < 0) return -1;
    let i: int = 0;
    let n: int = ent_hier_count();
    while (i < n) {
        if (ent_hier_slot(i) == slot) return i;
        i = i + 1;
    }
    return -1;
}

/* Select every visible hierarchy row from a..b inclusive. additive=0 clears first. */
fn hier_select_range(a: int, b: int, additive: int) {
    let total: int = ent_hier_count();
    if (total <= 0) return;
    if (a > b) { let t: int = a; a = b; b = t; }
    if (a < 0) a = 0;
    if (b >= total) b = total - 1;
    if (additive == 0) sel_clear();
    let row: int = a;
    while (row <= b) {
        let s: int = ent_hier_slot(row);
        if (s >= 0) ent_set_selected(s, 1);
        row = row + 1;
    }
}

fn hier_is_descendant(ancestor: int, node: int): int {
    if (ancestor < 0 || node < 0) return 0;
    if (ancestor == node) return 1;
    let p: int = ent_parent(node);
    while (p >= 0) {
        if (p == ancestor) return 1;
        p = ent_parent(p);
    }
    return 0;
}

fn hier_reparent(dragged: int, new_parent: int) {
    if (dragged < 0) return;
    if (new_parent >= 0) {
        if (dragged == new_parent) return;
        if (hier_is_descendant(dragged, new_parent) == 1) return;
    }
    undo_save_modify(dragged);
    let ok: int = ent_set_parent(dragged, new_parent);
    if (ok == 1) {
        if (new_parent >= 0) eng_log("[hierarchy] " + ent_name(dragged) + " -> child of " + ent_name(new_parent));
        else                 eng_log("[hierarchy] " + ent_name(dragged) + " -> root");
    }
}

// =============================================================================
// Asset drag-and-drop  (script card -> entity script)
// =============================================================================

fn drag_is_active(): bool {
    if (drag_script_name.len() > 0) return true;
    if (drag_asset_path.len()  > 0) return true;
    return false;
}

fn drag_update() {
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();

    /* ---- script drag ---- */
    if (drag_pending_name.len() > 0 && drag_script_name.len() == 0 && mouse_down(MOUSE_LEFT)) {
        let dx: int = mx - drag_pending_x;
        let dy: int = my - drag_pending_y;
        if (dx < 0) dx = -dx;
        if (dy < 0) dy = -dy;
        if (dx > 4 || dy > 4) drag_script_name = drag_pending_name;
    }
    if (mouse_released(MOUSE_LEFT) && drag_pending_name.len() > 0) {
        if (drag_script_name.len() > 0) drag_script_drop_at(mx, my);
        else if (drag_pending_bp >= 0) bp_open_path(proj_bp_path(drag_pending_bp));
        else                           open_script_in_editor(drag_pending_idx);
        drag_pending_name = "";
        drag_pending_idx  = -1;
        drag_pending_bp   = -1;
        drag_script_name  = "";
    }

    /* ---- asset (image) drag ---- */
    if (drag_pending_asset_path.len() > 0 && drag_asset_path.len() == 0 && mouse_down(MOUSE_LEFT)) {
        let dx: int = mx - drag_pending_x;
        let dy: int = my - drag_pending_y;
        if (dx < 0) dx = -dx;
        if (dy < 0) dy = -dy;
        if (dx > 4 || dy > 4) {
            drag_asset_path = drag_pending_asset_path;
            drag_asset_rel  = drag_pending_asset_rel;
        }
    }
    if (mouse_released(MOUSE_LEFT) && drag_pending_asset_path.len() > 0) {
        if (drag_asset_path.len() > 0) drag_asset_drop_at(mx, my);
        /* short click = no drop, no fallback action right now */
        drag_pending_asset_path = "";
        drag_pending_asset_rel  = "";
        drag_pending_asset_idx  = -1;
        drag_asset_path = "";
        drag_asset_rel  = "";
    }
    if (drag_pending_asset_path.len() > 0 && mouse_down(MOUSE_LEFT) == false) {
        drag_pending_asset_path = "";
        drag_pending_asset_rel  = "";
        drag_pending_asset_idx  = -1;
        drag_asset_path = "";
        drag_asset_rel  = "";
    }
}

fn attach_asset_to(slot: int, path: string, rel: string) {
    if (slot < 0) return;
    undo_save_modify(slot);
    if (path_is_obj(rel) == 1 || path_is_obj(path) == 1) {
        ent_set_model(slot, path);
        let k: string = ent_kind(slot);
        if (k == "cube" || k == "sphere" || k == "cylinder" || k == "capsule" || k == "rect" || k == "empty" || k == "model") {
            ent_set_kind(slot, "model");
        }
        eng_log("[asset] model " + rel + " -> " + ent_name(slot));
    } else if (path_is_sound(rel) == 1 || path_is_sound(path) == 1) {
        ent_set_sound(slot, path);
        insp_buf_sound = ent_sound(slot);
        eng_log("[asset] sound " + rel + " -> " + ent_name(slot));
    } else if (path_is_image(rel) == 1 || path_is_image(path) == 1) {
        ent_set_sprite(slot, path);
        eng_log("[asset] " + rel + " -> " + ent_name(slot));
    } else {
        eng_log("[asset] " + rel + " is in the project");
    }
}

fn mat_apply_drop(s: int, kind: string, path: string) {
    undo_save_modify(s);
    if (kind == "albedo") { ent_set_tex_albedo(s, path); insp_buf_tex_albedo = ent_tex_albedo(s); }
    else if (kind == "normal") { ent_set_tex_normal(s, path); insp_buf_tex_normal = ent_tex_normal(s); }
    else if (kind == "rough") { ent_set_tex_rough(s, path); insp_buf_tex_rough = ent_tex_rough(s); }
    else if (kind == "metal") { ent_set_tex_metal(s, path); insp_buf_tex_metal = ent_tex_metal(s); }
    else if (kind == "height") { ent_set_tex_height(s, path); insp_buf_tex_height = ent_tex_height(s); }
    else if (kind == "ao") { ent_set_tex_ao(s, path); insp_buf_tex_ao = ent_tex_ao(s); }
    eng_log("[drop] map " + kind + " <- " + path);
}

fn drop_place_asset(mx: int, my: int) {
    let path: string = drag_asset_path;
    let rel: string = drag_asset_rel;
    let is_model: int = 0;
    if (path_is_obj(rel) == 1 || path_is_obj(path) == 1) is_model = 1;
    let is_image: int = 0;
    if (path_is_image(path) == 1 || path_is_image(rel) == 1) is_image = 1;
    if (is_model == 0 && is_image == 0) {
        eng_log("[drop] asset " + rel + " -> (no valid target)");
        return;
    }
    let iw: int = 64;
    let ih: int = 64;
    if (is_image == 1) {
        let img: int = eng_image_load_cached(path);
        if (img != 0) {
            let pw: int = eng_image_w(img);
            let ph: int = eng_image_h(img);
            if (pw > 0 && ph > 0) { iw = pw; ih = ph; }
        }
    }
    let name: string = path_basename(rel);
    if (name.len() == 0) name = path_basename(path);
    if (name.len() == 0) name = "sprite";
    let s: int = -1;
    if (viewport_mode == "ui") {
        if (is_model == 1) {
            eng_log("[drop] models go on the scene, not the UI canvas");
            return;
        }
        ui_canvas_layout_game_view(game_view_rect());
        let scale: float = 1.0;
        if (iw > UI_CANVAS_W) {
            let fit: float = UI_CANVAS_W;
            fit = fit / iw;
            scale = fit;
        }
        if (ih > UI_CANVAS_H) {
            let fit: float = UI_CANVAS_H;
            fit = fit / ih;
            if (fit < scale) scale = fit;
        }
        let fw: float = iw;
        fw = fw * scale;
        let fh: float = ih;
        fh = fh * scale;
        iw = fw;
        ih = fh;
        if (iw < 4) iw = 4;
        if (ih < 4) ih = 4;
        let uxf: float = screen_to_ui_x(mx);
        let uyf: float = screen_to_ui_y(my);
        let ux: int = uxf - iw / 2;
        let uy: int = uyf - ih / 2;
        s = ent_create("sprite2d", name, ux, uy, iw, ih, 255, 255, 255);
        if (s >= 0) ent_set_sprite(s, path);
    } else {
        if (viewport_mode == "play") play_snap_to_camera();
        let wxf: float = screen_to_world_x(mx);
        let wyf: float = screen_to_world_y(my);
        if (is_model == 1) {
            let wx: int = wxf - 32.0;
            let wy: int = wyf - 32.0;
            if (name.len() == 0) name = "model";
            s = ent_create("model", name, wx, wy, 64, 64, 200, 200, 210);
            if (s >= 0) ent_set_model(s, path);
        } else {
            let nx: int = wxf - iw / 2.0;
            let ny: int = wyf - ih / 2.0;
            s = ent_create("rect", name, nx, ny, iw, ih, 255, 255, 255);
            if (s >= 0) ent_set_sprite(s, path);
        }
    }
    if (s < 0) return;
    undo_save_create(s);
    sel_clear();
    ent_set_selected(s, 1);
    last_inspector_slot = -1;
    if (is_image == 1) insp_buf_sprite = path;
    eng_log("[drop] placed " + rel);
}

fn drag_asset_drop_at(mx: int, my: int) {
    let target: int = -1;
    let where: string = "";

    /* inspector sprite / MATERIALS fields (only when one entity selected) */
    let s_one: int = sel_first();
    if (s_one >= 0 && sel_count() == 1) {
        if (path_is_image(drag_asset_path) == 1 || path_is_image(drag_asset_rel) == 1) {
            let drop_path: string = drag_asset_rel;
            if (drop_path.len() == 0) drop_path = drag_asset_path;
            let ab: Rect = rect(mat_field_albedo_x, mat_field_albedo_y, mat_field_albedo_w, mat_field_albedo_h);
            let nm: Rect = rect(mat_field_normal_x, mat_field_normal_y, mat_field_normal_w, mat_field_normal_h);
            let rg: Rect = rect(mat_field_rough_x, mat_field_rough_y, mat_field_rough_w, mat_field_rough_h);
            let mt: Rect = rect(mat_field_metal_x, mat_field_metal_y, mat_field_metal_w, mat_field_metal_h);
            let ht: Rect = rect(mat_field_height_x, mat_field_height_y, mat_field_height_w, mat_field_height_h);
            let ao: Rect = rect(mat_field_ao_x, mat_field_ao_y, mat_field_ao_w, mat_field_ao_h);
            if (ab.w > 0 && point_in_rect(mx, my, ab)) { mat_apply_drop(s_one, "albedo", drop_path); return; }
            if (nm.w > 0 && point_in_rect(mx, my, nm)) { mat_apply_drop(s_one, "normal", drop_path); return; }
            if (rg.w > 0 && point_in_rect(mx, my, rg)) { mat_apply_drop(s_one, "rough", drop_path); return; }
            if (mt.w > 0 && point_in_rect(mx, my, mt)) { mat_apply_drop(s_one, "metal", drop_path); return; }
            if (ht.w > 0 && point_in_rect(mx, my, ht)) { mat_apply_drop(s_one, "height", drop_path); return; }
            if (ao.w > 0 && point_in_rect(mx, my, ao)) { mat_apply_drop(s_one, "ao", drop_path); return; }
        }
    }

    /* Anywhere on the inspector assigns the picture to the selection. */
    if (point_in_rect(mx, my, right_rect()) && sel_count() > 0) {
        let s: int = sel_first();
        while (s >= 0) {
            attach_asset_to(s, drag_asset_path, drag_asset_rel);
            s = sel_iter_next(s + 1);
        }
        if (sel_count() == 1 && (path_is_image(drag_asset_rel) == 1 || path_is_image(drag_asset_path) == 1)) {
            insp_buf_sprite = drag_asset_path;
        }
        return;
    }

    /* Scene, Play, and UI: drop on an object to assign, or on empty space to place one. */
    let v: Rect = viewport_rect();
    if (viewport_mode == "play") v = game_view_rect();
    if (point_in_rect(mx, my, v) && (viewport_mode == "scene" || viewport_mode == "play" || viewport_mode == "ui")) {
        let hit: int = -1;
        if (viewport_mode == "ui") {
            ui_canvas_layout_game_view(game_view_rect());
            hit = ui_viewport_hit_at(mx, my);
        } else {
            if (viewport_mode == "play") play_snap_to_camera();
            hit = viewport_hit_at(mx, my);
        }
        if (hit >= 0) {
            attach_asset_to(hit, drag_asset_path, drag_asset_rel);
            sel_clear();
            ent_set_selected(hit, 1);
            last_inspector_slot = -1;
            if (path_is_image(drag_asset_rel) == 1 || path_is_image(drag_asset_path) == 1) insp_buf_sprite = drag_asset_path;
            return;
        }
        drop_place_asset(mx, my);
        return;
    }

    /* hierarchy row hit-test */
    if (target < 0) {
        let hr: Rect = left_rect();
        let hrow: int = hier_row_at(mx, my, hr);
        if (hrow >= 0) {
            let it: int = ent_hier_slot(hrow);
            if (it >= 0) { target = it; where = "hierarchy"; }
        }
    }

    if (target < 0) {
        eng_log("[drop] asset " + drag_asset_rel + " -> (no valid target)");
        return;
    }

    attach_asset_to(target, drag_asset_path, drag_asset_rel);
    sel_clear();
    ent_set_selected(target, 1);
    last_inspector_slot = -1;
}

fn drag_script_drop_at(mx: int, my: int) {
    /* 1) inspector script field (only when exactly one entity selected) */
    let s: int = sel_first();
    if (s >= 0 && sel_count() == 1) {
        let fr: Rect = rect(last_script_field_x, last_script_field_y,
                            last_script_field_w, last_script_field_h);
        if (fr.w > 0 && point_in_rect(mx, my, fr)) {
            undo_save_modify(s);
            ent_set_script(s, drag_script_name);
            insp_buf_script = drag_script_name;
            eng_log("[drop] " + drag_script_name + " -> " + ent_name(s) + " (inspector)");
            return;
        }
    }
    /* 2) viewport entity hit-test in world coords */
    let v: Rect = viewport_rect();
    if (point_in_rect(mx, my, v) && viewport_mode == "scene") {
        let hit: int = viewport_hit_at(mx, my);
        if (hit >= 0) {
            undo_save_modify(hit);
            ent_set_script(hit, drag_script_name);
            sel_clear();
            ent_set_selected(hit, 1);
            last_inspector_slot = -1;
            eng_log("[drop] " + drag_script_name + " -> " + ent_name(hit) + " (viewport)");
            return;
        }
    }
    /* 3) hierarchy row hit-test */
    let hr: Rect = left_rect();
    let hrow: int = hier_row_at(mx, my, hr);
    if (hrow >= 0) {
        let it: int = ent_hier_slot(hrow);
        if (it >= 0) {
            undo_save_modify(it);
            ent_set_script(it, drag_script_name);
            sel_clear();
            ent_set_selected(it, 1);
            last_inspector_slot = -1;
            eng_log("[drop] " + drag_script_name + " -> " + ent_name(it) + " (hierarchy)");
            return;
        }
    }
    eng_log("[drop] cancelled (no valid target)");
}

fn drag_drop_target_hint() {
    /* glow the entity under the cursor while dragging a script */
    if (drag_is_active() == false) return;
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let v: Rect = viewport_rect();
    if (viewport_mode != "scene") return;
    if (point_in_rect(mx, my, v) == false) return;
    let hit: int = viewport_hit_at(mx, my);
    if (hit < 0) return;
    let glow: Rect;
    if (ent_is_empty(hit) == 1) {
        glow = empty_gizmo_screen(hit);
        glow = rect(glow.x - 3, glow.y - 3, glow.w + 6, glow.h + 6);
    } else {
        let sx: int = world_to_screen_x(ent_x(hit));
        let sy: int = world_to_screen_y(ent_y(hit));
        let sw: int = world_len(ent_w(hit));
        let sh: int = world_len(ent_h(hit));
        glow = rect(sx - 3, sy - 3, sw + 6, sh + 6);
    }
    draw_outline_rect(glow, 2, col_play());
    let glow2: Rect = rect(glow.x - 2, glow.y - 2, glow.w + 4, glow.h + 4);
    draw_outline_rect(glow2, 1, col_play());
}

fn drag_preview_draw() {
    if (drag_is_active() == false) return;
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let label: string = "";
    if (drag_script_name.len() > 0) label = "+ " + drag_script_name;
    else                            label = "+ " + drag_asset_rel;
    eng_set_font_size(12);
    let tw: int = eng_text_width(label);
    let r: Rect = rect(mx + 14, my + 6, tw + 18, 24);
    draw_fill_rect(r, col_accent_dim());
    draw_outline_rect(r, 1, col_accent());
    draw_text(r.x + 9, r.y + 5, label, col_text_main());
    eng_set_font_size(14);
    if (drag_asset_path.len() > 0) {
        if (point_in_rect(mx, my, right_rect())) draw_outline_rect(right_rect(), 2, col_accent());
        let vr: Rect = viewport_rect();
        if (viewport_mode == "play") vr = game_view_rect();
        if (point_in_rect(mx, my, vr)) draw_outline_rect(vr, 2, col_accent());
    }
}

fn context_menu_open(x: int, y: int) {
    context_menu_active = 1;
    context_menu_x = x;
    context_menu_y = y;
    context_menu_source = "viewport";
    context_menu_target = -1;
    let hit: int = viewport_hit_at(x, y);
    if (hit >= 0) context_menu_target = hit;
}

fn context_menu_open_for(source: string, x: int, y: int) {
    context_menu_active = 1;
    context_menu_x = x;
    context_menu_y = y;
    context_menu_source = source;
    context_menu_target = -1;
}

fn context_menu_open_for_entity(source: string, x: int, y: int, slot: int) {
    context_menu_active = 1;
    context_menu_x = x;
    context_menu_y = y;
    context_menu_source = source;
    context_menu_target = slot;
}

fn context_menu_close() {
    context_menu_active = 0;
    context_submenu     = "";
    context_menu_target = -1;
    /* Keep the Project-dock target while an inline rename is open. */
    if (edit_target != "assets_rename") {
        assets_cm_kind = "";
        assets_cm_rel = "";
        assets_cm_path = "";
        assets_cm_idx = -1;
    }
}

fn assets_cm_open_item(kind: string, rel: string, path: string, idx: int, x: int, y: int) {
    assets_rmb_used = 1;
    assets_cm_kind = kind;
    assets_cm_rel = rel;
    assets_cm_path = path;
    assets_cm_idx = idx;
    context_menu_open_for("assets", x, y);
}

fn file_stem(name: string): string {
    let base: string = path_basename(name);
    let i: int = base.len() - 1;
    while (i > 0) {
        if (base.substring(i, 1) == ".") return base.substring(0, i);
        i = i - 1;
    }
    return base;
}

fn begin_assets_rename() {
    if (assets_cm_kind.len() == 0) return;
    if (assets_cm_kind == "script" || assets_cm_kind == "blueprint") {
        begin_script_rename(assets_cm_rel);
        return;
    }
    edit_target = "assets_rename";
    edit_buf = file_stem(assets_cm_rel);
    if (assets_cm_kind == "folder") edit_buf = path_basename(assets_cm_rel);
    edit_caret = edit_buf.len();
    edit_anchor = edit_caret;
    rename_buf = edit_buf;
}

fn assets_renaming_this(kind: string, rel: string, path: string): int {
    if (edit_target != "assets_rename") return 0;
    if (assets_cm_kind != kind) return 0;
    if (path.len() > 0 && assets_cm_path == path) return 1;
    if (rel.len() > 0 && assets_cm_rel == rel) return 1;
    return 0;
}

fn assets_rename_finish(got: string) {
    if (got == rename_buf || got.len() == 0) {
        edit_target = "";
        assets_cm_kind = "";
        assets_cm_rel = "";
        assets_cm_path = "";
        assets_cm_idx = -1;
        return;
    }
    if (script_name_ok(got) == 0) {
        eng_log("[assets] rename needs a name without special characters");
        edit_target = "";
        assets_cm_kind = "";
        assets_cm_rel = "";
        assets_cm_path = "";
        assets_cm_idx = -1;
        return;
    }
    let kind: string = assets_cm_kind;
    let rel: string = assets_cm_rel;
    let path: string = assets_cm_path;
    let idx: int = assets_cm_idx;
    edit_target = "";
    assets_cm_kind = "";
    assets_cm_rel = "";
    assets_cm_path = "";
    assets_cm_idx = -1;
    if (kind == "folder") {
        let parent: string = path_dirname(path);
        let dst: string = proj_path_join(parent, got);
        if (eng_fs_exists(dst) == 1) { eng_log("[folder] already exists: " + got); return; }
        if (eng_fs_copy_tree(path, dst) == 0) { eng_log("[folder] rename failed"); return; }
        eng_fs_remove_tree(path);
        eng_log("[folder] renamed -> " + got);
        if (assets_root_for_tab() == "scenes") proj_rescan_scenes();
        else if (assets_root_for_tab() == "scripts") proj_rescan_scripts();
        else if (assets_root_for_tab() == "assets") proj_rescan_assets();
        else proj_rescan_prefabs();
        return;
    }
    if (kind == "scene") {
        if (idx < 0 || idx >= proj_scene_count()) return;
        let old_rel: string = proj_scene_rel(idx);
        let old_abs: string = proj_scene_abs(idx);
        let new_rel: string = rel_join(path_dirname(old_rel), got + ".scene");
        if (new_rel == old_rel) return;
        let new_abs: string = proj_path_join(proj_root(), new_rel);
        if (eng_fs_exists(new_abs) == 1) { eng_log("[scene] already exists: " + new_rel); return; }
        ensure_parent_dir(new_abs);
        if (eng_fs_copy_file(old_abs, new_abs) == 0) { eng_log("[scene] rename failed"); return; }
        /* Keep the slot. Removing the open scene refuses when it is the only
           one, and otherwise saves its entities over whichever scene slides
           into that index. */
        if (proj_rename_scene(idx, new_rel) == 0) {
            eng_fs_remove_file(new_abs);
            eng_log("[scene] rename failed");
            return;
        }
        eng_fs_remove_file(old_abs);
        eng_log("[scene] renamed -> " + new_rel);
        return;
    }
    if (kind == "asset") {
        let parent: string = path_dirname(path);
        let ext: string = "";
        let base: string = path_basename(path);
        let dot: int = -1;
        let i: int = 0;
        while (i < base.len()) {
            if (base.substring(i, 1) == ".") dot = i;
            i = i + 1;
        }
        if (dot >= 0) ext = base.substring(dot, base.len() - dot);
        let dst: string = proj_path_join(parent, got + ext);
        if (eng_fs_exists(dst) == 1) { eng_log("[asset] already exists"); return; }
        if (eng_fs_copy_file(path, dst) == 0) { eng_log("[asset] rename failed"); return; }
        eng_fs_remove_file(path);
        proj_rescan_assets();
        eng_log("[asset] renamed -> " + got + ext);
        return;
    }
    if (kind == "prefab") {
        let parent: string = path_dirname(path);
        let dst: string = proj_path_join(parent, got + ".prefab");
        if (eng_fs_exists(dst) == 1) { eng_log("[prefab] already exists"); return; }
        if (eng_fs_copy_file(path, dst) == 0) { eng_log("[prefab] rename failed"); return; }
        eng_fs_remove_file(path);
        proj_rescan_prefabs();
        eng_log("[prefab] renamed -> " + got + ".prefab");
        return;
    }
}

fn assets_delete_item() {
    let kind: string = assets_cm_kind;
    let rel: string = assets_cm_rel;
    let path: string = assets_cm_path;
    let idx: int = assets_cm_idx;
    if (kind == "folder") {
        if (path.len() == 0) return;
        eng_fs_remove_tree(path);
        eng_log("[folder] deleted " + rel);
        if (assets_root_for_tab() == "scenes") proj_rescan_scenes();
        else if (assets_root_for_tab() == "scripts") proj_rescan_scripts();
        else if (assets_root_for_tab() == "assets") proj_rescan_assets();
        else proj_rescan_prefabs();
        return;
    }
    if (kind == "scene") {
        if (idx >= 0) delete_scene_at(idx);
        return;
    }
    if (kind == "script" || kind == "blueprint") {
        delete_script_named(rel);
        return;
    }
    if (kind == "asset") {
        if (path.len() == 0) return;
        eng_fs_remove_file(path);
        proj_rescan_assets();
        eng_log("[asset] deleted " + rel);
        return;
    }
    if (kind == "prefab") {
        if (path.len() == 0) return;
        eng_fs_remove_file(path);
        proj_rescan_prefabs();
        eng_log("[prefab] deleted " + rel);
        return;
    }
}

fn assets_attach_item() {
    let s: int = sel_first();
    if (s < 0) return;
    if (assets_cm_kind == "script" || assets_cm_kind == "blueprint") {
        undo_save_modify(s);
        ent_set_script(s, assets_cm_rel);
        eng_log("[script] attached " + assets_cm_rel + " to " + ent_name(s));
        return;
    }
    if (assets_cm_kind == "asset") {
        attach_asset_to(s, assets_cm_path, assets_cm_rel);
    }
}

/* Where to spawn an entity created from the context menu. Uses the
 * right-clicked entity's center when parenting, otherwise click point
 * (viewport) or viewport center (hierarchy empty space). */
fn cm_spawn_x(): int {
    cm_spawn_target = context_menu_target;
    if (context_menu_target >= 0) {
        if (ent_is_ui(context_menu_target) == 1) {
            ui_canvas_layout_update();
            let px: float = ent_x(context_menu_target) + ent_w(context_menu_target) / 2;
            return ui_to_screen_x(px);
        }
        let px: int = ent_x(context_menu_target);
        let pw: int = ent_w(context_menu_target);
        let cx: int = px + pw / 2;
        return world_to_screen_x(cx);
    }
    if (context_menu_source == "hierarchy") {
        let v: Rect = viewport_rect();
        if (viewport_mode == "ui") {
            ui_canvas_layout_update();
            return ui_to_screen_x(UI_CANVAS_W / 2);
        }
        return v.x + v.w / 2;
    }
    return context_menu_x;
}
fn cm_spawn_y(): int {
    if (context_menu_target >= 0) {
        if (ent_is_ui(context_menu_target) == 1) {
            ui_canvas_layout_update();
            let py: float = ent_y(context_menu_target) + ent_h(context_menu_target) / 2;
            return ui_to_screen_y(py);
        }
        let py: int = ent_y(context_menu_target);
        let ph: int = ent_h(context_menu_target);
        let cy: int = py + ph / 2;
        return world_to_screen_y(cy);
    }
    if (context_menu_source == "hierarchy") {
        let v: Rect = viewport_rect();
        if (viewport_mode == "ui") {
            ui_canvas_layout_update();
            return ui_to_screen_y(UI_CANVAS_H / 2);
        }
        return v.y + v.h / 2;
    }
    return context_menu_y;
}

/* After creating an entity from the context menu: parent it under the
 * right-click target (if any), register undo, and select it. */
/* 1 while "Create >" or one of its 2nd-level submenus is open */
fn cm_create_open(): int {
    if (context_submenu == "create" || cm_sub2_open() == 1) return 1;
    return 0;
}
fn cm_sub2_open(): int {
    if (context_submenu == "create_2d" || context_submenu == "create_ui" || context_submenu == "create_3d") return 1;
    return 0;
}

fn cm_finish_create(s: int) {
    if (s < 0) return;
    if (context_menu_target >= 0) {
        ent_set_parent(s, context_menu_target);
    }
    undo_save_create(s);
    sel_clear();
    ent_set_selected(s, 1);
    /* force inspector to reload from the new entity, not stale edit_buf */
    edit_target = "";
    edit_buf    = "";
    last_inspector_slot = -1;
}

/* Submenu trigger row: label on the left, ">" chevron on the right.
 * Returns 1 when the cursor is hovering it, so the caller can flip
 * context_submenu over to this entry. */
fn menu_item_chevron(rx: int, ry: int, rw: int, label: string, opened: int): int {
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let r: Rect = rect(rx, ry, rw, 22);
    let hover: bool = point_in_rect(mx, my, r);
    let lit: int = 0;
    if (hover || opened == 1) lit = 1;
    th_menu_row(r, lit);
    th_font(12);
    let ty: int = th_text_y(ry, 22);
    draw_text(rx + 14, ty, label, col_text_main());
    draw_text(rx + rw - 18, ty, ">", col_text_dim());
    th_font(14);
    if (hover) return 1;
    return 0;
}

/* draw the "Create > ..." 1st-level submenu and let the caller know if
 * the cursor is currently hovering a 2nd-level trigger inside it. */
fn cm_draw_create_submenu(): int {
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();

    let dw: int = 200;
    let item_h: int = 22;
    let sep_h: int = 8;
    /* items: 2D Object>, 3D Object>, UI>, sep, Camera, Empty */
    let dh: int = 6 + item_h * 5 + sep_h + 6;

    let rx: int = context_submenu_x;
    let ry: int = context_submenu_y;
    if (rx + dw > WIN_W) rx = context_menu_x - dw + 2;
    if (ry + dh > WIN_H) ry = WIN_H - dh - 4;

    context_subbox_x = rx;
    context_subbox_y = ry;
    context_subbox_w = dw;
    context_subbox_h = dh;

    chrome_popup(rect(rx, ry, dw, dh));

    let yy: int = ry + 4;
    let any_hover: int = 0;
    let trigger_hover: int = 0;

    /* 2D Object > */
    let opened_2d: int = 0;
    if (context_submenu == "create_2d") opened_2d = 1;
    if (menu_item_chevron(rx + 2, yy, dw - 4, "2D Object", opened_2d) == 1) {
        any_hover = 1;
        trigger_hover = 1;
        context_submenu = "create_2d";
        context_sub2_x = rx + dw - 2;
        context_sub2_y = yy - 4;
    }
    yy = yy + item_h;

    /* 3D Object > */
    let opened_3d: int = 0;
    if (context_submenu == "create_3d") opened_3d = 1;
    if (menu_item_chevron(rx + 2, yy, dw - 4, "3D Object", opened_3d) == 1) {
        any_hover = 1;
        trigger_hover = 1;
        context_submenu = "create_3d";
        context_sub2_x = rx + dw - 2;
        context_sub2_y = yy - 4;
    }
    yy = yy + item_h;

    /* UI > */
    let opened_ui: int = 0;
    if (context_submenu == "create_ui") opened_ui = 1;
    if (menu_item_chevron(rx + 2, yy, dw - 4, "UI", opened_ui) == 1) {
        any_hover = 1;
        trigger_hover = 1;
        context_submenu = "create_ui";
        context_sub2_x = rx + dw - 2;
        context_sub2_y = yy - 4;
    }
    yy = yy + item_h;

    menu_separator(rx, yy + 4, dw);
    yy = yy + sep_h;

    /* Camera (leaf) */
    let cam_r: Rect = rect(rx + 2, yy, dw - 4, item_h);
    if (point_in_rect(mx, my, cam_r)) any_hover = 1;
    if (menu_item(cam_r.x, cam_r.y, cam_r.w, "Camera", "") == 1) {
        let cx: int = cm_spawn_x();
        let cy: int = cm_spawn_y();
        context_menu_close();
        cm_finish_create(spawn_camera_at(cx, cy));
        return 1;
    }
    yy = yy + item_h;

    /* Empty (leaf) */
    let empty_r: Rect = rect(rx + 2, yy, dw - 4, item_h);
    if (point_in_rect(mx, my, empty_r)) any_hover = 1;
    if (menu_item(empty_r.x, empty_r.y, empty_r.w, "Empty", "") == 1) {
        let cx: int = cm_spawn_x();
        let cy: int = cm_spawn_y();
        context_menu_close();
        cm_finish_create(spawn_empty_at(cx, cy));
        return 1;
    }
    yy = yy + item_h;

    /* if mouse is in this submenu but not over a chevron trigger,
       collapse any 2nd-level submenu so it doesn't linger */
    if (any_hover == 1 && trigger_hover == 0) context_submenu = "create";

    return any_hover;
}

fn cm_draw_2d_submenu(): int {
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();

    let dw: int = 180;
    let item_h: int = 22;
    let dh: int = 6 + item_h * 4 + 6;

    let rx: int = context_sub2_x;
    let ry: int = context_sub2_y;
    if (rx + dw > WIN_W) rx = context_subbox_x - dw + 2;
    if (ry + dh > WIN_H) ry = WIN_H - dh - 4;

    context_sub2box_x = rx;
    context_sub2box_y = ry;
    context_sub2box_w = dw;
    context_sub2box_h = dh;

    chrome_popup(rect(rx, ry, dw, dh));

    let yy: int = ry + 4;
    let any_hover: int = 0;

    let r1: Rect = rect(rx + 2, yy, dw - 4, item_h);
    if (point_in_rect(mx, my, r1)) any_hover = 1;
    if (menu_item(r1.x, r1.y, r1.w, "Rectangle", "") == 1) {
        let cx: int = cm_spawn_x();
        let cy: int = cm_spawn_y();
        context_menu_close();
        cm_finish_create(spawn_rect_at(cx, cy));
        return 1;
    }
    yy = yy + item_h;

    let r2: Rect = rect(rx + 2, yy, dw - 4, item_h);
    if (point_in_rect(mx, my, r2)) any_hover = 1;
    if (menu_item(r2.x, r2.y, r2.w, "Sprite", "") == 1) {
        let cx: int = cm_spawn_x();
        let cy: int = cm_spawn_y();
        context_menu_close();
        cm_finish_create(spawn_sprite_at(cx, cy));
        return 1;
    }
    yy = yy + item_h;

    let r3: Rect = rect(rx + 2, yy, dw - 4, item_h);
    if (point_in_rect(mx, my, r3)) any_hover = 1;
    if (menu_item(r3.x, r3.y, r3.w, "Label", "") == 1) {
        let cx: int = cm_spawn_x();
        let cy: int = cm_spawn_y();
        context_menu_close();
        cm_finish_create(spawn_label_at(cx, cy));
        return 1;
    }
    yy = yy + item_h;

    let r4: Rect = rect(rx + 2, yy, dw - 4, item_h);
    if (point_in_rect(mx, my, r4)) any_hover = 1;
    if (menu_item(r4.x, r4.y, r4.w, "Particles", "") == 1) {
        let cx: int = cm_spawn_x();
        let cy: int = cm_spawn_y();
        context_menu_close();
        cm_finish_create(spawn_emitter_at(cx, cy));
        return 1;
    }
    yy = yy + item_h;

    return any_hover;
}

fn cm_draw_3d_submenu(): int {
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();

    let dw: int = 180;
    let item_h: int = 22;
    let dh: int = 6 + item_h * 11 + 26 + 6;

    let rx: int = context_sub2_x;
    let ry: int = context_sub2_y;
    if (rx + dw > WIN_W) rx = context_subbox_x - dw + 2;
    if (ry + dh > WIN_H) ry = WIN_H - dh - 4;

    context_sub2box_x = rx;
    context_sub2box_y = ry;
    context_sub2box_w = dw;
    context_sub2box_h = dh;

    chrome_popup(rect(rx, ry, dw, dh));

    /* lights: the second group, under the shapes */
    let lkinds  = ["light_directional", "light_point", "light_spot", "light_ambient"];
    let llabels = ["Directional Light", "Point Light", "Spot Light", "Ambient Light"];
    let ly: int = ry + 4 + item_h * 7;
    chrome_hsep(rx + 8, ly + 5, dw - 16);
    th_caption(rx + 12, ly + 11, "LIGHT");
    ly = ly + 26;
    let lhover: int = 0;
    let li: int = 0;
    while (li < 4) {
        let lrow: Rect = rect(rx + 2, ly, dw - 4, item_h);
        if (point_in_rect(mx, my, lrow)) lhover = 1;
        if (menu_item(lrow.x, lrow.y, lrow.w, llabels[li], "") == 1) {
            let lcx: int = cm_spawn_x();
            let lcy: int = cm_spawn_y();
            context_menu_close();
            cm_finish_create(spawn_light_at(lkinds[li], lcx, lcy));
            return 1;
        }
        ly = ly + item_h;
        li = li + 1;
    }
    if (point_in_rect(mx, my, rect(rx, ry + 4 + item_h * 7, dw, 26))) lhover = 1;

    let kinds  = ["cube", "sphere", "cylinder", "capsule", "model"];
    let labels = ["Cube", "Sphere", "Cylinder", "Capsule", "Model (.obj)..."];
    let yy: int = ry + 4;
    let any_hover: int = 0;
    let i: int = 0;
    while (i < 5) {
        let row: Rect = rect(rx + 2, yy, dw - 4, item_h);
        if (point_in_rect(mx, my, row)) any_hover = 1;
        if (menu_item(row.x, row.y, row.w, labels[i], "") == 1) {
            let cx: int = cm_spawn_x();
            let cy: int = cm_spawn_y();
            context_menu_close();
            cm_finish_create(spawn_shape3d_at(kinds[i], cx, cy));
            return 1;
        }
        yy = yy + item_h;
        i = i + 1;
    }
    let prow: Rect = rect(rx + 2, yy, dw - 4, item_h);
    if (point_in_rect(mx, my, prow)) any_hover = 1;
    if (menu_item(prow.x, prow.y, prow.w, "Particles", "") == 1) {
        let cx: int = cm_spawn_x();
        let cy: int = cm_spawn_y();
        context_menu_close();
        cm_finish_create(spawn_emitter_at(cx, cy));
        return 1;
    }
    yy = yy + item_h;
    let srow: Rect = rect(rx + 2, yy, dw - 4, item_h);
    if (point_in_rect(mx, my, srow)) any_hover = 1;
    if (menu_item(srow.x, srow.y, srow.w, "Screen Sprite", "") == 1) {
        let cx: int = cm_spawn_x();
        let cy: int = cm_spawn_y();
        context_menu_close();
        cm_finish_create(spawn_screen_sprite_at(cx, cy));
        return 1;
    }
    if (lhover == 1) any_hover = 1;
    return any_hover;
}

fn cm_draw_ui_submenu(): int {
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();

    let labels = ["Label", "Panel", "Button", "Checkbox", "Toggle", "Slider", "Progress bar", "Text field"];
    let n: int = 8;
    let dw: int = 180;
    let item_h: int = 22;
    let dh: int = 6 + item_h * n + 6;

    let rx: int = context_sub2_x;
    let ry: int = context_sub2_y;
    if (rx + dw > WIN_W) rx = context_subbox_x - dw + 2;
    if (ry + dh > WIN_H) ry = WIN_H - dh - 4;

    context_sub2box_x = rx;
    context_sub2box_y = ry;
    context_sub2box_w = dw;
    context_sub2box_h = dh;

    chrome_popup(rect(rx, ry, dw, dh));

    let yy: int = ry + 4;
    let any_hover: int = 0;
    let i: int = 0;
    while (i < n) {
        let row: Rect = rect(rx + 2, yy, dw - 4, item_h);
        if (point_in_rect(mx, my, row)) any_hover = 1;
        if (menu_item(row.x, row.y, row.w, labels[i], "") == 1) {
            viewport_show("ui");
            ui_canvas_layout_update();
            let cx: int = cm_spawn_x();
            let cy: int = cm_spawn_y();
            context_menu_close();
            let made: int = -1;
            if (i == 0) made = spawn_ui_label_at(cx, cy);
            else if (i == 1) made = spawn_ui_panel_at(cx, cy);
            else if (i == 2) made = spawn_ui_button_at(cx, cy);
            else if (i == 3) made = spawn_ui_check_at(cx, cy);
            else if (i == 4) made = spawn_ui_toggle_at(cx, cy);
            else if (i == 5) made = spawn_ui_slider_at(cx, cy);
            else if (i == 6) made = spawn_ui_bar_at(cx, cy);
            else made = spawn_ui_field_at(cx, cy);
            cm_finish_create(made);
            return 1;
        }
        yy = yy + item_h;
        i = i + 1;
    }
    return any_hover;
}

fn assets_cm_draw_create_submenu() {
    let dw: int = 180;
    let item_h: int = 22;
    /* Folder, Nexa Script, Blueprint, Scene, separator, Import Asset */
    let dh: int = 8 + item_h * 5 + 8;
    let rx: int = context_submenu_x;
    let ry: int = context_submenu_y;
    if (rx + dw > WIN_W) rx = context_menu_x - dw + 2;
    if (ry + dh > WIN_H) ry = WIN_H - dh - 4;
    context_subbox_x = rx;
    context_subbox_y = ry;
    context_subbox_w = dw;
    context_subbox_h = dh;
    chrome_popup(rect(rx, ry, dw, dh));
    let yy: int = ry + 4;

    if (menu_item(rx + 2, yy, dw - 4, "Folder", "") == 1) {
        context_menu_close();
        create_new_folder();
        return;
    }
    yy = yy + item_h;
    if (menu_item(rx + 2, yy, dw - 4, "Nexa Script", "") == 1) {
        context_menu_close();
        create_new_script("");
        return;
    }
    yy = yy + item_h;
    if (menu_item(rx + 2, yy, dw - 4, "Blueprint", "") == 1) {
        context_menu_close();
        create_new_blueprint();
        return;
    }
    yy = yy + item_h;
    if (menu_item(rx + 2, yy, dw - 4, "Scene", "") == 1) {
        context_menu_close();
        add_new_scene();
        viewport_show("scene");
        return;
    }
    yy = yy + item_h;
    menu_separator(rx, yy + 3, dw);
    yy = yy + 8;
    if (menu_item(rx + 2, yy, dw - 4, "Import Asset...", "") == 1) {
        context_menu_close();
        import_asset_dialog();
        return;
    }
}

fn assets_context_menu_draw() {
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let dw: int = 220;
    let item_h: int = 22;
    let sep_h: int = 8;
    let has_sel: int = 0;
    if (sel_first() >= 0) has_sel = 1;
    let on_item: int = 0;
    if (assets_cm_kind.len() > 0) on_item = 1;

    let n_items: int = 1; /* Cancel */
    let n_seps: int = 1;
    if (on_item == 1) {
        n_items = n_items + 2; /* Rename, Delete */
        if (has_sel == 1 && (assets_cm_kind == "script" || assets_cm_kind == "blueprint" || assets_cm_kind == "asset")) {
            n_items = n_items + 1; /* Attach */
            n_seps = n_seps + 1;
        }
    } else {
        n_items = n_items + 1; /* Create */
        if (has_sel == 1) {
            n_items = n_items + 1; /* Save as Prefab */
            n_seps = n_seps + 1;
        }
    }
    let dh: int = 8 + n_items * item_h + n_seps * sep_h;
    let rx: int = context_menu_x;
    let ry: int = context_menu_y;
    if (rx + dw > WIN_W) rx = WIN_W - dw - 4;
    if (ry + dh > WIN_H) ry = WIN_H - dh - 4;
    let main_box: Rect = rect(rx, ry, dw, dh);
    chrome_popup(main_box);
    let yy: int = ry + 4;
    let main_hover_kind: string = "";

    if (on_item == 1) {
        let ren_r: Rect = rect(rx + 2, yy, dw - 4, item_h);
        if (point_in_rect(mx, my, ren_r)) main_hover_kind = "leaf";
        if (menu_item(ren_r.x, ren_r.y, ren_r.w, "Rename", "F2") == 1) {
            begin_assets_rename();
            context_menu_active = 0;
            context_submenu = "";
            return;
        }
        yy = yy + item_h;

        let del_r: Rect = rect(rx + 2, yy, dw - 4, item_h);
        if (point_in_rect(mx, my, del_r)) main_hover_kind = "leaf";
        if (menu_item(del_r.x, del_r.y, del_r.w, "Delete", "Del") == 1) {
            assets_delete_item();
            context_menu_close();
            return;
        }
        yy = yy + item_h;

        if (has_sel == 1 && (assets_cm_kind == "script" || assets_cm_kind == "blueprint" || assets_cm_kind == "asset")) {
            menu_separator(rx, yy + 4, dw); yy = yy + sep_h;
            let att_r: Rect = rect(rx + 2, yy, dw - 4, item_h);
            if (point_in_rect(mx, my, att_r)) main_hover_kind = "leaf";
            if (menu_item(att_r.x, att_r.y, att_r.w, "Attach to Selection", "") == 1) {
                assets_attach_item();
                context_menu_close();
                return;
            }
            yy = yy + item_h;
        }
    } else {
        let opened_create: int = 0;
        if (context_submenu == "assets_create") opened_create = 1;
        let create_r: Rect = rect(rx + 2, yy, dw - 4, item_h);
        if (menu_item_chevron(create_r.x, create_r.y, create_r.w, "Create", opened_create) == 1) {
            main_hover_kind = "create";
            context_submenu_x = rx + dw - 2;
            context_submenu_y = create_r.y - 4;
        }
        yy = yy + item_h;

        if (has_sel == 1) {
            menu_separator(rx, yy + 4, dw); yy = yy + sep_h;
            let pref_r: Rect = rect(rx + 2, yy, dw - 4, item_h);
            if (point_in_rect(mx, my, pref_r)) main_hover_kind = "leaf";
            if (menu_item(pref_r.x, pref_r.y, pref_r.w, "Save Selection as Prefab", "") == 1) {
                context_menu_close();
                let s: int = sel_first();
                if (s >= 0) {
                    let pname: string = ent_name(s);
                    if (pname.len() == 0) pname = "prefab";
                    proj_save_prefab(pname, s);
                }
                return;
            }
            yy = yy + item_h;
        }
    }

    menu_separator(rx, yy + 4, dw); yy = yy + sep_h;
    let cancel_r: Rect = rect(rx + 2, yy, dw - 4, item_h);
    if (point_in_rect(mx, my, cancel_r)) main_hover_kind = "leaf";
    if (menu_item(cancel_r.x, cancel_r.y, cancel_r.w, "Cancel", "Esc") == 1) {
        context_menu_close();
        return;
    }

    if (main_hover_kind == "leaf") context_submenu = "";
    if (main_hover_kind == "create") context_submenu = "assets_create";

    if (context_menu_active == 0) return;
    if (on_item == 0 && context_submenu == "assets_create") assets_cm_draw_create_submenu();

    if (mouse_pressed(MOUSE_LEFT)) {
        let inside: bool = point_in_rect(mx, my, main_box);
        if (inside == false && context_submenu == "assets_create") {
            inside = point_in_rect(mx, my, rect(context_subbox_x, context_subbox_y, context_subbox_w, context_subbox_h));
        }
        if (inside == false) context_menu_close();
    }
    if (key_pressed(VK_ESCAPE)) {
        if (context_submenu.len() > 0) context_submenu = "";
        else context_menu_active = 0;
    }
}

fn context_menu_draw() {
    if (context_menu_active == 0) return;
    if (context_menu_source == "assets") {
        assets_context_menu_draw();
        return;
    }
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();

    let has_sel: int = 0;
    if (sel_first() >= 0) has_sel = 1;

    /* main menu: always offers Create>; selection items appear only if
     * something is selected. */
    let dw: int = 220;
    let item_h: int = 22;
    let sep_h: int = 8;

    let n_items: int = 1;            /* Create */
    let n_seps:  int = 1;            /* before Cancel */
    if (has_sel == 1) {
        n_items = n_items + 4;       /* Rename, Duplicate, Save as Prefab, Delete */
        n_seps  = n_seps + 1;        /* between Create and Rename */
    }
    n_items = n_items + 1;           /* Cancel */

    let dh: int = 8 + n_items * item_h + n_seps * sep_h;
    let rx: int = context_menu_x;
    let ry: int = context_menu_y;
    if (rx + dw > WIN_W) rx = WIN_W - dw - 4;
    if (ry + dh > WIN_H) ry = WIN_H - dh - 4;

    let main_box: Rect = rect(rx, ry, dw, dh);
    chrome_popup(main_box);

    let yy: int = ry + 4;

    /* "leaf" hover -> collapse submenu; "create" hover -> open submenu;
     * no hover at all -> leave submenu state untouched so the cursor can
     * travel from "Create" out to its submenu items. */
    let main_hover_kind: string = "";

    /* Create > */
    let opened_create: int = 0;
    if (cm_create_open() == 1) {
        opened_create = 1;
    }
    let create_r: Rect = rect(rx + 2, yy, dw - 4, item_h);
    if (menu_item_chevron(create_r.x, create_r.y, create_r.w, "Create", opened_create) == 1) {
        main_hover_kind = "create";
        context_submenu_x = rx + dw - 2;
        context_submenu_y = create_r.y - 4;
    }
    yy = yy + item_h;

    if (has_sel == 1) {
        menu_separator(rx, yy + 4, dw); yy = yy + sep_h;

        let r1: Rect = rect(rx + 2, yy, dw - 4, item_h);
        if (point_in_rect(mx, my, r1)) main_hover_kind = "leaf";
        if (menu_item(r1.x, r1.y, r1.w, "Rename", "F2") == 1) {
            context_menu_close();
            let s: int = sel_first();
            if (s >= 0) inspector_begin_rename(s);
        }
        yy = yy + item_h;

        let r2: Rect = rect(rx + 2, yy, dw - 4, item_h);
        if (point_in_rect(mx, my, r2)) main_hover_kind = "leaf";
        if (menu_item(r2.x, r2.y, r2.w, "Duplicate", "Ctrl+D") == 1) {
            context_menu_close();
            let s: int = sel_first();
            if (s >= 0) {
                let ns: int = ent_create(ent_kind(s), ent_name(s),
                                         ent_x(s) + 16, ent_y(s) + 16, ent_w(s), ent_h(s),
                                         ent_r(s), ent_g(s), ent_b(s));
                if (ns >= 0) {
                    ent_set_text(ns, ent_text(s));
                    ent_set_font_px(ns, ent_font_px(s));
                    ent_set_font_ox(ns, ent_font_ox(s));
                    ent_set_font_oy(ns, ent_font_oy(s));
                    ent_set_ui_radius(ns, ent_ui_radius(s));
                    ent_set_ui_border(ns, ent_ui_border(s));
                    ent_set_ui_align(ns, ent_ui_align(s));
                    ent_set_ui_shadow(ns, ent_ui_shadow(s));
                    ent_set_ui_text(ns, ent_ui_text(s));
                    ent_set_pixel(ns, ent_pixel(s));
                    ent_set_script(ns, ent_script(s));
                    ent_set_sprite(ns, ent_sprite(s));
                    ent_set_parent(ns, ent_parent(s));
                    ent_set_rot(ns, ent_rot(s));
                    ent_set_rot_x(ns, ent_rot_x(s));
                    ent_set_rot_y(ns, ent_rot_y(s));
                    ent_set_z(ns, ent_z(s));
                    ent_set_depth(ns, ent_depth(s));
                    ent_set_model(ns, ent_model(s));
                    ent_set_sound(ns, ent_sound(s));
                    ent_set_sound_loop(ns, ent_sound_loop(s));
                    ent_set_sound_range(ns, ent_sound_range(s));
                    ent_set_emit_rate(ns, ent_emit_rate(s));
                    ent_set_emit_life(ns, ent_emit_life(s));
                    ent_set_emit_speed(ns, ent_emit_speed(s));
                    ent_set_emit_spread(ns, ent_emit_spread(s));
                    ent_set_emit_size(ns, ent_emit_size(s));
                    ent_set_emit_hd(ns, ent_emit_hd(s));
                    ent_set_light_intensity(ns, ent_light_intensity(s));
                    ent_set_light_range(ns, ent_light_range(s));
                    ent_set_light_angle(ns, ent_light_angle(s));
                    ent_set_light_tilt(ns, ent_light_tilt(s));
                    ent_set_visible(ns, ent_visible(s));
                    ent_set_alpha(ns, ent_a(s));
                    ent_set_body(ns, ent_has_body(s));
                    ent_set_body_type(ns, ent_body_type(s));
                    ent_set_hitbox(ns, ent_hitbox(s));
                    ent_set_ui_value(ns, ent_ui_value(s));
                    ent_copy_button(ns, s);
                    eng_pub_copy(ns, s);
                    ent_set_aa(ns, ent_aa(s));
                    undo_save_create(ns);
                    sel_clear();
                    ent_set_selected(ns, 1);
                }
            }
        }
        yy = yy + item_h;

        let r3: Rect = rect(rx + 2, yy, dw - 4, item_h);
        if (point_in_rect(mx, my, r3)) main_hover_kind = "leaf";
        if (menu_item(r3.x, r3.y, r3.w, "Save as Prefab", "") == 1) {
            context_menu_close();
            let s: int = sel_first();
            if (s >= 0) {
                let pname: string = ent_name(s);
                if (pname.len() == 0) pname = "prefab";
                proj_save_prefab(pname, s);
            }
        }
        yy = yy + item_h;

        let r4: Rect = rect(rx + 2, yy, dw - 4, item_h);
        if (point_in_rect(mx, my, r4)) main_hover_kind = "leaf";
        if (menu_item(r4.x, r4.y, r4.w, "Delete", "Del") == 1) {
            context_menu_close();
            delete_selection();
        }
        yy = yy + item_h;
    }

    menu_separator(rx, yy + 4, dw); yy = yy + sep_h;
    let r5: Rect = rect(rx + 2, yy, dw - 4, item_h);
    if (point_in_rect(mx, my, r5)) main_hover_kind = "leaf";
    if (menu_item(r5.x, r5.y, r5.w, "Cancel", "Esc") == 1) {
        context_menu_close();
        return;
    }

    /* Resolve submenu visibility from main-menu hover. Hover on a leaf in
     * the main column collapses the submenu. Hover on "Create" expands it
     * (without dropping any open 2nd-level submenu). */
    if (main_hover_kind == "leaf") context_submenu = "";
    if (main_hover_kind == "create") {
        if (cm_sub2_open() == 0) {
            context_submenu = "create";
        }
    }

    /* If the bookkeeping above closed the menu, bail out before drawing
     * any of its child boxes. */
    if (context_menu_active == 0) return;

    /* draw nested submenus on top */
    if (cm_create_open() == 1) {
        cm_draw_create_submenu();
    }
    if (context_submenu == "create_2d") cm_draw_2d_submenu();
    if (context_submenu == "create_ui") cm_draw_ui_submenu();
    if (context_submenu == "create_3d") cm_draw_3d_submenu();

    /* Click-outside dismissal needs to consider all visible boxes. */
    if (mouse_pressed(MOUSE_LEFT)) {
        let inside: bool = point_in_rect(mx, my, main_box);
        if (inside == false &&
            (cm_create_open() == 1)) {
            inside = point_in_rect(mx, my, rect(context_subbox_x,  context_subbox_y,  context_subbox_w,  context_subbox_h));
        }
        if (inside == false &&
            (cm_sub2_open() == 1)) {
            inside = point_in_rect(mx, my, rect(context_sub2box_x, context_sub2box_y, context_sub2box_w, context_sub2box_h));
        }
        if (inside == false) context_menu_close();
    }

    if (key_pressed(VK_ESCAPE)) {
        if (context_submenu.len() > 0) context_submenu = "";
        else context_menu_active = 0;
    }
}

fn viewport_input() {
    let v: Rect = viewport_rect();
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let inside: bool = point_in_rect(mx, my, v);

    if (view3d_toggle_input() == 1) return;

    /* finish drags / pans on mouse release before handling new input */
    if (mouse_released(MOUSE_LEFT)) {
        if (resize_active == 1 || rotate_active == 1 || scale_uniform_active == 1) {
            last_inspector_slot = -1;
        }
        drag_active = 0;
        drag_recorded = 0;
        move_axis = 0;
        resize_active = 0;
        resize_slot = -1;
        resize_recorded = 0;
        rotate_active = 0;
        rotate_slot = -1;
        rotate_recorded = 0;
        scale_uniform_active = 0;
        scale_uniform_slot = -1;
        scale_recorded = 0;
        if (edit_tool == "hand" || key_down(VK_SPACE) == 0) cam_panning = 0;
    }
    if (mouse_released(MOUSE_MIDDLE)) cam_panning = 0;
    if (key_released(VK_SPACE) && mouse_down(MOUSE_LEFT) == 0) cam_panning = 0;

    if (inside && key_pressed(VK_F) && edit_target.len() == 0) camera_reset();

    if (inside) {
        let w: int = eng_mouse_wheel();
        if (w != 0) {
            let pre_wx: float = screen_to_world_x(mx);
            let pre_wy: float = screen_to_world_y(my);
            let factor: float = 1.0 + w * 0.12;
            cam_zoom = cam_zoom * factor;
            if (cam_zoom < 0.1) cam_zoom = 0.1;
            if (cam_zoom > 6.0) cam_zoom = 6.0;
            let post_wx: float = screen_to_world_x(mx);
            let post_wy: float = screen_to_world_y(my);
            cam_x = cam_x + (pre_wx - post_wx);
            cam_y = cam_y + (pre_wy - post_wy);
        }
    }

    /* pan: middle mouse, hand tool, or space+drag */
    if (inside && mouse_pressed(MOUSE_MIDDLE)) {
        cam_panning = 1;
        cam_pan_anchor_x = mx;
        cam_pan_anchor_y = my;
        cam_pan_start_camx = cam_x;
        cam_pan_start_camy = cam_y;
    }
    if (edit_tool == "hand" && inside && mouse_pressed(MOUSE_LEFT)) {
        cam_panning = 1;
        cam_pan_anchor_x = mx;
        cam_pan_anchor_y = my;
        cam_pan_start_camx = cam_x;
        cam_pan_start_camy = cam_y;
    }
    if (key_down(VK_SPACE) && inside && mouse_pressed(MOUSE_LEFT)) {
        cam_panning = 1;
        cam_pan_anchor_x = mx;
        cam_pan_anchor_y = my;
        cam_pan_start_camx = cam_x;
        cam_pan_start_camy = cam_y;
    }
    if (cam_panning == 1) {
        let panning: int = 0;
        if (mouse_down(MOUSE_MIDDLE)) panning = 1;
        if (edit_tool == "hand" && mouse_down(MOUSE_LEFT)) panning = 1;
        if (key_down(VK_SPACE) && mouse_down(MOUSE_LEFT)) panning = 1;
        if (panning == 1) {
            let dx: float = mx - cam_pan_anchor_x;
            let dy: float = my - cam_pan_anchor_y;
            cam_x = cam_pan_start_camx - dx / cam_zoom;
            cam_y = cam_pan_start_camy - dy / cam_zoom;
        }
    }

    if (inside && mouse_pressed(MOUSE_RIGHT)) {
        let hit: int = viewport_hit_at(mx, my);
        if (hit >= 0) {
            if (ent_selected(hit) == 0) { sel_clear(); ent_set_selected(hit, 1); }
        }
        context_menu_open(mx, my);
        return;
    }
    if (context_menu_active == 1) return;
    if (cam_panning == 1) return;

    /* begin transforms on click (before ongoing drag updates) */
    if (edit_tool == "scale" && inside && mouse_pressed(MOUSE_LEFT) &&
        drag_active == 0 && box_select_active == 0 && rotate_active == 0 &&
        scale_uniform_active == 0 && resize_active == 0) {
        let rh: int = resize_handle_at(mx, my);
        if (rh >= 0 && resize_slot >= 0 && (ent_is_ui(resize_slot) == 1 || xform_local == 0)) {
            resize_begin(resize_slot, rh);
            return;
        }
        if (xform_local == 1) {
            if (scale_local_press(mx, my) == 1) return;
        }
    }

    if (edit_tool != "hand" && inside && mouse_pressed(MOUSE_LEFT) &&
        drag_active == 0 && box_select_active == 0 && resize_active == 0 &&
        rotate_active == 0 && scale_uniform_active == 0) {
        if (edit_tool == "move") {
            let gizmo_axis: int = move_gizmo_pick_selection(mx, my);
            if (gizmo_axis != 0) {
                move_axis = gizmo_axis;
                if (move_axis == 3) move_axis = 0;
                drag_active = 1;
                drag_anchor_x = mx;
                drag_anchor_y = my;
                drag_recorded = 0;
                return;
            }
        }
        let hit: int = -1;
        if (edit_tool == "rotate") hit = rotate_tool_pick(mx, my);
        else                      hit = viewport_hit_at(mx, my);
        if (hit >= 0) {
            if (ctrl_held()) {
                if (ent_selected(hit) == 1) ent_set_selected(hit, 0);
                else                        ent_set_selected(hit, 1);
            } else {
            if (shift_held() == false && ent_selected(hit) == 0) sel_clear();
            ent_set_selected(hit, 1);
            if (edit_tool == "move") {
                move_axis = 0;
                drag_active = 1;
                drag_anchor_x = mx;
                drag_anchor_y = my;
                drag_recorded = 0;
            } else if (edit_tool == "rotate") {
                rotate_begin_drag(hit, mx, my);
                rotate_apply_drag(mx, my);
            } else if (edit_tool == "scale" && ent_is_ui(hit) == 0) {
                scale_begin_uniform(hit, mx, my);
                scale_apply_uniform(mx, my);
            }
            }
        } else if (edit_tool == "move" && shift_held() == false && ctrl_held() == false && sel_pick_at(mx, my) >= 0) {
            /* grab inside a selected object's pad — keep multi-select and drag the group */
            move_axis = 0;
            drag_active = 1;
            drag_anchor_x = mx;
            drag_anchor_y = my;
            drag_recorded = 0;
        } else if (edit_tool != "rotate") {
            if (shift_held() == false && ctrl_held() == false) sel_clear();
            box_select_active = 1;
            box_select_x0 = mx;
            box_select_y0 = my;
        }
    }

    if (resize_active == 1 && mouse_down(MOUSE_LEFT)) {
        resize_apply(mx, my);
        return;
    }
    if (rotate_active == 1 && mouse_down(MOUSE_LEFT)) {
        rotate_apply_drag(mx, my);
        return;
    }
    if (scale_uniform_active == 1 && mouse_down(MOUSE_LEFT)) {
        if (ent_is_ui(scale_uniform_slot) == 1) {
            ui_canvas_layout_game_view(game_view_rect());
            scale_apply_uniform_ui(mx, my);
        } else {
            scale_apply_uniform(mx, my);
        }
        return;
    }

    if (drag_active == 1 && mouse_down(MOUSE_LEFT) && edit_tool == "move") {
        let dx_screen: int = mx - drag_anchor_x;
        let dy_screen: int = my - drag_anchor_y;
        if (dx_screen != 0 || dy_screen != 0) {
            if (drag_recorded == 0) {
                undo_begin_group();
                let s: int = sel_first();
                while (s >= 0) {
                    undo_save_modify_tree(s);
                    s = sel_iter_next(s + 1);
                }
                undo_end_group();
                let origin: int = sel_move_root();
                if (origin < 0) origin = sel_ui_move_root();
                if (origin >= 0) {
                    move_from_x = ent_x(origin);
                    move_from_y = ent_y(origin);
                }
                drag_recorded = 1;
            }
            if (sel_move_root() < 0 && sel_ui_move_root() >= 0) {
                ui_canvas_layout_game_view(game_view_rect());
                let uroot: int = sel_ui_move_root();
                let dxf: float = dx_screen;
                let dyf: float = dy_screen;
                let dxu: int = ui_round(dxf / ui_scale_x);
                let dyu: int = ui_round(dyf / ui_scale_y);
                move_along(dxu, dyu, move_axis, uroot);
                let tx: int = drag_snap_target(move_from_x, move_out_x);
                let ty: int = drag_snap_target(move_from_y, move_out_y);
                let adx: int = tx - ent_x(uroot);
                let ady: int = ty - ent_y(uroot);
                if (adx != 0 || ady != 0) {
                    let us: int = sel_first();
                    while (us >= 0) {
                        if (ent_is_ui(us) == 1 && sel_is_carried(us) == 0) {
                            if (adx != 0) ent_set_x(us, ent_x(us) + adx);
                            if (ady != 0) ent_set_y(us, ent_y(us) + ady);
                        }
                        us = sel_iter_next(us + 1);
                    }
                }
            } else if (sel_move_root() >= 0) {
                let wroot: int = sel_move_root();
                let dxw: float = dx_screen;
                let dyw: float = dy_screen;
                let dx: int = dxw / cam_zoom;
                let dy: int = dyw / cam_zoom;
                move_along(dx, dy, move_axis, wroot);
                let tx: int = drag_snap_target(move_from_x, move_out_x);
                let ty: int = drag_snap_target(move_from_y, move_out_y);
                let adx: int = tx - ent_x(wroot);
                let ady: int = ty - ent_y(wroot);
                if (adx != 0 || ady != 0) sel_move_by(adx, ady, 0);
            }
        }
    }

    if (box_select_active == 1 && mouse_released(MOUSE_LEFT)) {
        /* finalize: select every entity intersecting the box (in world space) */
        let x0: int = box_select_x0;
        let y0: int = box_select_y0;
        let x1: int = mx;
        let y1: int = my;
        if (x1 < x0) { let t: int = x0; x0 = x1; x1 = t; }
        if (y1 < y0) { let t: int = y0; y0 = y1; y1 = t; }
        ui_canvas_layout_game_view(game_view_rect());
        let wx0: float = screen_to_world_x(x0);
        let wy0: float = screen_to_world_y(y0);
        let wx1: float = screen_to_world_x(x1);
        let wy1: float = screen_to_world_y(y1);
        let ux0: float = screen_to_ui_x(x0);
        let uy0: float = screen_to_ui_y(y0);
        let ux1: float = screen_to_ui_x(x1);
        let uy1: float = screen_to_ui_y(y1);
        let i: int = ent_iter_next(0);
        while (i >= 0) {
            if (ent_is_ui(i) == 1) {
                i = ent_iter_next(i + 1);
                continue;
            }
            let ex0: int = ent_x(i);
            let ey0: int = ent_y(i);
            let ex1: int = ex0 + ent_w(i);
            let ey1: int = ey0 + ent_h(i);
            let bx0: float = wx0;
            let by0: float = wy0;
            let bx1: float = wx1;
            let by1: float = wy1;
            if (ent_is_ui(i) == 1) {
                bx0 = ux0;
                by0 = uy0;
                bx1 = ux1;
                by1 = uy1;
            }
            let overlap: int = 1;
            if (ex1 < bx0) overlap = 0;
            if (ex0 > bx1) overlap = 0;
            if (ey1 < by0) overlap = 0;
            if (ey0 > by1) overlap = 0;
            if (overlap == 1) ent_set_selected(i, 1);
            i = ent_iter_next(i + 1);
        }
        box_select_active = 0;
    }
}

// =============================================================================
// Menu bar (File / Edit / View / Project / Help)
// =============================================================================

fn menu_label_w(label: string): int {
    th_font(12);
    let w: int = eng_text_width(label) + 22;
    th_font(14);
    return w;
}

fn menu_item(rx: int, ry: int, rw: int, label: string, shortcut: string): int {
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let r: Rect = rect(rx, ry, rw, 22);
    let hover: bool = point_in_rect(mx, my, r);
    let lit: int = 0;
    if (hover) lit = 1;
    th_menu_row(r, lit);
    th_font(12);
    let ty: int = th_text_y(ry, 22);
    draw_text(rx + 14, ty, label, col_text_main());
    if (shortcut.len() > 0) {
        let sw: int = eng_text_width(shortcut);
        draw_text(rx + rw - sw - 14, ty, shortcut, col_text_dim());
    }
    th_font(14);
    if (hover && mouse_pressed(MOUSE_LEFT)) return 1;
    return 0;
}

fn menu_separator(rx: int, ry: int, rw: int) {
    draw_fill_rect(rect(rx + 10, ry, rw - 20, 1), col_ui_border());
}

fn menu_dropdown_file(rx: int, ry: int) {
    let dw: int = 220;
    let dh: int = 8 + 22 * 8 + 8 * 2;          /* 8 items, 2 separators */
    chrome_popup(rect(rx, ry, dw, dh));
    let yy: int = ry + 4;
    if (menu_item(rx + 2, yy, dw - 4, "New Project...",  "")          == 1) {
        menu_open = ""; welcome_action = "new"; app_state = "welcome";
    }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Open Project...", "")          == 1) {
        menu_open = ""; welcome_action = "open"; app_state = "welcome";
    }
    yy = yy + 22;
    menu_separator(rx, yy + 4, dw); yy = yy + 8;
    if (menu_item(rx + 2, yy, dw - 4, "Save Scene",      "Ctrl+S")    == 1) { menu_open = ""; save_active_scene(); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "New Scene",       "")          == 1) { menu_open = ""; add_new_scene(); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Next Scene",      "Ctrl+PgDn") == 1) { menu_open = ""; cycle_scene(1); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Previous Scene",  "Ctrl+PgUp") == 1) { menu_open = ""; cycle_scene(-1); }
    yy = yy + 22;
    menu_separator(rx, yy + 4, dw); yy = yy + 8;
    if (menu_item(rx + 2, yy, dw - 4, "Close Project",   "")          == 1) { menu_open = ""; close_active_project(); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Quit",            "")          == 1) { menu_open = ""; want_quit = 1; }
}

fn menu_dropdown_edit(rx: int, ry: int) {
    let dw: int = 200;
    let dh: int = 8 + 22 * 4 + 8;              /* 4 items, 1 separator */
    chrome_popup(rect(rx, ry, dw, dh));
    let yy: int = ry + 4;
    if (menu_item(rx + 2, yy, dw - 4, "Undo", "Ctrl+Z") == 1) { menu_open = ""; undo(); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Redo", "Ctrl+Y") == 1) { menu_open = ""; redo(); }
    yy = yy + 22;
    menu_separator(rx, yy + 4, dw); yy = yy + 8;
    if (menu_item(rx + 2, yy, dw - 4, "Delete Selection", "Del") == 1) { menu_open = ""; delete_selection(); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Clear All",        "")    == 1) { menu_open = ""; ent_clear_all(); sel_clear(); }
}

fn menu_dropdown_view(rx: int, ry: int) {
    let dw: int = 220;
    let dh: int = 8 + 22 * 4;
    chrome_popup(rect(rx, ry, dw, dh));
    let yy: int = ry + 4;
    if (menu_item(rx + 2, yy, dw - 4, "Scene Viewport",  "") == 1) { menu_open = ""; viewport_show("scene"); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "UI Editor",       "") == 1) { menu_open = ""; viewport_show("ui"); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Play",            "") == 1) { menu_open = ""; viewport_show("play"); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Script Editor",   "") == 1) {
        menu_open = "";
        let tp: string = te_path();
        if (tp.len() > 0) viewport_show("script");
    }
}

fn menu_dropdown_project(rx: int, ry: int) {
    let dw: int = 240;
    let dh: int = 8 + 22 * 9 + 8 * 2;          /* 9 items, 2 separators */
    chrome_popup(rect(rx, ry, dw, dh));
    let yy: int = ry + 4;
    if (menu_item(rx + 2, yy, dw - 4, "Settings",         "")             == 1) { settings_show(); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Build",            "Ctrl+B")       == 1) { menu_open = ""; compile_begin("idle"); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Rebuild All",      "Ctrl+Shift+B") == 1) { menu_open = ""; force_rebuild = 1; compile_begin("idle"); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Play",             "Ctrl+P")       == 1) { menu_open = ""; want_play = 1; }
    yy = yy + 22;
    menu_separator(rx, yy + 4, dw); yy = yy + 8;
    if (menu_item(rx + 2, yy, dw - 4, "Export...", "Ctrl+E") == 1) { menu_open = ""; export_show(0); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "New Extension...", "") == 1) { menu_open = ""; extbuild_show(); }
    yy = yy + 22;
    menu_separator(rx, yy + 4, dw); yy = yy + 8;
    if (menu_item(rx + 2, yy, dw - 4, "Rescan Scripts",   "")             == 1) { menu_open = ""; proj_rescan_scripts(); }
    yy = yy + 22;
    if (menu_item(rx + 2, yy, dw - 4, "Open Project Folder", "")          == 1) {
        menu_open = "";
        eng_run_command("explorer \"" + proj_root() + "\"");
    }
}

fn menu_dropdown_help(rx: int, ry: int) {
    let dw: int = 240;
    let dh: int = 8 + 22 * 1;
    chrome_popup(rect(rx, ry, dw, dh));
    if (menu_item(rx + 2, ry + 4, dw - 4, "About Eyescire 0.1", "") == 1) {
        menu_open = "";
        eng_log("[help] Eyescire Engine 0.1 - Nexa-powered 2D / 3D editor");
    }
}

fn menubar_draw() {
    let r: Rect = menubar_rect();
    draw_fill_rect(r, col_bg_deep());
    chrome_hsep(r.x, r.y + r.h - 1, r.w);

    let labels = ["File", "Edit", "View", "Project", "Help"];
    let ids    = ["file", "edit", "view", "project", "help"];

    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let xx: int = 4;
    let i: int = 0;
    while (i < 5) {
        let lab: string = labels[i];
        let id:  string = ids[i];
        let lw: int = menu_label_w(lab);
        let mr: Rect = rect(xx, r.y + 3, lw, MENUBAR_H - 6);
        let active: int = 0;
        if (menu_open == id) active = 1;
        let hover: bool = point_in_rect(mx, my, mr);
        if (active == 1)  th_fill(mr, 4, col_panel_lit());
        else if (hover)   th_fill(mr, 4, col_panel_med());
        let tc: Color = col_text_dim();
        if (active == 1 || hover) tc = col_text_main();
        th_font(12);
        draw_text_centered(mr.x, mr.y, mr.w, mr.h, lab, tc);
        th_font(14);
        if (hover && mouse_pressed(MOUSE_LEFT) && settings_open == 0 && export_open == 0 && extbuild_open == 0 && extdev_open == 0) {
            if (menu_open == id) menu_open = "";
            else                 { menu_open = id; menu_just_opened = 1; }
        }
        xx = xx + lw + 2;
        i = i + 1;
    }
}

fn menu_draw_dropdown_overlay() {
    if (menu_open.len() == 0) return;
    let labels = ["File", "Edit", "View", "Project", "Help"];
    let ids    = ["file", "edit", "view", "project", "help"];
    let xx: int = 4;   /* same walk as menubar_draw so each dropdown sits under its label */
    let i: int = 0;
    while (i < 5) {
        let lab: string = labels[i];
        let id:  string = ids[i];
        let lw: int = menu_label_w(lab);
        if (id == menu_open) {
            let dy: int = MENUBAR_H + 2;
            if (id == "file")    menu_dropdown_file(xx, dy);
            if (id == "edit")    menu_dropdown_edit(xx, dy);
            if (id == "view")    menu_dropdown_view(xx, dy);
            if (id == "project") menu_dropdown_project(xx, dy);
            if (id == "help")    menu_dropdown_help(xx, dy);
            return;
        }
        xx = xx + lw + 2;
        i = i + 1;
    }
}

fn menu_dismiss_if_outside_click() {
    if (menu_open.len() == 0) return;
    if (menu_just_opened == 1) { menu_just_opened = 0; return; }
    if (mouse_pressed(MOUSE_LEFT) == false) return;
    /* if click landed neither on the menu bar nor on an active dropdown, dismiss */
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    if (my < MENUBAR_H) return;            /* clicks on menu bar handled there */
    /* dropdown footprint (x from the same walk as menubar_draw); items handle the click */
    let ids = ["file", "edit", "view", "project", "help"];
    let labels = ["File", "Edit", "View", "Project", "Help"];
    let xx: int = 4;
    let i: int = 0;
    while (i < 5) {
        if (ids[i] == menu_open) {
            if (my < MENUBAR_H + 270 && mx >= xx && mx < xx + 240) return;
        }
        xx = xx + menu_label_w(labels[i]) + 2;
        i = i + 1;
    }
    menu_open = "";
}

// =============================================================================
// Viewport tabs (Scene / Script)
// =============================================================================

fn viewport_tabs_draw() {
    let r: Rect = viewport_tabs_rect();
    draw_fill_rect(r, col_header());
    chrome_hsep(r.x, r.y + r.h - 1, r.w);
    chrome_vsep(r.x, r.y, r.h);

    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let on_toggle: int = 0;
    if (scene_render3d() == 1 && viewport_mode == "scene" && point_in_rect(mx, my, view3d_toggle_rect())) on_toggle = 1;
    let xx: int = r.x + 8;
    let scene_label: string = "(no scene)";
    if (proj_loaded() == 1 && proj_scene_count() > 0) {
        scene_label = path_basename(proj_scene_rel(proj_active_scene()));
    }
    th_font_semi(12);
    let scene_w: int = eng_text_width(scene_label) + 44;
    th_font(14);
    let scene_tab: Rect = rect(xx, r.y, scene_w, r.h - 1);
    let active_scene: int = 0;
    if (viewport_mode == "scene") active_scene = 1;
    let scene_hover: int = 0;
    if (point_in_rect(mx, my, scene_tab)) scene_hover = 1;
    th_tab(rect(scene_tab.x, scene_tab.y, scene_tab.w - 18, scene_tab.h), scene_label, active_scene, scene_hover);
    let chev_r: Rect = rect(scene_tab.x + scene_tab.w - 24, scene_tab.y + 5, 18, scene_tab.h - 10);
    if (point_in_rect(mx, my, chev_r)) th_fill(chev_r, 4, col_panel_lit());
    icon_in_rect("chevron_down", chev_r, 3, col_text_dim());
    if (on_toggle == 0 && point_in_rect(mx, my, scene_tab) && mouse_pressed(MOUSE_LEFT)) {
        if (point_in_rect(mx, my, chev_r)) {
            scene_picker_open = 1;
            scene_picker_x = scene_tab.x;
            scene_picker_y = scene_tab.y + scene_tab.h;
        } else {
            viewport_show("scene");
        }
    }
    xx = xx + scene_w + 4;

    let ui_w: int = 52;
    let ui_tab: Rect = rect(xx, r.y, ui_w, r.h - 1);
    let active_ui: int = 0;
    if (viewport_mode == "ui") active_ui = 1;
    let ui_hover: int = 0;
    if (point_in_rect(mx, my, ui_tab)) ui_hover = 1;
    th_tab(ui_tab, "UI", active_ui, ui_hover);
    if (on_toggle == 0 && point_in_rect(mx, my, ui_tab) && mouse_pressed(MOUSE_LEFT)) viewport_show("ui");
    xx = xx + ui_w + 4;

    let play_w: int = 64;
    let play_tab: Rect = rect(xx, r.y, play_w, r.h - 1);
    let active_play: int = 0;
    if (viewport_mode == "play") active_play = 1;
    let play_hover: int = 0;
    if (point_in_rect(mx, my, play_tab)) play_hover = 1;
    th_tab(play_tab, "Play", active_play, play_hover);
    if (on_toggle == 0 && point_in_rect(mx, my, play_tab) && mouse_pressed(MOUSE_LEFT)) viewport_show("play");
    xx = xx + play_w + 4;

    let cur_path: string = bp_tab_path();
    if (cur_path.len() > 0) {
        let stitle: string = path_basename(cur_path);
        if (bp_tab_dirty() == 1) stitle = stitle + " *";
        th_font_semi(12);
        let sw: int = eng_text_width(stitle) + 52;
        th_font(14);
        let stab: Rect = rect(xx, r.y, sw, r.h - 1);
        let active_script: int = 0;
        if (viewport_mode == "script") active_script = 1;
        let script_hover: int = 0;
        if (point_in_rect(mx, my, stab)) script_hover = 1;
        th_tab(rect(stab.x, stab.y, stab.w - 18, stab.h), stitle, active_script, script_hover);
        if (on_toggle == 0 && point_in_rect(mx, my, stab) && mouse_pressed(MOUSE_LEFT)) viewport_show("script");
        let close_r: Rect = rect(stab.x + sw - 24, stab.y + 5, 18, stab.h - 10);
        if (point_in_rect(mx, my, close_r)) th_fill(close_r, 4, col_panel_lit());
        icon_in_rect("close", close_r, 3, col_text_dim());
        if (on_toggle == 0 && point_in_rect(mx, my, close_r) && mouse_pressed(MOUSE_LEFT)) {
            bp_tab_close();
            viewport_show("scene");
        }
    }
}

// =============================================================================
// Status bar
// =============================================================================

fn statusbar_draw() {
    let r: Rect = statusbar_rect();
    draw_fill_rect(r, col_bg_deep());
    chrome_hsep(r.x, r.y, r.w);

    let proj: string = proj_name();
    if (proj.len() == 0) proj = "no project";
    let scene: string = "-";
    if (proj_loaded() == 1 && proj_scene_count() > 0) scene = path_basename(proj_scene_rel(proj_active_scene()));

    let mode_label: string = "EDIT";
    let mode_col: Color = col_accent();
    if (app_state == "play") {
        mode_label = "PLAY";
        mode_col = col_play();
    } else if (viewport_mode == "play") {
        mode_label = "GAME";
        mode_col = col_play();
    }
    if (viewport_mode == "script") {
        mode_label = "SCRIPT";
        mode_col = col_warn();
        if (bp_is_open() == 1) mode_label = "GRAPH";
    }
    if (viewport_mode == "ui") {
        mode_label = "UI";
        mode_col = rgb(180, 140, 255);
    }

    th_chip(rect(r.x + 6, r.y + 3, 60, r.h - 6), mode_label, mode_col);
    th_font(11);

    let left_text: string = tool_display_name() + " (" + tool_shortcut_key() + ")"
                          + "     " + proj + "  /  " + scene
                          + "     " + sel_count() + " selected";
    draw_text(r.x + 78, th_text_y(r.y, r.h), left_text, col_text_dim());

    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let v: Rect = viewport_rect();
    let inv: bool = point_in_rect(mx, my, v);
    let mlabel: string = "";
    if (inv) mlabel = "x " + (mx - v.x) + "  y " + (my - v.y) + "    ";

    let dt: float = frame_dt_ms();
    if (dt < 0.1) dt = 0.1;
    let fps_int: int = 1000.0 / dt;
    let right_text: string = mlabel + fps_int + " fps";
    let rw: int = eng_text_width(right_text);
    draw_text(r.x + r.w - rw - 10, th_text_y(r.y, r.h), right_text, col_text_dim());
    th_font(14);
}

// =============================================================================
// Hierarchy panel (entity list, occupies the top of the left side)
// =============================================================================

fn hierarchy_input(r: Rect) {
    if (context_menu_active == 1) return;
    if (drag_is_active()) return;

    hier_fold_ate_click = 0;
    hier_eye_ate_click = 0;

    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let body: Rect = rect(r.x, r.y + 24, r.w, r.h - 24);
    let inside: bool = point_in_rect(mx, my, body);
    let row_h: int = 20;
    let indent: int = 16;

    /* fold-arrow / eye click (must run before row select / drag) */
    if (inside && mouse_pressed(MOUSE_LEFT)) {
        let hrow: int = hier_row_at(mx, my, r);
        if (hrow >= 0) {
            let slot: int = ent_hier_slot(hrow);
            let depth: int = ent_hier_depth(hrow);
            if (slot >= 0 && ent_child_count(slot) > 0) {
                let ix: int = r.x + 2 + depth * indent;
                let row_y: int = r.y + 26 + (hrow - hier_scroll) * row_h;
                let fold_r: Rect = rect(ix + 2, row_y + 2, 14, row_h - 4);
                if (point_in_rect(mx, my, fold_r)) {
                    ent_hier_toggle_expanded(slot);
                    hier_fold_ate_click = 1;
                    return;
                }
            }
            let eye: Rect = hier_eye_rect_at(r, depth, hrow);
            if (slot >= 0 && point_in_rect(mx, my, eye)) {
                undo_save_modify(slot);
                if (ent_visible(slot) == 1) ent_set_visible(slot, 0);
                else                         ent_set_visible(slot, 1);
                hier_eye_ate_click = 1;
                return;
            }
        } else if (shift_held() == false && ctrl_held() == false) {
            /* empty list space — clear and arm a drag-select from this Y */
            if (rename_ent_slot >= 0) inspector_end_rename();
            sel_clear();
            hier_press_row = hier_row_at_clamped(mx, my, r);
            hier_press_was_sel = 0;
            hier_drag_slot = -1;
            hier_drag_x = mx;
            hier_drag_y = my;
            hier_drag_active = 0;
            hier_range_active = 0;
        }
    }

    /* promote pending press into reparent-drag OR range-select */
    if (hier_range_active == 0 && hier_drag_active == 0 && mouse_down(MOUSE_LEFT)) {
        if (hier_press_row >= 0 || hier_drag_slot >= 0) {
            let dx: int = mx - hier_drag_x;
            let dy: int = my - hier_drag_y;
            if (dx < 0) dx = -dx;
            if (dy < 0) dy = -dy;
            if (dx > 4 || dy > 4) {
                if (hier_press_was_sel == 1 && hier_drag_slot >= 0) {
                    hier_drag_active = 1;
                } else {
                    hier_range_active = 1;
                    if (hier_press_row < 0) hier_press_row = hier_row_at_clamped(mx, my, r);
                }
            }
        }
    }

    if (hier_range_active == 1 && mouse_down(MOUSE_LEFT)) {
        let cur: int = hier_row_at_clamped(mx, my, r);
        if (cur >= 0 && hier_press_row >= 0) {
            hier_select_range(hier_press_row, cur, 0);
            hier_anchor_row = hier_press_row;
        }
    }

    if (hier_drag_active == 1) {
        hier_drop_target = -2;
        let row: int = hier_row_at(mx, my, r);
        if (row >= 0) {
            let target: int = ent_hier_slot(row);
            if (target >= 0 && target != hier_drag_slot) {
                if (hier_is_descendant(hier_drag_slot, target) == 0) {
                    hier_drop_target = target;
                }
            }
        } else if (inside) {
            hier_drop_target = -1;   /* empty panel space -> unparent to root */
        }
    }

    if (mouse_released(MOUSE_LEFT) && (hier_drag_slot >= 0 || hier_range_active == 1 || hier_press_row >= 0)) {
        let dropped: int = 0;
        if (hier_drag_active == 1 && hier_drag_slot >= 0 && bp_is_open() == 1 && viewport_mode == "script") {
            let dxm: int = eng_mouse_x();
            let dym: int = eng_mouse_y();
            if (point_in_rect(dxm, dym, bp_canvas()) && bp_over_props(dxm, dym) == 0) {
                bp_drop_object(hier_drag_slot, dxm, dym);
                dropped = 1;
            }
        }
        if (dropped == 0 && hier_drag_active == 1 && hier_drag_slot >= 0) {
            if (hier_drop_target >= -1) {
                /* reparent every selected root so multi-select can be moved together */
                if (ent_selected(hier_drag_slot) == 1 && sel_count() > 1) {
                    let s: int = sel_first();
                    while (s >= 0) {
                        if (sel_is_carried(s) == 0) hier_reparent(s, hier_drop_target);
                        s = sel_iter_next(s + 1);
                    }
                } else {
                    hier_reparent(hier_drag_slot, hier_drop_target);
                }
            }
        }
        if (hier_range_active == 1 && hier_press_row >= 0) {
            let end_row: int = hier_row_at_clamped(mx, my, r);
            if (end_row >= 0) hier_anchor_row = end_row;
        }
        hier_drag_slot   = -1;
        hier_drag_active = 0;
        hier_drop_target = -2;
        hier_range_active = 0;
        hier_press_row = -1;
        hier_press_was_sel = 0;
    }

    if (mouse_down(MOUSE_LEFT) == false) {
        if (hier_drag_slot >= 0 || hier_range_active == 1 || hier_press_row >= 0) {
            hier_drag_slot   = -1;
            hier_drag_active = 0;
            hier_drop_target = -2;
            hier_range_active = 0;
            hier_press_row = -1;
            hier_press_was_sel = 0;
        }
    }

    /* right-click empty hierarchy space */
    if (inside && mouse_pressed(MOUSE_RIGHT)) {
        let row: int = hier_row_at(mx, my, r);
        if (row < 0) {
            context_menu_open_for("hierarchy", mx, my);
        }
    }
}

fn hier_range_box_draw(r: Rect) {
    if (hier_range_active == 0) return;
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let x0: int = hier_drag_x;
    let y0: int = hier_drag_y;
    let x1: int = mx;
    let y1: int = my;
    if (x1 < x0) { let t: int = x0; x0 = x1; x1 = t; }
    if (y1 < y0) { let t: int = y0; y0 = y1; y1 = t; }
    let body: Rect = rect(r.x, r.y + 24, r.w, r.h - 24);
    eng_set_clip(body.x, body.y, body.w, body.h);
    let br: Rect = rect(x0, y0, x1 - x0, y1 - y0);
    let c: Color = th_white();
    eng_fill_rect_a(br.x, br.y, br.w, br.h, c.r, c.g, c.b, 40);
    draw_outline_rect(br, 1, c);
    eng_clear_clip();
}

fn hier_drag_preview_draw() {
    if (hier_range_active == 1) return;
    if (hier_drag_active == 0 || hier_drag_slot < 0) return;
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let label: string = ent_name(hier_drag_slot);
    if (label.len() == 0) label = "(unnamed)";
    eng_set_font_size(12);
    let tw: int = eng_text_width(label);
    let pr: Rect = rect(mx + 14, my + 6, tw + 18, 24);
    draw_fill_rect(pr, col_accent_dim());
    draw_outline_rect(pr, 1, col_accent());
    draw_text(pr.x + 9, pr.y + 5, label, col_text_main());
    eng_set_font_size(14);
}

fn hier_eye_rect_at(r: Rect, depth: int, hrow: int): Rect {
    let row_h: int = 20;
    let indent: int = 16;
    let ix: int = r.x + 2 + depth * indent;
    let row_y: int = r.y + 26 + (hrow - hier_scroll) * row_h;
    let row_w: int = r.w - 4 - depth * indent;
    return rect(ix + row_w - 20, row_y + 2, 16, row_h - 4);
}

fn hier_eye_draw(eye: Rect, open: int, c: Color) {
    let x: int = eye.x + 1;
    let y: int = eye.y + 1;
    if (open == 1) {
        eng_outline_round_a(x, y + 3, 12, 7, 3, 1, c.r, c.g, c.b, 255);
        eng_fill_round_a(x + 4, y + 4, 4, 4, 2, c.r, c.g, c.b, 255);
    } else {
        eng_line(x, y + 6, x + 12, y + 6, c.r, c.g, c.b);
        eng_line(x + 1, y + 3, x + 11, y + 9, c.r, c.g, c.b);
    }
}

fn hier_icon_name(slot: int): string {
    let kind: string = ent_kind(slot);
    if (kind == "label" || kind == "ui_label") return "label";
    if (ent_is_empty(slot) == 1) return "empty";
    if (ent_is_camera_ent(slot) == 1) return "camera";
    if (kind == "light_spot") return "light_spot";
    if (kind == "light_ambient") return "light_ambient";
    if (kind == "light_directional") return "light_dir";
    if (kind == "light_point") return "light_point";
    if (kind == "cube") return "cube";
    if (kind == "sphere") return "sphere";
    if (kind == "cylinder") return "cylinder";
    if (kind == "capsule") return "capsule";
    if (kind == "model") return "model";
    if (kind == "sprite2d") return "sprite";
    if (ui_ent_is_button(slot) == 1 || ui_ent_is_check(slot) == 1 || ui_ent_is_toggle(slot) == 1) return "button";
    if (ent_is_ui(slot) == 1) return "panel";
    if (ent_sprite_id(slot) != 0) return "sprite";
    return "rect";
}

fn hierarchy_draw(r: Rect) {
    insp_name_field_done = 0;
    chrome_panel(r);
    chrome_vsep(r.x + r.w - 1, r.y, r.h);
    let header: Rect = rect(r.x, r.y, r.w, 24);
    chrome_header_bar(header, "Hierarchy");

    let btn_y: int = r.y + 3;
    let btn_h: int = 18;
    if (ui_chrome_icon(rect(r.x + r.w - 56, btn_y, 22, btn_h), "minus", "Collapse all", "secondary") == 1) ent_hier_collapse_all();
    if (ui_chrome_icon(rect(r.x + r.w - 30, btn_y, 22, btn_h), "plus", "Expand all", "secondary") == 1) ent_hier_expand_all();

    hierarchy_input(r);

    eng_set_clip(r.x, r.y + 24, r.w, r.h - 24);
    let row_h: int = 20;
    let indent: int = 16;
    let visible_rows: int = (r.h - 28) / row_h;
    let total: int = ent_hier_count();
    let max_scroll: int = total - visible_rows;
    if (max_scroll < 0) max_scroll = 0;
    if (hier_scroll > max_scroll) hier_scroll = max_scroll;
    if (hier_scroll < 0) hier_scroll = 0;

    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();

    let yy: int = r.y + 26;
    let row: int = hier_scroll;
    let drawn: int = 0;
    while (row < total && drawn < visible_rows + 1) {
        let slot: int = ent_hier_slot(row);
        let depth: int = ent_hier_depth(row);
        if (slot < 0) {
            row = row + 1;
            continue;
        }

        let ix: int = r.x + 2 + depth * indent;
        let row_rect: Rect = rect(ix, yy, r.w - 4 - depth * indent, row_h);
        let is_sel: int = ent_selected(slot);
        let hover: bool = point_in_rect(mx, my, row_rect);
        let is_drop: int = 0;
        if (hier_drag_active == 1 && hier_drop_target == slot) is_drop = 1;

        let row_hover: int = 0;
        if (hover) row_hover = 1;
        if (is_drop == 1) {
            th_fill_a(row_rect, 4, col_play(), 70);
            th_edge(row_rect, 4, col_play());
        } else {
            th_row(row_rect, is_sel, row_hover);
        }

        let cc: int = ent_child_count(slot);
        let text_x: int = row_rect.x + 10;

        /* fold arrow for parents */
        if (cc > 0) {
            let fold_r: Rect = rect(row_rect.x + 2, row_rect.y + 2, 14, row_h - 4);
            let expanded: int = ent_hier_expanded(slot);
            let arrow: string = "chevron_right";
            if (expanded == 1) arrow = "chevron_down";
            icon_in_rect(arrow, fold_r, 2, col_text_dim());
            text_x = row_rect.x + 18;
        }

        /* tree guide lines for nested rows */
        if (depth > 0) {
            let gx: int = r.x + 8 + depth * indent - 8;
            draw_fill_rect(rect(gx, yy + 4, 1, row_h - 8), col_border_soft());
        }

        /* kind icon, tinted with the entity colour when it has one */
        let icn: string = hier_icon_name(slot);
        let ic: Color = col_text_dim();
        if (is_sel == 1) ic = th_white();
        else if (icn != "label" && icn != "empty" && icn != "camera") ic = rgb(ent_r(slot), ent_g(slot), ent_b(slot));
        let icon: Rect = rect(text_x, row_rect.y + (row_h - 14) / 2, 14, 14);
        icon_draw(icn, icon.x, icon.y, icon.w, icon.h, ic);
        let nm: string = ent_name(slot);
        if (nm.len() == 0) nm = "(unnamed)";
        th_font(12);
        let ty: int = th_text_y(row_rect.y, row_h);
        let renaming: int = 0;
        if (edit_target == "insp_name" && rename_ent_slot == slot) renaming = 1;
        let hier_rename_ate: int = 0;
        if (renaming == 1) {
            let eye0: Rect = hier_eye_rect_at(r, depth, row);
            let name_r: Rect = rect(text_x + 18, row_rect.y + 1, eye0.x - (text_x + 18) - 4, row_h - 2);
            if (name_r.w < 40) name_r.w = 40;
            let got: string = ui_field("insp_name", name_r, ent_name(slot));
            insp_name_field_done = 1;
            if (got != ent_name(slot)) {
                undo_save_modify(slot);
                ent_set_name(slot, got);
                if (last_inspector_slot == slot) insp_buf_name = got;
            }
            if (edit_target != "insp_name") rename_ent_slot = -1;
            if (point_in_rect(mx, my, name_r) && mouse_pressed(MOUSE_LEFT)) hier_rename_ate = 1;
        } else {
            let name_c: Color = col_text_main();
            if (ent_shown(slot) == 0) name_c = col_text_dim();
            if (is_sel == 1) name_c = th_white();
            draw_text(text_x + 20, ty, nm, name_c);
            if (cc > 0) {
                let hidden: int = cc;
                if (ent_hier_expanded(slot) == 0) {
                    let child_label: string = "  [" + hidden + "]";
                    let nx: int = text_x + 20 + eng_text_width(nm) + 2;
                    draw_text(nx, ty, child_label, col_text_dim());
                }
            }
            let sc: string = ent_script(slot);
            if (sc.len() > 0) {
                th_font(11);
                let scr_w: int = eng_text_width(sc) + 14;
                let chip: Rect = rect(row_rect.x + row_rect.w - scr_w - 24, row_rect.y + 3, scr_w, row_h - 6);
                th_fill_a(chip, chip.h / 2, col_play(), 40);
                draw_text_centered(chip.x, chip.y, chip.w, chip.h, sc, col_play());
            }
        }
        th_font(14);

        let eye: Rect = hier_eye_rect_at(r, depth, row);
        let eye_c: Color = col_text_dim();
        if (ent_visible(slot) == 0) eye_c = col_text_dim();
        else if (hover) eye_c = col_text_main();
        hier_eye_draw(eye, ent_visible(slot), eye_c);
        if (point_in_rect(mx, my, eye)) tooltip_request("Show or hide this object", eye);

        if (hover && mouse_pressed(MOUSE_LEFT) && hier_drag_active == 0 && hier_range_active == 0 &&
            hier_fold_ate_click == 0 && hier_eye_ate_click == 0 && hier_rename_ate == 0) {
            if (rename_ent_slot >= 0 && rename_ent_slot != slot) inspector_end_rename();
            if (shift_held()) {
                /* select contiguous rows from the anchor to this one */
                let anchor: int = hier_anchor_row;
                if (anchor < 0) {
                    let s0: int = sel_first();
                    if (s0 >= 0) anchor = hier_row_of_slot(s0);
                }
                if (anchor < 0) anchor = row;
                let additive: int = 0;
                if (ctrl_held()) additive = 1;
                hier_select_range(anchor, row, additive);
                hier_press_row = -1;
                hier_drag_slot = -1;
            } else if (ctrl_held()) {
                if (ent_selected(slot) == 1) ent_set_selected(slot, 0);
                else                         ent_set_selected(slot, 1);
                hier_anchor_row = row;
                hier_press_row = -1;
                hier_drag_slot = -1;
            } else {
                /* already-selected → keep multi and arm reparent; else select and arm range-drag */
                let was_sel: int = ent_selected(slot);
                if (was_sel == 0) sel_clear();
                ent_set_selected(slot, 1);
                hier_anchor_row    = row;
                hier_press_row     = row;
                hier_press_was_sel = was_sel;
                hier_drag_slot     = slot;
                hier_drag_x        = mx;
                hier_drag_y        = my;
                hier_drag_active   = 0;
                hier_range_active  = 0;
            }
        }
        if (hover && mouse_pressed(MOUSE_RIGHT)) {
            if (ent_selected(slot) == 0) { sel_clear(); ent_set_selected(slot, 1); }
            context_menu_open_for_entity("hierarchy", mx, my, slot);
        }

        yy = yy + row_h;
        drawn = drawn + 1;
        row = row + 1;
    }
    eng_clear_clip();

    hier_range_box_draw(r);

    /* scroll on wheel */
    if (point_in_rect(mx, my, r)) {
        let w: int = eng_mouse_wheel();
        if (w != 0) hier_scroll = hier_scroll - w * 3;
    }
}

// =============================================================================
// Toolbar
