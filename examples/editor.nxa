// =============================================================================
// Layout / colour helpers
// =============================================================================

fn path_basename(p: string): string {
    let n: int = p.len();
    let i: int = n - 1;
    while (i >= 0) {
        let c: string = p.substring(i, 1);
        if (c == "\\" || c == "/") return p.substring(i + 1, n - i - 1);
        i = i - 1;
    }
    return p;
}

fn path_dirname(p: string): string {
    let n: int = p.len();
    let i: int = n - 1;
    while (i >= 0) {
        let c: string = p.substring(i, 1);
        if (c == "\\" || c == "/") return p.substring(0, i);
        i = i - 1;
    }
    return "";
}

/* Folder under the category root. "scenes/levels/a.scene" -> "levels". */
fn rel_folder(rel: string): string {
    let folder: string = path_dirname(rel);
    if (folder == "scenes") return "";
    if (folder.len() > 7 && folder.substring(0, 7) == "scenes/") return folder.substring(7, folder.len() - 7);
    return folder;
}

fn ensure_parent_dir(path: string) {
    let dir: string = path_dirname(path);
    if (dir.len() > 0) eng_fs_make_dir(dir);
}

fn path_is_obj(p: string): int {
    let n: int = p.len();
    if (n < 4) return 0;
    let tail: string = p.substring(n - 4, 4);
    if (tail == ".obj" || tail == ".OBJ") return 1;
    return 0;
}

fn path_is_image(p: string): int {
    let n: int = p.len();
    if (n < 4) return 0;
    let t4: string = p.substring(n - 4, 4);
    if (t4 == ".png" || t4 == ".PNG" || t4 == ".jpg" || t4 == ".JPG"
        || t4 == ".bmp" || t4 == ".BMP" || t4 == ".tga" || t4 == ".TGA"
        || t4 == ".gif" || t4 == ".GIF") return 1;
    if (n >= 5) {
        let t5: string = p.substring(n - 5, 5);
        if (t5 == ".jpeg" || t5 == ".JPEG") return 1;
    }
    return 0;
}

fn sound_preview(path: string) {
    let r: int = sfx_preview(path);
    if (r == 2) {
        sound_listen_path = "";
        eng_log("[sound] stopped " + path_basename(path));
    } else if (r == 1) {
        sound_listen_path = path;
        eng_log("[sound] " + path_basename(path));
    } else {
        sound_listen_path = "";
        eng_log("[sound] could not play " + path_basename(path));
    }
}

fn path_is_sound(p: string): int {
    if (path_ends_ci(p, ".wav") == 1) return 1;
    if (path_ends_ci(p, ".mp3") == 1) return 1;
    if (path_ends_ci(p, ".ogg") == 1) return 1;
    if (path_ends_ci(p, ".flac") == 1) return 1;
    return 0;
}

fn browse_abs(root_folder: string, browse: string): string {
    let base: string = proj_path_join(proj_root(), root_folder);
    if (browse.len() == 0) return base;
    return proj_path_join(base, browse);
}

fn browse_enter(panel: string, browse: string, name: string) {
    let next: string = name;
    if (browse.len() > 0) next = browse + "/" + name;
    if (panel == "scenes") browse_scenes = next;
    else if (panel == "scripts") browse_scripts = next;
    else if (panel == "assets") browse_assets = next;
    else if (panel == "prefabs") browse_prefabs = next;
}

fn browse_up(panel: string) {
    if (panel == "scenes") browse_scenes = path_dirname(browse_scenes);
    else if (panel == "scripts") browse_scripts = path_dirname(browse_scripts);
    else if (panel == "assets") browse_assets = path_dirname(browse_assets);
    else if (panel == "prefabs") browse_prefabs = path_dirname(browse_prefabs);
}

/* Back row when inside a folder. Shrinks the grid and records the click. */
fn panel_folder_bar(b: Rect, browse: string, root_name: string): Rect {
    browse_went_up = 0;
    if (browse.len() == 0) return b;
    let bar: Rect = rect(b.x, b.y, b.w, 32);
    draw_fill_rect(bar, col_panel_med());
    draw_fill_rect(rect(bar.x, bar.y + bar.h - 1, bar.w, 1), col_border_soft());
    if (ui_pill(rect(bar.x + 8, bar.y + 4, 72, 24), "< Back", 0) == 1) browse_went_up = 1;
    th_font(12);
    draw_text(bar.x + 90, bar.y + 8, root_name + "/" + browse, col_text_main());
    th_font(14);
    return rect(b.x, b.y + 32, b.w, b.h - 32);
}

/* Folder cards for the current directory. Returns the next grid slot, or -1 after opening one. */
fn draw_subfolders(grid: Rect, abs_dir: string, browse: string, panel: string, card_w: int, card_h: int, pad: int, cols: int, slot: int): int {
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let i: int = 0;
    while (i < 512) {
        let name: string = eng_fs_list(abs_dir, i);
        if (name.len() == 0) return slot;
        let full: string = proj_path_join(abs_dir, name);
        if (eng_fs_is_dir(full) == 1) {
            let cx: int = grid.x + pad + (slot % cols) * (card_w + pad);
            let cy: int = grid.y + pad + (slot / cols) * (card_h + pad);
            let card: Rect = rect(cx, cy, card_w, card_h);
            let hover: bool = point_in_rect(mx, my, card);
            let card_hover: int = 0;
            if (hover) card_hover = 1;
            th_card(card, 0, card_hover);
            asset_icon(rect(card.x + 12, card.y + 14, 34, 34), "project", rgb(230, 186, 64));
            th_font(11);
            draw_text(card.x + 56, card.y + 15, "Folder", col_text_dim());
            th_font_semi(12);
            let folder_rel: string = rel_join(browse, name);
            /* Capture before rename finish clears the context — a click that
               commits the name must not also open the folder. */
            let renaming: int = assets_renaming_this("folder", folder_rel, full);
            if (renaming == 1) {
                let was: string = edit_target;
                let got: string = ui_field("assets_rename", rect(card.x + 52, card.y + 26, card.w - 64, 22), rename_buf);
                if (was == "assets_rename" && edit_target != "assets_rename") assets_rename_finish(got);
            } else {
                draw_text(card.x + 56, card.y + 31, name, col_text_main());
            }
            th_font(14);
            if (hover && mouse_pressed(MOUSE_LEFT) && renaming == 0) {
                browse_enter(panel, browse, name);
                return -1;
            }
            if (hover && mouse_pressed(MOUSE_RIGHT) && renaming == 0) {
                assets_cm_open_item("folder", folder_rel, full, -1, mx, my);
            }
            slot = slot + 1;
        }
        i = i + 1;
    }
    return slot;
}

/* chrome palette: charcoal + soft steel (engine/color.nxa col_ui_*) */
