fn spawn_ui_label_at(x_screen: int, y_screen: int): int {
    ui_canvas_layout_update();
    let uxf: float = screen_to_ui_x(x_screen);
    let uyf: float = screen_to_ui_y(y_screen);
    let ux: int = uxf;
    let uy: int = uyf;
    let s: int = ent_create("label", "label", ux, uy, 120, 18, 230, 230, 230);
    if (s >= 0) ent_set_text(s, "Label");
    return s;
}

fn delete_selection() {
    let s: int = sel_first();
    while (s >= 0) {
        undo_save_delete(s);
        ent_destroy(s);
        s = sel_iter_next(0);
    }
}

fn close_active_project() {
    save_active_scene();
    bp_leave_project();
    proj_close();
    ent_clear_all();
    sel_clear();
    undo_clear();
    te_clear();
    viewport_show("scene");
    app_state = "welcome";
    welcome_action = "menu";
    eng_set_title("Eyescire Editor");
}

// =============================================================================
// Build Game / Export -- produces a portable dist/<ProjectName>/ folder
// containing <ProjectName>.exe + engine.dll + project.eye + scenes/ + bin/
// + assets/. Web export writes dist/<ProjectName>/web/ (HTML + JS + iframe).
// =============================================================================

fn web_template_root(): string {
    return eng_exe_dir() + "\\..\\export\\web";
}

fn web_json_escape(s: string): string {
    let out: string = "\"";
    let i: int = 0;
    while (i < s.len()) {
        let c: string = s.substring(i, 1);
        if (c == "\\") out = out + "\\\\";
        else if (c == "\"") out = out + "\\\"";
        else out = out + c;
        i = i + 1;
    }
    return out + "\"";
}

fn web_script_js_rel(script_name: string): string {
    let base: string = script_name.replace(".nxa", ".js");
    return "scripts/" + base;
}

fn web_emit_script_file(web_dir: string, script_name: string) {
    let dst: string = proj_path_join(web_dir, web_script_js_rel(script_name));
    ensure_parent_dir(dst);
    let tpl_player: string = proj_path_join(web_template_root(), "scripts\\player.js");
    if (script_name == "player.nxa" && eng_fs_exists(tpl_player) == 1) {
        eng_fs_copy_file(tpl_player, dst);
        return;
    }
    let stub: string = "window.EYESCIRE_SCRIPTS = window.EYESCIRE_SCRIPTS || {};\n";
    stub = stub + "window.EYESCIRE_SCRIPTS[" + web_json_escape(script_name) + "] = {\n";
    stub = stub + "  script_init: function(api) {},\n";
    stub = stub + "  script_update: function(api) {}\n};\n";
    file.write(dst, stub);
}

fn web_entity_json_from_line(line: string): string {
    if (line.len() < 8) return "";
    if (line.substring(0, 7) != "ENTITY ") return "";
    let n: int = line.len();
    let body: string = line.substring(7, n - 7);
    let parts = body.split("|");
    if (len(parts) < 10) return "";

    let sprite: string = "";
    if (len(parts) >= 11) sprite = parts[10];
    sprite = sprite.replace("\\", "/");
    let text: string = "";
    if (len(parts) >= 12) text = parts[11];
    let script: string = "";
    if (len(parts) >= 13) script = parts[12];
    let parent_id: int = 0;
    if (len(parts) >= 14) parent_id = parse_int_or(parts[13], 0);
    let rot: int = 0;
    if (len(parts) >= 15) rot = parse_int_or(parts[14], 0);
    let is_cam: int = 0;
    if (len(parts) >= 16) is_cam = parse_int_or(parts[15], 0);
    let has_body: int = 0;
    if (len(parts) >= 17) has_body = parse_int_or(parts[16], 0);
    let body_type: int = 1;
    if (len(parts) >= 18) body_type = parse_int_or(parts[17], 1);
    let density: string = "1";
    if (len(parts) >= 19 && parts[18].len() > 0) density = parts[18];
    let friction: string = "0.3";
    if (len(parts) >= 20 && parts[19].len() > 0) friction = parts[19];
    let restitution: string = "0";
    if (len(parts) >= 21 && parts[20].len() > 0) restitution = parts[20];
    let grav_scale: string = "1";
    if (len(parts) >= 22 && parts[21].len() > 0) grav_scale = parts[21];
    let fixed_rot: int = 0;
    if (len(parts) >= 23) fixed_rot = parse_int_or(parts[22], 0);

    let js: string = "    {";
    js = js + "\"id\":" + parse_int_or(parts[0], 0);
    js = js + ",\"name\":" + web_json_escape(parts[1]);
    js = js + ",\"kind\":" + web_json_escape(parts[2]);
    js = js + ",\"x\":" + parse_int_or(parts[3], 0);
    js = js + ",\"y\":" + parse_int_or(parts[4], 0);
    js = js + ",\"w\":" + parse_int_or(parts[5], 0);
    js = js + ",\"h\":" + parse_int_or(parts[6], 0);
    js = js + ",\"r\":" + parse_int_or(parts[7], 0);
    js = js + ",\"g\":" + parse_int_or(parts[8], 0);
    js = js + ",\"b\":" + parse_int_or(parts[9], 0);
    js = js + ",\"sprite\":" + web_json_escape(sprite);
    js = js + ",\"text\":" + web_json_escape(text);
    js = js + ",\"script\":" + web_json_escape(script);
    js = js + ",\"parentId\":" + parent_id;
    js = js + ",\"rot\":" + rot;
    js = js + ",\"isCamera\":" + is_cam;
    js = js + ",\"hasBody\":" + has_body;
    js = js + ",\"bodyType\":" + body_type;
    js = js + ",\"density\":" + density;
    js = js + ",\"friction\":" + friction;
    js = js + ",\"restitution\":" + restitution;
    js = js + ",\"gravityScale\":" + grav_scale;
    js = js + ",\"fixedRotation\":" + fixed_rot;
    let vis: int = 1;
    if (len(parts) >= 31) vis = parse_int_or(parts[30], 1);
    js = js + ",\"visible\":" + vis;
    let nparts: int = len(parts);
    let btoggle: int = 0;
    let btoggled: int = 0;
    let hc: int = 0; let hr: int = 0; let hg: int = 0; let hb: int = 0;
    let pc: int = 0; let pr: int = 0; let pg: int = 0; let pb: int = 0;
    let oc: int = 0; let orr: int = 0; let og: int = 0; let ob: int = 0;
    let ohc: int = 0; let ohr: int = 0; let ohg: int = 0; let ohb: int = 0;
    if (nparts > 35) hc = parse_int_or(parts[35], 0);
    if (nparts > 32) hr = parse_int_or(parts[32], 0);
    if (nparts > 33) hg = parse_int_or(parts[33], 0);
    if (nparts > 34) hb = parse_int_or(parts[34], 0);
    if (nparts > 39) pc = parse_int_or(parts[39], 0);
    if (nparts > 36) pr = parse_int_or(parts[36], 0);
    if (nparts > 37) pg = parse_int_or(parts[37], 0);
    if (nparts > 38) pb = parse_int_or(parts[38], 0);
    if (nparts > 40) btoggle = parse_int_or(parts[40], 0);
    if (nparts > 41) btoggled = parse_int_or(parts[41], 0);
    if (nparts > 45) oc = parse_int_or(parts[45], 0);
    if (nparts > 42) orr = parse_int_or(parts[42], 0);
    if (nparts > 43) og = parse_int_or(parts[43], 0);
    if (nparts > 44) ob = parse_int_or(parts[44], 0);
    if (nparts > 49) ohc = parse_int_or(parts[49], 0);
    if (nparts > 46) ohr = parse_int_or(parts[46], 0);
    if (nparts > 47) ohg = parse_int_or(parts[47], 0);
    if (nparts > 48) ohb = parse_int_or(parts[48], 0);
    js = js + ",\"btnToggle\":" + btoggle;
    js = js + ",\"btnToggled\":" + btoggled;
    js = js + ",\"hoverCustom\":" + hc;
    js = js + ",\"hoverR\":" + hr;
    js = js + ",\"hoverG\":" + hg;
    js = js + ",\"hoverB\":" + hb;
    js = js + ",\"pressCustom\":" + pc;
    js = js + ",\"pressR\":" + pr;
    js = js + ",\"pressG\":" + pg;
    js = js + ",\"pressB\":" + pb;
    js = js + ",\"onCustom\":" + oc;
    js = js + ",\"onR\":" + orr;
    js = js + ",\"onG\":" + og;
    js = js + ",\"onB\":" + ob;
    js = js + ",\"onHoverCustom\":" + ohc;
    js = js + ",\"onHoverR\":" + ohr;
    js = js + ",\"onHoverG\":" + ohg;
    js = js + ",\"onHoverB\":" + ohb;
    let uival: int = 0;
    if (nparts > 54) uival = parse_int_or(parts[54], 0);
    js = js + ",\"uiValue\":" + uival;
    let ez: int = 0;
    if (nparts > 23) ez = parse_int_or(parts[23], 0);
    let esound: string = "";
    if (nparts > 57) esound = parts[57];
    esound = esound.replace("\\", "/");
    let eloop: int = 0;
    if (nparts > 58) eloop = parse_int_or(parts[58], 0);
    let erange: int = 800;
    if (nparts > 59) erange = parse_int_or(parts[59], 800);
    js = js + ",\"z\":" + ez;
    js = js + ",\"sound\":" + web_json_escape(esound);
    js = js + ",\"soundLoop\":" + eloop;
    js = js + ",\"soundRange\":" + erange;
    let ealpha: int = 255;
    if (nparts > 50) ealpha = parse_int_or(parts[50], 255);
    let emrate: int = 20;
    if (nparts > 60) emrate = parse_int_or(parts[60], 20);
    let emlife: int = 900;
    if (nparts > 61) emlife = parse_int_or(parts[61], 900);
    let emspeed: int = 80;
    if (nparts > 62) emspeed = parse_int_or(parts[62], 80);
    let emspread: int = 40;
    if (nparts > 63) emspread = parse_int_or(parts[63], 40);
    let emsize: int = 28;
    if (nparts > 64) emsize = parse_int_or(parts[64], 28);
    let emhd: int = 0;
    if (nparts > 65) emhd = parse_int_or(parts[65], 0);
    js = js + ",\"a\":" + ealpha;
    js = js + ",\"emitRate\":" + emrate;
    js = js + ",\"emitLife\":" + emlife;
    js = js + ",\"emitSpeed\":" + emspeed;
    js = js + ",\"emitSpread\":" + emspread;
    js = js + ",\"emitSize\":" + emsize;
    js = js + ",\"emitHD\":" + emhd;
    let efont: int = 0;
    if (nparts > 78) efont = parse_int_or(parts[78], 0);
    js = js + ",\"fontPx\":" + efont;
    let eox: int = 0;
    if (nparts > 79) eox = parse_int_or(parts[79], 0);
    let eoy: int = 0;
    if (nparts > 80) eoy = parse_int_or(parts[80], 0);
    js = js + ",\"fontOx\":" + eox;
    js = js + ",\"fontOy\":" + eoy;
    let erad: int = -1;
    if (nparts > 81) erad = parse_int_or(parts[81], -1);
    let ebdr: int = -1;
    if (nparts > 82) ebdr = parse_int_or(parts[82], -1);
    let ealign: int = 0;
    if (nparts > 83) ealign = parse_int_or(parts[83], 0);
    let eshadow: int = 0;
    if (nparts > 84) eshadow = parse_int_or(parts[84], 0);
    let etext: int = -1;
    if (nparts > 85) etext = parse_int_or(parts[85], -1);
    js = js + ",\"uiRadius\":" + erad;
    js = js + ",\"uiBorder\":" + ebdr;
    js = js + ",\"uiAlign\":" + ealign;
    js = js + ",\"uiShadow\":" + eshadow;
    js = js + ",\"uiText\":" + etext;
    let epix: int = 0;
    if (nparts > 86) epix = parse_int_or(parts[86], 0);
    js = js + ",\"pixel\":" + epix;
    js = js + "}";
    return js;
}

fn web_write_game_data(web_dir: string): int {
    if (proj_scene_count() <= 0) return 0;
    let scene_i: int = proj_active_scene();
    if (pref_int("export_used", 1) == 1) {
        let si: int = export_start_index();
        if (si >= 0 && si < proj_scene_count()) scene_i = si;
    }
    let scene_path: string = proj_scene_abs(scene_i);
    if (eng_fs_exists(scene_path) == 0) return 0;

    let raw: string = file.read(scene_path);
    let lines = raw.split("\n");

    /* pull scene gravity out of the GRAVITY line (defaults match the engine) */
    let grav_x: string = "0";
    let grav_y: string = "980";
    let gi: int = 0;
    while (gi < len(lines)) {
        let gl: string = lines[gi];
        if (gl.len() >= 8 && gl.substring(0, 8) == "GRAVITY ") {
            let gbody: string = gl.substring(8, gl.len() - 8);
            let gparts = gbody.split(" ");
            if (len(gparts) >= 1 && gparts[0].len() > 0) grav_x = gparts[0];
            if (len(gparts) >= 2 && gparts[1].len() > 0) grav_y = gparts[1];
            break;
        }
        gi = gi + 1;
    }

    let out: string = "window.EYESCIRE_SCENE = {\n";
    out = out + "  \"projectName\": " + web_json_escape(proj_name()) + ",\n";
    out = out + "  \"gravityX\": " + grav_x + ",\n";
    out = out + "  \"gravityY\": " + grav_y + ",\n";
    out = out + "  \"entities\": [\n";

    let first: int = 1;
    let i: int = 0;
    let line_count: int = len(lines);
    while (i < line_count) {
        let ej: string = web_entity_json_from_line(lines[i]);
        if (ej.len() > 0) {
            if (first == 0) out = out + ",\n";
            out = out + ej;
            first = 0;
        }
        i = i + 1;
    }
    out = out + "\n  ]\n};\n";

    out = out + "window.EYESCIRE_SCRIPT_FILES = [";
    let sf: int = 1;
    let si: int = 0;
    let trim_scripts: int = pref_int("export_used", 1);
    while (si < proj_script_count()) {
        let sn: string = proj_script_name(si);
        if (trim_scripts == 1 && export_used_has("scripts/" + sn) == 0) {
            si = si + 1;
            continue;
        }
        web_emit_script_file(web_dir, sn);
        if (sf == 0) out = out + ", ";
        out = out + web_json_escape(web_script_js_rel(sn));
        sf = 0;
        si = si + 1;
    }
    out = out + "];\n";

    out = out + "window.EYESCIRE_SFX = " + pref_int("sfx", 100) + ";\n";
    let dst: string = proj_path_join(web_dir, "game-data.js");
    file.write(dst, out);
    return 1;
}

fn build_web_begin() {
    if (proj_loaded() == 0) {
        eng_log("[web] no project open");
        return;
    }
    if (scene_render3d() == 1) eng_log("[web] note: web export flattens 3D scenes for now");
    save_active_scene();
    bp_prepare_build();
    proj_rescan_scripts();
    do_export_web();
}

fn do_export_web() {
    if (proj_loaded() == 0) return;

    let pname: string = proj_name();
    if (pname.len() == 0) pname = "Game";
    let tpl: string = web_template_root();
    if (eng_fs_exists(tpl) == 0) {
        eng_log("[web] templates missing at " + tpl);
        eng_log("[web] expected export/web/ next to the engine repo");
        return;
    }

    let dist_dir: string = proj_path_join(proj_path_join(proj_root(), "dist"), pname);
    let web_dir:  string = proj_path_join(dist_dir, "web");
    if (export_dest.len() > 0) web_dir = export_dest;

    eng_log("[web] target: " + web_dir);
    eng_fs_make_dir(dist_dir);
    if (eng_fs_exists(web_dir) == 1) eng_fs_remove_tree(web_dir);
    eng_fs_make_dir(web_dir);
    eng_fs_make_dir(proj_path_join(web_dir, "scripts"));

    if (eng_fs_copy_file(proj_path_join(tpl, "index.html"), proj_path_join(web_dir, "index.html")) == 0) {
        eng_log("[web] FAILED to copy index.html"); return;
    }
    if (eng_fs_copy_file(proj_path_join(tpl, "game.html"), proj_path_join(web_dir, "game.html")) == 0) {
        eng_log("[web] FAILED to copy game.html"); return;
    }
    if (eng_fs_copy_file(proj_path_join(tpl, "EyescirePlayer.js"), proj_path_join(web_dir, "EyescirePlayer.js")) == 0) {
        eng_log("[web] FAILED to copy EyescirePlayer.js"); return;
    }
    if (eng_fs_copy_file(proj_path_join(tpl, "boot.js"), proj_path_join(web_dir, "boot.js")) == 0) {
        eng_log("[web] FAILED to copy boot.js"); return;
    }
    if (eng_fs_copy_file(proj_path_join(tpl, "planck.min.js"), proj_path_join(web_dir, "planck.min.js")) == 0) {
        eng_log("[web] FAILED to copy planck.min.js (physics)"); return;
    }

    let trim: int = pref_int("export_used", 1);
    let used_n: int = 0;
    if (trim == 1) used_n = export_used_count();

    if (web_write_game_data(web_dir) == 0) {
        eng_log("[web] FAILED to export scene data");
        return;
    }

    if (trim == 1) {
        let i: int = 0;
        while (i < used_n) {
            let rel: string = export_used_rel(i);
            if (rel.len() >= 7 && rel.substring(0, 7) == "assets/") {
                let src: string = proj_path_join(proj_root(), rel);
                let dst: string = proj_path_join(web_dir, rel);
                if (eng_fs_copy_file(src, dst) == 0) eng_log("[web] FAILED to copy " + rel);
            }
            i = i + 1;
        }
    } else {
        let assets_src: string = proj_path_join(proj_root(), "assets");
        if (eng_fs_exists(assets_src) == 1) {
            eng_fs_copy_tree(assets_src, proj_path_join(web_dir, "assets"));
        }
    }

    eng_log("[web] DONE -> " + proj_path_join(web_dir, "index.html"));
    eng_log("[web] Tip: run a local server in the web folder (e.g. npx serve .)");
    if (pref_int("export_open_folder", 1) == 1) eng_run_command("explorer \"" + web_dir + "\"");
    export_dest = "";
}

/* EyescirePlayer3D.exe (examples/player3d.nxa), next to the editor */
fn player3d_exe_path(): string {
    return eng_exe_dir() + "\\EyescirePlayer3D.exe";
}

/* Play for a 3D scene: scripts are already built; run the 3D player on the
   saved scene in its own window. The editor stays usable meanwhile. */
fn launch_play_3d() {
    let exe: string = player3d_exe_path();
    if (eng_fs_exists(exe) == 0) {
        eng_log("[play3d] EyescirePlayer3D.exe not found at " + exe + " (rebuild with build.cmd)");
        return;
    }
    save_active_scene();
    /* the 3D player loads the same bin/*.dll; release ours so rebuilds can overwrite them */
    eng_dll_unload_all();
    let cmd: string = "\"" + exe + "\" \"" + proj_root() + "\" " + proj_active_scene();
    if (eng_launch(cmd, proj_root()) == 1) eng_log("[play3d] started (Esc closes the 3D window)");
    else                                  eng_log("[play3d] FAILED to start " + exe);
}

fn export_default_dir(preset: int): string {
    let pname: string = proj_name();
    if (pname.len() == 0) pname = "Game";
    let base: string = proj_path_join(proj_path_join(proj_root(), "dist"), pname);
    if (preset == 1) return proj_path_join(base, "web");
    return base;
}

fn export_show(preset: int) {
    if (app_state != "edit") return;
    if (proj_loaded() == 0) {
        eng_log("[export] no project open");
        return;
    }
    if (settings_open == 1) settings_close();
    if (extbuild_open == 1) extbuild_close();
    if (extdev_open == 1) extdev_close();
    export_open = 1;
    export_preset = preset;
    if (export_preset < 0) export_preset = 0;
    if (export_preset > 1) export_preset = 1;
    export_dest = export_default_dir(export_preset);
    export_guard = 1;
    menu_open = "";
    if (edit_target.len() >= 4 && edit_target.substring(0, 4) == "exp_") edit_target = "";
}

fn export_close() {
    export_open = 0;
    export_guard = 0;
    if (edit_target.len() >= 4 && edit_target.substring(0, 4) == "exp_") edit_target = "";
}

fn export_preset_row(x: int, y: int, w: int, id: int, title: string, subtitle: string) {
    let r: Rect = rect(x, y, w, 52);
    let on: int = 0;
    if (export_preset == id) on = 1;
    let hover: int = 0;
    if (mouse_hover_held(r) >= 1) hover = 1;
    th_row(r, on, hover);
    th_font_semi(13);
    draw_text(r.x + 16, r.y + 10, title, col_text_main());
    th_font(11);
    draw_text(r.x + 16, r.y + 30, subtitle, col_text_dim());
    th_font(14);
    if (hover == 1 && mouse_pressed(MOUSE_LEFT) && on == 0) {
        export_preset = id;
        export_dest = export_default_dir(export_preset);
    }
}

fn export_onoff(x: int, y: int, w: int, label: string, key: string, def: int) {
    draw_text(x, th_text_y(y, 28), label, col_text_main());
    let on: int = pref_int(key, def);
    let k0: string = "secondary";
    let k1: string = "secondary";
    if (on == 1) k1 = "primary";
    else k0 = "primary";
    if (ui_button_kind(rect(x + w - 168, y, 76, 28), "Off", k0) == 1 && on == 1) pref_set_int(key, 0);
    if (ui_button_kind(rect(x + w - 84, y, 76, 28), "On", k1) == 1 && on == 0) pref_set_int(key, 1);
}

fn export_path_label(path: string, max_w: int): string {
    th_font(12);
    if (eng_text_width(path) <= max_w) {
        th_font(14);
        return path;
    }
    let ell: string = "...";
    let i: int = 0;
    while (i < path.len()) {
        let tail: string = ell + path.substring(i, path.len() - i);
        if (eng_text_width(tail) <= max_w) {
            th_font(14);
            return tail;
        }
        i = i + 1;
    }
    th_font(14);
    return ell;
}

fn export_run() {
    if (proj_loaded() == 0) return;
    let preset: int = export_preset;
    let dest: string = export_dest;
    export_close();
    if (dest.len() == 0) dest = export_default_dir(preset);
    export_dest = dest;
    if (preset == 1) build_web_begin();
    else build_game_begin();
}

/* Full-screen export page — replaces the editor chrome while open. */
fn export_draw() {
    if (export_open == 0) return;
    draw_fill_rect(rect(0, 0, WIN_W, WIN_H), col_panel_dark());

    let foot_h: int = 64;
    let nav_w: int = 280;
    if (nav_w > WIN_W / 3) nav_w = WIN_W / 3;
    let nav: Rect = rect(0, 0, nav_w, WIN_H - foot_h);
    let body: Rect = rect(nav_w, 0, WIN_W - nav_w, WIN_H - foot_h);
    let foot: Rect = rect(0, WIN_H - foot_h, WIN_W, foot_h);

    draw_fill_rect(nav, col_bg_deep());
    draw_fill_rect(rect(nav.x + nav.w - 1, nav.y, 1, nav.h), col_border_soft());
    draw_fill_rect(foot, col_bg_deep());
    draw_fill_rect(rect(foot.x, foot.y, foot.w, 1), col_border_soft());

    th_font_semi(20);
    draw_text(nav.x + 24, nav.y + 28, "Export", col_text_main());
    th_font(11);
    draw_text(nav.x + 24, nav.y + 58, "PRESETS", col_text_dim());
    th_font(14);
    export_preset_row(nav.x + 12, nav.y + 84, nav.w - 24, 0, "Windows Desktop", "Standalone .exe");
    export_preset_row(nav.x + 12, nav.y + 144, nav.w - 24, 1, "Web (HTML)", "Browser player");

    let x: int = body.x + 48;
    let y: int = body.y + 36;
    let w: int = body.w - 96;
    if (w > 720) w = 720;

    th_font_semi(18);
    if (export_preset == 1) draw_text(x, y, "Web (HTML)", col_text_main());
    else draw_text(x, y, "Windows Desktop", col_text_main());
    th_font(14);
    y = y + 36;

    y = chrome_section(x, y, w, "OUTPUT");
    chrome_field_label(x, y, "Export path");
    y = y + 14;
    let gap: int = 8;
    let browse_w: int = 96;
    let path_r: Rect = rect(x, y, w - browse_w - gap, 32);
    let shown: string = export_path_label(export_dest, path_r.w - 18);
    ui_field_draw(path_r, shown, 0);
    if (ui_button(rect(x + w - browse_w, y, browse_w, 32), "Browse") == 1) {
        let initial: string = export_dest;
        if (initial.len() == 0) initial = proj_root();
        let picked: string = eng_open_folder_dialog("Choose export folder", initial);
        if (picked.len() > 0) export_dest = picked;
    }
    y = y + 44;
    th_font(12);
    if (export_preset == 1) draw_text(x, y, "Writes index.html and game files into this folder.", col_text_dim());
    else draw_text(x, y, "Writes the game .exe and bundled files into this folder.", col_text_dim());
    th_font(14);
    y = y + 36;

    y = chrome_section(x, y, w, "OPTIONS");
    export_onoff(x, y, w, "Export used files only", "export_used", 1);
    y = y + 36;
    th_font(12);
    draw_text(x, y, "On: launch scene and referenced files. Off: whole project.", col_text_dim());
    th_font(14);
    y = y + 32;
    if (export_preset == 0) {
        draw_text(x, th_text_y(y, 28), "Content protection", col_text_main());
        let prot: int = pref_int("export_protect", 1);
        let k0: string = "secondary";
        let k1: string = "secondary";
        let k2: string = "secondary";
        let k3: string = "secondary";
        if (prot == 0) k0 = "primary";
        if (prot == 1) k1 = "primary";
        if (prot == 2) k2 = "primary";
        if (prot == 3) k3 = "primary";
        if (ui_button_kind(rect(x + w - 288, y, 66, 28), "Off", k0) == 1) pref_set_int("export_protect", 0);
        if (ui_button_kind(rect(x + w - 216, y, 66, 28), "Std", k1) == 1) pref_set_int("export_protect", 1);
        if (ui_button_kind(rect(x + w - 144, y, 66, 28), "Strong", k2) == 1) pref_set_int("export_protect", 2);
        if (ui_button_kind(rect(x + w - 72, y, 66, 28), "Secure", k3) == 1) pref_set_int("export_protect", 3);
        y = y + 36;
        th_font(12);
        if (prot == 0) draw_text(x, y, "Plain files — easiest to inspect and copy.", col_text_dim());
        if (prot == 1) draw_text(x, y, "Encrypted; key hidden in the .exe.", col_text_dim());
        if (prot == 2) draw_text(x, y, "Encrypted + integrity; key split across .exe and engine.dll.", col_text_dim());
        if (prot == 3) draw_text(x, y, "Studio: dual ChaCha, triple split, keyed tamper seal.", col_text_dim());
        th_font(14);
        y = y + 32;
        export_onoff(x, y, w, "Console window", "export_console", 0);
        y = y + 36;
        th_font(12);
        draw_text(x, y, "On opens a console beside the game. Off leaves only the game window.", col_text_dim());
        th_font(14);
        y = y + 32;
    }
    export_onoff(x, y, w, "Open folder when done", "export_open_folder", 1);
    y = y + 40;
    if (export_preset == 1 && scene_render3d() == 1) {
        th_font(12);
        draw_text(x, y, "Web export flattens 3D scenes for now.", col_text_dim());
        th_font(14);
    }

    if (ui_button(rect(foot.x + 24, foot.y + 16, 120, 32), "Back") == 1) export_close();
    if (ui_button_primary(rect(foot.x + foot.w - 168, foot.y + 16, 144, 32), "Export Project") == 1) export_run();
    export_guard = 0;
    th_font(14);
}

fn extbuild_slug(s: string): string {
    let out: string = "";
    let i: int = 0;
    while (i < s.len() && out.len() < 48) {
        let c: string = s.substring(i, 1);
        let ok: int = 0;
        if (c >= "a" && c <= "z") ok = 1;
        if (c >= "A" && c <= "Z") ok = 1;
        if (c >= "0" && c <= "9") ok = 1;
        if (c == "_" || c == "-") ok = 1;
        if (c == " ") { ok = 1; c = "_"; }
        if (ok == 1) out = out + c;
        i = i + 1;
    }
    return out;
}

fn extbuild_show() {
    if (app_state != "edit") return;
    if (proj_loaded() == 0) {
        eng_log("[ext] no project open");
        return;
    }
    if (settings_open == 1) settings_close();
    if (export_open == 1) export_close();
    if (extdev_open == 1) extdev_close();
    extbuild_open = 1;
    extbuild_guard = 1;
    extbuild_lang = 0;
    extbuild_id = "";
    extbuild_name = "";
    extbuild_ver = "1.0";
    extbuild_desc = "";
    extbuild_status = "";
    extbuild_id_manual = 0;
    menu_open = "";
    if (edit_target.len() >= 4 && edit_target.substring(0, 4) == "exb_") edit_target = "";
}

fn extbuild_close() {
    extbuild_open = 0;
    extbuild_guard = 0;
    if (edit_target.len() >= 4 && edit_target.substring(0, 4) == "exb_") edit_target = "";
}

fn extbuild_lang_row(x: int, y: int, w: int, id: int, title: string, subtitle: string) {
    let r: Rect = rect(x, y, w, 52);
    let on: int = 0;
    if (extbuild_lang == id) on = 1;
    let hover: int = 0;
    if (mouse_hover_held(r) >= 1) hover = 1;
    th_row(r, on, hover);
    th_font_semi(13);
    draw_text(r.x + 16, r.y + 10, title, col_text_main());
    th_font(11);
    draw_text(r.x + 16, r.y + 30, subtitle, col_text_dim());
    th_font(14);
    if (hover == 1 && mouse_pressed(MOUSE_LEFT) && on == 0) {
        extbuild_lang = id;
        extbuild_status = "";
    }
}

fn extbuild_compile_index(i: int): int {
    if (i < 0 || i >= eng_ext_count()) return 0;
    let src: string = eng_ext_source(i);
    let folder: string = eng_ext_folder(i);
    let id: string = eng_ext_id(i);
    let dll: string = proj_path_join(folder, id + ".dll");
    /* Build to a temp name so the linker never has to overwrite a still-mapped DLL. */
    let tmp: string = proj_path_join(folder, id + ".build.dll");
    let lib: string = eng_engine_lib();
    if (src.len() == 0) {
        eng_log("[ext] no source for " + id);
        return 0;
    }
    if (eng_fs_exists(lib) == 0) {
        eng_log("[ext] engine.lib missing: " + lib);
        return 0;
    }
    eng_ext_prepare_rebuild(dll);
    if (eng_fs_exists(tmp) == 1) eng_fs_remove_file(tmp);
    let lang: int = eng_ext_lang(i);
    let cmd: string = "";
    if (lang == 1) {
        cmd = "cmd /c clang++ -std=c++17 -O2 -shared \"" + src + "\" \"" + lib + "\" -o \"" + tmp + "\"";
    } else {
        cmd = "cmd /c NexaC \"" + src + "\" --dll --link \"" + lib + "\" -p -o \"" + tmp + "\"";
    }
    eng_log("[ext] building " + id);
    let code: int = eng_run_command(cmd);
    let out: string = eng_last_command_output();
    if (code != 0) {
        eng_log("[ext] build FAILED " + id);
        let lines = out.split("\n");
        let nlines: int = len(lines);
        let shown: int = 0;
        let k: int = 0;
        while (k < nlines && shown < 12) {
            let ln: string = lines[k];
            if (match_substr(ln, "error") == 1 || match_substr(ln, "Error") == 1
                || match_substr(ln, "not recognized") == 1
                || match_substr(ln, "Permission") == 1) {
                eng_log("    " + ln);
                shown = shown + 1;
            }
            k = k + 1;
        }
        if (shown == 0) {
            k = 0;
            while (k < nlines && k < 8) {
                let ln2: string = lines[k];
                if (ln2.len() > 0) eng_log("    " + ln2);
                k = k + 1;
            }
        }
        if (eng_fs_exists(tmp) == 1) eng_fs_remove_file(tmp);
        return 0;
    }
    eng_ext_prepare_rebuild(dll);
    if (eng_fs_replace_file(tmp, dll) == 0) {
        eng_log("[ext] build ok, but could not replace " + dll + " (still in use?)");
        if (eng_fs_exists(tmp) == 1) eng_fs_remove_file(tmp);
        return 0;
    }
    /* Drop the import lib NexaC may leave next to the temp output. */
    let tmp_lib: string = proj_path_join(folder, id + ".build.lib");
    if (eng_fs_exists(tmp_lib) == 1) eng_fs_remove_file(tmp_lib);
    eng_log("[ext] build ok " + id);
    return 1;
}

/* Queue a rebuild; main() draws the popup, presents, then runs the sync compile. */
fn ext_rebuild_begin(i: int) {
    if (i < 0 || i >= eng_ext_count()) return;
    if (compile_active == 1) return;
    if (ext_rebuild_active == 1) return;
    ext_rebuild_active = 1;
    ext_rebuild_index = i;
    ext_rebuild_name = eng_ext_name(i);
    if (ext_rebuild_name.len() == 0) ext_rebuild_name = eng_ext_id(i);
    ext_rebuild_reload = 1;
    if (extdev_open == 1) extdev_status = "Rebuilding " + ext_rebuild_name + "...";
}

fn ext_rebuild_overlay_draw() {
    r3d_dismiss();
    let pw: int = 520;
    let ph: int = 180;
    let px: int = (WIN_W - pw) / 2;
    let py: int = (WIN_H - ph) / 2;

    draw_fill_rect(rect(0, 0, WIN_W, WIN_H), col_ui_bg());
    let card: Rect = rect(px, py, pw, ph);
    th_popup(card);

    th_font_semi(18);
    draw_text(px + 28, py + 28, "Rebuilding extension", col_text_main());
    th_font(13);
    let label: string = ext_rebuild_name;
    if (label.len() == 0) label = "extension";
    draw_text(px + 28, py + 68, label, col_text_dim());
    th_font(12);
    draw_text(px + 28, py + 108, "Compiling the DLL. The editor will respond when it finishes.", col_text_dim());
    th_font(14);
    th_progress(px + 28, py + 136, pw - 56, 1, 2);
}

fn ext_rebuild_step() {
    if (ext_rebuild_active == 0) return;
    let i: int = ext_rebuild_index;
    let name: string = ext_rebuild_name;
    let do_reload: int = ext_rebuild_reload;
    ext_rebuild_active = 0;
    ext_rebuild_index = -1;
    let ok: int = extbuild_compile_index(i);
    if (do_reload == 1) eng_ext_load_enabled(1);
    if (ok == 1) {
        if (extdev_open == 1) extdev_status = "Saved and rebuilt " + name + ".";
    } else {
        if (extdev_open == 1) extdev_status = "Rebuild failed for " + name + ". Check the console.";
        dock_tab = "console";
    }
}

fn extbuild_find_id(id: string): int {
    let i: int = 0;
    let n: int = eng_ext_count();
    while (i < n) {
        if (eng_ext_id(i) == id) return i;
        i = i + 1;
    }
    return -1;
}

fn extbuild_run() {
    if (proj_loaded() == 0) return;
    let id: string = extbuild_slug(extbuild_id);
    if (id.len() == 0) id = extbuild_slug(extbuild_name);
    if (id.len() == 0) {
        extbuild_status = "Enter an id or name first.";
        return;
    }
    let name: string = extbuild_name;
    if (name.len() == 0) name = id;
    let ver: string = extbuild_ver;
    if (ver.len() == 0) ver = "1.0";
    if (eng_ext_create(id, name, ver, extbuild_desc, extbuild_lang, 1) == 0) {
        extbuild_status = "Create failed. See the console (id taken or write error).";
        return;
    }
    eng_ext_rescan();
    let idx: int = extbuild_find_id(id);
    if (idx < 0) {
        extbuild_status = "Created folder, but it did not show up in the registry.";
        return;
    }
    eng_log("[ext] Extension Builder finished scaffold: " + id);
    extbuild_close();
    extdev_show_id(id);
    extdev_status = "Created " + id + ". Building DLL...";
    ext_rebuild_begin(idx);
}

fn extbuild_rebuild_index(i: int) {
    if (i < 0 || i >= eng_ext_count()) return;
    ext_rebuild_begin(i);
}

/* Full-screen Extension Builder — replaces the editor chrome while open. */
fn extbuild_draw() {
    if (extbuild_open == 0) return;
    draw_fill_rect(rect(0, 0, WIN_W, WIN_H), col_panel_dark());

    let foot_h: int = 64;
    let nav_w: int = 280;
    if (nav_w > WIN_W / 3) nav_w = WIN_W / 3;
    let nav: Rect = rect(0, 0, nav_w, WIN_H - foot_h);
    let body: Rect = rect(nav_w, 0, WIN_W - nav_w, WIN_H - foot_h);
    let foot: Rect = rect(0, WIN_H - foot_h, WIN_W, foot_h);

    draw_fill_rect(nav, col_bg_deep());
    draw_fill_rect(rect(nav.x + nav.w - 1, nav.y, 1, nav.h), col_border_soft());
    draw_fill_rect(foot, col_bg_deep());
    draw_fill_rect(rect(foot.x, foot.y, foot.w, 1), col_border_soft());

    th_font_semi(20);
    draw_text(nav.x + 24, nav.y + 28, "Extension", col_text_main());
    th_font(11);
    draw_text(nav.x + 24, nav.y + 58, "LANGUAGE", col_text_dim());
    th_font(14);
    extbuild_lang_row(nav.x + 12, nav.y + 84, nav.w - 24, 0, "Nexa", "Visual Blueprints + Code");
    extbuild_lang_row(nav.x + 12, nav.y + 144, nav.w - 24, 1, "C++", "Native clang++ DLL");

    let x: int = body.x + 48;
    let y: int = body.y + 36;
    let w: int = body.w - 96;
    if (w > 720) w = 720;

    th_font_semi(18);
    if (extbuild_lang == 1) draw_text(x, y, "New C++ Extension", col_text_main());
    else draw_text(x, y, "New Nexa Extension", col_text_main());
    th_font(14);
    y = y + 30;
    th_font(12);
    draw_text(x, y, "Creates extensions/<id>/ with a starter, builds the DLL, and loads it with Full permission.", col_text_dim());
    th_font(14);
    y = y + 36;

    y = chrome_section(x, y, w, "DETAILS");
    chrome_field_label(x, y, "Name");
    y = y + 14;
    let nm: string = ui_field("exb_name", rect(x, y, w, 32), extbuild_name);
    if (nm != extbuild_name) {
        extbuild_name = nm;
        if (extbuild_id_manual == 0) extbuild_id = extbuild_slug(extbuild_name);
    }
    y = y + 44;
    chrome_field_label(x, y, "Id");
    y = y + 14;
    let idv: string = ui_field("exb_id", rect(x, y, w, 32), extbuild_id);
    if (idv != extbuild_id) {
        extbuild_id = idv;
        extbuild_id_manual = 1;
    }
    y = y + 40;
    th_font(12);
    draw_text(x, y, "Folder and DLL name. Letters, numbers, _ and - only.", col_text_dim());
    th_font(14);
    y = y + 28;
    chrome_field_label(x, y, "Version");
    y = y + 14;
    extbuild_ver = ui_field("exb_ver", rect(x, y, 160, 32), extbuild_ver);
    y = y + 44;
    chrome_field_label(x, y, "Description");
    y = y + 14;
    extbuild_desc = ui_field("exb_desc", rect(x, y, w, 32), extbuild_desc);
    y = y + 48;

    y = chrome_section(x, y, w, "PERMISSION");
    th_font(12);
    draw_text(x, y, "Local extensions created here start with Full permission (entire engine API).", col_text_dim());
    th_font(14);
    y = y + 22;
    th_font(12);
    draw_text(x, y, "You can switch back to Sandbox later in Settings -> Extensions.", col_text_dim());
    th_font(14);
    y = y + 36;

    if (extbuild_status.len() > 0) {
        th_font(12);
        draw_text(x, y, extbuild_status, col_text_main());
        th_font(14);
    }

    if (ui_button(rect(foot.x + 24, foot.y + 16, 120, 32), "Back") == 1) extbuild_close();
    if (ui_button_primary(rect(foot.x + foot.w - 200, foot.y + 16, 176, 32), "Create Extension") == 1) extbuild_run();
    extbuild_guard = 0;
    th_font(14);
}

fn extdev_index(): int {
    return extbuild_find_id(extdev_id);
}

fn extdev_has_blocks(): int {
    let idx: int = extdev_index();
    if (idx < 0) return 0;
    if (eng_ext_lang(idx) == 1) return 0;
    if (eng_ext_blueprint(idx).len() > 0) return 1;
    return 0;
}

fn extdev_close() {
    if (extdev_open == 0) return;
    if (extdev_view == 1 && te_path().len() > 0 && te_dirty() == 1) te_save();
    if (bp_is_open() == 1) {
        if (bp_dirty() == 1) bp_save();
        bp_close();
        bp_ui_reset();
    }
    bp_clear_host();
    bp_host_want_save = 0;
    extdev_open = 0;
    extdev_guard = 0;
    extdev_status = "";
    extdev_view = 0;
    extdev_detached = 0;
}

fn extdev_open_blocks() {
    let idx: int = extdev_index();
    if (idx < 0) return;
    let ebp: string = eng_ext_blueprint(idx);
    if (ebp.len() == 0) return;
    if (te_dirty() == 1 && te_path().len() > 0) te_save();
    te_clear();
    if (bp_is_open() == 1 && bp_path() != ebp) {
        if (bp_dirty() == 1) bp_save();
        bp_close();
        bp_ui_reset();
    }
    if (bp_is_open() == 0 || bp_path() != ebp) {
        if (bp_open(ebp) == 0) {
            extdev_status = "Could not open blueprint.";
            return;
        }
        bp_ui_reset();
    }
    extdev_view = 0;
    extdev_detached = 0;
}

fn extdev_open_code(detach: int) {
    let idx: int = extdev_index();
    if (idx < 0) return;
    let src: string = eng_ext_source(idx);
    if (src.len() == 0) {
        extdev_status = "No source file.";
        return;
    }
    if (bp_is_open() == 1) {
        if (bp_dirty() == 1) bp_save();
        /* keep ebp on disk; close graph while editing code */
        bp_close();
        bp_ui_reset();
    }
    bp_clear_host();
    te_load(src);
    extdev_view = 1;
    if (detach == 1) extdev_detached = 1;
}

fn extdev_reset_from_blocks() {
    let idx: int = extdev_index();
    if (idx < 0) return;
    let ebp: string = eng_ext_blueprint(idx);
    if (ebp.len() == 0) {
        extdev_status = "No blueprint to reset from.";
        return;
    }
    if (te_dirty() == 1) te_save();
    if (bp_translate_file(ebp, 1) == 0) {
        extdev_status = "Reset failed. Check the console.";
        return;
    }
    extdev_detached = 0;
    eng_ext_rescan();
    extdev_open_blocks();
    extdev_status = "Reset from Blocks. Building DLL...";
    ext_rebuild_begin(extdev_index());
}

fn extdev_create_blocks() {
    let idx: int = extdev_index();
    if (idx < 0) return;
    if (eng_ext_lang(idx) == 1) {
        extdev_status = "C++ extensions use Code only.";
        return;
    }
    if (eng_ext_blueprint(idx).len() > 0) {
        extdev_open_blocks();
        return;
    }
    let folder: string = eng_ext_folder(idx);
    if (bp_create_extension(folder) == 0) {
        extdev_status = "Could not create blueprint. Check the console.";
        return;
    }
    eng_ext_rescan();
    extdev_detached = 0;
    extdev_open_blocks();
    extdev_status = "Blocks graph created. Building DLL...";
    ext_rebuild_begin(extdev_index());
}

fn extdev_show_id(id: string) {
    if (app_state != "edit") return;
    if (proj_loaded() == 0) return;
    eng_ext_rescan();
    let idx: int = extbuild_find_id(id);
    if (idx < 0) {
        eng_log("[ext] develop: unknown id " + id);
        return;
    }
    let src: string = eng_ext_source(idx);
    let ebp: string = eng_ext_blueprint(idx);
    if (src.len() == 0 && ebp.len() == 0) {
        eng_log("[ext] develop: no source for " + id);
        return;
    }
    if (settings_open == 1) settings_close();
    if (export_open == 1) export_close();
    if (extbuild_open == 1) extbuild_close();
    if (extdev_open == 1) {
        if (te_dirty() == 1 && te_path().len() > 0) te_save();
        if (bp_is_open() == 1 && bp_dirty() == 1) bp_save();
    } else if (bp_is_open() == 1) {
        if (bp_dirty() == 1) bp_save();
        bp_close();
        bp_ui_reset();
    }
    extdev_id = id;
    extdev_open = 1;
    extdev_guard = 1;
    extdev_nav_scroll = 0;
    extdev_detached = 0;
    edit_target = "";
    menu_open = "";
    bp_host_want_save = 0;
    if (eng_ext_lang(idx) != 1 && ebp.len() > 0) {
        extdev_open_blocks();
        extdev_status = "Blocks view. Save rebuilds the DLL. Code detaches from Blocks.";
    } else {
        extdev_open_code(0);
        extdev_detached = 1;
        if (eng_ext_lang(idx) == 1) extdev_status = "C++ Code view. Save rebuilds the DLL.";
        else extdev_status = "Code view (no Blocks yet). Use Create Blocks to add a graph.";
    }
    eng_log("[ext] develop " + id);
}

fn extdev_show_index(i: int) {
    if (i < 0 || i >= eng_ext_count()) return;
    extdev_show_id(eng_ext_id(i));
}

fn extdev_save_and_rebuild() {
    if (extdev_open == 0) return;
    let idx: int = extdev_index();
    if (idx < 0) {
        extdev_status = "Extension missing.";
        return;
    }
    if (extdev_view == 0 && extdev_has_blocks() == 1 && extdev_detached == 0) {
        if (bp_is_open() == 1 && bp_dirty() == 1) {
            if (bp_save() == 0) {
                extdev_status = "Blueprint save failed.";
                return;
            }
        }
        let ebp: string = eng_ext_blueprint(idx);
        if (bp_translate_file(ebp, 0) == 0) {
            extdev_status = "Could not generate Code from Blocks.";
            return;
        }
        eng_log("[ext] translated " + ebp);
    } else {
        if (te_path().len() == 0) {
            let src: string = eng_ext_source(idx);
            if (src.len() > 0) te_load(src);
        }
        if (te_path().len() == 0) {
            extdev_status = "No source file open.";
            return;
        }
        if (te_dirty() == 1 || extdev_view == 1) {
            if (te_save() == 0) {
                extdev_status = "Save failed.";
                return;
            }
        }
        eng_log("[ext] saved " + te_path());
    }
    eng_ext_rescan();
    idx = extdev_index();
    if (idx < 0) {
        extdev_status = "Extension missing after save.";
        return;
    }
    ext_rebuild_begin(idx);
}

fn extdev_editor_input(r: Rect) {
    let strip_h: int = 28;
    let body_y: int = r.y + strip_h;
    let body_h: int = r.h - strip_h;
    if (body_h < 40) return;
    let visible: int = body_h / SCRIPT_LINE_H;

    let cursor_before_line: int = te_cursor_line();
    let cursor_before_col: int = te_cursor_col();

    if (edit_target.len() == 0) {
        let c: int = typed_pop();
        while (c != 0) {
            if (c == 8) te_backspace();
            else if (c == 13) te_newline();
            else if (c == 9) te_insert_text("    ");
            else if (c >= 32 && c < 127) te_insert_char(c);
            c = typed_pop();
        }
        if (key_pressed(VK_LEFT))  te_move_cursor(0, -1);
        if (key_pressed(VK_RIGHT)) te_move_cursor(0, 1);
        if (key_pressed(VK_UP))    te_move_cursor(-1, 0);
        if (key_pressed(VK_DOWN))  te_move_cursor(1, 0);
        if (key_pressed(VK_HOME))  te_home();
        if (key_pressed(VK_END))   te_end();
        if (key_pressed(VK_PAGEUP))   te_page(-visible + 1);
        if (key_pressed(VK_PAGEDOWN)) te_page(visible - 1);
        if (key_pressed(VK_DELETE) && ctrl_held() == false) te_delete();
    }

    if (ctrl_held() && key_pressed(VK_S)) extdev_save_and_rebuild();

    if (point_in_rect(eng_mouse_x(), eng_mouse_y(), r) && mouse_pressed(MOUSE_LEFT)) {
        edit_target = "";
        let mx: int = eng_mouse_x();
        let my: int = eng_mouse_y();
        th_font_mono(13);
        if (my > r.y + strip_h && my < r.y + r.h) {
            let line_idx: int = (my - body_y) / SCRIPT_LINE_H + te_scroll_y();
            if (line_idx < 0) line_idx = 0;
            if (line_idx >= te_line_count()) line_idx = te_line_count() - 1;
            let line_text: string = te_line(line_idx);
            let cur_x: int = r.x + SCRIPT_GUTTER;
            let n: int = line_text.len();
            let i: int = 0;
            while (i < n) {
                let ch: string = line_text.substring(i, 1);
                let cw: int = eng_text_width(ch);
                if (mx < cur_x + cw / 2) break;
                cur_x = cur_x + cw;
                i = i + 1;
            }
            te_set_cursor(line_idx, i);
        }
        th_font(14);
    }

    let cursor_moved: int = 0;
    if (te_cursor_line() != cursor_before_line) cursor_moved = 1;
    if (te_cursor_col() != cursor_before_col) cursor_moved = 1;
    if (cursor_moved == 1) {
        let cl: int = te_cursor_line();
        let sy: int = te_scroll_y();
        if (cl < sy) te_set_scroll_y(cl);
        if (cl >= sy + visible) te_set_scroll_y(cl - visible + 1);
    }

    if (point_in_rect(eng_mouse_x(), eng_mouse_y(), r)) {
        let w: int = eng_mouse_wheel();
        if (w != 0) {
            let total: int = te_line_count();
            let new_sy: int = te_scroll_y() - w * 3;
            if (new_sy < 0) new_sy = 0;
            let max_sy: int = total - visible;
            if (max_sy < 0) max_sy = 0;
            if (new_sy > max_sy) new_sy = max_sy;
            te_set_scroll_y(new_sy);
        }
    }
}

fn extdev_editor_draw(r: Rect) {
    draw_fill_rect(r, col_ui_input());
    let strip: Rect = rect(r.x, r.y, r.w, 28);
    draw_fill_rect(strip, col_panel_dark());
    draw_fill_rect(rect(strip.x, strip.y + strip.h - 1, strip.w, 1), col_border_soft());

    let title: string = path_basename(te_path());
    if (title.len() == 0) title = "(no source)";
    th_font_semi(12);
    draw_text(r.x + 12, th_text_y(strip.y, strip.h), title, col_text_main());
    if (te_dirty() == 1) {
        let dx: int = r.x + 12 + eng_text_width(title) + 10;
        th_chip(rect(dx, strip.y + 5, 64, strip.h - 10), "UNSAVED", col_warn());
    }
    th_font(14);

    let bx: int = r.x + r.w - 200;
    if (ui_pill(rect(bx, r.y + 3, 88, strip.h - 6), "Save", 0) == 1) extdev_save_and_rebuild();
    if (ui_pill(rect(bx + 96, r.y + 3, 96, strip.h - 6), "Rebuild", 1) == 1) {
        if (te_dirty() == 1) te_save();
        eng_ext_rescan();
        let idx: int = extdev_index();
        if (idx >= 0) ext_rebuild_begin(idx);
    }

    if (te_line_count() == 0) return;

    let body_y: int = r.y + 30;
    let body_h: int = r.h - 30;
    eng_set_clip(r.x, body_y, r.w, body_h);

    th_font_mono(13);
    let visible: int = body_h / SCRIPT_LINE_H;
    let total: int = te_line_count();
    let sy: int = te_scroll_y();
    if (sy + visible > total) sy = total - visible;
    if (sy < 0) sy = 0;
    if (sy != te_scroll_y()) te_set_scroll_y(sy);

    eng_fill_rect(r.x, body_y, SCRIPT_GUTTER - 4, body_h, 24, 25, 29);
    draw_fill_rect(rect(r.x + SCRIPT_GUTTER - 4, body_y, 1, body_h), col_border_soft());

    let cl_hl: int = te_cursor_line();
    if (cl_hl >= sy && cl_hl < sy + visible) {
        let hy: int = body_y + 2 + (cl_hl - sy) * SCRIPT_LINE_H;
        eng_fill_rect(r.x + SCRIPT_GUTTER - 4, hy - 2, r.w - SCRIPT_GUTTER + 4, SCRIPT_LINE_H, 37, 39, 46);
    }

    let i: int = sy;
    let yy: int = body_y + 2;
    while (i < total && i - sy < visible) {
        let lnum: string = "" + (i + 1);
        let lw: int = eng_text_width(lnum);
        let lnum_color_r: int = 90;
        let lnum_color_g: int = 100;
        let lnum_color_b: int = 120;
        if (i == te_cursor_line()) { lnum_color_r = 200; lnum_color_g = 210; lnum_color_b = 230; }
        eng_text(r.x + SCRIPT_GUTTER - 12 - lw, yy, lnum, lnum_color_r, lnum_color_g, lnum_color_b);
        let line_text: string = te_line(i);
        draw_script_line(r.x + SCRIPT_GUTTER, yy, line_text, r.w - SCRIPT_GUTTER - 8);
        i = i + 1;
        yy = yy + SCRIPT_LINE_H;
    }

    let cl: int = te_cursor_line();
    let cc: int = te_cursor_col();
    if (cl >= sy && cl < sy + visible) {
        let line_text: string = te_line(cl);
        let prefix: string = "";
        if (cc <= line_text.len()) prefix = line_text.substring(0, cc);
        let cx: int = r.x + SCRIPT_GUTTER + eng_text_width(prefix);
        let cy: int = body_y + 2 + (cl - sy) * SCRIPT_LINE_H;
        cursor_blink_ms = cursor_blink_ms + frame_dt_ms();
        let phase: int = cursor_blink_ms;
        phase = phase % 1000;
        if (phase < 600) {
            eng_fill_rect(cx, cy - 1, 2, SCRIPT_LINE_H, 220, 230, 250);
        }
    }

    eng_clear_clip();
    th_font(14);
}

fn extdev_nav_row(x: int, y: int, w: int, i: int) {
    let id: string = eng_ext_id(i);
    let name: string = eng_ext_name(i);
    let r: Rect = rect(x, y, w, 52);
    let on: int = 0;
    if (id == extdev_id) on = 1;
    let hover: int = 0;
    if (mouse_hover_held(r) >= 1) hover = 1;
    th_row(r, on, hover);
    th_font_semi(13);
    draw_text(r.x + 14, r.y + 10, name, col_text_main());
    th_font(11);
    let sub: string = id;
    let lg: int = eng_ext_lang(i);
    if (lg == 0) sub = id + "  -  Nexa";
    else if (lg == 1) sub = id + "  -  C++";
    draw_text(r.x + 14, r.y + 30, sub, col_text_dim());
    th_font(14);
    if (hover == 1 && mouse_pressed(MOUSE_LEFT) && on == 0) {
        if (te_dirty() == 1) te_save();
        if (bp_is_open() == 1 && bp_dirty() == 1) bp_save();
        extdev_show_id(id);
    }
}

fn extdev_draw() {
    if (extdev_open == 0) return;
    draw_fill_rect(rect(0, 0, WIN_W, WIN_H), col_panel_dark());

    let foot_h: int = 64;
    let nav_w: int = 280;
    if (nav_w > WIN_W / 3) nav_w = WIN_W / 3;
    let nav: Rect = rect(0, 0, nav_w, WIN_H - foot_h);
    let body: Rect = rect(nav_w, 0, WIN_W - nav_w, WIN_H - foot_h);
    let foot: Rect = rect(0, WIN_H - foot_h, WIN_W, foot_h);

    draw_fill_rect(nav, col_bg_deep());
    draw_fill_rect(rect(nav.x + nav.w - 1, nav.y, 1, nav.h), col_border_soft());
    draw_fill_rect(foot, col_bg_deep());
    draw_fill_rect(rect(foot.x, foot.y, foot.w, 1), col_border_soft());

    th_font_semi(20);
    draw_text(nav.x + 24, nav.y + 28, "Develop", col_text_main());
    th_font(11);
    draw_text(nav.x + 24, nav.y + 58, "EXTENSIONS", col_text_dim());
    th_font(14);

    let nav_top: int = nav.y + 84;
    let nav_bot: int = nav.y + nav.h - 56;
    let nav_vis: int = nav_bot - nav_top;
    eng_set_clip(nav.x, nav_top, nav.w, nav_vis);
    let ny: int = nav_top - extdev_nav_scroll;
    let n: int = eng_ext_count();
    let listed: int = 0;
    let i: int = 0;
    while (i < n) {
        if (eng_ext_source(i).len() > 0) {
            extdev_nav_row(nav.x + 12, ny, nav.w - 24, i);
            ny = ny + 60;
            listed = listed + 1;
        }
        i = i + 1;
    }
    eng_clear_clip();
    let nav_total: int = listed * 60;
    let max_nav: int = nav_total - nav_vis;
    if (max_nav < 0) max_nav = 0;
    if (point_in_rect(eng_mouse_x(), eng_mouse_y(), rect(nav.x, nav_top, nav.w, nav_vis))) {
        let wh: int = eng_mouse_wheel();
        if (wh > 0) extdev_nav_scroll = extdev_nav_scroll - 60;
        if (wh < 0) extdev_nav_scroll = extdev_nav_scroll + 60;
    }
    if (extdev_nav_scroll < 0) extdev_nav_scroll = 0;
    if (extdev_nav_scroll > max_nav) extdev_nav_scroll = max_nav;

    if (ui_button(rect(nav.x + 16, nav.y + nav.h - 44, nav.w - 32, 32), "New...") == 1) {
        if (te_dirty() == 1) te_save();
        extdev_close();
        extbuild_show();
    }

    let idx: int = extdev_index();
    let head_h: int = 96;
    let x: int = body.x + 24;
    let y: int = body.y + 16;
    let w: int = body.w - 48;
    if (idx >= 0) {
        th_font_semi(18);
        draw_text(x, y, eng_ext_name(idx), col_text_main());
        th_font(12);
        let meta: string = eng_ext_id(idx) + "  v" + eng_ext_version(idx);
        if (eng_ext_full(idx) == 1) meta = meta + "  |  Full";
        else meta = meta + "  |  Sandbox";
        if (eng_ext_enabled(idx) == 0) meta = meta + "  |  Disabled";
        if (extdev_detached == 1) meta = meta + "  |  Code detached";
        draw_text(x, y + 26, meta, col_text_dim());
        th_font(14);
        if (ui_button(rect(x + w - 140, y, 140, 32), "Open folder") == 1) {
            eng_run_command("explorer \"" + eng_ext_folder(idx) + "\"");
        }
        y = y + 52;
        let is_cpp: int = 0;
        if (eng_ext_lang(idx) == 1) is_cpp = 1;
        let has_bp: int = extdev_has_blocks();
        if (is_cpp == 0) {
            let b_on: int = 0;
            let c_on: int = 0;
            if (extdev_view == 0) b_on = 1;
            else c_on = 1;
            if (ui_pill(rect(x, y, 100, 28), "Blocks", b_on) == 1) {
                if (extdev_detached == 1) {
                    extdev_status = "Code is detached. Use Reset from Blocks to return.";
                } else if (has_bp == 1) {
                    extdev_open_blocks();
                } else {
                    extdev_create_blocks();
                }
            }
            if (ui_pill(rect(x + 108, y, 100, 28), "Code", c_on) == 1) {
                if (extdev_view != 1) {
                    extdev_open_code(1);
                    extdev_status = "Code detached from Blocks. Reset from Blocks to sync again.";
                }
            }
            if (has_bp == 1 && extdev_detached == 1) {
                if (ui_button(rect(x + 220, y, 160, 28), "Reset from Blocks") == 1) {
                    extdev_reset_from_blocks();
                }
            } else if (has_bp == 0 && is_cpp == 0) {
                if (ui_button(rect(x + 220, y, 140, 28), "Create Blocks") == 1) {
                    extdev_create_blocks();
                }
            }
        } else {
            th_font(12);
            draw_text(x, y + 6, "C++ extensions use the Code editor only.", col_text_dim());
            th_font(14);
        }
    } else {
        th_font_semi(18);
        draw_text(x, y, "No extension selected", col_text_main());
        th_font(14);
    }

    let editor: Rect = rect(body.x + 16, body.y + head_h, body.w - 32, body.h - head_h - 8);
    if (editor.h > 80) {
        if (extdev_view == 0 && extdev_has_blocks() == 1 && extdev_detached == 0) {
            bp_set_host(editor.x, editor.y, editor.w, editor.h);
            bp_editor_input();
            bp_editor_draw();
            if (bp_host_want_save == 1) {
                bp_host_want_save = 0;
                extdev_save_and_rebuild();
            }
        } else {
            bp_clear_host();
            extdev_editor_input(editor);
            extdev_editor_draw(editor);
        }
    }

    if (ui_button(rect(foot.x + 24, foot.y + 16, 120, 32), "Back") == 1) extdev_close();
    if (ui_button(rect(foot.x + 156, foot.y + 16, 140, 32), "Save + Rebuild") == 1) extdev_save_and_rebuild();
    if (extdev_status.len() > 0) {
        th_font(12);
        draw_text(foot.x + 316, th_text_y(foot.y, foot.h), extdev_status, col_text_dim());
        th_font(14);
    }
    extdev_guard = 0;
    th_font(14);
}

fn build_game_begin() {
    if (proj_loaded() == 0) {
        eng_log("[export] no project open");
        return;
    }
    if (scene_render3d() == 1) {
        if (eng_fs_exists(player3d_exe_path()) == 0) {
            eng_log("[export] EyescirePlayer3D.exe not found at " + player3d_exe_path() + " (rebuild with build.cmd)");
            return;
        }
        save_active_scene();
        compile_begin("export");
        return;
    }
    let launcher: string = eng_runtime_exe_path();
    if (eng_fs_exists(launcher) == 0) {
        eng_log("[export] EyescirePlayer.exe not found at " + launcher);
        eng_log("[export] (rebuild with build.cmd: it makes EyescirePlayer.exe and EyescirePlayer.dll)");
        return;
    }
    let player_dll: string = eng_player_dll_path();
    if (eng_fs_exists(player_dll) == 0) {
        eng_log("[export] EyescirePlayer.dll not found at " + player_dll);
        return;
    }
    save_active_scene();
    compile_begin("export");
}

fn export_is_source(rel: string): int {
    let n: int = rel.len();
    if (n < 4) return 0;
    let e: string = rel.substring(n - 4, 4);
    if (e == ".nxa" || e == ".ebp") return 1;
    return 0;
}

/* 2 = windowed, 3 = console. Applied to the shipped .exe before the content key is sealed in. */
fn export_set_console(path: string, on: int): int {
    let ok: int = 0;
    inline_cpp! {
        FILE* f = fopen(path.c_str(), "r+b");
        if (f) {
            unsigned char mz[64];
            int pe = 0;
            int magic = 0;
            if (fread(mz, 1, 64, f) == 64 && mz[0] == 'M' && mz[1] == 'Z') {
                pe = (int)mz[0x3C] | ((int)mz[0x3D] << 8) | ((int)mz[0x3E] << 16) | ((int)mz[0x3F] << 24);
            }
            if (pe >= 64 && pe <= 4096 && fseek(f, pe, SEEK_SET) == 0) {
                unsigned char sig[4];
                if (fread(sig, 1, 4, f) == 4 && sig[0] == 'P' && sig[1] == 'E' && sig[2] == 0 && sig[3] == 0
                    && fseek(f, pe + 24, SEEK_SET) == 0) {
                    unsigned char mag[2];
                    if (fread(mag, 1, 2, f) == 2) magic = (int)mag[0] | ((int)mag[1] << 8);
                }
            }
            /* Optional-header magic, not the COFF machine field. Both PE32 and PE32+ keep Subsystem at +68. */
            if ((magic == 0x10B || magic == 0x20B) && fseek(f, pe + 24 + 68, SEEK_SET) == 0) {
                unsigned short sub = on ? 3 : 2;
                if (fwrite(&sub, 2, 1, f) == 1) ok = 1;
            }
            fclose(f);
        }
    }
    return ok;
}

fn export_fail(msg: string) {
    eng_log("[export] " + msg);
    dock_tab = "console";
    inline_cpp! {
        MessageBoxA(nullptr, msg.c_str(), "Eyescire Export", 0x10);
    }
}

/* llvm-mingw runtime DLLs — search next to the editor, engine.dll, then ../release. */
fn export_find_runtime_dll(name: string): string {
    let a: string = eng_exe_dir() + "\\" + name;
    if (eng_fs_exists(a) == 1) return a;
    let engp: string = eng_engine_dll_path();
    let slash: int = -1;
    let i: int = 0;
    while (i < engp.len()) {
        let c: string = engp.substring(i, 1);
        if (c == "\\" || c == "/") slash = i;
        i = i + 1;
    }
    if (slash >= 0) {
        let b: string = engp.substring(0, slash) + "\\" + name;
        if (eng_fs_exists(b) == 1) return b;
        let c2: string = engp.substring(0, slash) + "\\..\\release\\" + name;
        if (eng_fs_exists(c2) == 1) return c2;
    }
    let d: string = eng_exe_dir() + "\\..\\release\\" + name;
    if (eng_fs_exists(d) == 1) return d;
    return "";
}

fn do_export() {
    if (proj_loaded() == 0) return;

    let pname: string = proj_name();
    if (pname.len() == 0) pname = "Game";
    let dist_root: string = proj_path_join(proj_root(), "dist");
    let dist_dir:  string = proj_path_join(dist_root, pname);
    if (export_dest.len() > 0) dist_dir = export_dest;

    /* Resolve runtime DLLs before wiping dist — abort cleanly if missing. */
    let cxx_src: string = export_find_runtime_dll("libc++.dll");
    let unw_src: string = export_find_runtime_dll("libunwind.dll");
    if (cxx_src.len() == 0 || unw_src.len() == 0) {
        export_fail("libc++.dll / libunwind.dll not found next to the editor. Run build.cmd, then export again.");
        return;
    }

    eng_log("[export] target: " + dist_dir);
    eng_fs_remove_tree(dist_dir);
    eng_fs_make_dir(dist_dir);

    let runtime_dst: string = proj_path_join(dist_dir, pname + ".exe");
    if (scene_render3d() == 1) {
        /* 3D: EyescirePlayer3D.exe -> <ProjectName>.exe; it opens project.eye beside it */
        if (eng_fs_copy_file(player3d_exe_path(), runtime_dst) == 0) {
            export_fail("FAILED to copy EyescirePlayer3D.exe"); return;
        }
    } else {
        /* EyescirePlayer.exe launcher -> <ProjectName>.exe */
        if (eng_fs_copy_file(eng_runtime_exe_path(), runtime_dst) == 0) {
            export_fail("FAILED to copy EyescirePlayer.exe launcher"); return;
        }

        /* EyescirePlayer.dll — game player module */
        let player_dst: string = proj_path_join(dist_dir, "EyescirePlayer.dll");
        if (eng_fs_copy_file(eng_player_dll_path(), player_dst) == 0) {
            export_fail("FAILED to copy EyescirePlayer.dll"); return;
        }
    }

    /* engine.dll */
    let engine_dst: string = proj_path_join(dist_dir, "engine.dll");
    if (eng_fs_copy_file(eng_engine_dll_path(), engine_dst) == 0) {
        export_fail("FAILED to copy engine.dll"); return;
    }

    if (eng_fs_copy_file(cxx_src, proj_path_join(dist_dir, "libc++.dll")) == 0) {
        export_fail("FAILED to copy libc++.dll"); return;
    }
    if (eng_fs_copy_file(unw_src, proj_path_join(dist_dir, "libunwind.dll")) == 0) {
        export_fail("FAILED to copy libunwind.dll"); return;
    }
    if (pref_int("export_console", 0) == 1) {
        if (export_set_console(runtime_dst, 1) == 1) eng_log("[export] console window on");
        else eng_log("[export] FAILED to turn the console window on");
    } else {
        if (export_set_console(runtime_dst, 0) == 1) eng_log("[export] console window off");
        else eng_log("[export] FAILED to turn the console window off");
    }

    /* Filament is the 3D renderer. A 2D build does not ship it. */
    if (scene_render3d() == 1) {
        let fil_src: string = export_find_runtime_dll("filament_bridge.dll");
        if (fil_src.len() > 0) eng_fs_copy_file(fil_src, proj_path_join(dist_dir, "filament_bridge.dll"));
    }

    let root: string = proj_root();
    let prot: int = pref_int("export_protect", 1);
    if (prot < 0) prot = 0;
    if (prot > 3) prot = 3;
    let enc: int = 0;
    if (prot > 0) enc = 1;
    if (enc == 1) {
        if (eng_content_key_generate() == 0) {
            export_fail("FAILED to generate content key"); return;
        }
        eng_content_set_protect(prot);
        if (prot == 3) eng_log("[export] Secure protection: dual ChaCha + per-file keys + triple split");
        if (prot == 2) eng_log("[export] Strong protection: encrypt + integrity + split key");
        if (prot == 1) eng_log("[export] Standard protection: encrypt; key embedded in the .exe");
    }

    /* project.eye is encrypted with the rest when protection is on */
    let manifest_src: string = proj_path_join(root, "project.eye");
    let manifest_dst: string = proj_path_join(dist_dir, "project.eye");
    if (eng_content_ship_file(manifest_src, manifest_dst, enc) == 0) {
        eng_log("[export] FAILED to copy project.eye"); return;
    }

    let trim: int = pref_int("export_used", 1);
    if (trim == 1) {
        let n: int = export_used_count();
        let i: int = 0;
        while (i < n) {
            let rel: string = export_used_rel(i);
            /* Skip editor-only / source paths; player gets game.cfg instead of editor.cfg. */
            if (rel == "editor.cfg") { i = i + 1; continue; }
            if (export_is_source(rel) == 0) {
                let src: string = proj_path_join(root, rel);
                let dst: string = proj_path_join(dist_dir, rel);
                if (eng_content_ship_file(src, dst, enc) == 0) eng_log("[export] FAILED to copy " + rel);
            }
            i = i + 1;
        }
    } else {
        let scenes_src: string = proj_path_join(root, "scenes");
        if (eng_fs_exists(scenes_src) == 1) eng_content_ship_tree(scenes_src, proj_path_join(dist_dir, "scenes"), enc);

        let bin_src: string = proj_path_join(root, "bin");
        if (eng_fs_exists(bin_src) == 1) eng_content_ship_tree(bin_src, proj_path_join(dist_dir, "bin"), enc);

        let assets_src: string = proj_path_join(root, "assets");
        if (eng_fs_exists(assets_src) == 1) eng_content_ship_tree(assets_src, proj_path_join(dist_dir, "assets"), enc);

        let prefabs_src: string = proj_path_join(root, "prefabs");
        if (eng_fs_exists(prefabs_src) == 1) eng_content_ship_tree(prefabs_src, proj_path_join(dist_dir, "prefabs"), enc);

        let splash_src: string = proj_path_join(root, "splash.cfg");
        if (eng_fs_exists(splash_src) == 1) eng_content_ship_file(splash_src, proj_path_join(dist_dir, "splash.cfg"), enc);
    }
    /* Runtime prefs only — never ship editor.cfg (grid/export options/etc.). */
    if (eng_content_ship_game_cfg(proj_path_join(dist_dir, "game.cfg"), enc) == 0)
        eng_log("[export] FAILED to write game.cfg");
    /* Extensions: compiled DLL only (no .json / source / blueprints / .lib). */
    let ext_src: string = proj_path_join(root, "extensions");
    if (eng_fs_exists(ext_src) == 1) {
        if (eng_content_ship_extensions(ext_src, proj_path_join(dist_dir, "extensions"), enc) == 0)
            eng_log("[export] FAILED to ship extensions");
    }
    let ext_cfg: string = proj_path_join(root, "extensions.cfg");
    if (eng_fs_exists(ext_cfg) == 1) eng_content_ship_file(ext_cfg, proj_path_join(dist_dir, "extensions.cfg"), enc);
    if (enc == 1) {
        let emb: int = 0;
        if (prot >= 2) emb = eng_content_embed_key_ex(runtime_dst, engine_dst);
        else emb = eng_content_embed_key(runtime_dst);
        if (emb == 0) {
            export_fail("FAILED to embed content key (protection). Check Console for details."); return;
        }
        eng_content_key_clear();
    }
    let icons_dst: string = proj_path_join(dist_dir, "icons");
    eng_fs_make_dir(icons_dst);
    let logo_src: string = eng_exe_dir() + "\\icons\\eyescire.png";
    if (eng_fs_exists(logo_src) == 0) logo_src = eng_exe_dir() + "\\..\\icons\\eyescire.png";
    if (eng_fs_exists(logo_src) == 1) eng_fs_copy_file(logo_src, proj_path_join(icons_dst, "eyescire.png"));

    eng_log("[export] DONE -> " + runtime_dst);
    if (pref_int("export_open_folder", 1) == 1) eng_run_command("explorer \"" + dist_dir + "\"");
    export_dest = "";
}

/* ----- toolbar pill button helpers ----- */

/* accent: 0 = secondary, 1 = primary, 2 = danger (std/ui button kinds) */
fn pill_kind(accent: int): string {
    if (accent == 1) return "primary";
    if (accent == 2) return "danger";
    return "secondary";
}

fn ui_pill_draw(r: Rect, label: string, accent: int) {
    let st: int = mouse_hover_held(r);
    let hover: int = 0;
    let held: int = 0;
    if (st >= 1) hover = 1;
    if (st == 2) held = 1;
    th_button(r, label, pill_kind(accent), hover, held);
}

fn ui_pill(r: Rect, label: string, accent: int): int {
    return ui_button_kind(r, label, pill_kind(accent));
}

fn ui_pill_disabled(r: Rect, label: string) {
    th_button(r, label, "disabled", 0, 0);
}

/* Icon on a toolbar plate. kind matches th_button: primary, secondary, ghost, danger, disabled. */
fn ui_chrome_icon_draw(r: Rect, icon: string, tooltip: string, kind: string) {
    let st: int = mouse_hover_held(r);
    let hover: int = 0;
    let held: int = 0;
    if (kind != "disabled" && st >= 1) hover = 1;
    if (kind != "disabled" && st == 2) held = 1;
    th_button(r, "", kind, hover, held);
    let c: Color = col_text_main();
    if (kind == "primary" || kind == "danger") c = rgb(220, 220, 220);
    if (kind == "disabled") c = rgb(110, 110, 110);
    /* Fixed glyph size so Play / Pause / Stop share one optical box. */
    let s: int = 18;
    if (r.w < 28 || r.h < 28) s = 14;
    let ix: int = r.x + (r.w - s) / 2;
    let iy: int = r.y + (r.h - s) / 2;
    if (held == 1) iy = iy + 1;
    icon_draw(icon, ix, iy, s, s, c);
    if (hover == 1 && tooltip.len() > 0) tooltip_request(tooltip, r);
}

fn ui_chrome_icon(r: Rect, icon: string, tooltip: string, kind: string): int {
    ui_chrome_icon_draw(r, icon, tooltip, kind);
    if (kind == "disabled") return 0;
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    if (point_in_rect(mx, my, r) && mouse_pressed(MOUSE_LEFT)) return 1;
    return 0;
}

/* Segmented tool picker: the active tool is accent-tinted, others go ghost. */
fn ui_tool_btn_draw(r: Rect, label: string, shortcut: string, active: int) {
    let hover: int = 0;
    if (mouse_hover_held(r) >= 1) hover = 1;
    let tc: Color = col_text_dim();
    if (active == 1) {
        th_fill(r, th_radius_for(r.h), col_accent_dim());
        tc = th_shade(col_accent(), 90);
    } else if (hover == 1) {
        th_fill(r, th_radius_for(r.h), col_panel_lit());
        tc = col_text_main();
    }
    let iname: string = "move";
    if (label == "Pan") iname = "pan";
    if (label == "Move") iname = "move";
    if (label == "Rot") iname = "rotate";
    if (label == "Scale") iname = "scale";
    icon_draw(iname, r.x + (r.w - 16) / 2, r.y + 1, 16, 16, tc);
    th_font(10);
    let kc: Color = col_text_dim();
    if (active == 1) kc = tc;
    draw_text_centered(r.x, r.y + 16, r.w, 12, shortcut, kc);
    th_font(14);
    if (hover == 1) tooltip_request(label + " tool  (" + shortcut + ")", r);
}

fn ui_tool_btn_input(r: Rect, label: string, shortcut: string, active: int): int {
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();
    let hover: bool = point_in_rect(mx, my, r);
    if (hover && mouse_pressed(MOUSE_LEFT)) return 1;
    return 0;
}

fn toolbar_input() {
    if (mouse_pressed(MOUSE_LEFT) == 0) return;
    let mx: int = eng_mouse_x();
    let my: int = eng_mouse_y();

    let hand_on: int = 0;
    let move_on: int = 0;
    let rot_on: int = 0;
    let scale_on: int = 0;
    if (edit_tool == "hand") hand_on = 1;
    if (edit_tool == "move") move_on = 1;
    if (edit_tool == "rotate") rot_on = 1;
    if (edit_tool == "scale") scale_on = 1;
    if (ui_tool_btn_input(toolbar_tool_rect(0), "Pan", "Q", hand_on) == 1) edit_tool = "hand";
    if (ui_tool_btn_input(toolbar_tool_rect(1), "Move", "W", move_on) == 1) edit_tool = "move";
    if (ui_tool_btn_input(toolbar_tool_rect(2), "Rotate", "E", rot_on) == 1) edit_tool = "rotate";
    if (ui_tool_btn_input(toolbar_tool_rect(3), "Scale", "R", scale_on) == 1) edit_tool = "scale";
    let space_label: string = "World";
    if (xform_local == 1) space_label = "Local";
    if (ui_tool_btn_input(toolbar_tool_rect(4), space_label, "L", xform_local) == 1) {
        if (xform_local == 1) xform_local = 0;
        else xform_local = 1;
    }

    if (app_state == "edit" && point_in_rect(mx, my, toolbar_settings_rect())) {
        settings_show();
        return;
    }
    if (app_state == "edit") {
        if (point_in_rect(mx, my, toolbar_play_rect())) { want_play = 1; return; }
    } else {
        if (point_in_rect(mx, my, toolbar_stop_rect())) { want_stop = 1; return; }
        if (point_in_rect(mx, my, toolbar_pause_rect())) {
            if (play_paused == 1) play_paused = 0;
            else                  play_paused = 1;
            return;
        }
    }

    if (app_state != "edit") return;

    if (point_in_rect(mx, my, toolbar_save_rect()))  { save_active_scene(); return; }
    if (point_in_rect(mx, my, toolbar_build_rect())) { compile_begin("idle"); return; }
    if (point_in_rect(mx, my, toolbar_redo_rect()))  { redo(); return; }
    if (point_in_rect(mx, my, toolbar_undo_rect()))  { undo(); return; }
    if (point_in_rect(mx, my, toolbar_add_label_rect())) { add_ui_label_at_center(); return; }
    if (point_in_rect(mx, my, toolbar_add_rect())) {
        if (viewport_mode == "ui") add_ui_panel_at_center();
        else                       add_rect_at_center();
        return;
    }
    if (point_in_rect(mx, my, toolbar_close_rect())) close_active_project();
}

fn toolbar_draw() {
    let r: Rect = toolbar_rect();
    draw_fill_rect(r, col_panel_dark());
    chrome_hsep(r.x, r.y + r.h - 1, r.w);

    let hand_on: int = 0;
    let move_on: int = 0;
    let rot_on: int = 0;
    let scale_on: int = 0;
    if (edit_tool == "hand") hand_on = 1;
    if (edit_tool == "move") move_on = 1;
    if (edit_tool == "rotate") rot_on = 1;
    if (edit_tool == "scale") scale_on = 1;
    ui_tool_btn_draw(toolbar_tool_rect(0), "Pan", "Q", hand_on);
    ui_tool_btn_draw(toolbar_tool_rect(1), "Move", "W", move_on);
    ui_tool_btn_draw(toolbar_tool_rect(2), "Rot", "E", rot_on);
    ui_tool_btn_draw(toolbar_tool_rect(3), "Scale", "R", scale_on);
    let space_label: string = "World";
    if (xform_local == 1) space_label = "Local";
    ui_tool_btn_draw(toolbar_tool_rect(4), space_label, "L", xform_local);

    let save_r: Rect = toolbar_save_rect();
    chrome_vsep(save_r.x - 8, toolbar_btn_y() + 4, toolbar_btn_h() - 8);

    if (app_state == "edit") {
        ui_chrome_icon_draw(toolbar_save_rect(), "save", "Save", "secondary");
        ui_chrome_icon_draw(toolbar_build_rect(), "build", "Build", "secondary");
    } else {
        ui_chrome_icon_draw(toolbar_save_rect(), "save", "Save", "disabled");
        ui_chrome_icon_draw(toolbar_build_rect(), "build", "Build", "disabled");
    }

    chrome_vsep(toolbar_play_x() - 10, toolbar_btn_y() + 4, toolbar_btn_h() - 8);
    if (app_state == "edit") {
        ui_chrome_icon_draw(toolbar_play_rect(), "play", "Play", "primary");
        ui_chrome_icon_draw(toolbar_pause_rect(), "pause", "Pause", "disabled");
        ui_chrome_icon_draw(toolbar_stop_rect(), "stop", "Stop", "disabled");
    } else {
        ui_chrome_icon_draw(toolbar_play_rect(), "play", "Play", "disabled");
        let pause_icon: string = "pause";
        let pause_tip: string = "Pause";
        if (play_paused == 1) { pause_icon = "play"; pause_tip = "Resume"; }
        ui_chrome_icon_draw(toolbar_pause_rect(), pause_icon, pause_tip, "secondary");
        ui_chrome_icon_draw(toolbar_stop_rect(), "stop", "Stop", "danger");
    }
    let stop_r: Rect = toolbar_stop_rect();
    chrome_vsep(stop_r.x + stop_r.w + 10, toolbar_btn_y() + 4, toolbar_btn_h() - 8);

    let set_on: int = 0;
    if (settings_open == 1) set_on = 1;
    ui_pill_draw(toolbar_settings_rect(), "Settings", set_on);
    let add_r: Rect = toolbar_add_rect();
    chrome_vsep(add_r.x - 8, toolbar_btn_y() + 4, toolbar_btn_h() - 8);
    if (app_state == "edit") {
        ui_chrome_icon_draw(toolbar_add_rect(), "add_rect", "Add rectangle", "ghost");
        ui_chrome_icon_draw(toolbar_add_label_rect(), "add_label", "Add UI label", "ghost");
        ui_chrome_icon_draw(toolbar_undo_rect(), "undo", "Undo", "ghost");
        ui_chrome_icon_draw(toolbar_redo_rect(), "redo", "Redo", "ghost");
    } else {
        ui_chrome_icon_draw(toolbar_add_rect(), "add_rect", "Add rectangle", "disabled");
        ui_chrome_icon_draw(toolbar_add_label_rect(), "add_label", "Add UI label", "disabled");
        ui_chrome_icon_draw(toolbar_undo_rect(), "undo", "Undo", "disabled");
        ui_chrome_icon_draw(toolbar_redo_rect(), "redo", "Redo", "disabled");
    }
    ui_chrome_icon_draw(toolbar_close_rect(), "close", "Close project", "secondary");
}

// =============================================================================
// Edit mode hotkeys
// =============================================================================

fn edit_hotkeys() {
    if (extdev_open == 1) {
        if (edit_target.len() == 0 && key_pressed(VK_ESCAPE)) extdev_close();
        return;
    }
    if (extbuild_open == 1) {
        if (edit_target.len() == 0 && key_pressed(VK_ESCAPE)) extbuild_close();
        return;
    }
    if (export_open == 1) {
        if (edit_target.len() == 0 && key_pressed(VK_ESCAPE)) export_close();
        return;
    }
    if (settings_open == 1) {
        if (edit_target.len() == 0 && key_pressed(VK_ESCAPE)) settings_close();
        return;
    }
    if (edit_target.len() > 0) return;  /* don't fire while typing */
    if (viewport_mode == "script") {
        /* script editor handles its own input */
        if (key_pressed(VK_F2)) {
            let target: string = open_script_rel();
            if (target.len() > 0) begin_script_rename(target);
        }
        if (ctrl_held() && key_pressed(VK_P)) want_play = 1;
        if (ctrl_held() && key_pressed(VK_B)) compile_begin("idle");
        return;
    }
    if (viewport_mode == "ui") {
        if (ctrl_held() && key_pressed(VK_P)) want_play = 1;
        if (ctrl_held() && key_pressed(VK_B)) compile_begin("idle");
    }
    if (key_pressed(VK_DELETE)) {
        let s: int = sel_first();
        while (s >= 0) {
            undo_save_delete(s);
            ent_destroy(s);
            s = sel_iter_next(0);
        }
    }
    if (key_pressed(VK_F2)) {
        let s: int = sel_first();
        if (s >= 0) inspector_begin_rename(s);
    }
    if (ctrl_held() == false && orb_mode != 1) {   /* not while flying the 3D view (WASD/QE) */
        if (key_pressed(VK_Q)) edit_tool = "hand";
        if (key_pressed(VK_W)) edit_tool = "move";
        if (key_pressed(VK_E)) edit_tool = "rotate";
        if (key_pressed(VK_R)) edit_tool = "scale";
        if (key_pressed(VK_L)) {
            if (xform_local == 1) xform_local = 0;
            else xform_local = 1;
        }
    }
    if (ctrl_held() && app_state != "play") {
        if (key_pressed(VK_S)) save_active_scene();
        if (key_pressed(VK_Z) && shift_held()) redo();
        else if (key_pressed(VK_Z))            undo();
        if (key_pressed(VK_Y))                 redo();
        if (key_pressed(VK_B) && shift_held()) { force_rebuild = 1; compile_begin("idle"); }
        else if (key_pressed(VK_B))            compile_begin("idle");
        if (key_pressed(VK_E)) export_show(0);
        if (key_pressed(VK_P))                 want_play = 1;
        if (key_pressed(VK_PAGEUP))            cycle_scene(-1);
        if (key_pressed(VK_PAGEDOWN))          cycle_scene(1);
        if (key_pressed(VK_D)) {
            let s: int = sel_first();
            if (s >= 0) {
                let ns: int = ent_create(ent_kind(s), ent_name(s),
                                         ent_x(s) + 16, ent_y(s) + 16, ent_w(s), ent_h(s),
                                         ent_r(s), ent_g(s), ent_b(s));
                if (ns >= 0) {
                    ent_set_text(ns, ent_text(s));
                    ent_set_font_px(ns, ent_font_px(s));
                    ent_set_font_ox(ns, ent_font_ox(s));
                    ent_set_font_oy(ns, ent_font_oy(s));
                    ent_set_ui_radius(ns, ent_ui_radius(s));
                    ent_set_ui_border(ns, ent_ui_border(s));
                    ent_set_ui_align(ns, ent_ui_align(s));
                    ent_set_ui_shadow(ns, ent_ui_shadow(s));
                    ent_set_ui_text(ns, ent_ui_text(s));
                    ent_set_pixel(ns, ent_pixel(s));
                    ent_set_script(ns, ent_script(s));
                    ent_set_sprite(ns, ent_sprite(s));
                    ent_set_parent(ns, ent_parent(s));
                    ent_set_rot(ns, ent_rot(s));
                    ent_set_rot_x(ns, ent_rot_x(s));
                    ent_set_rot_y(ns, ent_rot_y(s));
                    ent_set_z(ns, ent_z(s));
                    ent_set_depth(ns, ent_depth(s));
                    ent_set_model(ns, ent_model(s));
                    ent_set_sound(ns, ent_sound(s));
                    ent_set_sound_loop(ns, ent_sound_loop(s));
                    ent_set_sound_range(ns, ent_sound_range(s));
                    ent_set_emit_rate(ns, ent_emit_rate(s));
                    ent_set_emit_life(ns, ent_emit_life(s));
                    ent_set_emit_speed(ns, ent_emit_speed(s));
                    ent_set_emit_spread(ns, ent_emit_spread(s));
                    ent_set_emit_size(ns, ent_emit_size(s));
                    ent_set_emit_hd(ns, ent_emit_hd(s));
                    ent_set_light_intensity(ns, ent_light_intensity(s));
                    ent_set_light_range(ns, ent_light_range(s));
                    ent_set_light_angle(ns, ent_light_angle(s));
                    ent_set_light_tilt(ns, ent_light_tilt(s));
                    ent_set_visible(ns, ent_visible(s));
                    ent_set_alpha(ns, ent_a(s));
                    ent_set_body(ns, ent_has_body(s));
                    ent_set_body_type(ns, ent_body_type(s));
                    ent_set_hitbox(ns, ent_hitbox(s));
                    ent_set_ui_value(ns, ent_ui_value(s));
                    ent_copy_button(ns, s);
                    eng_pub_copy(ns, s);
                    ent_set_aa(ns, ent_aa(s));
                    undo_save_create(ns);
                    sel_clear();
                    ent_set_selected(ns, 1);
                }
            }
        }
    }
}

// =============================================================================
// Play mode
// =============================================================================

fn enter_play() {
    /* Scripts are already built by the compile pipeline.
     * Load every DLL, fire script_init once, then flip into play state. */
    if (eng_splash_run() == 0) return;
    play_snapshot_path = eng_exe_dir() + "\\_play_snapshot.scene";
    eng_scene_save(play_snapshot_path);
    let n: int = proj_script_count();
    let loaded: int = 0;
    let i: int = 0;
    while (i < n) {
        let dll: string = proj_script_dll(i);
        if (eng_fs_exists(dll) == 1) {
            let h: int = eng_dll_load(dll);
            if (h != 0) {
                eng_dll_call(h, "script_init");
                loaded = loaded + 1;
            }
        } else {
            eng_log("[play] missing dll: " + dll);
        }
        i = i + 1;
    }
    app_state = "play";
    play_paused = 0;
    play_undo_depth = undo_depth();
    sel_clear();
    viewport_show("play");
    sfx_set_live(1);
    phys_begin();
    eng_log("[play] entered with " + loaded + "/" + n + " script(s) loaded");
}

fn exit_play() {
    eng_mouse_lock(0);
    eng_music_stop();
    sfx_set_live(0);
    tilemap_destroy();
    phys_end();
    if (play_snapshot_path.len() > 0 && eng_fs_exists(play_snapshot_path) == 1) {
        eng_scene_load(play_snapshot_path);
    } else if (proj_loaded() == 1 && proj_scene_count() > 0) {
        let p: string = proj_scene_abs(proj_active_scene());
        if (eng_fs_exists(p) == 1) eng_scene_load(p);
    }
    /* release script DLLs so subsequent rebuilds aren't locked out by Windows. */
    eng_dll_unload_all();
    undo_trim(play_undo_depth);
    if (viewport_mode == "play") {
        cam_x = play_saved_cam_x;
        cam_y = play_saved_cam_y;
        cam_zoom = play_saved_cam_zoom;
    }
    app_state = "edit";
    play_paused = 0;
    eng_log("[play] stopped, scene reloaded, DLLs unloaded");
}

fn scene_has_pause(): int {
    let s: int = ent_iter_next(0);
    while (s >= 0) {
        if (ent_script(s) == "pause.nxa") return 1;
        s = ent_iter_next(s + 1);
    }
    return 0;
}

fn play_dispatch_scripts() {
    if (play_paused == 1) return;
    let paused: int = eng_paused();
    let s: int = ent_iter_next(0);
    while (s >= 0) {
        let sc: string = ent_script(s);
        let run: int = 1;
        if (paused == 1 && sc != "pause.nxa") run = 0;
        if (run == 1 && sc.len() > 0) {
            let dll: string = proj_path_join(proj_path_join(proj_root(), "bin"),
                                             sc.replace(".nxa", ".dll"));
            if (eng_fs_exists(dll) == 1) {
                let h: int = eng_dll_load(dll);
                if (h != 0) {
                    eng_set_self(s);
                    eng_dll_call(h, "script_update");
                }
            }
        }
        s = ent_iter_next(s + 1);
    }
    eng_set_self(-1);
}

fn play_dispatch_draw() {
    let s: int = ent_iter_next(0);
    while (s >= 0) {
        let sc: string = ent_script(s);
        if (sc.len() > 0) {
            let dll: string = proj_path_join(proj_path_join(proj_root(), "bin"),
                                             sc.replace(".nxa", ".dll"));
            if (eng_fs_exists(dll) == 1) {
                let h: int = eng_dll_load(dll);
                if (h != 0) {
                    eng_set_self(s);
                    eng_dll_call(h, "script_draw");
                }
            }
        }
        s = ent_iter_next(s + 1);
    }
    eng_set_self(-1);
}

fn play_draw_overlay() {
    let v: Rect = viewport_rect();
    let label: string = "PLAYING";
    if (play_paused == 1) label = "PAUSED";
    th_font(11);
    let hint: string = "Esc to stop";
    if (scene_has_pause() == 1) hint = "Esc to pause";
    let hw: int = eng_text_width(hint);
    let card: Rect = rect(v.x + v.w - hw - 110, v.y + v.h - 34, hw + 102, 26);
    viewport_hud_card(card.x, card.y, card.w, card.h);
    let chip_c: Color = col_play();
    if (play_paused == 1) chip_c = col_warn();
    th_chip(rect(card.x + 5, card.y + 4, 72, card.h - 8), label, chip_c);
    th_font(11);
    draw_text(card.x + 86, th_text_y(card.y, card.h), hint, col_text_dim());
    th_font(14);
}

/* Scene, UI, and Script keep the editor camera. Play shows the game camera. */
fn viewport_show(mode: string) {
    if (mode == viewport_mode) return;
    if (mode == "play") {
        play_saved_cam_x = cam_x;
        play_saved_cam_y = cam_y;
        play_saved_cam_zoom = cam_zoom;
    } else if (viewport_mode == "play") {
        cam_x = play_saved_cam_x;
        cam_y = play_saved_cam_y;
        cam_zoom = play_saved_cam_zoom;
    }
    viewport_mode = mode;
}

/* Scripts and physics keep going on every tab. The editor camera is put back
   when the Play tab is not the one on screen. */
fn play_sim() {
    if (viewport_mode == "play") {
        ui_canvas_layout_game_view(game_view_rect());
        ui_poll_buttons();
    }
    let hold: int = 0;
    let sx: float = cam_x;
    let sy: float = cam_y;
    let sz: float = cam_zoom;
    if (viewport_mode != "play") hold = 1;
    play_snap_to_camera();
    apply_engine_view();
    play_dispatch_scripts();
    if (play_paused == 0) phys_step(eng_dt_seconds());
    if (hold == 1) {
        cam_x = sx;
        cam_y = sy;
        cam_zoom = sz;
        apply_engine_view();
    } else {
        play_snap_to_camera();
        apply_engine_view();
    }
}

/* The game camera, in the 16:9 frame. Shown by the Play tab whether or not
   the game is running. */
fn play_viewport_draw() {
    if (scene_render3d() == 1) {
        let gv: Rect = game_view_rect();
        let wipe: Color = col_bg_deep();
        eng_fill_rect(gv.x, gv.y, gv.w, gv.h, wipe.r, wipe.g, wipe.b);
    } else {
        play_snap_to_camera();
        apply_engine_view();
        viewport_draw_grid();
        viewport_draw_tilemap();
        viewport_draw_entities();
    }
    if (app_state == "play") {
        ui_canvas_layout_game_view(game_view_rect());
        th_font_mono(14);
        play_dispatch_draw();
        th_font(14);
        play_draw_overlay();
    } else {
        let v: Rect = viewport_rect();
        th_font(11);
        draw_text(v.x + 12, v.y + v.h - 22, "Press Play to run. This tab keeps the game camera.", col_text_dim());
        th_font(14);
    }
    viewport_draw_ui_overlay();
}

// =============================================================================
// Project settings
// =============================================================================

fn settings_show() {
    if (app_state != "edit") return;
    if (proj_loaded() == 0) return;
    if (export_open == 1) export_close();
    if (extbuild_open == 1) extbuild_close();
    if (extdev_open == 1) extdev_close();
    settings_open = 1;
    settings_ready = 0;
    settings_guard = 1;
    settings_scroll = 0;
    settings_nav_scroll = 0;
    menu_open = "";
    if (edit_target.len() < 4 || edit_target.substring(0, 4) != "set_") edit_target = "";
}

fn settings_close() {
    settings_open = 0;
    settings_ready = 0;
    settings_guard = 0;
    if (edit_target.len() >= 4 && edit_target.substring(0, 4) == "set_") edit_target = "";
}

fn settings_sync() {
    if (settings_ready == 1) return;
    settings_name = proj_name();
    settings_gx = fmt2(phys_gravity_x());
    settings_gy = fmt2(phys_gravity_y());
    settings_ppm = fmt2(phys_ppm());
    settings_cr = "" + scene_clear_r();
    settings_cg = "" + scene_clear_g();
    settings_cb = "" + scene_clear_b();
    settings_fov = fmt2(scene_fov());
    settings_sky0 = scene_sky_face(0);
    settings_sky1 = scene_sky_face(1);
    settings_sky2 = scene_sky_face(2);
    settings_sky3 = scene_sky_face(3);
    settings_sky4 = scene_sky_face(4);
    settings_sky5 = scene_sky_face(5);
    settings_pw = "" + pref_int("play_w", 1280);
    settings_ph = "" + pref_int("play_h", 720);
    settings_music = "" + pref_int("music", 100);
    settings_sfx = "" + pref_int("sfx", 100);
    settings_fog_r = "" + pref_int("fog_r", 168);
    settings_fog_g = "" + pref_int("fog_g", 186);
    settings_fog_b = "" + pref_int("fog_b", 206);
    settings_fog_d = "" + pref_int("fog_dist", 4800);
    settings_ready = 1;
}

fn settings_save_scene() {
    if (proj_loaded() == 0 || proj_scene_count() == 0) return;
    eng_scene_save(proj_scene_abs(proj_active_scene()));
    gravity_buf_ready = 0;
    env_buf_ready = 0;
}

fn settings_page_header(x: int, y: int, title: string, subtitle: string): int {
    th_font_semi(18);
    draw_text(x, y, title, col_text_main());
    th_font(14);
    y = y + 30;
    if (subtitle.len() > 0) {
        th_font(12);
        draw_text(x, y, subtitle, col_text_dim());
        th_font(14);
        y = y + 26;
    }
    return y;
}

fn settings_hint(x: int, y: int, w: int, text: string): int {
    th_font(12);
    draw_text(x, y, text, col_text_dim());
    th_font(14);
    return y + 22;
}

fn settings_nav_row(x: int, y: int, w: int, id: int, label: string) {
    let r: Rect = rect(x, y, w, 44);
    let on: int = 0;
    if (settings_page == id) on = 1;
    let hover: int = 0;
    if (mouse_hover_held(r) >= 1) hover = 1;
    th_row(r, on, hover);
    th_font_semi(13);
    draw_text(r.x + 14, th_text_y(r.y, r.h), label, col_text_main());
    th_font(14);
    if (hover == 1 && mouse_pressed(MOUSE_LEFT)) {
        if (settings_page != id) {
            settings_page = id;
            settings_scroll = 0;
            if (edit_target.len() >= 6) {
                let head: string = edit_target.substring(0, 6);
                if (head == "set_sh" || head == "set_sf") edit_target = "";
            }
        }
    }
}

fn settings_onoff(x: int, y: int, w: int, label: string, key: string, def: int) {
    draw_text(x, th_text_y(y, 28), label, col_text_main());
    let on: int = pref_int(key, def);
    let k0: string = "secondary";
    let k1: string = "secondary";
    if (on == 1) k1 = "primary";
    else k0 = "primary";
    if (ui_button_kind(rect(x + w - 168, y, 76, 28), "Off", k0) == 1 && on == 1) pref_set_int(key, 0);
    if (ui_button_kind(rect(x + w - 84, y, 76, 28), "On", k1) == 1 && on == 0) pref_set_int(key, 1);
}

fn settings_launch_row(x: int, y: int, w: int, si: int, rel: string, selected: int) {
    let r: Rect = rect(x, y, w, 36);
    let hover: int = 0;
    if (mouse_hover_held(r) >= 1) hover = 1;
    th_row(r, selected, hover);
    th_font(13);
    draw_text(r.x + 14, th_text_y(r.y, r.h), rel, col_text_main());
    th_font(14);
    if (hover == 1 && mouse_pressed(MOUSE_LEFT)) {
        proj_set_start(rel);
        switch_active_scene(si);
        settings_ready = 0;
    }
}

fn splash_file_name(path: string): string {
    let slash: int = -1;
    let i: int = 0;
    while (i < path.len()) {
        let c: string = path.substring(i, 1);
        if (c == "/" || c == "\\") slash = i;
        i = i + 1;
    }
    if (slash < 0) return path;
    return path.substring(slash + 1, path.len() - slash - 1);
}

fn splash_row_visible(y: int, h: int): int {
    if (y + h < settings_clip_y0) return 0;
    if (y > settings_clip_y1) return 0;
    return 1;
}

fn settings_splash_section(x: int, y: int, w: int): int {
    y = chrome_section(x, y, w, "SPLASH");
    draw_text(x, y, "Plays when the game starts. A click or a key skips to the next screen.", col_text_dim());
    y = y + 22;
    draw_text(x, y, "Each screen fades out, then the next one fades in.", col_text_dim());
    y = y + 28;
    if (splash_row_visible(y, 28) == 1) {
        draw_text(x, th_text_y(y, 28), "Made with Eyescire", col_text_main());
        let on: int = splash_brand();
        let k0: string = "secondary";
        let k1: string = "secondary";
        if (on == 1) k1 = "primary";
        else k0 = "primary";
        if (ui_button_kind(rect(x + w - 168, y, 76, 28), "Off", k0) == 1 && on == 1) splash_set_brand(0);
        if (ui_button_kind(rect(x + w - 84, y, 76, 28), "On", k1) == 1 && on == 0) splash_set_brand(1);
    }
    y = y + 34;
    draw_text(x, y, "The words and the logo play first. Turn this off to start on your own images.", col_text_dim());
    y = y + 28;
    if (splash_row_visible(y, 28) == 1) {
        draw_text(x, th_text_y(y, 28), "Skip", col_text_main());
        let kon: int = splash_keys();
        let kk0: string = "secondary";
        let kk1: string = "secondary";
        if (kon == 1) kk1 = "primary";
        else kk0 = "primary";
        if (ui_button_kind(rect(x + w - 168, y, 76, 28), "Off", kk0) == 1 && kon == 1) splash_set_keys(0);
        if (ui_button_kind(rect(x + w - 84, y, 76, 28), "On", kk1) == 1 && kon == 0) splash_set_keys(1);
    }
    y = y + 34;
    draw_text(x, y, "Off waits out each screen. On, a click or a key skips.", col_text_dim());
    y = y + 32;
    let n: int = splash_count();
    let i: int = 0;
    while (i < n) {
        let path: string = splash_image(i);
        if (splash_row_visible(y, 22) == 1) draw_text(x, y, splash_file_name(path), col_text_main());
        y = y + 20;
        if (splash_row_visible(y, 28) == 1) {
            chrome_field_label(x, y, "Hold");
            chrome_field_label(x + 150, y, "Fade");
            y = y + 16;
            let hid: string = "set_sh" + i;
            let fid: string = "set_sf" + i;
            let hb: string = ui_field(hid, rect(x, y, 120, 28), splash_hold_text(i));
            let fb: string = ui_field(fid, rect(x + 150, y, 120, 28), splash_fade_text(i));
            if (hb != splash_hold_text(i)) splash_set_hold_text(i, hb);
            if (fb != splash_fade_text(i)) splash_set_fade_text(i, fb);
            if (ui_button(rect(x + w - 96, y, 96, 28), "Remove") == 1) {
                if (edit_target == hid || edit_target == fid) edit_target = "";
                splash_remove(i);
                return y + 40;
            }
        } else {
            y = y + 16;
        }
        y = y + 40;
        i = i + 1;
    }
    if (n >= 8) {
        draw_text(x, y, "Eight screens is the limit.", col_text_dim());
        y = y + 24;
    } else if (splash_row_visible(y, 28) == 1 && ui_button(rect(x, y, 160, 28), "Add image") == 1) {
        let picked: string = eng_open_file_dialog("Splash image", "Images|*.png;*.jpg;*.jpeg;*.bmp;*.gif", proj_root());
        if (picked.len() > 0 && proj_import_asset(picked) == 1) {
            splash_add(proj_last_import(), 2000, 400);
        }
    }
    y = y + 36;
    return y;
}

fn settings_page_project(x: int, y: int, w: int) {
    y = settings_page_header(x, y, "Project", "Name, startup scene, and splash screens");
    y = chrome_section(x, y, w, "PROJECT");
    chrome_field_label(x, y, "Name");
    y = y + 18;
    let nm: string = ui_field("set_name", rect(x, y, w, 28), settings_name);
    if (nm != settings_name) {
        proj_set_name(nm);
        settings_name = proj_name();
        eng_set_title("Eyescire Editor - " + proj_name());
    }
    y = y + 40;
    chrome_field_label(x, y, "Folder");
    y = y + 18;
    draw_text(x, y, proj_root(), col_text_main());
    y = y + 28;
    if (ui_button(rect(x, y, 160, 28), "Open folder") == 1) {
        eng_run_command("explorer \"" + proj_root() + "\"");
    }
    y = y + 44;
    y = chrome_section(x, y, w, "OPENS ON LAUNCH");
    y = settings_hint(x, y, w, "This scene loads when the project opens.");
    let start: string = proj_start();
    let si: int = 0;
    let shown: int = 0;
    while (si < proj_scene_count() && shown < 6) {
        let rel: string = proj_scene_rel(si);
        let mark: int = 0;
        if (rel == start) mark = 1;
        settings_launch_row(x, y, w, si, rel, mark);
        y = y + 40;
        shown = shown + 1;
        si = si + 1;
    }
    if (proj_scene_count() > 6) {
        draw_text(x, y, "More scenes are in the Scenes panel.", col_text_dim());
        y = y + 24;
    }
    y = y + 8;
    y = chrome_section(x, y, w, "CONTENTS");
    draw_text(x, y, "Scenes  " + proj_scene_count(), col_text_main());
    y = y + 22;
    draw_text(x, y, "Scripts  " + proj_script_count(), col_text_main());
    y = y + 22;
    draw_text(x, y, "Blueprints  " + proj_bp_count(), col_text_main());
    y = y + 22;
    draw_text(x, y, "Prefabs  " + proj_prefab_count(), col_text_main());
    y = y + 22;
    draw_text(x, y, "Assets  " + proj_asset_count(), col_text_main());
    y = y + 32;
    if (ui_button(rect(x, y, 180, 28), "Rescan project") == 1) {
        proj_rescan_scenes();
        proj_rescan_scripts();
        proj_rescan_prefabs();
        proj_rescan_assets();
        eng_log("[project] rescanned");
    }
    y = y + 48;
    y = settings_splash_section(x, y, w);
    settings_bottom = y;
}

fn settings_page_player(x: int, y: int, w: int) {
    y = settings_page_header(x, y, "Scene", "2D/3D mode, sky, and field of view");
    y = chrome_section(x, y, w, "HOW THIS SCENE PLAYS");
    let half: int = (w - 8) / 2;
    let is3d: int = scene_render3d();
    let k2: string = "secondary";
    let k3: string = "secondary";
    if (is3d == 1) k3 = "primary";
    else k2 = "primary";
    if (ui_button_kind(rect(x, y, half, 28), "2D", k2) == 1 && is3d == 1) {
        scene_set_render3d(0);
        settings_save_scene();
    }
    if (ui_button_kind(rect(x + half + 8, y, half, 28), "3D", k3) == 1 && is3d == 0) {
        scene_set_render3d(1);
        settings_save_scene();
    }
    y = y + 40;
    th_font(14);
    if (is3d == 1) {
        draw_text(x, y, "Play launches the 3D player with this scene's camera and lights.", col_text_dim());
    } else {
        draw_text(x, y, "Play runs inside the editor viewport.", col_text_dim());
    }
    y = y + 36;
    y = chrome_section(x, y, w, "ACTIVE SCENE");
    let scene: string = "(none)";
    if (proj_scene_count() > 0) scene = proj_scene_rel(proj_active_scene());
    draw_text(x, y, scene, col_text_main());
    y = y + 28;
    draw_text(x, y, "2D play stays in the editor. 3D play launches the 3D player.", col_text_dim());
    y = y + 36;
    y = chrome_section(x, y, w, "SKY");
    draw_text(x, y, "Fills the 3D view, Play, and exported 3D games.", col_text_dim());
    y = y + 24;
    let sky: int = scene_sky();
    let fifth: int = (w - 32) / 5;
    let kday: string = "secondary";
    let kset: string = "secondary";
    let knight: string = "secondary";
    let ksolid: string = "secondary";
    let kown: string = "secondary";
    if (sky == 1) kset = "primary";
    else if (sky == 2) knight = "primary";
    else if (sky == 3) kown = "primary";
    else if (sky == 4) ksolid = "primary";
    else kday = "primary";
    if (ui_button_kind(rect(x, y, fifth, 28), "Day", kday) == 1) settings_apply_sky(0);
    if (ui_button_kind(rect(x + fifth + 8, y, fifth, 28), "Sunset", kset) == 1) settings_apply_sky(1);
    if (ui_button_kind(rect(x + (fifth + 8) * 2, y, fifth, 28), "Night", knight) == 1) settings_apply_sky(2);
    if (ui_button_kind(rect(x + (fifth + 8) * 3, y, fifth, 28), "Solid", ksolid) == 1) settings_apply_sky(4);
    if (ui_button_kind(rect(x + (fifth + 8) * 4, y, fifth, 28), "Custom", kown) == 1) settings_apply_sky(3);
    y = y + 40;
    if (sky == 3) {
        draw_text(x, y, "One picture for each side.", col_text_dim());
        y = y + 22;
        let face: int = 0;
        while (face < 6) {
            chrome_field_label(x, y, settings_sky_label(face));
            y = y + 16;
            let cur: string = settings_sky_buf(face);
            let edited: string = ui_field("set_sky" + face, rect(x, y, w - 96, 28), cur);
            if (edited != cur) settings_sky_commit(face, edited);
            if (ui_button(rect(x + w - 88, y, 88, 28), "Browse...") == 1) {
                let filter: string = "Images|*.png;*.jpg;*.jpeg;*.bmp;*.gif|All files|*.*";
                let initial: string = "";
                if (proj_loaded() == 1) initial = proj_path_join(proj_root(), "assets");
                let chosen: string = eng_open_file_dialog("Sky face", filter, initial);
                if (chosen.len() > 0) settings_sky_commit(face, chosen);
            }
            y = y + 40;
            face = face + 1;
        }
    }
    y = chrome_section(x, y, w, "SOLID COLOR");
    draw_text(x, y, "One flat color for the whole sky.", col_text_dim());
    y = y + 24;
    let third: int = (w - 16) / 3;
    chrome_field_label(x, y, "Red");
    chrome_field_label(x + third + 8, y, "Green");
    chrome_field_label(x + (third + 8) * 2, y, "Blue");
    y = y + 16;
    let crb: string = ui_field("set_cr", rect(x, y, third, 28), settings_cr);
    let cgb: string = ui_field("set_cg", rect(x + third + 8, y, third, 28), settings_cg);
    let cbb: string = ui_field("set_cb", rect(x + (third + 8) * 2, y, third, 28), settings_cb);
    if (crb != settings_cr || cgb != settings_cg || cbb != settings_cb) {
        scene_set_clear(parse_int_or(crb, scene_clear_r()), parse_int_or(cgb, scene_clear_g()), parse_int_or(cbb, scene_clear_b()));
        scene_set_sky(4);
        settings_cr = crb;
        settings_cg = cgb;
        settings_cb = cbb;
        settings_save_scene();
    }
    y = y + 40;
    if (ui_button(rect(x, y, third, 28), "Night") == 1) settings_apply_clear(28, 32, 40);
    if (ui_button(rect(x + third + 8, y, third, 28), "Black") == 1) settings_apply_clear(0, 0, 0);
    if (ui_button(rect(x + (third + 8) * 2, y, third, 28), "Sky") == 1) settings_apply_clear(140, 176, 214);
    y = y + 44;
    y = chrome_section(x, y, w, "FIELD OF VIEW");
    chrome_field_label(x, y, "Degrees");
    y = y + 16;
    let fv: string = ui_field("set_fov", rect(x, y, 120, 28), settings_fov);
    if (fv != settings_fov) {
        scene_set_fov(parse_float_or(fv, scene_fov()));
        settings_fov = fv;
        settings_save_scene();
    }
    if (ui_button(rect(x + 132, y, 72, 28), "45") == 1) settings_apply_fov(45.0);
    if (ui_button(rect(x + 212, y, 72, 28), "60") == 1) settings_apply_fov(60.0);
    if (ui_button(rect(x + 292, y, 72, 28), "90") == 1) settings_apply_fov(90.0);
    y = y + 40;
    draw_text(x, y, "The editor camera, Play, and export use this angle.", col_text_dim());
    y = y + 28;
    settings_bottom = y;
}

fn settings_apply_sky(mode: int) {
    scene_set_sky(mode);
    settings_save_scene();
}

fn settings_sky_label(face: int): string {
    if (face == 0) return "Right";
    if (face == 1) return "Left";
    if (face == 2) return "Up";
    if (face == 3) return "Down";
    if (face == 4) return "Front";
    return "Back";
}

fn settings_sky_buf(face: int): string {
    if (face == 0) return settings_sky0;
    if (face == 1) return settings_sky1;
    if (face == 2) return settings_sky2;
    if (face == 3) return settings_sky3;
    if (face == 4) return settings_sky4;
    return settings_sky5;
}

fn settings_sky_commit(face: int, v: string) {
    scene_set_sky_face(face, v);
    let stored: string = scene_sky_face(face);
    if (edit_target == "set_sky" + face) stored = v;
    if (face == 0) settings_sky0 = stored;
    else if (face == 1) settings_sky1 = stored;
    else if (face == 2) settings_sky2 = stored;
    else if (face == 3) settings_sky3 = stored;
    else if (face == 4) settings_sky4 = stored;
    else settings_sky5 = stored;
    settings_save_scene();
}

fn settings_apply_clear(r: int, g: int, b: int) {
    scene_set_clear(r, g, b);
    scene_set_sky(4);
    settings_cr = "" + scene_clear_r();
    settings_cg = "" + scene_clear_g();
    settings_cb = "" + scene_clear_b();
    if (edit_target == "set_cr" || edit_target == "set_cg" || edit_target == "set_cb") edit_target = "";
    settings_save_scene();
}

fn settings_apply_fov(deg: float) {
    scene_set_fov(deg);
    settings_fov = fmt2(scene_fov());
    if (edit_target == "set_fov") edit_target = "";
    settings_save_scene();
}

fn settings_apply_gravity(gx: float, gy: float) {
    phys_set_gravity(gx, gy);
    settings_gx = fmt2(gx);
    settings_gy = fmt2(gy);
    if (edit_target == "set_gx" || edit_target == "set_gy") edit_target = "";
    settings_save_scene();
}

fn settings_page_physics(x: int, y: int, w: int) {
    y = settings_page_header(x, y, "Physics", "Gravity and collision scale");
    y = chrome_section(x, y, w, "GRAVITY");
    draw_text(x, y, "Pixels per second, squared. Positive Y pulls down the screen.", col_text_dim());
    y = y + 24;
    let half: int = (w - 8) / 2;
    chrome_field_label(x, y, "X");
    chrome_field_label(x + half + 8, y, "Y");
    y = y + 16;
    let gxb: string = ui_field("set_gx", rect(x, y, half, 28), settings_gx);
    let gyb: string = ui_field("set_gy", rect(x + half + 8, y, half, 28), settings_gy);
    if (gxb != settings_gx || gyb != settings_gy) {
        let ngx: float = parse_float_or(gxb, phys_gravity_x());
        let ngy: float = parse_float_or(gyb, phys_gravity_y());
        if (ngx != phys_gravity_x() || ngy != phys_gravity_y()) {
            phys_set_gravity(ngx, ngy);
            settings_save_scene();
        }
        settings_gx = gxb;
        settings_gy = gyb;
    }
    y = y + 40;
    let quarter: int = (w - 24) / 4;
    if (ui_button(rect(x, y, quarter, 28), "Earth") == 1) settings_apply_gravity(0.0, 980.0);
    if (ui_button(rect(x + quarter + 8, y, quarter, 28), "Moon") == 1) settings_apply_gravity(0.0, 163.0);
    if (ui_button(rect(x + (quarter + 8) * 2, y, quarter, 28), "Mars") == 1) settings_apply_gravity(0.0, 371.0);
    if (ui_button(rect(x + (quarter + 8) * 3, y, quarter, 28), "Zero-G") == 1) settings_apply_gravity(0.0, 0.0);
    y = y + 48;
    y = chrome_section(x, y, w, "SCALE");
    chrome_field_label(x, y, "Pixels per meter");
    y = y + 18;
    let pp: string = ui_field("set_ppm", rect(x, y, 160, 28), settings_ppm);
    if (pp != settings_ppm) {
        let np: float = parse_float_or(pp, phys_ppm());
        if (np != phys_ppm()) {
            phys_set_ppm(np);
            settings_save_scene();
        }
        settings_ppm = pp;
    }
    y = y + 40;
    y = settings_hint(x, y, w, "50 is the default. Bodies use the new scale the next time you press Play.");
    settings_bottom = y;
}

fn settings_page_build(x: int, y: int, w: int) {
    y = settings_page_header(x, y, "Build", "Compile scripts and open export");
    y = chrome_section(x, y, w, "SCRIPTS");
    if (ui_button(rect(x, y, 200, 32), "Build") == 1) {
        settings_close();
        compile_begin("idle");
    }
    if (ui_button(rect(x + 208, y, 200, 32), "Rebuild all") == 1) {
        settings_close();
        force_rebuild = 1;
        compile_begin("idle");
    }
    y = y + 44;
    y = settings_hint(x, y, w, "Build compiles scripts that changed. Rebuild all compiles every script.");
    y = y + 12;
    y = chrome_section(x, y, w, "EXPORT");
    if (ui_button(rect(x, y, 200, 32), "Export...") == 1) {
        settings_close();
        export_show(0);
    }
    y = y + 44;
    y = settings_hint(x, y, w, "Opens the export picker (Windows or Web presets, path, and options).");
    y = y + 12;
    settings_onoff(x, y, w, "Export used files", "export_used", 1);
    y = y + 36;
    y = settings_hint(x, y, w, "On ships the launch scene, scenes a script opens, and files those scripts name.");
    y = settings_hint(x, y, w, "Off copies every scene, script, prefab, and asset.");
    settings_bottom = y;
}

fn settings_page_extensions(x: int, y: int, w: int) {
    y = settings_page_header(x, y, "Extensions", "Install DLL plugins for editor and game");

    y = chrome_section(x, y, w, "INSTALL");
    th_font(12);
    draw_text(x, y, "Installed DLLs start sandboxed. New Extension creates a local plugin with Full permission.", col_text_dim());
    th_font(14);
    y = y + 28;
    if (ui_button_primary(rect(x, y, 200, 32), "New Extension...") == 1) {
        settings_close();
        extbuild_show();
    }
    if (ui_button(rect(x + 208, y, 160, 32), "Install DLL...") == 1) {
        let chosen: string = eng_open_file_dialog("Install Extension DLL", "Extension DLL (*.dll)|*.dll|All files|*.*", proj_root());
        if (chosen.len() > 0) {
            if (eng_ext_install_dll(chosen) == 1) {
                eng_ext_load_enabled(1);
                eng_log("[ext] installed " + chosen);
            } else {
                eng_log("[ext] install failed: " + chosen);
            }
        }
    }
    if (ui_button(rect(x + 376, y, 120, 32), "Rescan") == 1) {
        eng_ext_rescan();
        eng_ext_load_enabled(1);
    }
    y = y + 48;

    y = chrome_section(x, y, w, "INSTALLED");
    let n: int = eng_ext_count();
    if (n == 0) {
        th_font(12);
        draw_text(x, y, "No extensions in this project yet.", col_text_dim());
        th_font(14);
        y = y + 28;
        settings_bottom = y;
        return;
    }
    let i: int = 0;
    while (i < n) {
        let name: string = eng_ext_name(i);
        let ver: string = eng_ext_version(i);
        let id: string = eng_ext_id(i);
        th_font_semi(14);
        draw_text(x, y, name + "  v" + ver, col_text_main());
        th_font(14);
        let has_src: int = 0;
        if (eng_ext_source(i).len() > 0) has_src = 1;
        if (has_src == 1 && ui_button(rect(x + w - 232, y, 108, 28), "Develop") == 1) {
            settings_close();
            extdev_show_index(i);
            extdev_status = "Editing " + eng_ext_id(i) + ". Save rebuilds automatically.";
            return;
        }
        if (ui_button_danger(rect(x + w - 112, y, 112, 28), "Uninstall") == 1) {
            if (eng_ext_uninstall(i) == 1) {
                n = eng_ext_count();
                continue;
            }
        }
        y = y + 24;
        th_font(12);
        let lang_tag: string = "";
        let lg: int = eng_ext_lang(i);
        if (lg == 0) lang_tag = "  -  Nexa";
        else if (lg == 1) lang_tag = "  -  C++";
        draw_text(x, y, id + lang_tag, col_text_dim());
        th_font(14);
        y = y + 28;

        let en: int = eng_ext_enabled(i);
        draw_text(x, th_text_y(y, 28), "Enabled", col_text_main());
        let koff: string = "secondary";
        let kon: string = "secondary";
        if (en == 1) kon = "primary";
        else koff = "primary";
        if (ui_button_kind(rect(x + w - 168, y, 76, 28), "Off", koff) == 1 && en == 1) {
            eng_ext_set_enabled(i, 0);
            eng_ext_load_enabled(1);
        }
        if (ui_button_kind(rect(x + w - 84, y, 76, 28), "On", kon) == 1 && en == 0) {
            eng_ext_set_enabled(i, 1);
            eng_ext_load_enabled(1);
        }
        y = y + 36;

        let full: int = eng_ext_full(i);
        draw_text(x, th_text_y(y, 28), "Permission", col_text_main());
        let ks: string = "secondary";
        let kf: string = "secondary";
        if (full == 1) kf = "primary";
        else ks = "primary";
        if (ui_button_kind(rect(x + w - 168, y, 76, 28), "Sandbox", ks) == 1 && full == 1) {
            eng_ext_set_full(i, 0);
            eng_ext_load_enabled(1);
        }
        if (ui_button_kind(rect(x + w - 84, y, 76, 28), "Full", kf) == 1 && full == 0) {
            eng_ext_set_full(i, 1);
            eng_log("[ext] Full permission: " + id + " can use the entire engine API");
            eng_ext_load_enabled(1);
        }
        y = y + 36;

        let desc: string = eng_ext_desc(i);
        if (desc.len() > 0) {
            th_font(12);
            draw_text(x, y, desc, col_text_dim());
            th_font(14);
            y = y + 22;
        }
        if (full == 1) {
            th_font(12);
            draw_text(x, y, "Full trust - this DLL can call any engine API.", col_text_dim());
            th_font(14);
            y = y + 22;
        }
        if (i + 1 < n) {
            draw_fill_rect(rect(x, y, w, 1), col_border_soft());
            y = y + 16;
        }
        i = i + 1;
    }
    settings_bottom = y;
}

fn settings_page_editor(x: int, y: int, w: int) {
    y = settings_page_header(x, y, "Editor", "Grid, snapping, and autosave");
