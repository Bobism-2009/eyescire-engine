    }
    if (ui_button(rect(x + 132, y, 64, 28), "Mute") == 1) { pref_set_int("music", 0); settings_music = "0"; if (edit_target == "set_music") edit_target = ""; }
    if (ui_button(rect(x + 204, y, 64, 28), "Full") == 1) { pref_set_int("music", 100); settings_music = "100"; if (edit_target == "set_music") edit_target = ""; }
    y = y + 48;
    y = chrome_section(x, y, w, "EFFECTS");
    draw_text(x, y, "0 to 100. Scripts read this with the effects volume.", col_text_dim());
    y = y + 24;
