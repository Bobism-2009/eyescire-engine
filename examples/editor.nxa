// =============================================================================
// Eyescire Editor - the only executable in the project.
//
// Loads engine.dll for window/GDI/entity/scene/project/script-DLL state,
// runs a welcome screen + scene editor + in-window play mode, and hot-recompiles
// scripts/*.nxa whenever the source file changes.
// =============================================================================

#include "../engine/engine.nxa"
#include "../engine/theme.nxa"
#include <std/file>

/* user32's MessageBoxA, declared here: <windows.h> would clash with the
   engine's VK_* constants. Used only for the startup failure message. */
inline_cpp! {
extern "C" __declspec(dllimport) int __stdcall MessageBoxA(void*, const char*, const char*, unsigned int);
}

