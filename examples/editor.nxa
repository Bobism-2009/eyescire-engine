    if (ui_button(rect(x + 204, y, 64, 28), "Full") == 1) { pref_set_int("sfx", 100); settings_sfx = "100"; if (edit_target == "set_sfx") edit_target = ""; }
    settings_bottom = y + 40;
}

/* Full-screen settings page — replaces the editor chrome while open. */
fn settings_draw() {
    if (settings_open == 0) return;
    settings_sync();
    draw_fill_rect(rect(0, 0, WIN_W, WIN_H), col_panel_dark());

    let foot_h: int = 64;
    let nav_w: int = 280;
    if (nav_w > WIN_W / 3) nav_w = WIN_W / 3;
    let nav: Rect = rect(0, 0, nav_w, WIN_H - foot_h);
    let body: Rect = rect(nav_w, 0, WIN_W - nav_w, WIN_H - foot_h);
    let foot: Rect = rect(0, WIN_H - foot_h, WIN_W, foot_h);

    draw_fill_rect(nav, col_bg_deep());
    draw_fill_rect(rect(nav.x + nav.w - 1, nav.y, 1, nav.h), col_border_soft());
    draw_fill_rect(foot, col_bg_deep());
    draw_fill_rect(rect(foot.x, foot.y, foot.w, 1), col_border_soft());

    th_font_semi(20);
    draw_text(nav.x + 24, nav.y + 28, "Settings", col_text_main());
    th_font(11);
    draw_text(nav.x + 24, nav.y + 58, "PAGES", col_text_dim());
    th_font(14);
    let nav_ix: int = nav.x + 12;
    let nav_iw: int = nav.w - 24;
    let nav_top: int = nav.y + 84;
    let nav_vis_h: int = nav.h - 84;
    let nav_step: int = 48;
    let nav_total: int = 8 * nav_step;
    let max_nav_scroll: int = nav_total - nav_vis_h;
    if (max_nav_scroll < 0) max_nav_scroll = 0;
    eng_set_clip(nav.x, nav_top, nav.w, nav_vis_h);
    let ny: int = nav_top - settings_nav_scroll;
    settings_nav_row(nav_ix, ny, nav_iw, 0, "Project");
    ny = ny + nav_step;
    settings_nav_row(nav_ix, ny, nav_iw, 1, "Scene");
    ny = ny + nav_step;
    settings_nav_row(nav_ix, ny, nav_iw, 2, "Physics");
    ny = ny + nav_step;
    settings_nav_row(nav_ix, ny, nav_iw, 3, "Editor");
    ny = ny + nav_step;
    settings_nav_row(nav_ix, ny, nav_iw, 4, "Graphics");
    ny = ny + nav_step;
    settings_nav_row(nav_ix, ny, nav_iw, 5, "Audio");
    ny = ny + nav_step;
    settings_nav_row(nav_ix, ny, nav_iw, 6, "Build");
    ny = ny + nav_step;
    settings_nav_row(nav_ix, ny, nav_iw, 7, "Extensions");
    eng_clear_clip();
    if (point_in_rect(eng_mouse_x(), eng_mouse_y(), nav)) {
        let nwh: int = eng_mouse_wheel();
        if (nwh > 0) settings_nav_scroll = settings_nav_scroll - nav_step;
        if (nwh < 0) settings_nav_scroll = settings_nav_scroll + nav_step;
    }
    if (settings_nav_scroll < 0) settings_nav_scroll = 0;
    if (settings_nav_scroll > max_nav_scroll) settings_nav_scroll = max_nav_scroll;

    let x: int = body.x + 48;
    let y: int = body.y + 36 - settings_scroll;
    let w: int = body.w - 96;
    if (w > 720) w = 720;
    settings_clip_y0 = body.y + 24;
    settings_clip_y1 = body.y + body.h - 24;
    eng_set_clip(body.x + 24, settings_clip_y0, body.w - 48, body.h - 48);
    if (settings_page == 0) settings_page_project(x, y, w);
    else if (settings_page == 1) settings_page_player(x, y, w);
    else if (settings_page == 2) settings_page_physics(x, y, w);
    else if (settings_page == 3) settings_page_editor(x, y, w);
    else if (settings_page == 4) settings_page_graphics(x, y, w);
    else if (settings_page == 5) settings_page_audio(x, y, w);
    else if (settings_page == 6) settings_page_build(x, y, w);
    else settings_page_extensions(x, y, w);
    eng_clear_clip();

    let max_scroll: int = 0;
    let content_h: int = settings_bottom + settings_scroll - (body.y + 36);
    max_scroll = content_h - (body.h - 72);
    if (max_scroll < 0) max_scroll = 0;
    let content: Rect = rect(body.x + 24, body.y + 24, body.w - 48, body.h - 48);
    if (point_in_rect(eng_mouse_x(), eng_mouse_y(), content) && eng_mouse_x() >= nav_w) {
        let wh: int = eng_mouse_wheel();
        if (wh > 0) settings_scroll = settings_scroll - 56;
        if (wh < 0) settings_scroll = settings_scroll + 56;
    }
    if (settings_scroll < 0) settings_scroll = 0;
    if (settings_scroll > max_scroll) settings_scroll = max_scroll;

    if (ui_button(rect(foot.x + 24, foot.y + 16, 120, 32), "Back") == 1) settings_close();
    settings_guard = 0;
    th_font(14);
}

// =============================================================================
// Edit-mode frame
// =============================================================================

fn edit_frame() {
    os_file_drop_handle();
    edit_hotkeys();
    menu_dismiss_if_outside_click();
    drag_update();
    if (app_state == "play") play_sim();
    if (proj_loaded() == 1) eng_ext_update_all();

    let bgc: Color = col_bg_deep();
    eng_clear(bgc.r, bgc.g, bgc.b);

    let menu_capturing: int = 0;
    if (menu_open.len() > 0)         menu_capturing = 1;
    if (context_menu_active == 1)    menu_capturing = 1;
    if (scene_picker_open == 1)      menu_capturing = 1;
    if (drag_is_active())            menu_capturing = 1;
    if (hier_drag_active == 1)       menu_capturing = 1;
    if (settings_open == 1)          menu_capturing = 1;
    if (export_open == 1)            menu_capturing = 1;
    if (extbuild_open == 1)          menu_capturing = 1;
    if (extdev_open == 1)            menu_capturing = 1;

    if (menu_capturing == 0) {
        toolbar_input();
        if (viewport_mode == "script") script_editor_input();
        else if (viewport_mode == "ui") ui_viewport_input();
        else if (viewport_mode != "play") {
            if (view3d_active() == 1) viewport3d_input();
            else                      viewport_input();
        }
        console_input();
    }

    if (extdev_open == 1) {
        extdev_draw();
        tooltip_draw();
    } else if (extbuild_open == 1) {
        extbuild_draw();
        tooltip_draw();
    } else if (export_open == 1) {
        export_draw();
        tooltip_draw();
    } else if (settings_open == 1) {
        settings_draw();
        tooltip_draw();
    } else {
        if (viewport_mode == "play" && scene_render3d() == 1) play_draw3d();
        else if (view3d_active() == 1 && viewport_mode != "script" && viewport_mode != "ui") viewport3d_submit();

        menubar_draw();
        toolbar_draw();
        left_draw();
        viewport_tabs_draw();
        if (viewport_mode == "script") script_editor_draw();
        else if (viewport_mode == "ui") ui_viewport_draw();
        else if (viewport_mode == "play") play_viewport_draw();
        else if (view3d_active() == 1) viewport3d_overlay();
        else                           viewport_draw();
        inspector_draw();
        dock_draw();
        statusbar_draw();

        if (context_menu_active == 1) context_menu_draw();
        menu_draw_dropdown_overlay();
        scene_picker_draw();
        scene_picker_dismiss_outside();
        drag_preview_draw();
        hier_drag_preview_draw();
        tooltip_draw();
    }

    if (app_state != "play" && pref_int("autosave", 1) == 1 && proj_loaded() == 1 && proj_scene_count() > 0) {
        autosave_acc = autosave_acc + eng_dt_seconds();
        if (autosave_acc >= 20.0) {
            autosave_acc = 0.0;
            eng_scene_save(proj_scene_abs(proj_active_scene()));
        }
    }

    if (want_play == 1) {
        want_play = 0;
        if (app_state != "play") {
            save_active_scene();
            if (viewport_mode == "script" && te_dirty() == 1) te_save();
            compile_begin("play");
        }
    }
    if (eng_take_leave_play() == 1 && app_state == "play") {
        exit_play();
    } else if (app_state == "play" && want_stop == 1) {
        want_stop = 0;
        exit_play();
    } else if (app_state == "play" && viewport_mode == "play" && settings_open == 0 && edit_target.len() == 0 && key_pressed(VK_ESCAPE) && scene_has_pause() == 0) {
        exit_play();
    }
}

// =============================================================================
// main
// =============================================================================

fn typed_discard() {
    let c: int = typed_pop();
    while (c != 0) c = typed_pop();
}

/* The script view types without a field id. Everywhere else, keys that were
   not aimed at a box are thrown away before the next click can swallow them. */
fn typed_keep_for_script(): int {
    if (app_state != "edit" && app_state != "play") return 0;
    if (compile_active == 1) return 0;
    if (ext_rebuild_active == 1) return 0;
    if (viewport_mode != "script") return 0;
    if (bp_is_open() == 1) return 0;
    if (edit_target.len() > 0) return 0;
    if (menu_open.len() > 0) return 0;
    if (context_menu_active == 1) return 0;
    if (scene_picker_open == 1) return 0;
    if (drag_is_active()) return 0;
    if (hier_drag_active == 1) return 0;
    return 1;
}

fn main() {
    let ok: int = eng_init(WIN_W, WIN_H, "Eyescire Editor");
    if (ok == 0) {
        /* built with --no-console, so a println would go nowhere */
        inline_cpp! {
            MessageBoxA(nullptr, "Could not create the editor window.", "Eyescire Editor", 0x10);
        }
        return;
    }
    set_target_fps(60);

    let recent_path: string = eng_exe_dir() + "\\eyescire_recent.txt";
    proj_recent_set_file(recent_path);
    proj_recent_load();

    let running: int = 1;
    while (running == 1) {
        frame_begin();
        th_font(14);   /* chrome font; widgets that switch face restore it */
        running = eng_pump();
        /* Editing looks around only while the right button is held.
           Play keeps a blueprint lock until Stop. */
        if (app_state != "play" && mouse_down(MOUSE_RIGHT) == false) eng_mouse_lock(0);
        /* lay out to the window instead of stretching a fixed-size frame;
           below the minimum the layout is scaled down as before */
        if (eng_client_w() > 64 && eng_client_h() > 64) {
            let cw: int = eng_client_w();
            let ch: int = eng_client_h();
            if (cw < 1100) cw = 1100;
            if (ch < 680)  ch = 680;
            if (cw != WIN_W || ch != WIN_H) {
                if (eng_fit_buffer(cw, ch) == 1) {
                    WIN_W = cw;
                    WIN_H = ch;
                }
            }
        }
        if (want_quit == 1) running = 0;
        if (app_state == "welcome" && key_pressed(VK_ESCAPE) && edit_target.len() == 0) {
            running = 0;
        }

        let was_compiling: int = compile_active;
        let was_ext_rebuild: int = ext_rebuild_active;

        if (edit_target.len() == 0 && typed_keep_for_script() == 0) typed_discard();

        if (compile_active == 1) {
            compile_frame();
        } else if (ext_rebuild_active == 1) {
            ext_rebuild_overlay_draw();
        } else if (app_state == "welcome") {
            welcome_frame();
        } else if (app_state == "edit" || app_state == "play") {
            edit_frame();
        }

        /* if the per-state frame just kicked off a build (Build / Play button),
           overdraw with the compile overlay so the user actually sees it during
           the synchronous NexaC call below. */
        if (was_compiling == 0 && compile_active == 1) {
            compile_frame();
        }
        if (was_ext_rebuild == 0 && ext_rebuild_active == 1) {
            ext_rebuild_overlay_draw();
        }

        eng_present();
        frame_end();

        /* synchronous: blocks the main thread while NexaC compiles each script. */
        if (compile_active == 1) compile_step();
        if (ext_rebuild_active == 1) ext_rebuild_step();

        if (play_pending == 1 && play_in_window == 1) {
            play_pending = 0;
            play_in_window = 0;
            launch_play_3d();
        }
        if (play_pending == 1) {
            play_pending = 0;
            enter_play();
        }
    }
    if (app_state == "edit") save_active_scene();
    eng_shutdown();
}

