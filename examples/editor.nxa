fn add_rect_at_center() {
    let v: Rect = viewport_rect();
    let wxf: float = screen_to_world_x(v.x + v.w / 2);
    let wyf: float = screen_to_world_y(v.y + v.h / 2);
    let wx: int = wxf - 32.0;
    let wy: int = wyf - 32.0;
    let s: int = ent_create("rect", "rect", wx, wy, 64, 64, 200, 200, 200);
    if (s >= 0) {
        undo_save_create(s);
        sel_clear();
        ent_set_selected(s, 1);
    }
}

fn add_rect_at(x_screen: int, y_screen: int) {
    let s: int = spawn_rect_at(x_screen, y_screen);
    if (s >= 0) {
        undo_save_create(s);
        sel_clear();
        ent_set_selected(s, 1);
    }
}

