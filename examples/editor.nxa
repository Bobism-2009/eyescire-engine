/* "Sprite": a rect entity that immediately prompts for an image. The
 * rect is created first so even if the user cancels the dialog they get
 * an entity placed at the click point. */
fn add_sprite_at(x_screen: int, y_screen: int) {
    let s: int = spawn_sprite_at(x_screen, y_screen);
    if (s >= 0) {
        undo_save_create(s);
        sel_clear();
        ent_set_selected(s, 1);
    }
}

fn spawn_sprite_at(x_screen: int, y_screen: int): int {
    let wxf: float = screen_to_world_x(x_screen);
    let wyf: float = screen_to_world_y(y_screen);
    let wx: int = wxf - 32.0;
    let wy: int = wyf - 32.0;
    let s: int = ent_create("rect", "sprite", wx, wy, 64, 64, 255, 255, 255);
    if (s < 0) return -1;

    let filter: string = "Images|*.png;*.jpg;*.jpeg;*.bmp;*.gif|All files|*.*";
    let initial: string = "";
    if (proj_loaded() == 1) initial = proj_path_join(proj_root(), "assets");
    let chosen: string = eng_open_file_dialog("Choose sprite", filter, initial);
    if (chosen.len() > 0) {
        ent_set_sprite(s, chosen);
        let img: int = eng_image_load_cached(chosen);
        if (img != 0) {
            let iw: int = eng_image_w(img);
            let ih: int = eng_image_h(img);
            if (iw > 0 && ih > 0) {
                let nx_f: float = wxf - iw / 2.0;
                let ny_f: float = wyf - ih / 2.0;
                let nx: int = nx_f;
                let ny: int = ny_f;
                ent_set_w(s, iw);
                ent_set_h(s, ih);
                ent_set_x(s, nx);
                ent_set_y(s, ny);
            }
        }
    }
    return s;
}

/* "Empty": invisible 1x1 entity for parents/markers. */
fn add_empty_at(x_screen: int, y_screen: int) {
    let s: int = spawn_empty_at(x_screen, y_screen);
    if (s >= 0) {
        undo_save_create(s);
        sel_clear();
        ent_set_selected(s, 1);
    }
}

fn spawn_empty_at(x_screen: int, y_screen: int): int {
    let wxf: float = screen_to_world_x(x_screen);
    let wyf: float = screen_to_world_y(y_screen);
    let wx: int = wxf;
    let wy: int = wyf;
    return ent_create("empty", "empty", wx, wy, 0, 0, 255, 255, 255);
}

/* 3D shape centred on the cursor. A model asks for its .obj first and is not
   created if the dialog is cancelled. */
/* Scene position for something created at a screen point: the 2D layout's
   transform (z 0), or in the 3D view the point under it at the distance the
   camera is focused on. */
let spawn_wx: float = 0.0;
let spawn_wy: float = 0.0;
let spawn_wz: float = 0.0;
fn spawn_locate(x_screen: int, y_screen: int) {
    spawn_wx = screen_to_world_x(x_screen);
    spawn_wy = screen_to_world_y(y_screen);
    spawn_wz = 0.0;
    /* created on an entity (it becomes the parent): cm_spawn_x/y already point
       at its center, so only its depth is missing */
    if (cm_spawn_target >= 0 && ent_active(cm_spawn_target) == 1) spawn_wz = ent_z(cm_spawn_target);
    if (view3d_active() == 1 && cm_spawn_target < 0) {
        if (r3d_ray_point(x_screen, y_screen, orb_dist) == 1) {
            spawn_wx = r3d_hx();
            spawn_wy = r3d_hy();
            spawn_wz = r3d_hz();
        }
    }
}

fn spawn_light_at(kind: string, x_screen: int, y_screen: int): int {
    spawn_locate(x_screen, y_screen);
    let wx: int = spawn_wx - 24.0;
    let wy: int = spawn_wy - 24.0;
    let name: string = "Point Light";
    let r: int = 255;
    let g: int = 214;
    let b: int = 170;
    if (kind == "light_directional") { name = "Directional Light"; g = 244; b = 214; }
    if (kind == "light_spot")        { name = "Spot Light"; g = 255; b = 255; }
    if (kind == "light_ambient")     { name = "Ambient Light"; r = 90; g = 100; b = 120; }
    let s: int = ent_create(kind, name, wx, wy, 48, 48, r, g, b);
    if (s < 0) return s;
    let lz: int = spawn_wz;
    ent_set_z(s, lz);
    if (kind == "light_directional") {
        /* from the upper left front, like the default sun */
        ent_set_rot(s, 335);
        ent_set_light_tilt(s, 35);
        ent_set_light_intensity(s, 60);     /* on top of the stock fill, like the default sun */
    }
    if (kind == "light_spot") ent_set_light_range(s, 600);
    if (scene_render3d() == 0) eng_log("[3d] tip: lights only show in 3D scenes (Inspector, nothing selected: Rendering 3D)");
    return s;
}

fn spawn_shape3d_at(kind: string, x_screen: int, y_screen: int): int {
    let model: string = "";
    if (kind == "model") {
        let initial: string = "";
        if (proj_loaded() == 1) initial = proj_path_join(proj_root(), "assets");
        model = eng_open_file_dialog("Choose a model", "Wavefront OBJ (*.obj)|*.obj|All files|*.*", initial);
        if (model.len() == 0) return -1;
    }
    spawn_locate(x_screen, y_screen);
    let r: int = 110;
    let g: int = 160;
    let b: int = 240;
    if (kind == "sphere")   { r = 240; g = 120; b = 110; }
    if (kind == "cylinder") { r = 110; g = 210; b = 150; }
    if (kind == "capsule")  { r = 176; g = 140; b = 220; }
    if (kind == "model")    { r = 200; g = 200; b = 210; }
    let ew: int = 64;
    let eh: int = 64;
    if (kind == "capsule") eh = 160;
    let wx: int = spawn_wx - ew / 2;
    let wy: int = spawn_wy - eh / 2;
    let name: string = kind;
    if (kind == "capsule") name = "Capsule";
    let s: int = ent_create(kind, name, wx, wy, ew, eh, r, g, b);
    if (s >= 0) {
        let sz: int = spawn_wz - ew / 2;    /* centered in depth too */
        if (view3d_active() == 1) ent_set_z(s, sz);
    }
    if (s >= 0 && model.len() > 0) ent_set_model(s, model);
    if (s >= 0 && scene_render3d() == 0) eng_log("[3d] tip: set Rendering to 3D (Inspector, nothing selected) to play this scene in 3D");
    return s;
}

/* Screen picture. x/y/w/h are canvas pixels (1280x720), drawn over the 3D view. */
fn spawn_screen_sprite_at(x_screen: int, y_screen: int): int {
    ui_canvas_layout_game_view(game_view_rect());
    let uxf: float = screen_to_ui_x(x_screen);
    let uyf: float = screen_to_ui_y(y_screen);
    let sw: int = 256;
    let sh: int = 128;
    let ux: int = uxf - sw / 2;
    let uy: int = uyf - sh / 2;
    let s: int = ent_create("sprite2d", "Screen Sprite", ux, uy, sw, sh, 255, 255, 255);
    if (s < 0) return -1;
    let filter: string = "Images|*.png;*.jpg;*.jpeg;*.bmp;*.gif|All files|*.*";
    let initial: string = "";
    if (proj_loaded() == 1) initial = proj_path_join(proj_root(), "assets");
    let chosen: string = eng_open_file_dialog("Choose sprite", filter, initial);
    if (chosen.len() > 0) {
        ent_set_sprite(s, chosen);
        let img: int = eng_image_load_cached(chosen);
        if (img != 0) {
            let iw: int = eng_image_w(img);
            let ih: int = eng_image_h(img);
            if (iw > 0 && ih > 0) {
                let scale: float = 1.0;
                if (iw > UI_CANVAS_W) {
                    let fit: float = UI_CANVAS_W;
                    fit = fit / iw;
                    scale = fit;
                }
                if (ih > UI_CANVAS_H) {
                    let fit: float = UI_CANVAS_H;
                    fit = fit / ih;
                    if (fit < scale) scale = fit;
                }
                let fw: float = iw;
                fw = fw * scale;
                let fh: float = ih;
                fh = fh * scale;
                iw = fw;
                ih = fh;
                if (iw < 4) iw = 4;
                if (ih < 4) ih = 4;
                ent_set_w(s, iw);
                ent_set_h(s, ih);
                let nx: int = uxf - iw / 2;
                let ny: int = uyf - ih / 2;
                ent_set_x(s, nx);
                ent_set_y(s, ny);
            }
        }
    }
    return s;
}

fn spawn_emitter_at(x_screen: int, y_screen: int): int {
    spawn_locate(x_screen, y_screen);
    let wx: int = spawn_wx - 24.0;
    let wy: int = spawn_wy - 24.0;
    let s: int = ent_create("emitter", "Particles", wx, wy, 48, 48, 255, 255, 255);
    if (s >= 0 && view3d_active() == 1) {
        let sz: int = spawn_wz - 24.0;
        ent_set_z(s, sz);
    }
    return s;
}

