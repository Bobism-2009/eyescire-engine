fn settings_apply_play_size(pw: int, ph: int) {
    pref_set_int("play_w", pw);
    pref_set_int("play_h", ph);
    settings_pw = "" + pref_int("play_w", pw);
    settings_ph = "" + pref_int("play_h", ph);
    if (edit_target == "set_pw" || edit_target == "set_ph") edit_target = "";
}

fn scene_file_is_3d(path: string): int {
    let r: int = 0;
    inline_cpp! {
        FILE* f = fopen(path.c_str(), "rb");
        if (f) {
            char buf[512];
            std::string body;
            size_t nread = 0;
            while ((nread = fread(buf, 1, sizeof(buf), f)) > 0) body.append(buf, nread);
            fclose(f);
            if (body.find("RENDER 3D") != std::string::npos) r = 1;
        }
    }
    return r;
}

/* 1 when any scene in the open project plays in 3D. */
fn project_uses_3d(): int {
    if (scene_render3d() == 1) return 1;
    if (proj_loaded() == 0) return 0;
    let n: int = proj_scene_count();
    let i: int = 0;
    while (i < n) {
        if (scene_file_is_3d(proj_scene_abs(i)) == 1) return 1;
        i = i + 1;
    }
    return 0;
}

fn settings_page_graphics(x: int, y: int, w: int) {
    let use3d: int = project_uses_3d();
    let head: string = "Play resolution and the game window";
    if (use3d == 1) head = "Renderer, Filament, play resolution, and 3D options";
    y = settings_page_header(x, y, "Graphics", head);
    if (use3d == 1) {
    y = chrome_section(x, y, w, "RENDERER");
    let which: int = pref_int("renderer", 33);
    let k11: string = "secondary";
    let k33: string = "secondary";
    let kvk: string = "secondary";
    if (which == 11) k11 = "primary";
    else if (which == 14) kvk = "primary";
    else k33 = "primary";
    let half: int = (w - 8) / 2;
    if (ui_button_kind(rect(x, y, half, 28), "OpenGL 3.3", k33) == 1 && which != 33) pref_set_int("renderer", 33);
    if (ui_button_kind(rect(x + half + 8, y, half, 28), "Vulkan 1.4", kvk) == 1 && which != 14) pref_set_int("renderer", 14);
    y = y + 36;
    if (ui_button_kind(rect(x, y, half, 28), "OpenGL 1.1", k11) == 1 && which != 11) pref_set_int("renderer", 11);
    y = y + 40;
    draw_text(x, y, "Used when Filament is off. This frame: " + r3d_backend_name(), col_text_dim());
    y = y + 36;
    y = chrome_section(x, y, w, "FILAMENT");
    settings_onoff(x, y, w, "Filament", "filament", 1);
    y = y + 36;
    y = settings_hint(x, y, w, "Lights, shadows, and textures the 3D view. Off uses the renderer above.");
    y = y + 14;
    }
    y = chrome_section(x, y, w, "PLAY WINDOW");
    if (use3d == 1) draw_text(x, y, "3D Play and an exported game open at this size.", col_text_dim());
    else draw_text(x, y, "An exported game opens at this size.", col_text_dim());
    y = y + 24;
    let bw: int = (w - 16) / 3;
    let w1280: string = "secondary";
    let w1600: string = "secondary";
    let w1920: string = "secondary";
    let cw: int = pref_int("play_w", 1280);
    let ch: int = pref_int("play_h", 720);
    if (cw == 1280 && ch == 720) w1280 = "primary";
    if (cw == 1600 && ch == 900) w1600 = "primary";
    if (cw == 1920 && ch == 1080) w1920 = "primary";
    if (ui_button_kind(rect(x, y, bw, 28), "1280 x 720", w1280) == 1) settings_apply_play_size(1280, 720);
    if (ui_button_kind(rect(x + bw + 8, y, bw, 28), "1600 x 900", w1600) == 1) settings_apply_play_size(1600, 900);
    if (ui_button_kind(rect(x + (bw + 8) * 2, y, bw, 28), "1920 x 1080", w1920) == 1) settings_apply_play_size(1920, 1080);
    y = y + 40;
    chrome_field_label(x, y, "Width");
    chrome_field_label(x + 180, y, "Height");
    y = y + 16;
    let pwb: string = ui_field("set_pw", rect(x, y, 160, 28), settings_pw);
    let phb: string = ui_field("set_ph", rect(x + 180, y, 160, 28), settings_ph);
    if (pwb != settings_pw || phb != settings_ph) {
        pref_set_int("play_w", parse_int_or(pwb, cw));
        pref_set_int("play_h", parse_int_or(phb, ch));
        settings_pw = pwb;
        settings_ph = phb;
    }
    y = y + 44;
    settings_onoff(x, y, w, "Fullscreen", "fullscreen", 0);
    y = y + 36;
    y = settings_hint(x, y, w, "The editor stays in its own window. Fullscreen is for the game.");
    y = y + 12;
    settings_onoff(x, y, w, "VSync", "vsync", 1);
    y = y + 36;
    y = settings_hint(x, y, w, "On waits for the monitor. The editor and the game both use it.");
    y = y + 12;
    settings_onoff(x, y, w, "High definition", "hd", 0);
    y = y + 36;
    y = settings_hint(x, y, w, "On draws the 3D picture at twice the resolution. Sharper, and slower.");
    y = settings_hint(x, y, w, "The editor view, Play, and an exported 3D game all use it.");
    y = y + 12;
    settings_onoff(x, y, w, "Anti-aliasing", "aa", 1);
    y = y + 36;
    y = settings_hint(x, y, w, "On smooths the edges of the 3D picture. Off leaves them jagged.");
    y = settings_hint(x, y, w, "An object can follow this, or force its own edges on or off.");
    y = y + 12;
    settings_onoff(x, y, w, "Shadows", "shadows", 1);
    y = y + 36;
    y = settings_hint(x, y, w, "On casts one soft shadow from the directional light.");
    y = settings_hint(x, y, w, "It falls on the ground and on other objects. Spot and point lights stay plain.");
    y = y + 12;
    settings_onoff(x, y, w, "Fog", "fog", 0);
    y = y + 36;
    draw_text(x, y, "On fades far objects into a color. Off leaves the picture clear.", col_text_dim());
    y = y + 20;
    draw_text(x, y, "They are fully that color at the distance. Closer objects stay clearer.", col_text_dim());
    y = y + 20;
    draw_text(x, y, "The editor, Play, and an exported 3D game use it. OpenGL 1.1 stays clear.", col_text_dim());
    y = y + 28;
    chrome_field_label(x, y, "R");
    chrome_field_label(x + 88, y, "G");
    chrome_field_label(x + 176, y, "B");
    chrome_field_label(x + 264, y, "Distance");
    y = y + 16;
    let fr: string = ui_field("set_fogr", rect(x, y, 76, 28), settings_fog_r);
    let fg: string = ui_field("set_fogg", rect(x + 88, y, 76, 28), settings_fog_g);
    let fb: string = ui_field("set_fogb", rect(x + 176, y, 76, 28), settings_fog_b);
    let fd: string = ui_field("set_fogd", rect(x + 264, y, 120, 28), settings_fog_d);
    if (fr != settings_fog_r) { pref_set_int("fog_r", parse_int_or(fr, pref_int("fog_r", 168))); settings_fog_r = fr; }
    if (fg != settings_fog_g) { pref_set_int("fog_g", parse_int_or(fg, pref_int("fog_g", 186))); settings_fog_g = fg; }
    if (fb != settings_fog_b) { pref_set_int("fog_b", parse_int_or(fb, pref_int("fog_b", 206))); settings_fog_b = fb; }
    if (fd != settings_fog_d) { pref_set_int("fog_dist", parse_int_or(fd, pref_int("fog_dist", 4800))); settings_fog_d = fd; }
    settings_bottom = y + 40;
}

