// =============================================================================
// Eyescire Engine - Nexa wrappers around the engine.dll C ABI.
//
// editor.exe and every script DLL #include this file. Each wrapper is a
// thin Nexa fn that forwards arguments into the matching extern "C"
// engine_* function declared in the single inline_cpp! block below. With
// --preserve-names the Nexa parameter and local names match the names the
// inline_cpp! body references, so this is the only place in the project
// where Nexa source touches C++.
// =============================================================================

#include <std/io>
#include <std/inline>

