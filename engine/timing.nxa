// =============================================================================
// Eyescire Engine - frame timing.
//
// Wraps the engine's high-resolution timer into a frame-pacing helper.
// frame_begin() captures "now"; frame_end() sleeps off the remaining slice
// of the configured frame budget and stores the realized delta back inside
// the engine via eng_set_dt_seconds() so scripts running inside the engine
// (this process) can read eng_dt_seconds() directly.
// =============================================================================

#include "api.nxa"

let frame_target_ms: float  = 16.6667;
let frame_t0: float         = 0.0;
let frame_dt_ms_last: float = 16.0;
let frame_total: int        = 0;

fn set_target_fps(fps: int) {
    let f: float = fps;
    if (f < 1.0) f = 1.0;
    frame_target_ms = 1000.0 / f;
}

fn frame_begin() {
    frame_t0 = eng_now_ms();
}

fn frame_end() {
    let now: float     = eng_now_ms();
    let elapsed: float = now - frame_t0;
    /* VSync waits inside present, so the counter sits on the monitor rate.
       VSync off keeps the time the frame actually took, which is how a faster
       backend shows a higher rate. */
    if (elapsed < 0.0) elapsed = 0.0;
    frame_dt_ms_last = elapsed;
    eng_set_dt_seconds(frame_dt_ms_last / 1000.0);
    frame_total = frame_total + 1;
}

fn frame_dt_ms(): float { return frame_dt_ms_last; }
fn frame_count(): int   { return frame_total; }
