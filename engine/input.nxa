let MOUSE_LEFT:   int = 0;
let MOUSE_RIGHT:  int = 1;
let MOUSE_MIDDLE: int = 2;

fn key_down(vk: int): bool {
    if (eng_key_down(vk) == 1) return true;
    return false;
}
fn key_pressed(vk: int): bool {
    if (eng_key_pressed(vk) == 1) return true;
    return false;
}
fn key_released(vk: int): bool {
    if (eng_key_released(vk) == 1) return true;
    return false;
}
fn mouse_down(btn: int): bool {
    if (eng_mouse_down(btn) == 1) return true;
    return false;
}
fn mouse_pressed(btn: int): bool {
    if (eng_mouse_pressed(btn) == 1) return true;
    return false;
}
fn mouse_released(btn: int): bool {
    if (eng_mouse_released(btn) == 1) return true;
    return false;
}
fn ctrl_held(): bool { return key_down(VK_CONTROL); }
fn shift_held(): bool { return key_down(VK_SHIFT); }
fn alt_held(): bool { return key_down(VK_ALT); }

fn typed_pop(): int { return eng_typed_pop(); }
