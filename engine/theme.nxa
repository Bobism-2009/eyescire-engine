// =============================================================================
// Eyescire Engine - editor theme.
//
// Charcoal chrome on the engine.dll renderer: 10 px rounding, soft single
// shadow, Bahnschrift type, soft steel accent, muted field text.
//
// Editor-only: not part of engine.nxa, so scripts never compile it. Include it
// after engine.nxa.
// =============================================================================

let TH_RADIUS: int = 10;

// ----- type ------------------------------------------------------------------
// Chrome uses Bahnschrift; code, the console and anything that must match the
// shipped game (entity labels) stay on Cascadia Mono / Consolas-class.

fn th_font(px: int)      { eng_set_font("Bahnschrift", px); }
fn th_font_semi(px: int) { eng_set_font("Bahnschrift SemiBold", px); }
fn th_font_mono(px: int) { eng_set_font("Cascadia Mono", px); }

/* y that vertically centres a line of the current font inside [ry, ry+rh). */
fn th_text_y(ry: int, rh: int): int {
    return ry + (rh - eng_text_height()) / 2;
}

// ----- colour ----------------------------------------------------------------

fn th_white(): Color { return rgb(255, 255, 255); }

/* Lift a colour toward white by amt. */
fn th_shade(c: Color, amt: int): Color {
    return col_lerp(c, th_white(), (amt * 100) / 255);
}

// ----- shapes ----------------------------------------------------------------

fn th_radius_for(h: int): int {
    if (TH_RADIUS * 2 > h) return h / 2;
    return TH_RADIUS;
}

fn th_fill(r: Rect, rad: int, c: Color) {
    eng_fill_round_a(r.x, r.y, r.w, r.h, rad, c.r, c.g, c.b, 255);
}

fn th_fill_a(r: Rect, rad: int, c: Color, a: int) {
    eng_fill_round_a(r.x, r.y, r.w, r.h, rad, c.r, c.g, c.b, a);
}

/* 1 px edge that lands on the rect's own outer pixels. */
fn th_edge(r: Rect, rad: int, c: Color) {
    eng_outline_round_a(r.x, r.y, r.w - 1, r.h - 1, rad, 1, c.r, c.g, c.b, 255);
}

fn th_ring(r: Rect, rad: int, thickness: int, c: Color) {
    eng_outline_round_a(r.x, r.y, r.w - 1, r.h - 1, rad, thickness, c.r, c.g, c.b, 255);
}

fn th_shadow(r: Rect, rad: int) {
    /* One soft lift — avoid stacked heavy shadows. */
    eng_fill_round_a(r.x, r.y + 3, r.w, r.h + 2, rad + 2, 0, 0, 0, 55);
}

// ----- surfaces --------------------------------------------------------------

fn th_card(r: Rect, active: int, hover: int) {
    let rad: int = TH_RADIUS;
    th_shadow(r, rad);
    let fill: Color = col_ui_panel();
    if (hover == 1) fill = col_ui_panel_hi();
    th_fill(r, rad, fill);
    let edge: Color = col_ui_border();
    if (active == 1) edge = col_ui_accent();
    th_edge(r, rad, edge);
}

fn th_popup(r: Rect) {
    let rad: int = TH_RADIUS;
    th_shadow(r, rad);
    th_fill(r, rad, col_ui_panel());
    th_edge(r, rad, col_ui_border());
}

fn th_row(r: Rect, selected: int, hover: int) {
    if (selected == 1) {
        th_fill(r, 6, col_ui_select());
        let bh: int = r.h - 10;
        if (bh > 16) bh = 16;
        if (bh < 8) bh = 8;
        let a: Color = col_ui_accent();
        eng_fill_round_a(r.x + 4, r.y + (r.h - bh) / 2, 3, bh, 2, a.r, a.g, a.b, 255);
    } else if (hover == 1) {
        th_fill(r, 6, col_ui_panel_hi());
    }
}

fn th_menu_row(r: Rect, hover: int) {
    if (hover == 1) th_fill(rect(r.x + 4, r.y + 2, r.w - 8, r.h - 4), 6, col_ui_panel_hi());
}

// ----- widgets ---------------------------------------------------------------

fn th_button(r: Rect, label: string, kind: string, hover: int, held: int) {
    let rad: int = th_radius_for(r.h);
    let fill: Color = col_ui_panel();
    let text: Color = col_ui_text();
    let filled: int = 1;
    let outlined: int = 0;
    if (kind == "primary" || kind == "danger") {
        fill = col_ui_accent();
        if (kind == "danger") fill = col_ui_danger();
        text = rgb(220, 220, 220);
        if (held == 1)       fill = th_shade(fill, 36);
        else if (hover == 1) fill = th_shade(fill, 18);
    } else if (kind == "ghost") {
        fill = col_ui_panel_hi();
        filled = 0;
        if (hover == 1 || held == 1) filled = 1;
        if (held == 1) fill = th_shade(fill, 14);
    } else if (kind == "disabled") {
        /* Same outer plate as primary — muted fill, no hairline outline. */
        fill = rgb(32, 32, 32);
        text = rgb(96, 96, 96);
        outlined = 0;
        filled = 1;
    } else {
        outlined = 0;
        fill = col_ui_panel_hi();
        if (hover == 1) fill = th_shade(col_ui_panel_hi(), 18);
        if (held == 1)  fill = th_shade(col_ui_panel_hi(), 28);
    }
    if (filled == 1)   th_fill(r, rad, fill);
    if (outlined == 1) th_edge(r, rad, col_ui_border());
    if (label.len() == 0) return;
    th_font_semi(12);
    draw_text_centered(r.x, r.y + held, r.w, r.h, label, text);
    th_font(14);
}

fn th_field(r: Rect, focused: int, hover: int) {
    let rad: int = th_radius_for(r.h);
    th_fill(r, rad, col_ui_input());
    /* No idle hairline — only a soft fill lift on hover / accent fill on focus. */
    if (focused == 1) {
        th_fill_a(rect(r.x, r.y, r.w, r.h), rad, col_ui_accent(), 28);
    } else if (hover == 1) {
        th_fill(r, rad, th_shade(col_ui_input(), 18));
    }
}

fn th_tab(r: Rect, label: string, active: int, hover: int) {
    if (hover == 1 && active == 0) th_fill(rect(r.x + 2, r.y + 4, r.w - 4, r.h - 8), 6, col_ui_panel());
    let tc: Color = col_ui_text_dim();
    if (active == 1 || hover == 1) tc = col_ui_text();
    if (active == 1) th_font_semi(12);
    else             th_font(12);
    draw_text_centered(r.x, r.y - 1, r.w, r.h, label, tc);
    if (active == 1) {
        let a: Color = col_ui_accent();
        eng_fill_round_a(r.x + 8, r.y + r.h - 3, r.w - 16, 2, 1, a.r, a.g, a.b, 255);
    }
    th_font(14);
}

fn th_progress(x: int, y: int, w: int, num: int, den: int) {
    th_fill(rect(x, y, w, 6), 3, col_ui_track());
    if (den <= 0 || num <= 0) return;
    let fw: int = (num * w) / den;
    if (fw > w) fw = w;
    if (fw < 6) fw = 6;
    th_fill(rect(x, y, fw, 6), 3, col_ui_accent());
}

fn th_chip(r: Rect, label: string, c: Color) {
    th_fill_a(r, r.h / 2, c, 40);
    th_edge(r, r.h / 2, c);
    th_font_semi(11);
    draw_text_centered(r.x, r.y, r.w, r.h, label, c);
    th_font(14);
}

fn th_caption(x: int, y: int, s: string) {
    th_font_semi(11);
    draw_text(x, y, s, col_ui_text_dim());
    th_font(14);
}
