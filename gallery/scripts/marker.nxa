// marker.nxa
#include <eyescire/script>

fn script_update() {
    let me: int = eng_self();
    if (me < 0) return;
    let speed: float = pub_float("Spin", 40.0);
    let on: int = pub_bool("Show", 1);
    let title: string = pub_string("Label", "Gallery");
    if (on == 0) return;
    if (title.len() == 0) return;
    let step: float = speed * eng_dt_seconds();
    let add: int = step;
    if (add == 0 && speed > 0.0) add = 1;
    ent_set_rot_y(me, ent_rot_y(me) + add);
}
